---
# === Forward Plan ===
#
# Goal: Enable all checks in these categories (unless in Intentionally Disabled):
#   bugprone-*, cppcoreguidelines-*, misc-*, modernize-*, readability-*
#
# === Disabled Check Groups ===
#
# Irrelevant platforms/frameworks:
#   abseil-*, altera-*, android-*, darwin-*, fuchsia-*, google-objc-*,
#   linuxkernel-*, llvm-*, llvmlibc-*, openmp-*, zircon-*
#
# Run separately:
#   clang-analyzer-*  (dedicated scan with report)
#
# === Evaluated ===
#
# google-build-using-namespace, google-global-names-in-headers:
# readability-named-parameter, cppcoreguidelines-avoid-non-const-global-variables:
#   Enabled for Metalium host API header verification only, through
#   cmake/clang-tidy.d/metalium-api/.clang-tidy. Ordinary source scans keep
#   these checks disabled.
#
# bugprone-unchecked-optional-access:
#   Attempted, no fixit, lots of violations. Extensive usage of std::optional in this codebase.
#
# cppcoreguidelines-init-variables:
#   Attempted, has fixit, results in massive diff. Somewhat desireable for ND avoidance.
#
# === Intentionally Disabled ===
#
# bugprone-sizeof-expression:
#   Attempted, no fixit, developers rejected stating lack of value.
#
# concurrency-mt-unsafe:
#   Attempted, no fixit, may not be realistic to fix as it flags std::getenv();
#
# performance-avoid-endl:
#   Attempted, but developers rejected auto-fixits due to concerns about
#   potential flush dependency.
#
# === v23 additions ===
#
# Checks new in, or with a stricter matcher since, clang-tidy 23 — kept
# disabled rather than enabling + fixing as part of the version bump;
# revisit individually.
#
# Exceptions: portability-no-assembler stays enabled (carries v20's
# hicpp-no-assembler coverage); performance-faster-string-find stays
# disabled though not new (v23 errors on the deprecated name itself
# under --warnings-as-errors=*).
Checks: >
  *,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-narrowing-conversions,
  -bugprone-sizeof-expression,
  -bugprone-unchecked-optional-access,
  -concurrency-mt-unsafe,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-noexcept-move-operations,
  -cppcoreguidelines-noexcept-swap,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-const-cast,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-rvalue-reference-param-not-moved,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-use-default-member-init,
  -google-build-using-namespace,
  -google-default-arguments,
  -google-explicit-constructor,
  -google-global-names-in-headers,
  -google-objc-*,
  -google-readability-avoid-underscore-in-googletest-name,
  -google-readability-braces-around-statements,
  -google-readability-casting,
  -google-readability-function-size,
  -google-readability-namespace-comments,
  -google-readability-todo,
  -google-runtime-int,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -modernize-avoid-bind,
  -modernize-avoid-c-arrays,
  -modernize-macro-to-enum,
  -modernize-pass-by-value,
  -modernize-return-braced-init-list,
  -modernize-use-auto,
  -modernize-use-constraints,
  -modernize-use-designated-initializers,
  -modernize-use-emplace,
  -modernize-use-integer-sign-comparison,
  -modernize-use-nodiscard,
  -modernize-use-ranges,
  -modernize-use-trailing-return-type,
  -modernize-use-transparent-functors,
  -performance-avoid-endl,
  -performance-enum-size,
  -performance-inefficient-string-concatenation,
  -performance-no-int-to-ptr,
  -portability-simd-intrinsics,
  -portability-template-virtual-member-function,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-convert-member-functions-to-static,
  -readability-enum-initial-value,
  -readability-function-size,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-named-parameter,
  -readability-redundant-casting,
  -readability-suspicious-call-argument,
  -readability-uppercase-literal-suffix,
  -readability-use-anyofallof,
  -bugprone-assignment-in-selection-statement,
  -bugprone-capturing-this-in-member-variable,
  -bugprone-command-processor,
  -bugprone-copy-constructor-mutates-argument,
  -bugprone-default-operator-new-on-overaligned-type,
  -bugprone-derived-method-shadowing-base-method,
  -bugprone-exception-copy-constructor-throws,
  -bugprone-float-loop-counter,
  -bugprone-fold-init-type,
  -bugprone-invalid-enum-default-initialization,
  -bugprone-misleading-setter-of-reference,
  -bugprone-missing-end-comparison,
  -bugprone-optional-value-conversion,
  -bugprone-random-generator-seed,
  -bugprone-raw-memory-call-on-non-trivial-type,
  -bugprone-signed-bitwise,
  -bugprone-std-exception-baseclass,
  -bugprone-std-namespace-modification,
  -bugprone-throwing-static-initialization,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-unhandled-code-paths,
  -bugprone-unintended-char-ostream-output,
  -bugprone-unsafe-to-allow-exceptions,
  -cert-exp45-c,
  -cppcoreguidelines-explicit-constructor,
  -cppcoreguidelines-missing-std-forward,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-use-enum-class,
  -google-runtime-float,
  -misc-anonymous-namespace-in-header,
  -misc-explicit-constructor,
  -misc-multiple-inheritance,
  -misc-override-with-different-visibility,
  -misc-predictable-rand,
  -misc-static-initialization-cycle,
  -modernize-avoid-c-style-cast,
  -modernize-avoid-setjmp-longjmp,
  -modernize-avoid-variadic-functions,
  -modernize-redundant-void-arg,
  -modernize-type-traits,
  -modernize-use-default-member-init,
  -modernize-use-scoped-lock,
  -modernize-use-std-bit,
  -modernize-use-string-view,
  -modernize-use-structured-binding,
  -performance-faster-string-find,
  -performance-prefer-single-char-overloads,
  -performance-string-view-conversions,
  -performance-use-std-move,
  -portability-avoid-pragma-once,
  -readability-ambiguous-smartptr-reset-call,
  -readability-else-after-return,
  -readability-inconsistent-ifelse-braces,
  -readability-redundant-lambda-parameter-list,
  -readability-redundant-nested-if,
  -readability-redundant-parentheses,
  -readability-redundant-qualified-alias,
  -readability-redundant-typename,
  -readability-trailing-comma,
  -readability-trivial-switch,
  -readability-use-concise-preprocessor-directives,
  -abseil-*,
  -altera-*,
  -android-*,
  -boost-*,
  -cert-arr39-c,
  -cert-dcl16-c,
  -cert-dcl21-cpp,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-dcl58-cpp,
  -cert-env33-c,
  -cert-err33-c,
  -cert-err34-c,
  -cert-err58-cpp,
  -cert-flp30-c,
  -cert-int09-c,
  -cert-msc30-c,
  -cert-msc32-c,
  -cert-msc50-cpp,
  -cert-msc51-cpp,
  -cert-oop11-cpp,
  -cert-oop54-cpp,
  -clang-analyzer-*,
  -darwin-*,
  -fuchsia-*,
  -hicpp-avoid-c-arrays,
  -hicpp-avoid-goto,
  -hicpp-braces-around-statements,
  -hicpp-deprecated-headers,
  -hicpp-exception-baseclass,
  -hicpp-explicit-conversions,
  -hicpp-function-size,
  -hicpp-invalid-access-moved,
  -hicpp-member-init,
  -hicpp-move-const-arg,
  -hicpp-multiway-paths-covered,
  -hicpp-named-parameter,
  -hicpp-no-array-decay,
  -hicpp-no-malloc,
  -hicpp-noexcept-move,
  -hicpp-signed-bitwise,
  -hicpp-special-member-functions,
  -hicpp-uppercase-literal-suffix,
  -hicpp-use-auto,
  -hicpp-use-emplace,
  -hicpp-use-nullptr,
  -hicpp-vararg,
  -linuxkernel-*,
  -llvm-*,
  -llvmlibc-*,
  -openmp-*,
  -zircon-*

CheckOptions:
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
  - key: readability-function-cognitive-complexity.Threshold
    value: 312
  - key: portability-simd-intrinsics.Suggest
    value: true
  # May enable later; for now activate the check with a lighter touch
  - key: readability-simplify-boolean-expr.SimplifyDeMorgan
    value: false
  - key: performance-unnecessary-copy-initialization.AllowedTypes
    value: "^MemoryPin$"
  - key: readability-else-after-return.WarnOnUnfixable
    value: false
  - key: readability-else-after-return.WarnOnConditionVariables
    value: false

FormatStyle: 'file'

# LLVM uses POSIX regular expressions, which do not support negative lookahead.
HeaderFilterRegex: '.*'
# Exclude generated protobuf/FlatBuffers output, generated Quasar register maps, and third-party headers.
ExcludeHeaderFilterRegex: '\.pb\.h$|(^|/)tt_metal/(impl/flatbuffers/[^/]+_generated\.h|hw/inc/internal/tt-2xx/quasar/(tensix_neo_reg\.h|noc/registers/noc_address_translation_table_a_reg\.h))$|(^|/)(\.cpmcache|third_party)/'

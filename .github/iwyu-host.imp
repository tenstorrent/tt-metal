# include-what-you-use mapping file for the host scan; passed via --mapping_file
# by .github/scripts/utils/run_host_iwyu.sh (.github/workflows/iwyu-host.yaml).
# Format: https://github.com/include-what-you-use/include-what-you-use/blob/master/docs/IWYUMappings.md
#
# Each entry redirects a third-party header that IWYU would otherwise name in
# a recommendation to the header the library actually wants callers to use.
[
  # yaml-cpp (third_party/CMakeLists.txt pins 0.8.0 + patches). That release's
  # yaml.h has no "IWYU pragma: export" annotations (upstream added them
  # later), so IWYU attributes every YAML:: symbol to its declaring header and
  # asks callers to replace <yaml-cpp/yaml.h> with a dozen internal ones
  # (node/node.h, node/parse.h, node/detail/impl.h, emittermanip.h, ...).
  # yaml.h is the library's only documented entry point.
  { "include": ["@<yaml-cpp/.*>", "private", "<yaml-cpp/yaml.h>", "public"] },
  { "include": ["@\"yaml-cpp/.*\"", "private", "<yaml-cpp/yaml.h>", "public"] },

  # protobuf v21.12: repeated_ptr_field.h carries
  #   IWYU pragma: private, include "net/proto2/public/repeated_field.h"
  # which is Google's internal path, absent from the open-source release. Any
  # use of RepeatedPtrField (iterating a repeated message field) would
  # otherwise be told to include that nonexistent header. Generated .pb.h files
  # export <google/protobuf/repeated_field.h>, so this maps to it.
  { "include": ["\"net/proto2/public/repeated_field.h\"", "private", "<google/protobuf/repeated_field.h>", "public"] }
]

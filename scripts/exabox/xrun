#!/bin/bash
# xrun: place-aware dispatcher for the op gen workflow. Same call works on a regular machine and on the Exabox login node.
#   xrun build [--no-wait] [build_metal.sh args...]   build tt-metal
#   xrun test  <run_safe_pytest.sh args...>             run a device test
#   xrun run   "<command>"                              run any other command that needs the devices
# Where it runs is decided on every call:
#   Exabox login node (slurm-login-0[1-3], sbatch present): build -> sbatch on a build node (waits, exit 0 = built);
#                                                          test/run -> as a Slurm step on the reserved node (on-node)
#   anywhere else (IRD container, a dev box, a device node): runs ./build_metal.sh / scripts/run_safe_pytest.sh directly.
# Overrides: XRUN_MODE=exabox|local   XRUN_DRY_RUN=1 (print, do not run)   NODE_JOB=<jobid> (reservation job)
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO="${XRUN_REPO:-$(git -C "$HERE" rev-parse --show-toplevel 2>/dev/null || pwd)}"
detect() {
  [ -n "${XRUN_MODE:-}" ] && { echo "$XRUN_MODE"; return; }
  if [[ "$(hostname -f 2>/dev/null || hostname)" =~ ^slurm-login-0[1-3] ]] && command -v sbatch >/dev/null 2>&1; then echo exabox; else echo local; fi
}
MODE="$(detect)"; CMD="${1:-}"; shift || true
[ "$MODE" = exabox ] && . "$HERE/env.sh"   # eval DB + run dir on /data (no /localdev, no bgdepyc01 here)
do_run() { if [ -n "${XRUN_DRY_RUN:-}" ]; then echo "[xrun:$MODE] $*"; else "$@"; fi; }
case "$CMD" in
  build)
    WAIT=1; [ "${1:-}" = "--no-wait" ] && { WAIT=0; shift; }
    if [ "$MODE" = local ]; then cd "$REPO" && export XRUN_BYPASS=1 && do_run ./build_metal.sh "$@"; exit $?; fi
    echo "[xrun] exabox login node: submitting the build to a build node (not building here)"
    if [ -n "${XRUN_DRY_RUN:-}" ]; then echo "[xrun:$MODE] BUILD_ARGS=\"$*\" $HERE/build-metal"; [ $WAIT = 1 ] && echo "[xrun:$MODE] $HERE/build-wait <jobid>"; exit 0; fi
    OUT="$(BUILD_ARGS="$*" "$HERE/build-metal" 2>&1)" || { echo "$OUT"; exit 1; }
    JOB="$(echo "$OUT" | grep -oE "[0-9]+$" | tail -1)"; echo "[xrun] build job $JOB, log /data/$USER/logs/ttmetal-build-$JOB.out"
    [ $WAIT = 1 ] && exec "$HERE/build-wait" "$JOB"; exit 0 ;;
  test|run)
    if [ "$MODE" = local ]; then
      cd "$REPO"; export XRUN_BYPASS=1   # the real scripts carry an exabox guard that would call back into xrun
      if [ "$CMD" = test ]; then do_run scripts/run_safe_pytest.sh "$@"; else do_run bash -c "$*"; fi; exit $?
    fi
    echo "[xrun] exabox login node: running on the reserved node, not here"
    # Exabox only: precompile gave wrong device results on the reserved node (cause unknown), so run plain.
    if [ "$CMD" = test ]; then INNER="scripts/run_safe_pytest.sh --no-precompile $(printf "%q " "$@")"; else INNER="$*"; fi
    if [ -n "${XRUN_DRY_RUN:-}" ]; then echo "[xrun:$MODE] $HERE/on-node \"$INNER\""; exit 0; fi
    exec "$HERE/on-node" "$INNER" ;;
  *) echo "usage: xrun build [--no-wait] [args] | test <args> | run \"<cmd>\"   (mode now: $MODE)"; exit 2 ;;
esac

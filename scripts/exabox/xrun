#!/bin/bash
# xrun: place-aware dispatcher for the op gen workflow. Same call works on a regular machine and on a Slurm login node.
#   xrun build [--no-wait] [build_metal.sh args...]   build tt-metal
#   xrun test  <run_safe_pytest.sh args...>             run a device test
#   xrun run   "<command>"                              run any other command that needs the devices
#   xrun mode                                           print where calls go: login | local
# Where it runs is decided on every call:
#   Slurm login node (sbatch present, no /dev/tenstorrent, not inside a Slurm job):
#       build -> sbatch on a build node (waits, exit 0 = built); test/run -> Slurm step in your reservation (on-node)
#   anywhere else (IRD container, a dev box, a device node, inside a job): runs ./build_metal.sh /
#       scripts/run_safe_pytest.sh / the command directly.
# Overrides: XRUN_MODE=login|local   XRUN_DRY_RUN=1 (print, do not run)   NODE_JOB=<jobid>
#            XRUN_BUILDER=node (build on the reserved node, XRUN_NODE_JOBS jobs, default 24) | local (build on the login
#            node itself, XRUN_LOCAL_JOBS jobs, default 16) | sbatch; see env.sh.
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
detect() {
  [ -n "${XRUN_MODE:-}" ] && { echo "$XRUN_MODE"; return; }
  if command -v sbatch >/dev/null 2>&1 && [ ! -e /dev/tenstorrent ] && [ -z "${SLURM_JOB_ID:-}" ]; then echo login; else echo local; fi
}
MODE="$(detect)"; CMD="${1:-}"; shift || true
[ "$CMD" = mode ] && { echo "$MODE"; exit 0; }
. "$HERE/env.sh"
REPO="$XRUN_REPO"
do_run() { if [ -n "${XRUN_DRY_RUN:-}" ]; then echo "[xrun:$MODE] $*"; else "$@"; fi; }
case "$CMD" in
  build)
    WAIT=1; [ "${1:-}" = "--no-wait" ] && { WAIT=0; shift; }
    if [ "$MODE" = local ]; then cd "$REPO" && export XRUN_BYPASS=1 && do_run ./build_metal.sh "$@"; exit $?; fi
    if [ "${XRUN_BUILDER:-}" = node ]; then
      # When no build node is usable: build on the reserved device node as a Slurm step (on-node). Its clang lacks a
      # matching ld.lld, so the gcc toolchain ($XRUN_TOOLCHAIN); jobs are capped (XRUN_NODE_JOBS, default 24) because
      # the node's per-user process limit (ulimit -u 512) also covers the tests running there.
      echo "[xrun] XRUN_BUILDER=node: building on the reserved node with ${XRUN_NODE_JOBS:-24} jobs ($XRUN_TOOLCHAIN)"
      INNER="export XRUN_BYPASS=1 CMAKE_BUILD_PARALLEL_LEVEL=${XRUN_NODE_JOBS:-24} TMPDIR=$XRUN_DATA/tmp; mkdir -p \$TMPDIR; nice -n 10 ./build_metal.sh --toolchain-path $XRUN_TOOLCHAIN $(printf "%q " "$@")"
      if [ -n "${XRUN_DRY_RUN:-}" ]; then echo "[xrun:$MODE] $HERE/on-node \"$INNER\""; exit 0; fi
      exec "$HERE/on-node" "$INNER"
    fi
    if [ "${XRUN_BUILDER:-}" = local ]; then
      # Fallback when the build partition does not work: build here, throttled (a shared login node). The toolchain
      # links with ld.lld, which some hosts only ship as ld.lld-<version>: a PATH shim supplies the plain name.
      echo "[xrun] XRUN_BUILDER=local: building on this login node with ${XRUN_LOCAL_JOBS:-16} jobs"
      if ! command -v ld.lld >/dev/null 2>&1; then
        LLD="$(compgen -c ld.lld- | sort -V | tail -1)"
        [ -n "$LLD" ] && { mkdir -p "$XRUN_DATA/bin-shim" && ln -sfn "$(command -v "$LLD")" "$XRUN_DATA/bin-shim/ld.lld"; export PATH="$XRUN_DATA/bin-shim:$PATH"; }
      fi
      export CMAKE_BUILD_PARALLEL_LEVEL="${XRUN_LOCAL_JOBS:-16}"
      cd "$REPO" && export XRUN_BYPASS=1 && do_run nice -n 10 ./build_metal.sh "$@"; exit $?
    fi
    echo "[xrun] Slurm login node: submitting the build to a build node (not building here)"
    if [ -n "${XRUN_DRY_RUN:-}" ]; then echo "[xrun:$MODE] BUILD_ARGS=\"$*\" $HERE/build-metal"; [ $WAIT = 1 ] && echo "[xrun:$MODE] $HERE/build-wait <jobid>"; exit 0; fi
    OUT="$(BUILD_ARGS="$*" "$HERE/build-metal" 2>&1)" || { echo "$OUT"; exit 1; }
    JOB="$(echo "$OUT" | grep -oE "(Submitted batch job|build job) [0-9]+" | grep -oE "[0-9]+$" | tail -1)"
    [ -n "$JOB" ] || { echo "$OUT"; echo "[xrun] could not read the build job id"; exit 1; }
    echo "$OUT"; echo "[xrun] build job $JOB"
    [ $WAIT = 1 ] && exec "$HERE/build-wait" "$JOB"; exit 0 ;;
  test|run)
    if [ "$MODE" = local ]; then
      cd "$REPO"; export XRUN_BYPASS=1   # the real scripts carry a login-node guard that would call back into xrun
      if [ "$CMD" = test ]; then do_run scripts/run_safe_pytest.sh "$@"; else do_run bash -c "$*"; fi; exit $?
    fi
    echo "[xrun] Slurm login node: running on the reserved node, not here"
    # Precompile stays on (2026-11-27, bh-lb-a10u24: 104 golden tests identical with and without it, 2.4x faster).
    # Its compile workers are capped by XRUN_PRECOMPILE_WORKERS (env.sh): RLIMIT_NPROC on a reserved node is per user
    # across all of its processes and threads, and nproc workers hit it (posix_spawnp: Operation not permitted).
    # XRUN_PRECOMPILE=0 turns it off.
    PC=""; [ "${XRUN_PRECOMPILE:-1}" = 0 ] && PC="--no-precompile "
    if [ "$CMD" = test ]; then INNER="scripts/run_safe_pytest.sh $PC$(printf "%q " "$@")"; else INNER="$*"; fi
    if [ -n "${XRUN_DRY_RUN:-}" ]; then echo "[xrun:$MODE] $HERE/on-node \"$INNER\""; exit 0; fi
    exec "$HERE/on-node" "$INNER" ;;
  *) echo "usage: xrun build [--no-wait] [args] | test <args> | run \"<cmd>\" | mode   (mode now: $MODE)"; exit 2 ;;
esac

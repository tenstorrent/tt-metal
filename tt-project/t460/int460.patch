+class _StubMesh:
+    """The mesh surface the canvas routing and the VAE warmup read; no device behind it."""
+
+    shape = (4, 8)
+
+    def get_num_devices(self) -> int:
+        return 32
+
+    def num_program_cache_entries(self) -> int:
+        return 0
+

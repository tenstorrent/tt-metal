{"id": "83750df71436", "repo": "tenstorrent/tt-llk", "fix_commit": "83750df714363ba37934c9ba00aa05f3d9c3dd56", "files": ["tt_llk_blackhole/common/inc/sfpu/ckernel_sfpu_silu.h", "tt_llk_wormhole_b0/common/inc/sfpu/ckernel_sfpu_silu.h"], "class": "numeric-edge", "component": "llk/sfpu/silu", "summary": "SiLU SFPU kernel mishandled an input edge case causing PCC drop."}
{"id": "d96f4c3f41de", "repo": "tenstorrent/tt-llk", "fix_commit": "d96f4c3f41defc1a74cfcc892e1fd07374e56db1", "files": ["common/tensor_shape.h"], "class": "tt-dead-llk-assert", "component": "llk/asserts", "summary": "Compiler optimized out num_faces/face_r_dim so assert diagnostics showed '?'; made volatile under ENABLE_LLK_ASSERT (debuggability).", "valid": false, "invalid_reason": "debuggability-enhancement"}
{"id": "9ec671ce8922", "repo": "tenstorrent/tt-llk", "fix_commit": "9ec671ce8922ce4cf26cc83e6ee1627cd8231c3b", "files": ["tt_llk_blackhole/common/inc/sfpu/ckernel_sfpu_typecast.h", "tt_llk_wormhole_b0/common/inc/sfpu/ckernel_sfpu_typecast.h"], "class": "rounding", "component": "llk/sfpu-typecast", "summary": "The fp16b store mode writes only the Hi16 bits and leaves stale low bits, which double-rounds the int->fp16b typecast result (-1 becomes -1.0078)."}
{"id": "de501949a139", "repo": "tenstorrent/tt-llk", "fix_commit": "de501949a13972c3335b7af8142e7e2a3ecdb296", "files": ["tt_llk_blackhole/common/inc/cunpack_common.h", "tt_llk_wormhole_b0/common/inc/cunpack_common.h"], "class": "ordering", "component": "llk/unpack", "summary": "The unpack-to-dest semaphore wait named the wrong stall resource (UNPACK instead of STALL_UNPACK), so the stall did not guard what it was meant to."}
{"id": "e9c5400921a9", "repo": "tenstorrent/tt-llk", "fix_commit": "e9c5400921a97f56fb78c98d98e985b0a247f7fc", "files": ["tt_llk_blackhole/llk_lib/experimental/llk_math_mul_reduce_scalar.h"], "class": "stale-state", "component": "llk/math/mul_reduce_scalar", "summary": "The dest offset was hardcoded to 0, which ignores the active dest half when half-dest mode is on."}
{"id": "6f749e20a6f6", "repo": "tenstorrent/tt-llk", "fix_commit": "6f749e20a6f6f814fad66baf28339b3508238224", "files": ["tt_llk_blackhole/llk_lib/llk_math_common.h", "tt_llk_wormhole_b0/llk_lib/llk_math_common.h"], "class": "integer-width", "component": "llk/math", "summary": "Follow-up refactor of P1415 masked format before Int32 check, so int8_math_enabled flag computed wrongly (fix introduced a regression)."}
{"id": "24107c1847f2", "repo": "tenstorrent/tt-llk", "fix_commit": "24107c1847f23d7e79249c4e855dfed009afea71", "files": ["tt_llk_wormhole_b0/llk_lib/llk_math_eltwise_binary.h"], "class": "tt-arch-divergence", "component": "llk/math-eltwise-binary", "summary": "The WH eltwise MUL bcast-cols path lacked the dest-reuse guard, so ZEROACC ran and corrupted the Dest output."}
{"id": "91fa6c26a54f", "repo": "tenstorrent/tt-llk", "fix_commit": "91fa6c26a54f40dce21214eb04d66dae8c12c6e6", "files": ["tt_llk_blackhole/common/inc/sfpu/ckernel_sfpu_activations.h", "tt_llk_wormhole_b0/common/inc/sfpu/ckernel_sfpu_activations.h"], "class": "precision", "component": "llk/sfpu", "summary": "hardsigmoid lost precision for values near zero."}
{"id": "4c4f810cfea9", "repo": "tenstorrent/tt-llk", "fix_commit": "4c4f810cfea98cfe738e2c73e44f384af7cab3f4", "files": ["tt_llk_blackhole/common/inc/cpack_common.h", "tt_llk_blackhole/llk_lib/llk_pack.h"], "class": "tt-reconfig-drain", "component": "llk/pack", "summary": "BH packer reconfig did not re-apply num_faces/partial_face, so the artificial values set at hw_configure persisted."}
{"id": "4c153cd47727", "repo": "tenstorrent/tt-llk", "fix_commit": "4c153cd477274ed144a0c65e231fcac8f6c3418b", "files": ["tt_llk_blackhole/llk_lib/llk_pack_untilize.h"], "class": "contract-mismatch", "component": "llk/pack-untilize", "summary": "Callers set narrow_row for rows <32 while pack_untilize asserts <16; static assert removed as workaround, underlying caller contract bug left."}
{"id": "1eacf4c2a759", "repo": "tenstorrent/tt-llk", "fix_commit": "1eacf4c2a7593d9196bc3ebc9a85bb8af6534d24", "files": ["tt_llk_blackhole/llk_lib/llk_unpack_A.h", "tt_llk_wormhole_b0/llk_lib/llk_unpack_A.h"], "class": "stale-state", "component": "llk/unpack-A", "summary": "unpack_A init did not set the transpose register, so an earlier op's transpose setting leaked in."}
{"id": "fd8bafcfea4c", "repo": "tenstorrent/tt-llk", "fix_commit": "fd8bafcfea4c7865574727968252ace0a993c7b6", "files": ["tt_llk_blackhole/llk_lib/llk_math_eltwise_unary_datacopy.h", "tt_llk_blackhole/llk_lib/llk_unpack_A.h", "tt_llk_wormhole_b0/llk_lib/llk_unpack_A.h"], "class": "tt-cb-balance", "component": "llk/unpack-math-bcast", "summary": "Unpack and math disagreed on how many SrcA dvalids unary_bcast produces and consumes, so the handshake broke."}
{"id": "f9293efa7546", "repo": "tenstorrent/tt-llk", "fix_commit": "f9293efa754686e7581b4711168ea5abb05d3594", "files": ["tt_llk_blackhole/hw_specific/inc/tensix.h", "tt_llk_wormhole_b0/hw_specific/inc/tensix.h"], "class": "units", "component": "hw/registers", "summary": "RISCV_SOFT_RESET_0_BRISC constant had a wrong (shifted) bit value; correct is 0x800."}

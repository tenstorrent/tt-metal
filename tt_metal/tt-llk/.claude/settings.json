{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(//**/.git/**)",
            "Read(//localdev/jmacanovic/tt-metal/.git/**)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git-guard.sh\"",
                        "timeout": 10,
                        "statusMessage": "git-guard"
                    }
                ]
            }
        ]
    }
}

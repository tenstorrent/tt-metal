{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(//**/.git/**)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"${CLAUDE_PROJECT_DIR:-.}/../.claude/hooks/git-guard.sh\"",
                        "timeout": 10,
                        "statusMessage": "git-guard"
                    }
                ]
            }
        ]
    }
}

#
# Profile hal-test-gen: run-8 conditions with the HAL of njokovic/HAL-move-tests at 8da291f3f7c (2026-11-24),
# the base of branch sbratic/HAL-test-gen. Frozen test set (test_eltwise_binary -k add = 1660 passed on the
# original LLKs) and prompt of run 8, this HAL, and the HAL docs of run 8 (d8c6fa7), which may not match
# this HAL. Not run yet with this HAL.
PROFILE_DESCRIPTION="run-8 conditions with the HAL of njokovic/HAL-move-tests at 8da291f3f7c (base of sbratic/HAL-test-gen); docs of run 8"
REFERENCE_SERIES=8

BASE_COMMIT=c0e38f1ff70b7ee70c526fb44cbbf16736a341ed   # tests + original LLKs (frozen test set)
HAL_COMMIT=8da291f3f7c1b5540187fbd219ed6f3bb7d9ad4e    # HAL: njokovic/HAL-move-tests on 2026-11-24
DOCS_COMMIT=d8c6fa7c22fb89e109178778a537e5860fae0ac6   # tt_metal/tt-llk/docs/hal/ given to the agent
DOCS_INVALID="address_counters_hal_interface.html replay_hal_interface.html gpr_ops_hal_interface.html atomic_hal_interface.html"
# Branches that hold the three commits (tests: hal-llk-generation-results, HAL: HAL-test-gen, docs: hal-docs-pr59009);
# fetched from FETCH_REMOTE only if a commit is missing in REPO
FETCH_REFS="ctr-sbratic/hal-llk-generation-results ctr-sbratic/hal-docs-pr59009 sbratic/HAL-test-gen"

PROMPT=run8.md
PROMPT_MD5=3dbea124246f22cae0a3ce1d444d19b7
TESTS="test_eltwise_binary:add"
EXPECT_PASSED="test_eltwise_binary:add=1660"
PERF_TEST=perf_eltwise_binary
PERF_K=Elwadd

MODEL=claude-opus-5-5
CLAUDE_VERSION=2.1.287   # Claude Code version of the runs (a different version is a warning, STRICT_VERSIONS=1 stops)
TIMEOUT=4h
MAX_TURNS=500
MAX_BUDGET=60

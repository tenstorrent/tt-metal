#
# Profile run7: the configuration of runs 7a-7e.
# Frozen test set (test_eltwise_binary -k add = 1660 passed on the original LLKs), HAL with the
# Dst->SrcA move, HAL docs of the same state, prompt without the section on instruction cost of per-tile code.
PROFILE_DESCRIPTION="configuration of runs 7a-7e (frozen tests, HAL b9e522d, prompt without the per-tile cost section)"
REFERENCE_SERIES=7

BASE_COMMIT=c0e38f1ff70b7ee70c526fb44cbbf16736a341ed   # tests + original LLKs (frozen test set)
HAL_COMMIT=b9e522d39ae534f0281499dae11b425574d89d0d    # HAL implementation (BASE_COMMIT's HAL + Dst->SrcA move)
DOCS_COMMIT=d8c6fa7c22fb89e109178778a537e5860fae0ac6   # tt_metal/tt-llk/docs/hal/ given to the agent
DOCS_INVALID="address_counters_hal_interface.html replay_hal_interface.html gpr_ops_hal_interface.html atomic_hal_interface.html"
# Branches that hold the three commits (tests and HAL: hal-llk-generation-results, docs: hal-docs-pr59009);
# fetched from FETCH_REMOTE only if a commit is missing in REPO
FETCH_REFS="ctr-sbratic/hal-llk-generation-results ctr-sbratic/hal-docs-pr59009"

PROMPT=run7.md
PROMPT_MD5=411819d28e8e8e5766d81caad6b95b15
TESTS="test_eltwise_binary:add"
EXPECT_PASSED="test_eltwise_binary:add=1660"
PERF_TEST=perf_eltwise_binary
PERF_K=Elwadd

MODEL=claude-opus-5-5
CLAUDE_VERSION=2.1.287   # Claude Code version of the runs (a different version is a warning, STRICT_VERSIONS=1 stops)
TIMEOUT=4h
MAX_TURNS=500
MAX_BUDGET=60

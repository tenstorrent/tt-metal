#
# Optional machine settings for hal-llk-gen. The tool runs without local.env (defaults below); copy this file
# to local.env (not tracked by git) only to change a default. Experiment settings (commits, prompt, limits)
# belong in a profile, not here.

# Output root: harness runs, run folders, logs, summaries (default /proj_sw/user_dev/$USER/hal-llk-gen-work,
# or $HOME/hal-llk-gen-work). Must not be inside the tt-metal checkout.
#WORK=/proj_sw/user_dev/$USER/hal-llk-gen-work

# Python venv with pytest (+ pandas for the perf stage, tt-exalens for the dyn stage); tt-smi must be in PATH.
# Default: the active venv, else $WORK/venv, made by the first check or run from tt_metal/tt-llk/tests/requirements.txt
#VENV=/path/to/venv

# Folder with the claude binary to use (the runs used Claude Code 2.1.287); put first in PATH
# Default: claude from PATH or ~/.local/bin
#CLAUDE_DIR=/path/to/claude-2.1.287

# elfray binary for the TTI / TT counts (optional; without it only code size is counted)
# Default: elfray from PATH, if there is one
#ELFRAY=/path/to/elfray

# More absolute paths the agent must not read (space separated), e.g. other experiment outputs
#EXTRA_DENY="/path/one /path/two"

# Folders whose other subfolders are denied to the agent (default: /proj_sw/user_dev/$USER /localdev/$USER)
#SIBLING_ROOTS="/proj_sw/user_dev/$USER /localdev/$USER"

# Dynamic stage: reference stepping of the original kernel (files full_<core>.jsonl), optional
#DYN_REFERENCE=/path/to/reference

---
# Check-option tuning for kernel (device) code analyzed post-hoc from real
# runtime JIT compiles. See tech_reports/code-indexing/kernel-clang-tidy.md and
# scripts/build_kernel_clang_tidy_commands.py.
#
# This file serves the local dev path only:
#   build_kernel_clang_tidy_commands.py --run --config-file <this file>
# CI does not read it. There, checker selection, check options and scoping all
# come from codechecker.json + skiplist, because passing a --config-file
# alongside the -config that CodeChecker builds makes clang-tidy fail with
# "--config-file and --config are mutually exclusive". The CheckOptions below
# are mirrored as --checker-config entries in codechecker.json; keep the two in
# sync.
#
# Deliberately contains NO 'Checks:' key: clang-tidy's command-line -checks
# takes precedence over a config-file 'Checks:' anyway, so one here would be
# dead weight at best and misleading at worst.
#
# This replaced an inherited 189-entry opt-out list carried over from the
# kernel_clang_tidy CMake target in PR #37252. That list was assembled by
# muting whatever fired under a different (static) flow and had never been
# re-triaged, so it silently suppressed most of the checks worth running here.

CheckOptions:
  # Both values are clang-tidy's defaults, stated explicitly because the host
  # .clang-tidy at the repo root sets Threshold=312 with IgnoreMacros=true and
  # this file otherwise mirrors it. That pairing suits a blocking host gate but
  # defeats the check here: at 312 it produced 5 findings out of 62,710, and
  # IgnoreMacros hides exactly the macro-driven complexity that dominates LLK
  # and the SFPU headers. This report is non-blocking and exists to enumerate
  # problems, so do not "re-sync" these two from the host config.
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: false
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  # Fires when the base type name is at least this long, measured ignoring
  # const/volatile/*. At the default of 5 this reports 2,137 times, 89% of them
  # on `uint32_t x = get_arg_val<uint32_t>()` in the kernel runtime-arg preamble,
  # where the duplication it objects to is eight characters on the same line. 9
  # excludes uint32_t and keeps the ~131 sites with a genuinely long name to
  # duplicate: sfpi::vFloat, RealtimeProfilerState, DataFormat.
  - key: modernize-use-auto.MinTypeNameLength
    value: 9
  # Exemptions for names that are this domain's vocabulary rather than laziness:
  # NCDHW layout letters, tile-count dimensions (Wt/Ht/...), NOC coordinates,
  # circular buffers, virtual channels. The loop-counter list is the widest
  # because a counter's meaning comes from its bound three lines away, whereas a
  # variable lives for a whole function; hence 'h' passes as a counter but not
  # as a variable, and 'a'/'b' pass as math-helper operands but not as locals.
  - key: readability-identifier-length.IgnoredLoopCounterNames
    value: "^[ijk_nchwdbtr]$"
  - key: readability-identifier-length.IgnoredVariableNames
    value: "^([NCHWD]|[xyz]|[ijk]|[WHCND]t|cb|id)$"
  - key: readability-identifier-length.IgnoredParameterNames
    value: "^(n|[xyzab]|[ijk]|id|cb|vc|[WHCND]t)$"
  - key: readability-simplify-boolean-expr.SimplifyDeMorgan
    value: false
  - key: readability-else-after-return.WarnOnUnfixable
    value: false
  - key: readability-else-after-return.WarnOnConditionVariables
    value: false

FormatStyle: 'file'

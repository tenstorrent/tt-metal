{
    "analyze": [
        "--analyzers",
        "clang-tidy",
        "--enable-all",
        "--skip",
        "tt_metal/jit_build/kernel_clang_tidy/skiplist",
        "--drop-reports-from-skipped-files",
        "--disable",
        "prefix:abseil",
        "--disable",
        "prefix:altera",
        "--disable",
        "prefix:android",
        "--disable",
        "prefix:boost",
        "--disable",
        "prefix:darwin",
        "--disable",
        "prefix:fuchsia",
        "--disable",
        "prefix:linuxkernel",
        "--disable",
        "prefix:llvmlibc",
        "--disable",
        "prefix:mpi",
        "--disable",
        "prefix:objc",
        "--disable",
        "prefix:openmp",
        "--disable",
        "prefix:zircon",
        "--disable",
        "checker:hicpp-no-assembler",
        "--disable",
        "checker:portability-simd-intrinsics",
        "--disable",
        "prefix:clang-diagnostic-c++98-compat",
        "--disable",
        "checker:modernize-macro-to-enum",
        "--disable",
        "checker:readability-magic-numbers",
        "--disable",
        "checker:misc-const-correctness",
        "--disable",
        "checker:modernize-use-trailing-return-type",
        "--disable",
        "checker:readability-identifier-length",
        "--disable",
        "checker:bugprone-easily-swappable-parameters",
        "--disable",
        "checker:readability-uppercase-literal-suffix",
        "--disable",
        "checker:clang-diagnostic-sign-conversion",
        "--disable",
        "checker:clang-diagnostic-old-style-cast",
        "--disable",
        "checker:clang-diagnostic-unsafe-buffer-usage",
        "--disable",
        "checker:clang-diagnostic-documentation",
        "--disable",
        "checker:clang-diagnostic-unused-parameter",
        "--disable",
        "checker:misc-unused-parameters",
        "--checker-config",
        "clang-tidy:readability-function-cognitive-complexity:IgnoreMacros=true",
        "--checker-config",
        "clang-tidy:readability-function-cognitive-complexity:Threshold=312",
        "--checker-config",
        "clang-tidy:readability-simplify-boolean-expr:SimplifyDeMorgan=false",
        "--checker-config",
        "clang-tidy:readability-else-after-return:WarnOnUnfixable=false",
        "--checker-config",
        "clang-tidy:readability-else-after-return:WarnOnConditionVariables=false"
    ]
}

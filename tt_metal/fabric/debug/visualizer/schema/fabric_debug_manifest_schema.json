{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tenstorrent/tt-metal/tt_metal/fabric/debug/visualizer/schema/fabric_debug_manifest_schema.json",
  "title": "Fabric debug manifest",
  "description": "Frozen description of one fabric instance, written after fabric routers reach READY_FOR_TRAFFIC. Consumed by the fabric debug capture layer (ttexalens) and the visualizer. This schema is the stability boundary between the tt-metal fabric internals and the debug tooling. Consumers depend on manifest_version and the shapes below, never on ControlPlane signatures.",
  "type": "object",
  "required": [
    "manifest_version",
    "kind",
    "run",
    "hal",
    "heartbeat",
    "fabric_context",
    "router_template",
    "stream_assignment",
    "enums",
    "layouts",
    "meshes",
    "links"
  ],
  "properties": {
    "manifest_version": {
      "description": "Incremented on breaking changes.",
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "fabric_debug_manifest"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "hal": {
      "$ref": "#/$defs/hal"
    },
    "heartbeat": {
      "$ref": "#/$defs/heartbeat"
    },
    "fabric_context": {
      "$ref": "#/$defs/fabric_context"
    },
    "router_template": {
      "$ref": "#/$defs/router_template"
    },
    "stream_assignment": {
      "$ref": "#/$defs/stream_assignment"
    },
    "enums": {
      "$ref": "#/$defs/enums"
    },
    "layouts": {
      "description": "Interned per-router region trees, keyed by deterministic layout id.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/layout" }
    },
    "meshes": {
      "description": "Sorted by mesh_id. Output is deterministic so the artifact can serve as a test golden.",
      "type": "array",
      "items": { "$ref": "#/$defs/mesh" }
    },
    "links": {
      "description": "Flat edge list, what the viewer draws. Emitted once per directed source channel, so a physical cable appears twice (once from each end); each direction carries its own credit state and is coloured independently. Sorted by src.",
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "description": "Identity of the run, used to match a snapshot to this manifest.",
      "required": ["arch", "fabric_config", "fabric_type", "host_rank", "mpi_rank", "world_size", "written_at"],
      "properties": {
        "arch": {
          "description": "tt::ARCH as string, e.g. WORMHOLE_B0 / BLACKHOLE. Selects architecture-specific overlay register indices on the capture side.",
          "type": "string"
        },
        "fabric_config": {
          "description": "tt_fabric::FabricConfig as string, e.g. FABRIC_1D, FABRIC_1D_RING, FABRIC_2D, FABRIC_2D_TORUS_XY. Selects the viewer layout engine.",
          "type": "string"
        },
        "fabric_type": {
          "description": "tt_fabric::FabricType as string (MESH / TORUS_X / TORUS_Y / TORUS_XY), as resolved by get_fabric_type() including galaxy adjustment.",
          "type": "string"
        },
        "reliability_mode": { "type": "string" },
        "tensix_config": {
          "description": "FabricTensixConfig as string (DISABLED / MUX / UDM). Tensix extension cores are not fabric routers and are not listed in this manifest.",
          "type": "string"
        },
        "udm_mode": { "type": "string" },
        "host_rank": {
          "description": "This rank's MeshHostRankId. This is not necessarily the MPI process rank.",
          "type": "integer"
        },
        "mpi_rank": {
          "description": "MPI process rank from DistributedContext. Used to identify this host's files after they are copied and renamed.",
          "type": "integer"
        },
        "world_size": { "type": "integer" },
        "local_mesh_ids": {
          "description": "Meshes bound to this host. Chips outside these meshes appear with is_local false and cannot be peeked by this rank.",
          "type": "array",
          "items": { "type": "integer" }
        },
        "written_at": {
          "description": "UTC timestamp when this rank wrote the manifest after router sync.",
          "type": "string"
        }
      }
    },
    "mesh": {
      "type": "object",
      "required": ["mesh_id", "shape", "chips"],
      "properties": {
        "mesh_id": { "type": "integer" },
        "shape": {
          "description": "MeshShape dims, row-major. Axis 0 is north/south, axis 1 is east/west.",
          "type": "array",
          "items": { "type": "integer" }
        },
        "torus": {
          "description": "Per-axis realized wrap, from has_genuine_torus_axis(): declared torus flag AND a dimension large enough to form a distinct wrap edge. Absent for non-2D meshes, where the query is undefined. Note a declared torus axis of extent <= 2 reports false here.",
          "type": "object",
          "properties": {
            "y": { "description": "Axis 0 (north/south) wrap.", "type": "boolean" },
            "x": { "description": "Axis 1 (east/west) wrap.", "type": "boolean" }
          }
        },
        "chips": {
          "description": "Sorted by fabric_chip_id.",
          "type": "array",
          "items": { "$ref": "#/$defs/chip" }
        }
      }
    },
    "chip": {
      "type": "object",
      "required": ["fabric_chip_id", "mesh_coord", "is_local", "routers", "master_router_chan"],
      "properties": {
        "fabric_chip_id": {
          "description": "Chip id within the mesh (FabricNodeId.chip_id).",
          "type": "integer"
        },
        "mesh_coord": {
          "description": "Position in the mesh, matching the order of mesh.shape.",
          "type": "array",
          "items": { "type": "integer" }
        },
        "physical_chip_id": {
          "description": "UMD chip id, which equals ttexalens device.id. Null for chips owned by another host, which this rank cannot map or peek.",
          "type": ["integer", "null"]
        },
        "asic_id": {
          "description": "ASIC unique id as a hex string. String rather than number because the value exceeds the range JSON numbers represent exactly.",
          "type": ["string", "null"]
        },
        "is_local": {
          "description": "Whether this chip is owned by this host rank. Capture must skip non-local chips.",
          "type": "boolean"
        },
        "master_router_chan": {
          "description": "Ethernet channel of the master fabric router on this chip. Null for chips this rank does not own.",
          "type": ["integer", "null"]
        },
        "routers": {
          "description": "Ethernet cores running a fabric router on this chip, sorted by eth_chan. This is the capture layer's peek target list. It is deliberately narrower than every ethernet tile: it contains only channels that are link-up AND assigned EthRouterMode::FABRIC_ROUTER AND survived routing-plane trimming. Do not substitute ttexalens active/idle classification, which misses cross-host links. Empty for non-local chips.",
          "type": "array",
          "items": { "$ref": "#/$defs/router" }
        }
      }
    },
    "router": {
      "type": "object",
      "description": "One fabric router (one ERISC ethernet core), bound to an interned builder-produced layout.",
      "required": ["eth_chan", "direction", "layout_id", "instance"],
      "properties": {
        "eth_chan": {
          "description": "Ethernet channel id. Primary key for a router within a chip, and the index ttexalens uses into its eth block locations.",
          "type": "integer"
        },
        "direction": {
          "description": "Routing direction this port faces.",
          "type": "string",
          "enum": ["E", "W", "N", "S", "Z", "C", "NONE"]
        },
        "routing_plane": { "type": ["integer", "null"] },
        "link_class": {
          "description": "Whether this port faces another mesh (intermesh, the Z / exit-node case) or a chip within this mesh.",
          "type": "string",
          "enum": ["intramesh", "intermesh", "unknown"]
        },
        "logical_core": {
          "description": "Logical eth core coordinate [x, y], equal to ttexalens loc.to('logical').",
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        "virtual_core": {
          "description": "Virtual (NOC-addressable) eth core coordinate [x, y], for peeking. This is tt-metal's 'virtual' coordinate space, which is the coordinate system ttexalens calls 'translated'. It equals loc.to('translated'), not loc.to('noc0').",
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        "layout_id": {
          "description": "Key into top-level layouts.",
          "type": "string",
          "pattern": "^L[0-9a-f]{16}$"
        },
        "instance": { "$ref": "#/$defs/router_instance" }
      }
    },
    "router_instance": {
      "type": "object",
      "required": [
        "peer",
        "is_inter_mesh",
        "is_dispatch_link",
        "num_active_eriscs",
        "sender_channels_per_vc",
        "receiver_channels_per_vc",
        "worker_sender_channel",
        "credit_plan",
        "first_level_ack_vc0",
        "downstream_edm_mask_vc0",
        "downstream_edm_mask_vc1",
        "has_tensix_extension",
        "udm_mode"
      ],
      "properties": {
        "peer": {
          "oneOf": [{ "$ref": "#/$defs/endpoint" }, { "type": "null" }]
        },
        "is_inter_mesh": { "type": "boolean" },
        "is_dispatch_link": { "type": "boolean" },
        "num_active_eriscs": { "type": "integer", "minimum": 1 },
        "sender_channels_per_vc": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "receiver_channels_per_vc": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "worker_sender_channel": { "type": "integer", "minimum": 0 },
        "credit_plan": {
          "type": "object",
          "required": ["vc0_uses_counters", "vc1_uses_counters", "vc2_uses_counters"],
          "properties": {
            "vc0_uses_counters": { "type": "boolean" },
            "vc1_uses_counters": { "type": "boolean" },
            "vc2_uses_counters": { "type": "boolean" }
          }
        },
        "first_level_ack_vc0": { "type": "boolean" },
        "downstream_edm_mask_vc0": { "type": "integer", "minimum": 0 },
        "downstream_edm_mask_vc1": { "type": "integer", "minimum": 0 },
        "has_tensix_extension": { "type": "boolean" },
        "udm_mode": { "type": "boolean" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["regions", "router_count"],
      "properties": {
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/debug_region" }
        },
        "router_count": { "type": "integer", "minimum": 1 }
      }
    },
    "debug_region": {
      "type": "object",
      "required": ["id", "parent", "backing", "allocated", "enabled", "writer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parent": { "type": "string" },
        "backing": {
          "type": "string",
          "enum": ["group", "unreserved_l1", "fixed_l1", "stream_reg"]
        },
        "address": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 },
        "stride": { "type": "integer", "minimum": 0 },
        "stream_id": { "type": "integer", "minimum": 0, "maximum": 31 },
        "allocated": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "writer": {
          "type": "string",
          "enum": ["none", "erisc0", "erisc1", "any_erisc", "host", "peer", "worker"]
        },
        "schema": { "type": "string" },
        "overlaps": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backing": { "enum": ["unreserved_l1", "fixed_l1"] }
            }
          },
          "then": { "required": ["address", "size"] }
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "description": "Stable node/edge identity, also used as the key space for snapshot values.",
      "required": ["mesh_id", "chip_id", "eth_chan"],
      "properties": {
        "mesh_id": { "type": "integer" },
        "chip_id": { "type": "integer" },
        "eth_chan": { "type": "integer" }
      }
    },
    "link": {
      "type": "object",
      "required": ["src", "direction"],
      "properties": {
        "src": { "$ref": "#/$defs/endpoint" },
        "dst": {
          "description": "Peer endpoint of this physical hop. Null when the peer is not resolvable from this rank.",
          "oneOf": [{ "$ref": "#/$defs/endpoint" }, { "type": "null" }]
        },
        "direction": {
          "type": "string",
          "enum": ["E", "W", "N", "S", "Z", "C", "NONE"]
        },
        "routing_plane": { "type": ["integer", "null"] },
        "link_class": {
          "type": "string",
          "enum": ["intramesh", "intermesh", "unknown"]
        },
        "wrap": {
          "description": "Torus wrap edge, computed by the emitter rather than inferred by the viewer: an intra-mesh link on a genuine torus axis whose coordinate delta along that axis spans the mesh. The viewer draws these as arcs and must not re-derive topology itself.",
          "type": "boolean"
        },
        "cross_host": {
          "description": "Link crosses a host boundary. These are live fabric hops that ttexalens classifies as idle, which is why the manifest rather than ttexalens defines the router set.",
          "type": "boolean"
        }
      }
    },
    "l1_region": {
      "type": "object",
      "required": ["base", "size"],
      "properties": {
        "base": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "hal": {
      "description": "ACTIVE_ETH HAL-fixed L1 regions for this architecture.",
      "type": "object",
      "required": [
        "unreserved",
        "go_msg",
        "launch",
        "fabric_telemetry",
        "routing_table",
        "router_state",
        "router_command",
        "eth_fw_mailbox"
      ],
      "properties": {
        "unreserved": { "$ref": "#/$defs/l1_region" },
        "go_msg": { "$ref": "#/$defs/l1_region" },
        "launch": { "$ref": "#/$defs/l1_region" },
        "fabric_telemetry": { "$ref": "#/$defs/l1_region" },
        "routing_table": { "$ref": "#/$defs/l1_region" },
        "router_state": { "$ref": "#/$defs/l1_region" },
        "router_command": { "$ref": "#/$defs/l1_region" },
        "eth_fw_mailbox": { "$ref": "#/$defs/l1_region" }
      }
    },
    "heartbeat": {
      "description": "Shared fabric-loop liveness word. One location per ethernet core; both Blackhole fabric ERISCs write it.",
      "type": "object",
      "required": ["address", "magic", "magic_mask", "period_iters"],
      "properties": {
        "address": { "type": "integer" },
        "magic": { "type": "integer" },
        "magic_mask": { "type": "integer" },
        "period_iters": { "type": "integer" }
      }
    },
    "fabric_context": {
      "description": "Fabric-wide packet and routing constants from FabricContext.",
      "type": "object",
      "required": [
        "topology",
        "is_2d_routing",
        "packet_header_size_bytes",
        "max_payload_size_bytes",
        "channel_buffer_size_bytes",
        "tensix_enabled",
        "bubble_flow_control"
      ],
      "properties": {
        "topology": { "type": "string" },
        "is_2d_routing": { "type": "boolean" },
        "packet_header_size_bytes": { "type": "integer" },
        "max_payload_size_bytes": { "type": "integer" },
        "channel_buffer_size_bytes": { "type": "integer" },
        "routing_2d_route_buffer_size": { "type": "integer" },
        "routing_1d_extension_words": { "type": "integer" },
        "tensix_enabled": { "type": "boolean" },
        "bubble_flow_control": { "type": "boolean" }
      }
    },
    "router_template": {
      "description": "Builder-derived L1 addresses identical across fabric routers on this rank.",
      "type": "object",
      "required": [
        "edm_status_address",
        "termination_signal_address",
        "edm_local_sync_address",
        "handshake_address",
        "edm_channel_ack_addr",
        "unused_config_handshake_address",
        "diagnostics",
        "addresses_to_clear",
        "router_buffer_clear_size_words"
      ],
      "properties": {
        "edm_status_address": { "type": "integer" },
        "termination_signal_address": { "type": "integer" },
        "edm_local_sync_address": { "type": "integer" },
        "handshake_address": { "type": "integer" },
        "unused_config_handshake_address": { "type": "integer" },
        "edm_channel_ack_addr": { "type": "integer" },
        "diagnostics": {
          "type": "object",
          "required": ["perf_telemetry", "code_profiling", "trimming"],
          "properties": {
            "perf_telemetry": { "$ref": "#/$defs/l1_region" },
            "code_profiling": { "$ref": "#/$defs/l1_region" },
            "trimming": { "$ref": "#/$defs/l1_region" }
          }
        },
        "addresses_to_clear": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "router_buffer_clear_size_words": { "type": "integer" }
      }
    },
    "stream_assignment": {
      "description": "Per-mesh named stream-register ids from StreamAssignment::named_args(). Object keys are mesh ids.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "integer" }
      }
    },
    "enums": {
      "description": "Name-to-value tables exported from host/device headers so the viewer never guesses nearby names.",
      "type": "object",
      "required": ["EDMStatus", "TerminationSignal", "RouterCommand", "RunMsg"],
      "properties": {
        "EDMStatus": { "type": "object", "additionalProperties": { "type": "integer" } },
        "TerminationSignal": { "type": "object", "additionalProperties": { "type": "integer" } },
        "RouterCommand": { "type": "object", "additionalProperties": { "type": "integer" } },
        "RunMsg": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    }
  }
}

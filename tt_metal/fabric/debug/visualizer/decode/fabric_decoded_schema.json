{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fabric decoded snapshot",
  "description": "The shape of a decoded file (README.md in this directory). A value decoded from L1 takes the shape of its manifest type, so values are any JSON here.",
  "type": "object",
  "properties": {
    "kind": { "const": "fabric_decoded" },
    "decoded_version": { "const": 1 },
    "decoded_at": { "$ref": "#/$defs/utc" },
    "decoder": { "oneOf": [{ "$ref": "#/$defs/checkout" }, { "type": "null" }] },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "routers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/router_path" },
      "additionalProperties": { "$ref": "#/$defs/router" }
    }
  },
  "required": ["kind", "decoded_version", "decoded_at", "decoder", "sources", "routers"],
  "additionalProperties": false,

  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "word": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "router_path": { "type": "string", "pattern": "^M[0-9]+/C[0-9]+/[EWNSZ][0-9]+$" },
    "path": { "type": "string", "pattern": "^[^/]+(/[^/]+)*$" },
    "value": {},
    "checkout": {
      "type": "object",
      "properties": {
        "git_sha": { "type": "string" },
        "git_dirty": { "type": "boolean" }
      },
      "required": ["git_sha", "git_dirty"],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["file", "sha256"],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "snapshot": { "$ref": "#/$defs/file" },
        "manifest": {
          "type": "object",
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "run": { "type": "object" }
          },
          "required": ["file", "sha256", "run"],
          "additionalProperties": false
        },
        "capture": { "type": "object" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["snapshot", "manifest", "capture", "warnings"],
      "additionalProperties": false
    },
    "stream": {
      "type": "object",
      "properties": {
        "stream_id": { "$ref": "#/$defs/count" },
        "register": { "$ref": "#/$defs/name" },
        "before": { "$ref": "#/$defs/value" },
        "after": { "$ref": "#/$defs/value" }
      },
      "required": ["stream_id", "register", "before", "after"],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "array": { "$ref": "#/$defs/path" },
        "index": { "$ref": "#/$defs/count" },
        "value": { "$ref": "#/$defs/value" }
      },
      "required": ["array", "index", "value"],
      "additionalProperties": false
    },
    "optional_boolean": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
    "health": {
      "type": "object",
      "properties": {
        "t_ns": { "type": "array", "items": { "type": "integer" } },
        "eriscs": {
          "type": "object",
          "propertyNames": { "pattern": "^erisc[0-9]+$" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "physical_erisc": { "$ref": "#/$defs/count" },
              "mask": { "$ref": "#/$defs/word" },
              "in_reset": { "type": "array", "items": { "$ref": "#/$defs/optional_boolean" } }
            },
            "required": ["physical_erisc", "mask", "in_reset"],
            "additionalProperties": false
          }
        },
        "wall_clock": {
          "type": "object",
          "properties": {
            "cycles": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] } },
            "rises": { "$ref": "#/$defs/optional_boolean" },
            "mhz": { "oneOf": [{ "type": "number" }, { "type": "null" }] }
          },
          "required": ["cycles", "rises", "mhz"],
          "additionalProperties": false
        },
        "heartbeat": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "words": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/word" }, { "type": "null" }] } },
                "router_magic": { "type": "array", "items": { "$ref": "#/$defs/optional_boolean" } },
                "changed": { "$ref": "#/$defs/optional_boolean" }
              },
              "required": ["words", "router_magic", "changed"],
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["t_ns", "eriscs", "wall_clock", "heartbeat"],
      "additionalProperties": false
    },
    "router": {
      "type": "object",
      "properties": {
        "source": { "$ref": "#/$defs/count" },
        "error": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
        "areas": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "$ref": "#/$defs/value" }
        },
        "regions": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/path" },
          "additionalProperties": { "$ref": "#/$defs/value" }
        },
        "streams": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/path" },
          "additionalProperties": { "$ref": "#/$defs/stream" }
        },
        "elements": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/path" },
          "additionalProperties": { "$ref": "#/$defs/element" }
        },
        "health": { "$ref": "#/$defs/health" }
      },
      "required": ["source", "error", "areas", "regions", "streams", "elements", "health"],
      "additionalProperties": false
    }
  }
}

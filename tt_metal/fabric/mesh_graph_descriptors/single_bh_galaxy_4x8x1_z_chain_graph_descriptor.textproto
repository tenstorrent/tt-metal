# Single BH galaxy carved into 4 Z-connected [8,1] meshes, wired as a Z-chain 0->1->2->3.
#
# Each mesh is one column of the logical 8x4 galaxy (SP=8 x TP=1), the stage shape the
# single-process Mistral Small 4 pipeline measurements use, so numbers are comparable to those.
# A column spans two trays, so its device set cannot be read off tray discovery; the per-rank
# TT_VISIBLE_DEVICES in pipeline_prefill_request_intragalaxy_4rank_8x1.yaml come from
# create_submeshes(MeshShape(8,1)) on a live mesh.
#
# Line, not ring, on the SP axis: the D2D MeshSocket needs FABRIC_2D, and a torus mode would have to
# be matched by dim_types here.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 8, 1 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 3 } }

  # Adjacent columns of the galaxy are joined by one X-link per row (8 per boundary); 4 RELAXED
  # mirrors the proven [2,4] z-chain rather than demanding every link.
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    channels { count: 4 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    channels { count: 4 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
    channels { count: 4 policy: RELAXED }
    assign_z_direction: true
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

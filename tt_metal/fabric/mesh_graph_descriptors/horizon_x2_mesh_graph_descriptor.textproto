# Horizon x2: two virtual 1x3 UMD devices on one physical card, connected via AXI crossbar.
# No pinnings block -- chip assignment is provided programmatically via cluster.user_exposed_chip_ids().

# --- Meshes ---------------------------------------------------------------

mesh_descriptors {
  name: "M0"
  arch: QUASAR
  device_topology { dims: [ 1, 2 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 1 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

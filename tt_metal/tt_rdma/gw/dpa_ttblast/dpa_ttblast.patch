+ * so the SQ (128 WQEBBs / 4 = 32 sends) never overruns. The same read-only frame buffer is reused for every
+ * send (constant content), so there is no per-frame memcpy on the DPA. */
+static void tt_blast(struct host2dev_packet_processor_data *d)

+/* ---- TT-RDMA A1: DPA-originated TT-RDMA WRITE blast (the doca_ttblast-on-DPA equivalent) ---- */
+
+/* CRC-32 (reflected 0xEDB88320) via a 256-entry table built once (A4: ~5x fewer ops than the bit loop, which
+ * cost ~1.4us/frame on the DPA). */
+static uint32_t g_crc_tab[256];
+static int g_crc_tab_ready = 0;
+static void tt_crc_init(void)
+{
+	if (g_crc_tab_ready)
+		return;
+	for (uint32_t i = 0; i < 256; i++) {
+		uint32_t c = i;
+		for (int k = 0; k < 8; k++)
+			c = (c & 1u) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+		g_crc_tab[i] = c;
+	}
+	g_crc_tab_ready = 1;
+}
+static uint32_t tt_crc32(const uint8_t *p, uint32_t n)
+{
+	uint32_t crc = 0xFFFFFFFFu;
+	for (uint32_t i = 0; i < n; i++)
+		crc = g_crc_tab[(crc ^ p[i]) & 0xffu] ^ (crc >> 8);
+	return crc ^ 0xFFFFFFFFu;
+}
+static void tt_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = v & 0xff;
+	p[1] = (v >> 8) & 0xff;
+	p[2] = (v >> 16) & 0xff;
+	p[3] = (v >> 24) & 0xff;
+}
+
+/* Build one TT-RDMA WRITE frame into a data buffer, then post `tt_count` sends on the SQ. Paced by the SQ CQ:
+ * the last send of each batch is signaled (CQE_ALWAYS) and we wait for that CQE before posting the next batch,
+ * so the SQ (128 WQEBBs / 4 = 32 sends) never overruns. The same read-only frame buffer is reused for every
+ * send (constant content), so there is no per-frame memcpy on the DPA. */
+/* Build one TT-RDMA WRITE frame into data buffer `f`: L2 + 32B hdr (seq/rkey/CRC) + payload. If `src` != 0
+ * the payload is READ per-frame from that DPA-heap source (A2: the re-head read+build); else a fixed pattern. */
+static void tt_build_frame(uint8_t *f, const struct host2dev_packet_processor_data *d, uint32_t plen, uint32_t seq,
+			   const uint8_t *src, int hdr_only)
+{
+	for (int i = 0; i < 6; i++)
+		f[i] = d->tt_dmac[i];
+	for (int i = 0; i < 6; i++)
+		f[6 + i] = d->tt_smac[i];
+	f[12] = 0x1a;
+	f[13] = 0xf6;
+	uint8_t *h = f + 14;
+	h[0] = 0x10; /* WRITE opcode */
+	h[1] = 0x01; /* ver=1 */
+	h[2] = 0;
+	h[3] = 0;
+	tt_put32(h + 4, plen);        /* length */
+	tt_put32(h + 8, seq);         /* seq */
+	tt_put32(h + 12, d->tt_rkey); /* rkey -> MR slot */
+	tt_put32(h + 16, 0);          /* remote_offset lo */
+	tt_put32(h + 20, 0);          /* remote_offset hi */
+	tt_put32(h + 24, 0);          /* imm */
+	/* CRC over the 28B header. Skippable (write 0): the BH drainer pool validates rkey/op/roff/len only, not
+	 * the header CRC, and the DPA-side CRC is the per-thread throughput wall (A4) -> skip it for line rate. */
+	tt_put32(h + 28, d->tt_no_crc ? 0u : tt_crc32(h, 28));
+	if (hdr_only)
+		return; /* A4 gather: the payload is read by HW via the SQ 2nd data segment (no CPU copy) */
+	if (src)
+		memcpy(h + 32, src, plen);
+	else
+		for (uint32_t i = 0; i < plen; i++)
+			h[32 + i] = (uint8_t)i;
+}
+
+/* Per-invocation blast context: exactly the queue state one DPA thread needs to drive its OWN SQ. Multi-thread
+ * (N concurrent flexio_process_call RPCs) requires each thread to own its SQ/SQ-CQ/data-ring, so the blast
+ * MUST NOT touch the shared global app_ctx -- it builds this on its stack from its own host2dev arg. */
+struct tt_blast_ctx {
+	sq_ctx_t sq_ctx;    /* this thread's SQ */
+	cq_ctx_t sq_cq_ctx; /* this thread's SQ CQ */
+	dt_ctx_t dt_ctx;    /* this thread's SQ data ring */
+	uint32_t lkey;      /* this thread's SQ-data mkey */
+};
+
+static void tt_ctx_init(struct tt_blast_ctx *c, struct host2dev_packet_processor_data *d)
+{
+	c->lkey = d->sq_transf.wqd_mkey_id;
+	com_sq_ctx_init(&c->sq_ctx, d->sq_transf.wq_num, d->sq_transf.wq_ring_daddr);
+	com_cq_ctx_init(&c->sq_cq_ctx, d->sq_cq_transf.cq_num, d->sq_cq_transf.log_cq_depth,
+			d->sq_cq_transf.cq_ring_daddr, d->sq_cq_transf.cq_dbr_daddr);
+	com_dt_ctx_init(&c->dt_ctx, d->sq_transf.wqd_daddr);
+}
+
+/* Post `tt_count` TT-RDMA WRITE frames on THIS thread's SQ `c`, SQ-CQ paced (batch of 16, last send signaled,
+ * wait). Frame seq numbers start at d->tt_seq_base+1 so N concurrent threads emit DISJOINT seq ranges (the BH
+ * pool stays exactly-once). A4: if d->tt_src_mkey != 0 => ZERO-COPY GATHER: write only the 46B header per
+ * frame; the send WQE's 2nd data segment (the otherwise-pad 4th WQE slot) reads the payload directly from
+ * d->tt_src_daddr via tt_src_mkey, so the HW gathers [header]+[payload] with no per-frame CPU payload copy.
+ * Else COPY mode (whole frame). */
+static void tt_blast(struct tt_blast_ctx *c, struct host2dev_packet_processor_data *d)
+{
+	const uint32_t plen = d->tt_plen;
+	const uint32_t flen = 14u + 32u + plen;
+	const uint32_t hdr_len = 14u + 32u;
+	const uint32_t BATCH = 16u;
+	const int gather = (d->tt_src_mkey != 0);
+	const uint8_t *src = (const uint8_t *)d->tt_src_daddr;
+
+	if (!d->tt_no_crc)
+		tt_crc_init();
+	uint32_t sent = 0;
+	while (sent < d->tt_count) {
+		uint32_t b = d->tt_count - sent;
+		if (b > BATCH)
+			b = BATCH;
+		for (uint32_t j = 0; j < b; j++) {
+			uint8_t *f = (uint8_t *)get_next_dte(&c->dt_ctx, DATA_IDX_MASK, LOG_WQD_CHUNK_BSIZE);
+			tt_build_frame(f, d, plen, d->tt_seq_base + sent + j + 1, src, gather);
+
+			union flexio_dev_sqe_seg *cseg = get_next_sqe(&c->sq_ctx, SQ_IDX_MASK);
+			flexio_dev_swqe_seg_ctrl_set(cseg, c->sq_ctx.sq_pi, c->sq_ctx.sq_number,
+						     (j == b - 1) ? FLEXIO_CTRL_SEG_CE_CQE_ALWAYS
+								  : FLEXIO_CTRL_SEG_CE_CQE_ON_CQE_ERROR,
+						     FLEXIO_CTRL_SEG_TYPE_SEND_EN);
+			/* ctrl_set(SEND_EN) hardcodes ds=3 (ctrl+eth+1 data). Gather uses 4 segs (ctrl+eth+2 data);
+			 * ds is the low byte of the big-endian qpn_ds field -> patch it to 4. */
+			if (gather)
+				((uint8_t *)&cseg->ctrl.qpn_ds)[3] = 4u;
+			union flexio_dev_sqe_seg *swqe = get_next_sqe(&c->sq_ctx, SQ_IDX_MASK);
+			flexio_dev_swqe_seg_eth_set(swqe, 0, 0, 0, NULL);
+			swqe = get_next_sqe(&c->sq_ctx, SQ_IDX_MASK);
+			/* data seg 1: the 46B header (gather) or the whole frame (copy) */
+			flexio_dev_swqe_seg_mem_ptr_data_set(swqe, gather ? hdr_len : flen, c->lkey, (uint64_t)f);
+			swqe = get_next_sqe(&c->sq_ctx, SQ_IDX_MASK);
+			if (gather) /* data seg 2 (4th WQE slot): HW reads the payload from the source via its mkey */
+				flexio_dev_swqe_seg_mem_ptr_data_set(swqe, plen, d->tt_src_mkey, d->tt_src_daddr);
+			c->sq_ctx.sq_pi++;
+		}
+		__dpa_thread_fence(__DPA_MEMORY, __DPA_W, __DPA_W);
+		flexio_dev_qp_sq_ring_db(c->sq_ctx.sq_pi, c->sq_ctx.sq_number);
+		__dpa_thread_fence(__DPA_MEMORY, __DPA_W, __DPA_W);
+		while (flexio_dev_cqe_get_owner(c->sq_cq_ctx.cqe) != c->sq_cq_ctx.cq_hw_owner_bit)
+			;
+		com_step_cq(&c->sq_cq_ctx);
+		sent += b;
+	}
+	flexio_dev_print("TT-RDMA blast done: %u frames x %uB seqbase=%u (%s)\n", sent, flen, d->tt_seq_base,
+			 gather ? "gather" : "copy");
+}
+
+/* Host-invokable RPC entry (flexio_process_call): runs the blast synchronously on a per-call ctx. `arg` is the
+ * DPA-heap address of this thread's host2dev_packet_processor_data struct (== app_data_daddr[i] on the host).
+ * N host pthreads call this concurrently, each with its own arg -> each drives its own SQ on its own EU, with
+ * NO shared mutable state (thread-safe). */
+uint64_t tt_blast_rpc(uint64_t arg);
+__dpa_rpc__ uint64_t tt_blast_rpc(uint64_t arg)
+{
+	struct host2dev_packet_processor_data *d = (void *)arg;
+	struct tt_blast_ctx c;
+
+	tt_ctx_init(&c, d);
+	tt_blast(&c, d);
+	return d->tt_count;
+}
+
+/* ---- A3.2 arrival-driven re-head: drain a HOST doorbell, gather-egress each newly-"landed" frame ----
+ * The doorbell is a single uint64 `produced` in host memory (the RoCE responder bumps it per WRITE_IMM). The
+ * DPA polls it via window entity 0 and egresses frames [0..produced), each a gather send from the host landing
+ * buffer (tt_src_daddr/tt_src_mkey, A3.1), until it has egressed tt_count total. Runs in ONE RPC with a bounded
+ * spin (SPIN_MAX) so a stalled producer can't hang the DPA forever. Returns frames egressed. */
+uint64_t tt_drain_rpc(uint64_t arg);
+__dpa_rpc__ uint64_t tt_drain_rpc(uint64_t arg)
+{
+	struct host2dev_packet_processor_data *d = (void *)arg;
+	struct tt_blast_ctx c;
+	struct flexio_dev_thread_ctx *dtctx;
+	flexio_uintptr_t db_local = 0;
+	const uint32_t plen = d->tt_plen;
+	const uint32_t flen = 14u + 32u + plen;
+	const uint32_t hdr_len = 14u + 32u;
+	const uint32_t BATCH = 16u;
+	const int gather = (d->tt_src_mkey != 0);
+	const uint8_t *src = (const uint8_t *)d->tt_src_daddr;
+	const uint64_t SPIN_MAX = 4000000000ull; /* ~watchdog backstop if the producer stalls */
+	volatile uint64_t *produced;
+	uint64_t consumed = 0, spin = 0;
+
+	tt_ctx_init(&c, d);
+	if (!d->tt_no_crc)
+		tt_crc_init();
+	flexio_dev_get_thread_ctx(&dtctx);
+	/* Resolve the host doorbell address once (window entity 0). NOTE: window config and the SQ's outbox share
+	 * the thread's config slot -> after ANY window access the outbox MUST be restored or SQ doorbells go to
+	 * the window and sends silently fail to egress. So we toggle: window to read `produced`, outbox to send. */
+	flexio_dev_window_config(FLEXIO_DEV_WINDOW_ENTITY_0, (uint16_t)d->tt_win_id, d->tt_db_mkey);
+	if (flexio_dev_window_ptr_acquire(FLEXIO_DEV_WINDOW_ENTITY_0, d->tt_db_haddr, &db_local) !=
+	    FLEXIO_DEV_STATUS_SUCCESS)
+		return 0;
+	produced = (volatile uint64_t *)db_local;
+	flexio_dev_outbox_config(NULL, (uint16_t)d->tt_outbox_id); /* back to send mode */
+
+	while (consumed < d->tt_count) {
+		uint64_t p;
+
+		/* peek the host doorbell (switch to window, read, switch back to outbox for the sends) */
+		flexio_dev_window_config(FLEXIO_DEV_WINDOW_ENTITY_0, (uint16_t)d->tt_win_id, d->tt_db_mkey);
+		__dpa_thread_fence(__DPA_MEMORY, __DPA_R, __DPA_R);
+		p = *produced; /* live host doorbell read via the window */
+		flexio_dev_outbox_config(NULL, (uint16_t)d->tt_outbox_id);
+		if (p > d->tt_count)
+			p = d->tt_count;
+		if (consumed >= p) { /* caught up -> wait for more arrivals (bounded) */
+			if (++spin > SPIN_MAX)
+				break;
+			continue;
+		}
+		spin = 0;
+		/* drain [consumed, p) in SQ-CQ-paced batches */
+		while (consumed < p) {
+			uint64_t end = consumed + BATCH;
+			uint32_t j, b;
+
+			if (end > p)
+				end = p;
+			b = (uint32_t)(end - consumed);
+			for (j = 0; j < b; j++) {
+				uint8_t *f = (uint8_t *)get_next_dte(&c.dt_ctx, DATA_IDX_MASK, LOG_WQD_CHUNK_BSIZE);
+				union flexio_dev_sqe_seg *cseg, *swqe;
+
+				tt_build_frame(f, d, plen, (uint32_t)(consumed + 1), src, gather);
+				cseg = get_next_sqe(&c.sq_ctx, SQ_IDX_MASK);
+				flexio_dev_swqe_seg_ctrl_set(cseg, c.sq_ctx.sq_pi, c.sq_ctx.sq_number,
+							     (j == b - 1) ? FLEXIO_CTRL_SEG_CE_CQE_ALWAYS
+									  : FLEXIO_CTRL_SEG_CE_CQE_ON_CQE_ERROR,
+							     FLEXIO_CTRL_SEG_TYPE_SEND_EN);
+				if (gather)
+					((uint8_t *)&cseg->ctrl.qpn_ds)[3] = 4u;
+				swqe = get_next_sqe(&c.sq_ctx, SQ_IDX_MASK);
+				flexio_dev_swqe_seg_eth_set(swqe, 0, 0, 0, NULL);
+				swqe = get_next_sqe(&c.sq_ctx, SQ_IDX_MASK);
+				flexio_dev_swqe_seg_mem_ptr_data_set(swqe, gather ? hdr_len : flen, c.lkey, (uint64_t)f);
+				swqe = get_next_sqe(&c.sq_ctx, SQ_IDX_MASK);
+				if (gather)
+					flexio_dev_swqe_seg_mem_ptr_data_set(swqe, plen, d->tt_src_mkey, d->tt_src_daddr);
+				c.sq_ctx.sq_pi++;
+				consumed++;
+			}
+			__dpa_thread_fence(__DPA_MEMORY, __DPA_W, __DPA_W);
+			flexio_dev_qp_sq_ring_db(c.sq_ctx.sq_pi, c.sq_ctx.sq_number);
+			__dpa_thread_fence(__DPA_MEMORY, __DPA_W, __DPA_W);
+			while (flexio_dev_cqe_get_owner(c.sq_cq_ctx.cqe) != c.sq_cq_ctx.cq_hw_owner_bit)
+				;
+			com_step_cq(&c.sq_cq_ctx);
+		}
+	}
+	flexio_dev_print("TT-RDMA drain done: %u frames egressed (doorbell peek %u)\n", (uint32_t)consumed,
+			 (uint32_t)*produced);
+	return consumed;
+}

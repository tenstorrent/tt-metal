+/* CRC-32 (reflected 0xEDB88320) via a 256-entry table built once (A4: ~5x fewer ops than the bit loop, which
+ * cost ~1.4us/frame on the DPA). */
+static uint32_t g_crc_tab[256];
+static int g_crc_tab_ready = 0;
+static void tt_crc_init(void)
+{
+	if (g_crc_tab_ready)
+		return;
+	for (uint32_t i = 0; i < 256; i++) {
+		uint32_t c = i;
+		for (int k = 0; k < 8; k++)

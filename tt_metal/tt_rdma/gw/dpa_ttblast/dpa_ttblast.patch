+
+/* One RC-QP RoCEv2 responder via librdmacm: listen, accept ONE connection (advertising the landing MR's
+ * rkey/addr), then bump `produced` once per landed WRITE_IMM/SEND. The payload is HW-written straight into
+ * the landing buffer by the RDMA WRITE; this thread does NO data copy (just re-posts a recv + bumps). */
+static void *tt_roce_responder_thread(void *v)
+{
+	struct roce_resp_arg *a = v;
+	struct rdma_event_channel *ec = NULL;
+	struct rdma_cm_id *lid = NULL, *cid = NULL;
+	struct rdma_cm_event *ev = NULL;
+	struct ibv_qp_init_attr qia = {0};
+	struct rdma_conn_param cp = {0};
+	struct tt_roce_pdata pd_adv;
+	struct sockaddr_in sa = {0};
+	struct ibv_pd *pd = NULL;
+	struct ibv_cq *cq = NULL;
+	struct ibv_mr *mr = NULL;
+	const int NRECV = 1024;
+	uint64_t got = 0;
+	int i;
+
+	ec = rdma_create_event_channel();
+	if (!ec || rdma_create_id(ec, &lid, NULL, RDMA_PS_TCP)) {
+		fprintf(stderr, "roce: event channel / id failed\n");
+		*a->failed = 1;
+		return NULL;
+	}
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(a->port);
+	sa.sin_addr.s_addr = INADDR_ANY; /* bind all -> reachable via the SF's 10.99.0.1 */
+	if (rdma_bind_addr(lid, (struct sockaddr *)&sa) || rdma_listen(lid, 1)) {
+		fprintf(stderr, "roce: bind/listen on :%u failed\n", a->port);
+		*a->failed = 1;
+		return NULL;
+	}
+	printf("A3.3b-2 RoCE responder: RDMA CM listening on :%u (any RoCEv2 app can connect)\n", a->port);
+
+	if (rdma_get_cm_event(ec, &ev) || ev->event != RDMA_CM_EVENT_CONNECT_REQUEST) {
+		fprintf(stderr, "roce: expected CONNECT_REQUEST, got %s\n", ev ? rdma_event_str(ev->event) : "none");
+		*a->failed = 1;
+		return NULL;
+	}
+	cid = ev->id;
+	rdma_ack_cm_event(ev);
+
+	pd = ibv_alloc_pd(cid->verbs);
+	cq = ibv_create_cq(cid->verbs, NRECV + 16, NULL, NULL, 0);
+	mr = ibv_reg_mr(pd, a->land, a->land_len, IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE);
+	if (!pd || !cq || !mr) {
+		fprintf(stderr, "roce: pd/cq/mr on the connected device failed\n");
+		*a->failed = 1;
+		return NULL;
+	}
+	qia.send_cq = cq;
+	qia.recv_cq = cq;
+	qia.qp_type = IBV_QPT_RC;
+	qia.cap.max_send_wr = 16;
+	qia.cap.max_recv_wr = NRECV;
+	qia.cap.max_send_sge = 1;
+	qia.cap.max_recv_sge = 1;
+	if (rdma_create_qp(cid, pd, &qia)) {
+		fprintf(stderr, "roce: rdma_create_qp failed\n");
+		*a->failed = 1;
+		return NULL;
+	}
+	/* A recv WR is consumed per RDMA_WRITE_WITH_IMM (and per SEND); no sge needed for WRITE_IMM. */
+	for (i = 0; i < NRECV; i++) {
+		struct ibv_recv_wr rwr = {0}, *bad;
+		rwr.wr_id = (uint64_t)i;
+		rwr.num_sge = 0;
+		if (ibv_post_recv(cid->qp, &rwr, &bad)) {
+			fprintf(stderr, "roce: post_recv %d failed\n", i);
+			*a->failed = 1;
+			return NULL;
+		}
+	}
+	/* Advertise the landing MR so the requester knows where to WRITE (CM private_data). */
+	pd_adv.rkey = mr->rkey;
+	pd_adv.addr = (uint64_t)(uintptr_t)a->land;
+	pd_adv.len = a->land_len;
+	cp.private_data = &pd_adv;
+	cp.private_data_len = sizeof(pd_adv);
+	cp.responder_resources = 4;
+	cp.initiator_depth = 4;
+	cp.rnr_retry_count = 7;
+	if (rdma_accept(cid, &cp)) {
+		fprintf(stderr, "roce: rdma_accept failed\n");
+		*a->failed = 1;
+		return NULL;
+	}
+	if (rdma_get_cm_event(ec, &ev) || ev->event != RDMA_CM_EVENT_ESTABLISHED) {
+		fprintf(stderr, "roce: expected ESTABLISHED, got %s\n", ev ? rdma_event_str(ev->event) : "none");
+		*a->failed = 1;
+		return NULL;
+	}
+	rdma_ack_cm_event(ev);
+	printf("A3.3b-2 RoCE responder: ESTABLISHED, advertised rkey=0x%x addr=%p len=%u\n", pd_adv.rkey, a->land,
+	       pd_adv.len);
+	*a->ready = 1; /* the drain may start now */
+
+	/* Each recv completion == one landed WRITE_IMM/SEND -> bump the doorbell + re-post. */
+	while (got < a->count) {
+		struct ibv_wc wc;
+		struct ibv_recv_wr rwr = {0}, *bad;
+		int n = ibv_poll_cq(cq, 1, &wc);
+
+		if (n < 0) {
+			fprintf(stderr, "roce: poll_cq error\n");
+			break;
+		}
+		if (n == 0)
+			continue;
+		if (wc.status != IBV_WC_SUCCESS) {
+			fprintf(stderr, "roce: wc status %s\n", ibv_wc_status_str(wc.status));
+			break;
+		}
+		got++;
+		*a->produced = got;
+		__sync_synchronize();
+		rwr.wr_id = wc.wr_id;
+		rwr.num_sge = 0;
+		ibv_post_recv(cid->qp, &rwr, &bad);
+	}
+	printf("A3.3b-2 RoCE responder: %lu WRITE_IMM/SEND landed -> produced=%lu\n", (unsigned long)got,
+	       (unsigned long)*a->produced);
+	return NULL;
+}
+
+/* A3.2 arrival simulator: bump the host `produced` doorbell from 0 to target in chunks (models a RoCE
+ * responder posting WRITE_IMM completions), so the DPA drain is genuinely doorbell-paced. */
+struct db_bump {
+	volatile uint64_t *db;
+	uint64_t target;
+	uint64_t chunk;
+	unsigned us;
+};
+
+static void *db_bump_fn(void *v)
+{
+	struct db_bump *a = v;
+	uint64_t p = 0;
+
+	while (p < a->target) {
+		p += a->chunk;
+		if (p > a->target)
+			p = a->target;
+		*a->db = p;
+		__sync_synchronize();
+		if (a->us)
+			usleep(a->us);
+	}
+	return NULL;
+}
+
+/* A3.2 full doorbell datapath: the DPA drains a host `produced` doorbell (read via a flexio_window) and
+ * gather-egresses each newly-"landed" frame from the host landing buffer (A3.1), until `total` frames. Either
+ * PRESET (produced=total up front) or ARRIVAL-DRIVEN (a bump thread grows produced over time). This is the
+ * hybrid-doorbell re-head with a SIMULATED producer; A3.3 swaps the bump thread for the real RoCE responder. */
+static int tt_run_doorbell(struct app_context *app_ctx)
+{
+	struct host2dev_packet_processor_data h = {0};
+	struct flexio_window *win = NULL;
+	struct flexio_outbox *outbox = NULL;
+	struct flexio_outbox_attr obattr = {0};
+	struct ibv_mr *dbmr = NULL;
+	flexio_uintptr_t app_data = 0;
+	void *dbpage = NULL;
+	volatile uint64_t *db;
+	struct db_bump ba;
+	pthread_t bt;
+	struct timespec t0, t1;
+	uint64_t ret = 0;
+	uint32_t total, plen;
+	int preset, have_thread = 0, rc = 0;
+	/* A3.3a cross-program seam: landing buffer + doorbell in a file-backed shared mmap the RoCE responder fills. */
+	const char *shmfile = getenv("TTDPA_SHMFILE");
+	struct ibv_mr *shmmr = NULL;
+	void *shmbase = NULL;
+	size_t shmsz = 0;
+	/* A3.3b-2: real RDMA-CM RoCE responder thread drives the doorbell (replaces the sim producer). */
+	int use_roce = getenv("TTDPA_ROCE") && strtoul(getenv("TTDPA_ROCE"), NULL, 0) > 0;
+	struct roce_resp_arg ra = {0};
+	volatile int roce_ready = 0, roce_failed = 0;
+	pthread_t rt;
+	int have_roce = 0;
+
+	total = tt_fill_hdr_params(&h);
+	if (!total)
+		return -1;
+	plen = h.tt_plen;
+
+	if (shmfile) {
+		/* Cross-program seam: [u64 produced @0][pad][landing buffer @4096] in a file-backed shared mmap that
+		 * a SEPARATE process fills. ONE ibv_mr over it on the process PD serves both the DPA gather (landing)
+		 * and the window (doorbell). No internal producer -> the external writer/RoCE responder drives it. */
+		int fd;
+		const size_t off = 4096;
+
+		shmsz = getenv("TTDPA_SHMSIZE") ? strtoul(getenv("TTDPA_SHMSIZE"), NULL, 0) : (16u << 20);
+		fd = open(shmfile, O_RDWR | O_CREAT, 0666);
+		if (fd < 0 || ftruncate(fd, (off_t)shmsz)) {
+			fprintf(stderr, "doorbell: shm open/ftruncate %s failed\n", shmfile);
+			if (fd >= 0)
+				close(fd);
+			return -1;
+		}
+		shmbase = mmap(NULL, shmsz, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+		close(fd);
+		if (shmbase == MAP_FAILED) {
+			fprintf(stderr, "doorbell: shm mmap failed\n");
+			return -1;
+		}
+		shmmr = ibv_reg_mr(app_ctx->process_pd, shmbase, shmsz, IBV_ACCESS_LOCAL_WRITE);
+		if (!shmmr) {
+			fprintf(stderr, "doorbell: shm ibv_reg_mr failed\n");
+			munmap(shmbase, shmsz);
+			shmbase = NULL;
+			return -1;
+		}
+		db = (volatile uint64_t *)shmbase;
+		h.tt_src_daddr = (flexio_uintptr_t)(uintptr_t)((char *)shmbase + off); /* landing buffer */
+		h.tt_src_mkey = shmmr->lkey;
+		h.tt_db_mkey = shmmr->lkey;
+		h.tt_db_haddr = (flexio_uintptr_t)(uintptr_t)shmbase; /* produced doorbell @0 */
+	} else {
+		if (tt_create_src(app_ctx, plen))
+			fprintf(stderr, "doorbell: source setup failed\n");
+		h.tt_src_daddr = app_ctx->tt_src_daddr;
+		h.tt_src_mkey = app_ctx->tt_src_mkey;
+
+		if (posix_memalign(&dbpage, 4096, 4096))
+			return -1;
+		memset(dbpage, 0, 4096);
+		db = (volatile uint64_t *)dbpage;
+		dbmr = ibv_reg_mr(app_ctx->process_pd, dbpage, 4096, IBV_ACCESS_LOCAL_WRITE);
+		if (!dbmr) {
+			fprintf(stderr, "doorbell: ibv_reg_mr failed\n");
+			free(dbpage);
+			return -1;
+		}
+		h.tt_db_mkey = dbmr->lkey;
+		h.tt_db_haddr = (flexio_uintptr_t)(uintptr_t)dbpage;
+	}
+	h.sq_cq_transf = app_ctx->sq_cq_transf; /* reuse the single SQ created in main */
+	h.sq_transf = app_ctx->sq_transf;
+	h.rq_cq_transf = app_ctx->rq_cq_transf;
+	h.rq_transf = app_ctx->rq_transf;
+
+	if (flexio_window_create(app_ctx->flexio_process, app_ctx->process_pd, &win)) {
+		fprintf(stderr, "doorbell: flexio_window_create failed\n");
+		rc = -1;
+		goto out;
+	}
+	h.tt_win_id = flexio_window_get_id(win);
+
+	/* Explicit outbox over the process UAR: the DPA restores this after each window access so SQ doorbells
+	 * still reach the (process-UAR) SQ. Without it, window access leaves the doorbell pointing at the window. */
+	if (flexio_outbox_create(app_ctx->flexio_process, &obattr, &outbox)) {
+		fprintf(stderr, "doorbell: flexio_outbox_create failed\n");
+		rc = -1;
+		goto out;
+	}
+	h.tt_outbox_id = flexio_outbox_get_id(outbox);
+
+	if (flexio_copy_from_host(app_ctx->flexio_process, &h, sizeof(h), &app_data)) {
+		fprintf(stderr, "doorbell: copy app_data failed\n");
+		rc = -1;
+		goto out;
+	}
+
+	preset = getenv("TTDPA_DB_PRESET") && strtoul(getenv("TTDPA_DB_PRESET"), NULL, 0) > 0;
+	printf("A3.2 DOORBELL: total=%u plen=%u %s src=%s\n", total, plen,
+	       use_roce ? "REAL-ROCE(responder thread)"
+			: (shmfile ? "EXTERNAL(shm producer)"
+				   : (preset ? "PRESET(produced=total)" : "ARRIVAL-DRIVEN(bump thread)")),
+	       shmfile ? "SHM-MEM" : (app_ctx->tt_src_ibv_mr ? "HOST-MEM" : (app_ctx->tt_src_mkey ? "DPA-heap-gather" : "none")));
+
+	if (use_roce) {
+		/* A3.3b-2: the real RoCE responder thread bumps `produced` per WRITE_IMM. Needs the HOST landing
+		 * buffer (TTDPA_HOSTSRC) so it can be registered on the connected device's PD for REMOTE_WRITE. */
+		int waited = 0;
+
+		if (!app_ctx->tt_src_hostbuf) {
+			fprintf(stderr, "TTDPA_ROCE needs a HOST landing buffer -> set TTDPA_HOSTSRC=1\n");
+			rc = -1;
+			goto out;
+		}
+		ra.land = app_ctx->tt_src_hostbuf;
+		ra.land_len = plen;
+		ra.produced = db;
+		ra.count = total;
+		ra.port = getenv("TTDPA_ROCE_PORT") ? (uint16_t)strtoul(getenv("TTDPA_ROCE_PORT"), NULL, 0) : 18515;
+		ra.ready = &roce_ready;
+		ra.failed = &roce_failed;
+		if (pthread_create(&rt, NULL, tt_roce_responder_thread, &ra)) {
+			fprintf(stderr, "doorbell: RoCE responder thread failed\n");
+			rc = -1;
+			goto out;
+		}
+		have_roce = 1;
+		/* Wait (off the DPA watchdog clock) for a RoCE connection before starting the blocking drain. */
+		printf("A3.3b-2: waiting for a RoCE connection before starting the DPA drain...\n");
+		while (!roce_ready && !roce_failed && waited < 120000) {
+			usleep(1000);
+			waited++;
+		}
+		if (roce_failed || !roce_ready) {
+			fprintf(stderr, "doorbell: RoCE responder never established (failed=%d)\n", roce_failed);
+			rc = -1;
+			goto out;
+		}
+	} else if (shmfile) {
+		/* External process (writer / RoCE responder) drives `produced`; the DPA drain waits on the doorbell.
+		 * Don't touch *db here (the writer owns it). */
+		printf("A3.3a: waiting on external producer via %s (produced now=%lu)\n", shmfile, (unsigned long)*db);
+	} else if (preset) {
+		*db = total;
+		__sync_synchronize();
+	} else {
+		ba.db = db;
+		ba.target = total;
+		ba.chunk = getenv("TTDPA_DB_CHUNK") ? strtoul(getenv("TTDPA_DB_CHUNK"), NULL, 0) : 4096;
+		ba.us = getenv("TTDPA_DB_US") ? (unsigned)strtoul(getenv("TTDPA_DB_US"), NULL, 0) : 200;
+		if (pthread_create(&bt, NULL, db_bump_fn, &ba)) {
+			fprintf(stderr, "doorbell: bump thread failed\n");
+			rc = -1;
+			goto out;
+		}
+		have_thread = 1;
+	}
+
+	clock_gettime(CLOCK_MONOTONIC, &t0);
+	if (flexio_process_call(app_ctx->flexio_process, &tt_drain_rpc, &ret, app_data)) {
+		fprintf(stderr, "doorbell: drain RPC failed\n");
+		rc = -1;
+	}
+	clock_gettime(CLOCK_MONOTONIC, &t1);
+	if (have_thread)
+		pthread_join(bt, NULL);
+	if (have_roce)
+		pthread_join(rt, NULL);
+	{
+		double dt = (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) / 1e9;
+		double fl = 14.0 + 32.0 + (double)plen;
+
+		printf("A3.2 DOORBELL done: %lu frames egressed (doorbell=%lu) in %.4fs = %.2f Mpps = %.2f Gbps%s\n",
+		       (unsigned long)ret, (unsigned long)*db, dt, dt > 0 ? ret / dt / 1e6 : 0.0,
+		       dt > 0 ? (ret * fl * 8.0) / dt / 1e9 : 0.0,
+		       ret == total ? " [exact]" : " [SHORT]");
+	}
+
+out:
+	if (app_data)
+		flexio_buf_dev_free(app_ctx->flexio_process, app_data);
+	if (outbox)
+		flexio_outbox_destroy(outbox);
+	if (win)
+		flexio_window_destroy(win);
+	if (dbmr)
+		ibv_dereg_mr(dbmr);
+	free(dbpage);
+	if (shmmr)
+		ibv_dereg_mr(shmmr);
+	if (shmbase)
+		munmap(shmbase, shmsz);
+	return rc;
+}
+
+/* A3.2 doorbell seam test: prove the DPA can read a live HOST-memory doorbell via a flexio_window. Allocates a
+ * host page, registers it (ibv_mr on the process PD) as the window's access key, creates the window, then calls
+ * the DPA winread RPC twice with two different host values -> confirms the DPA reads the CURRENT host value
+ * each time (a stale/mismatch would fail). This is the host->DPA signalling half of the hybrid doorbell. */
+static int tt_run_wintest(struct app_context *app_ctx)
+{
+	struct host2dev_packet_processor_data h = {0};
+	struct flexio_window *win = NULL;
+	struct ibv_mr *mr = NULL;
+	flexio_uintptr_t app_data = 0;
+	volatile uint64_t *db;
+	uint64_t ret = 0;
+	void *hb = NULL;
+	int rc = 0, pass = 0;
+
+	if (posix_memalign(&hb, 4096, 4096))
+		return -1;
+	memset(hb, 0, 4096);
+	db = (volatile uint64_t *)hb;
+
+	mr = ibv_reg_mr(app_ctx->process_pd, hb, 4096, IBV_ACCESS_LOCAL_WRITE);
+	if (!mr) {
+		fprintf(stderr, "WINTEST: ibv_reg_mr failed\n");
+		free(hb);
+		return -1;
+	}
+	if (flexio_window_create(app_ctx->flexio_process, app_ctx->process_pd, &win)) {
+		fprintf(stderr, "WINTEST: flexio_window_create failed\n");
+		rc = -1;
+		goto out;
+	}
+	h.tt_win_id = flexio_window_get_id(win);
+	h.tt_db_mkey = mr->lkey;
+	h.tt_db_haddr = (flexio_uintptr_t)(uintptr_t)hb;
+	printf("WINTEST: win_id=%u db_mkey=0x%x db_haddr=%p\n", h.tt_win_id, h.tt_db_mkey, hb);
+
+	if (flexio_copy_from_host(app_ctx->flexio_process, &h, sizeof(h), &app_data)) {
+		fprintf(stderr, "WINTEST: copy app_data failed\n");
+		rc = -1;
+		goto out;
+	}
+
+	*db = 0xDEADBEEFULL;
+	__sync_synchronize();
+	if (flexio_process_call(app_ctx->flexio_process, &tt_winread_rpc, &ret, app_data)) {
+		fprintf(stderr, "WINTEST: process_call 1 failed\n");
+		rc = -1;
+		goto out;
+	}
+	printf("WINTEST 1: host wrote 0x%lx, DPA read 0x%lx -> %s\n", (unsigned long)*db,
+	       (unsigned long)ret, ret == 0xDEADBEEFULL ? "OK" : "MISMATCH");
+	pass += (ret == 0xDEADBEEFULL);
+
+	*db = 0x12345678ULL;
+	__sync_synchronize();
+	if (flexio_process_call(app_ctx->flexio_process, &tt_winread_rpc, &ret, app_data)) {
+		fprintf(stderr, "WINTEST: process_call 2 failed\n");
+		rc = -1;
+		goto out;
+	}
+	printf("WINTEST 2: host wrote 0x%lx, DPA read 0x%lx -> %s\n", (unsigned long)*db,
+	       (unsigned long)ret, ret == 0x12345678ULL ? "OK (live read)" : "STALE/MISMATCH");
+	pass += (ret == 0x12345678ULL);
+
+	printf("WINTEST RESULT: %s (%d/2)\n", pass == 2 ? "PASS -- DPA reads live host doorbell" : "FAIL", pass);
+
+out:
+	if (app_data)
+		flexio_buf_dev_free(app_ctx->flexio_process, app_data);
+	if (win)
+		flexio_window_destroy(win);
+	if (mr)
+		ibv_dereg_mr(mr);
+	free(hb);
+	return rc;
+}
+
+/* TT-RDMA multi-thread fan-out. Creates `nthreads` SQs, builds one per-thread host2dev struct each (disjoint
+ * seq range so the BH pool stays exactly-once), then spawns `nthreads` host pthreads that each block in one
+ * flexio_process_call. pthread_join gives clean completion + per-thread frame count + wall-clock. 0 / -1. */
+static int tt_run_multithread(struct app_context *app_ctx, int nthreads)
+{
+	struct host2dev_packet_processor_data tmpl = {0};
+	struct tt_worker_arg *args = NULL;
+	pthread_t *tids = NULL;
+	struct tt_sq *sqs = NULL;
+	uint32_t total, per, plen;
+	struct timespec t0, t1;
+	uint64_t done = 0;
+	int i, created = 0, launched = 0, err = 0;
+	int persrc = getenv("TTDPA_PERSRC") && strtoul(getenv("TTDPA_PERSRC"), NULL, 0) > 0;
+
+	total = tt_fill_hdr_params(&tmpl);
+	if (!total)
+		return -1;
+	plen = tmpl.tt_plen;
+	if (tt_create_src(app_ctx, plen))
+		fprintf(stderr, "TT-RDMA: source buffer setup failed\n");
+	tmpl.tt_src_daddr = app_ctx->tt_src_daddr;
+	tmpl.tt_src_mkey = app_ctx->tt_src_mkey;
+	/* Per-thread source only makes sense in zero-copy gather mode (a real source mkey exists). */
+	if (persrc && !app_ctx->tt_src_mkey)
+		persrc = 0;
+
+	sqs = calloc(nthreads, sizeof(*sqs));
+	args = calloc(nthreads, sizeof(*args));
+	tids = calloc(nthreads, sizeof(*tids));
+	if (!sqs || !args || !tids) {
+		free(sqs);
+		free(args);
+		free(tids);
+		return -1;
+	}
+
+	per = total / (uint32_t)nthreads;
+	printf("TT-RDMA MULTI-THREAD: %d threads x %u frames (%u total, %u dropped as remainder) plen=%u %s%s\n",

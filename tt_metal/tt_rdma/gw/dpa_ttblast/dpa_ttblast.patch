+/* Fill the TT-RDMA header params (dmac/smac/count/plen/rkey) into `h` from the environment. Prints the params
+ * line when a blast was requested. Returns the blast count (0 => not a blast run). */
+static uint32_t tt_fill_hdr_params(struct host2dev_packet_processor_data *h)
+{
+	const char *c = getenv("TTDPA_COUNT");
+	const char *p = getenv("TTDPA_PLEN");
+	const char *r = getenv("TTDPA_RKEY");
+	const char *dm = getenv("TTDPA_DMAC");
+	unsigned m[6] = {0x02, 0, 0, 0, 0, 0x02};
+	uint64_t smac = SMAC; /* src MAC must match the TX steering rule (create_rule_tx_fwd_to_vport) */
+	int i;
+
+	if (dm)
+		sscanf(dm, "%x:%x:%x:%x:%x:%x", &m[0], &m[1], &m[2], &m[3], &m[4], &m[5]);
+	for (i = 0; i < 6; i++) {
+		h->tt_dmac[i] = (uint8_t)m[i];
+		h->tt_smac[i] = (uint8_t)(smac >> (8 * (5 - i))); /* SMAC is big-endian 48-bit */
+	}
+	h->tt_count = c ? (uint32_t)strtoul(c, NULL, 0) : 0;
+	h->tt_plen = p ? (uint32_t)strtoul(p, NULL, 0) : 256;
+	h->tt_rkey = r ? (uint32_t)strtoul(r, NULL, 0) : 0x00CAFE42u;
+	h->tt_no_crc = (getenv("TTDPA_NOCRC") && strtoul(getenv("TTDPA_NOCRC"), NULL, 0) > 0) ? 1 : 0;
+	if (h->tt_count)
+		printf("TT-RDMA blast: count=%u plen=%u rkey=0x%08x dmac=%02x:%02x:%02x:%02x:%02x:%02x crc=%s\n",
+		       h->tt_count, h->tt_plen, h->tt_rkey, m[0], m[1], m[2], m[3], m[4], m[5],
+		       h->tt_no_crc ? "OFF" : "on");
+	return h->tt_count;
+}

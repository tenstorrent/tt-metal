+/* A3.3b MERGED gateway: in the SAME process, ALSO register the landing buffer on a SECOND device (the RoCE SF,
+ * TTDPA_ROCE_DEV) with REMOTE_WRITE, so a real RoCEv2 WRITE_IMM from the x86 requester lands into the very
+ * bytes the FlexIO DPA (mlx5_0) gathers. No shared memory: one process, one buffer, two device registrations.
+ * Prints the rkey the requester must target. Returns 0 (or if the device isn't set, a no-op). */
+static int tt_reg_roce_landing(struct app_context *app_ctx, void *buf, size_t len)
+{
+	const char *dev = getenv("TTDPA_ROCE_DEV");
+	struct ibv_device **list;
+	int i, n = 0;
+
+	if (!dev)
+		return 0; /* single-device / sim mode — no RoCE dest registration */
+	list = ibv_get_device_list(&n);
+	if (!list) {
+		fprintf(stderr, "A3.3b: ibv_get_device_list failed\n");
+		return -1;
+	}
+	for (i = 0; i < n; i++) {
+		if (!strcmp(ibv_get_device_name(list[i]), dev)) {
+			app_ctx->roce_ctx = ibv_open_device(list[i]);
+			break;
+		}
+	}
+	ibv_free_device_list(list);
+	if (!app_ctx->roce_ctx) {
+		fprintf(stderr, "A3.3b: RoCE device %s not found/openable\n", dev);
+		return -1;
+	}
+	app_ctx->roce_pd = ibv_alloc_pd(app_ctx->roce_ctx);
+	if (!app_ctx->roce_pd) {
+		fprintf(stderr, "A3.3b: alloc_pd on %s failed\n", dev);
+		return -1;
+	}
+	app_ctx->roce_mr = ibv_reg_mr(app_ctx->roce_pd, buf, len,
+				      IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE);
+	if (!app_ctx->roce_mr) {
+		fprintf(stderr, "A3.3b: reg_mr on %s (REMOTE_WRITE) failed\n", dev);
+		return -1;
+	}
+	printf("A3.3b MERGED: landing buffer ALSO on %s (RoCE dest) rkey=0x%x addr=%p len=%zu\n", dev,
+	       app_ctx->roce_mr->rkey, buf, len);
+	return 0;
+}

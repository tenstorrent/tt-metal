+{
+	struct host2dev_packet_processor_data *d = (void *)arg;
+	struct flexio_dev_thread_ctx *dtctx;
+	flexio_uintptr_t local = 0;
+	uint64_t v = 0;
+
+	flexio_dev_get_thread_ctx(&dtctx);
+	/* Point window entity 0 at the host doorbell region (window id + its access mkey). */
+	flexio_dev_window_config(FLEXIO_DEV_WINDOW_ENTITY_0, (uint16_t)d->tt_win_id, d->tt_db_mkey);
+	/* Translate the host VA into a DPA-local pointer, then read it. */
+	if (flexio_dev_window_ptr_acquire(FLEXIO_DEV_WINDOW_ENTITY_0, d->tt_db_haddr, &local) ==
+	    FLEXIO_DEV_STATUS_SUCCESS) {
+		__dpa_thread_fence(__DPA_MEMORY, __DPA_R, __DPA_R);
+		v = *(volatile uint64_t *)local;
+	}
+	return v;
+}

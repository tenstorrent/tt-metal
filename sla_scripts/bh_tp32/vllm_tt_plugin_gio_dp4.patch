+def get_tt_max_new_prefills_per_step(vllm_config: "VllmConfig") -> int:
+    """Most new requests one prefill step admits per scheduler (lane); 0 = no cap.
+
+    The TT runner returns a step's first tokens only when the whole step ends, so a large token budget that admits
+    several whole prompts per step delays every first token in it. Capping admissions keeps a large budget (one long
+    prompt in one pass instead of chunks) without growing the step.
+    """
+    value = get_tt_config(vllm_config).get(_MAX_NEW_PREFILLS_PER_STEP_KEY, 0)
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise ValueError(
+            f"additional_config['tt']['{_MAX_NEW_PREFILLS_PER_STEP_KEY}'] must be an integer >= 0, got {value!r}"
+        )
+    return value
+

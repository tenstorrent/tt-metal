#############################################################
# yq - simple binary extraction
# Outputs: /install/bin/yq
#############################################################

FROM alpine:3.19 AS yq-builder
ARG YQ_VERSION
ARG YQ_SHA256
# Install bash first (required for SHELL directive)
RUN apk add --no-cache bash wget
# Enforce strict error handling: exit on error, unset vars, pipe failures
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
COPY dockerfile/scripts/install-yq.sh /tmp/install-yq.sh
RUN YQ_VERSION=${YQ_VERSION} \

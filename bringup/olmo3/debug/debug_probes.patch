+def _make_op_probe(records):
+    """Debug (OLMO_OP_PROBE=<path>): checksum every ttnn op output per device and per row during one eager decode step."""
+    import hashlib
+
+    def hook(operation, args, kwargs, output):
+        outs = output if isinstance(output, (list, tuple)) else [output]
+        for t in outs:
+            if not isinstance(t, ttnn.Tensor) or t.storage_type() != ttnn.StorageType.DEVICE or not t.is_allocated():
+                continue
+            hashes, rows = [], []
+            for dt in ttnn.get_device_tensors(t):
+                x = ttnn.to_torch(dt).float()
+                hashes.append(hashlib.md5(x.numpy().tobytes()).hexdigest()[:12])
+                rows.append(x.reshape(-1, x.shape[-1]).double().sum(-1) if x.dim() >= 2 else x.double().sum().reshape(1))
+            records.append({"op": str(operation.python_fully_qualified_name), "shape": tuple(t.shape), "hashes": hashes, "rows": rows})
+
+    return hook
+

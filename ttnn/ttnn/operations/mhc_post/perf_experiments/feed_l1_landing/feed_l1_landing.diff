+def feed_l1_plan(device, feed, t_tiles, ht_img, c_tiles, T, worker_cb_bytes, n_workers):
+    """Landing mode and size of the feed L1 landing (FEED_L1_MODE). Returns dict(mode = 0 dram / 1 stage / 2 direct,

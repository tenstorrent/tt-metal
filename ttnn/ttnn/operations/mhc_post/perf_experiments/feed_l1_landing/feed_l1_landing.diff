+    mode = FEED_L1_MODE
+    if mode in ("direct", "stream", "greedy") and shifted:
+        # T % 32 != 0: the stage variant (the port reader assembles the shifted D tiles from the landing over the
+        # NoC) measured slower than the DRAM staging (T150 C5120 2 links: +3.6 us fastest / +3.5 us slowest), so the
+        # shifted feed keeps the R4 DRAM-staged path; MHC_FEED_L1=stage forces it for experiments
+        mode = "dram"
+    land = 0

+def _landing_place(mesh, chips, cluster_axis, num_links, cells, H, Hl):
+    """Head -> core map that shortens the router's landing writes (landing_contention experiment). The router writes a
+    landed packet into compute L1 on NoC1 (edm_to_local_chip_noc), which runs north along the receiving Ethernet
+    core's column, then WEST along the destination core's row; the compute cores' weight responses (NoC1: north along
+    the DRAM column, then west along the core's row) load the same row links. Cost of head h on core c = sum over the
+    chips that receive h of the westward row hops from the receiving Ethernet column to c's physical column (+0.05 x
+    the column hops as a tie-break). Same per-core head counts as _split_heads (min-cost assignment over capacity
+    copies). Returns [(core xy, [heads])] like _split_heads."""
+    import numpy as np
+    from scipy.optimize import linear_sum_assignment
+
+    _, _, (gx, gy) = _soc(mesh)
+    key = (id(mesh), cluster_axis, num_links, tuple(cells))
+    if key not in _LAND_GEO_CACHE:
+        ethx, physx = {}, {}
+        for coord, ch in chips.items():
+            eth_list, t2p = _chip_maps(mesh, coord)
+            for d, peer in ((FWD, ch["next"]), (BWD, ch["prev"])):
+                for l in range(num_links):
+                    ethx[(ch["p"], d, l)] = eth_list[_eth_channel(mesh, coord, peer, ch["links"][d][l])]
+            for c in cells:
+                v = mesh.worker_core_from_logical_core(ttnn.CoreCoord(*c))
+                physx[(ch["p"], c)] = (t2p.get(v.x, v.x), v.y)
+        _LAND_GEO_CACHE[key] = (mesh, ethx, physx)
+    _, ethx, physx = _LAND_GEO_CACHE[key]
+    pos = {ch["p"]: ch for ch in chips.values()}
+    G = len(pos)
+    cost = np.zeros((H, len(cells)))
+    for h in range(H):
+        s, j = h // Hl, h % Hl
+        for t in range(G):
+            if t == s:
+                continue
+            ex, ey = ethx[(t, 1 - pos[s]["route"][t], j % num_links)]
+            for ci, c in enumerate(cells):
+                cx, cy = physx[(t, c)]
+                cost[h, ci] += (ex - cx) % gx + 0.05 * ((ey - cy) % gy)
+    C = len(cells)
+    q, rem = divmod(H, C)
+    ncap = q + (1 if rem else 0)
+    cols = [ci for ci in range(C) for _ in range(ncap)]
+    big = 1e6
+    m = np.stack([cost[:, ci] - (big if k < q else 0.0) for ci in range(C) for k in range(ncap)], axis=1)
+    rows, cidx = linear_sum_assignment(m)
+    heads = {}
+    for h, k in zip(rows, cidx):
+        heads.setdefault(cells[cols[k]], []).append(int(h))
+    return [(c, sorted(heads[c])) for c in cells if c in heads]
+

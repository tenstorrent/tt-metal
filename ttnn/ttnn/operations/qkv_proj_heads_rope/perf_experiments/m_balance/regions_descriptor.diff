+# ---------------------------------------------------------------------------------------------------------
+# m_balance: the core assignment as a list of regions. A region is a grid_m x grid_n sub-grid with one h_c
+# (one W slice width, one N-group set), its own M-groups (row ranges) and its own CT args; regions are
+# disjoint core sets, so every multicast group stays inside one region. One region = today's assignment.
+# MB_PLAN (env) forces a hand-placed mixed plan for Mt = 64 on the 11x10 grid; anything else = baseline.
+# ---------------------------------------------------------------------------------------------------------
+import os
+from dataclasses import replace
+
+MB_PLAN = os.environ.get("MB_PLAN", "base")
+# Split each M-group's x multicast into one group per rectangle (own sender each): x is re-read from its
+# tier once per rectangle, but no sender issues more than one multicast write per round.
+MB_XSPLIT = os.environ.get("MB_XSPLIT", "0") == "1"
+
+
+@dataclass
+class Region:
+    blocking: Blocking
+    row_ranges: list  # (row_start, rows) per M-group
+    layout: dict  # (m_group, n_group) -> (x, y)
+    w_multicast: bool
+
+
+def _region_blocking(base, heads_per_core, rows, compute_kernel_config):
+    n_tiles = TILES_PER_HEAD * heads_per_core
+    cap = block_m_cap(n_tiles, base.seq_tiles)
+    block_m = _block_m(max(rows), min(rows), cap)
+    sb_h, sb_w = _subblock(block_m, n_tiles, _dest_tiles(compute_kernel_config))
+    return replace(
+        base,
+        heads_per_core=heads_per_core,
+        grid_m=len(rows),
+        grid_n=TOTAL_HEADS // heads_per_core,
+        block_m=block_m,
+        sb_h=sb_h,
+        sb_w=sb_w,
+        weight_depth=WEIGHT_DEPTH,
+    )
+
+
+def _ranges(rows, start):
+    out = []
+    for r in rows:
+        out.append((start, r))
+        start += r
+    return out, start
+
+
+def _plan_a(base, cfg, w_mc_small):
+    """h_c = 3: 6 M-groups x 7 rows (12 cores each) + h_c = 2: 2 M-groups x 11 rows (18 cores each)."""
+    h3 = {}
+    for m in range(6):
+        for n in range(12):
+            h3[(m, n)] = (n, m) if n < 11 else (m, 6)
+    h2_cells = {0: [(x, 7) for x in range(11)] + [(x, 9) for x in range(7)],
+                1: [(x, 8) for x in range(11)] + [(x, 6) for x in range(6, 11)] + [(x, 9) for x in (7, 8)]}
+    h2 = {(m, n): h2_cells[m][n] for m in range(2) for n in range(18)}
+    r3, start = _ranges([7] * 6, 0)
+    r2, end = _ranges([11, 11], start)
+    assert end == base.tensor_row_tiles
+    return [
+        Region(_region_blocking(base, 3, [7] * 6, cfg), r3, h3, True),
+        Region(_region_blocking(base, 2, [11, 11], cfg), r2, h2, w_mc_small),
+    ]
+
+
+def _plan_a2(base, cfg):
+    """As _plan_a, h_c = 2 M-groups as rectangles: x 0..5 y 7..9 (1 rect); x 6..10 y 6..8 + x 6..8 y 9 (2)."""
+    regions = _plan_a(base, cfg, True)
+    cells = {0: [(x, y) for y in (7, 8, 9) for x in range(6)],
+             1: [(x, y) for y in (6, 7, 8) for x in range(6, 11)] + [(x, 9) for x in (6, 7, 8)]}
+    regions[1].layout = {(m, n): cells[m][n] for m in range(2) for n in range(18)}
+    return regions
+
+
+def _plan_b2(base, cfg):
+    """h_c = 2: M-group m = rows y = m and m + 4, x 0..8 (N-groups are 4-core columns); h_c = 4: rows y = 8, 9
+    x 0..8 and columns x = 9, 10 y 0..8 (N-group n = pair (n, 8..9) + pair (9..10, n))."""
+    h2 = {(m, n): (n % 9, m + 4 * (n // 9)) for m in range(4) for n in range(18)}
+    h4 = {}
+    for n in range(9):
+        h4[(0, n)], h4[(1, n)], h4[(2, n)], h4[(3, n)] = (n, 8), (n, 9), (9, n), (10, n)
+    r4, start = _ranges([5] * 4, 0)
+    r2, end = _ranges([11] * 4, start)
+    assert end == base.tensor_row_tiles
+    return [
+        Region(_region_blocking(base, 4, [5] * 4, cfg), r4, h4, True),
+        Region(_region_blocking(base, 2, [11] * 4, cfg), r2, h2, True),
+    ]
+
+
+def _plan_b(base, cfg):
+    """h_c = 4: 4 M-groups x 5 rows (9 cores each) + h_c = 2: 4 M-groups x 11 rows (18 cores each)."""
+    h4 = {(m, n): (n, m) for m in range(4) for n in range(9)}
+    h2 = {}
+    for m in range(4):
+        for n in range(18):
+            if n < 11:
+                h2[(m, n)] = (n, 4 + m)
+            elif n < 16:
+                j = n - 11
+                h2[(m, n)] = (j + 5 * (m // 2), 8 + m % 2)
+            else:
+                h2[(m, n)] = (9 + n - 16, m)
+    r4, start = _ranges([5] * 4, 0)
+    r2, end = _ranges([11] * 4, start)
+    assert end == base.tensor_row_tiles
+    return [
+        Region(_region_blocking(base, 4, [5] * 4, cfg), r4, h4, True),
+        Region(_region_blocking(base, 2, [11] * 4, cfg), r2, h2, True),
+    ]
+
+
+def plan_regions(device, blocking, compute_kernel_config):
+    if MB_PLAN != "base" and blocking.tensor_row_tiles == 64:
+        grid = device.compute_with_storage_grid_size()
+        assert (grid.x, grid.y) == (11, 10), "forced plans are hand-placed for the 11x10 p100a grid"
+        plans = {
+            "A_mc": lambda: _plan_a(blocking, compute_kernel_config, True),
+            "A_uc": lambda: _plan_a(blocking, compute_kernel_config, False),
+            "B": lambda: _plan_b(blocking, compute_kernel_config),
+            "A2": lambda: _plan_a2(blocking, compute_kernel_config),
+            "B2": lambda: _plan_b2(blocking, compute_kernel_config),
+        }
+        regions = plans[MB_PLAN]()
+    else:
+        grid = device.compute_with_storage_grid_size()
+        layout, _ = _choose_layout(grid.x, grid.y, blocking.grid_n, blocking.grid_m)
+        w_multicast = _w_multicast(grid, blocking.grid_m, blocking.grid_n, blocking.tensor_row_tiles, blocking.block_m)
+        regions = [Region(blocking, _row_ranges(blocking.tensor_row_tiles, blocking.grid_m), layout, w_multicast)]
+    cells = [c for r in regions for c in r.layout.values()]
+    assert len(cells) == len(set(cells)), "regions overlap"
+    for r in regions:
+        groups = [[r.layout[(m, n)] for n in range(r.blocking.grid_n)] for m in range(r.blocking.grid_m)]
+        if r.w_multicast:
+            groups += [[r.layout[(m, n)] for m in range(r.blocking.grid_m)] for n in range(r.blocking.grid_n)]
+        for g in groups:
+            assert len(_rectangles(g)) <= MAX_MCAST_RECTANGLES, (g, _rectangles(g))
+    return regions
+

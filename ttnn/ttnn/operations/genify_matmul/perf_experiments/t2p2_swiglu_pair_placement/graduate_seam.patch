+def bank_seam_layout(gx: int, rows: int, homes, sizes):
+    """BANK_LOCAL_PAIR_SEAM: the swiglu pair classes (homes[u]: the NoC0 home (x, y) of each bank of class u, sizes[u]
+    its units) on the grid rows [0, rows), as bank_layout's {(x, y): (u, t0, w)}; None when infeasible. A cell on row r
+    crosses the +y seam for every bank of its class homed below r (home row > r).
+      1. units per core w: the smallest that fits (every core walks the grid's nominal max run);
+      2. seam-free cells: the class with the fewest free ones claims first, its cells ordered by +x distance from its
+         banks' DRAM column, then row; a row several classes need equally goes, cell by cell, to the nearest in +x;
+      3. cells crossing the seam for one bank, then for both: greedy over (class, cell) by the column's seam load
+         (units already crossing it there), the hops past the seam, then +x distance -- the seam traffic spreads over
+         every column instead of stacking."""
+    U = len(sizes)
+    cells = [(x, y) for y in range(rows) for x in range(gx)]
+    hx = [homes[u][0][0] for u in range(U)]
+
+    def wraps(u, r):
+        return sum(1 for _, hy in homes[u] if r < hy)
+
+    def xpref(u, x):
+        return (x - hx[u]) % gx
+
+    def hops(u, r):
+        return max([r + rows - hy for _, hy in homes[u] if r < hy] or [0])
+
+    for w in range(max(1, _cdiv(sum(sizes), len(cells))), max(sizes) + 1):
+        need = [_cdiv(s, w) for s in sizes]
+        if sum(need) > len(cells):
+            continue
+        owner, claimed = {}, {u: [] for u in range(U)}
+
+        def claim(u, xy):
+            owner[xy] = u
+            claimed[u].append(xy)
+            need[u] -= 1
+
+        while True:  # 2. seam-free cells
+            free0 = {u: [c for c in cells if c not in owner and wraps(u, c[1]) == 0] for u in range(U) if need[u] > 0}
+            free0 = {u: f for u, f in free0.items() if f}
+            if not free0:
+                break
+            scarce = min(len(f) for f in free0.values())
+            group = sorted(u for u, f in free0.items() if len(f) == scarce)
+            mine = {u: [] for u in group}
+            for c in sorted(set().union(*[free0[u] for u in group]), key=lambda c: (c[1], c[0])):
+                mine[min((u for u in group if c in free0[u]), key=lambda u: (xpref(u, c[0]), u))].append(c)
+            for u in group:
+                for c in sorted(mine[u], key=lambda c: (xpref(u, c[0]), c[1]))[: need[u]]:
+                    claim(u, c)
+            for u in group:  # a member short of its own cells takes the others' leftovers
+                rest = sorted((c for c in free0[u] if c not in owner), key=lambda c: (xpref(u, c[0]), c[1]))
+                for c in rest[: max(0, need[u])]:
+                    claim(u, c)
+        load = [0] * gx  # 3. seam cells, one crossing bank, then two
+        for k in (1, 2):
+            while any(n > 0 for n in need):
+                best = None
+                for u in (u for u in range(U) if need[u] > 0):
+                    for c in cells:
+                        if c not in owner and wraps(u, c[1]) == k:
+                            key = (load[c[0]] + w * k, hops(u, c[1]), -need[u], xpref(u, c[0]), c[1], u)
+                            if best is None or key < best[0]:
+                                best = (key, u, c)
+                if best is None:
+                    break
+                claim(best[1], best[2])
+                load[best[2][0]] += w * k
+        if any(n > 0 for n in need):
+            continue
+        out = {c: (0, 0, 0) for c in cells}
+        for u in range(U):
+            for xy, (t0, wu) in zip(claimed[u], _even_runs(sizes[u], len(claimed[u]))):
+                out[xy] = (u, t0, wu)
+        return out
+    return None
+
+
+def bank_seam_bytes(geom: Geometry, layout):
+    """The most B bytes one bank streams across the NoC0 +y seam under a swiglu bank layout (cores on rows above the
+    bank's home row), else 0."""
+    if not geom.swiglu:
+        return 0
+    unit = 2
+    seam = [0] * geom.b_banks
+    for (_, y), (u, _, w) in layout.items():
+        for i in range(unit):
+            if w and y < geom.bank_home[unit * u + i][1]:
+                seam[unit * u + i] += w
+    return max(seam) * geom.tensor_k_tiles * geom.b_tile_bytes
+

+def _progressive_split(geom: Geometry, grid: GridChoice, budget: int, whole: "Blocking"):
+    """PROGRESSIVE_N_BLOCKS: the chosen split's S2 walk (whole region, K-walk) split into N-blocks (see
+    the knob). Applied AFTER choose_split -- ranking it inside the split choice charges the A re-reads to
+    the grid and demotes it (PERF FOCUS 1 then picked a 10x10 7x28 grid: 539.6 us). None when off, not
+    an S2 walk, or when the split would pad compute, lose DEST subblock area, miss the operand mode, or
+    not fit."""
+    nb = PROGRESSIVE_N_BLOCKS
+    cm, cn = grid.core_m_tiles, grid.core_n_tiles
+    s2 = (
+        whole.block_m_tiles == cm
+        and whole.block_n_tiles == cn
+        and whole.num_k_blocks > 1
+        and not (whole.weight_resident or whole.act_resident)
+    )
+    if nb <= 1 or whole.block_batches != 1 or grid.core_batches != 1 or not s2:
+        return None
+    bn = _round_up(_cdiv(cn, nb), geom.q_n_min)
+    if bn >= cn or cn % bn:
+        return None
+    sb_h, sb_w = choose_subblock(cm, bn, geom.dest_limit)
+    if sb_h * sb_w != whole.sb_h * whole.sb_w:
+        return None
+    depth_out = cm // sb_h  # the whole block's row groups
+    best = None
+    for depth in range(max(whole.depth_act, whole.depth_weight), PROGRESSIVE_MAX_DEPTH + 1):
+        if _footprint(geom, cm, bn, whole.block_k_tiles, True, depth_weight=depth, depth_act=depth, depth_out=depth_out) > budget:
+            break
+        best = depth
+    if best is None:
+        return None
+    blk = replace(
+        _make_blocking(geom, 1, cm, bn, whole.block_k_tiles, (best, best)), depth_out=depth_out
+    )
+    if operand_mode(geom, grid, blk) != operand_mode(geom, grid, whole):
+        return None
+    return blk
+

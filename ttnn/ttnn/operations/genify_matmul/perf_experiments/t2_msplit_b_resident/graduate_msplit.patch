+// ---- t2_msplit_b_resident (perf experiment): M-split walk with B L1-resident ----
+// GM_MSPLIT: the core's rows are walked as GM_MSPLIT_NB M-blocks of heights GM_MSPLIT_H0.. (non-increasing, each
+// dividing block_m_tiles = the first / tallest). B is pushed ONCE (cb_weight_tiles holds all num_k_blocks K-blocks)
+// and never popped until the end: M-block 0 waits for K-block kb cumulatively (PreKBlockFn), every M-block reads
+// K-block kb at tile offset kb * block_k * block_n (In1BaseOffsetFn, in1 NoWaitNoPop). Each M-block is the same
+// helper call as the op's multi-K-block walk (packer L1 acc, LastBlockTarget::Out), so the per-tile accumulation
+// order is unchanged. A shorter M-block packs h * block_n partials per K-block into a block_m * block_n ring: the
+// PostKBlockFn advances both ends by the difference after every drained K-block so in-place L1 accumulation keeps
+// landing on the same address.
+#ifdef GM_MSPLIT
+#ifndef GM_MSPLIT_H2
+#define GM_MSPLIT_H2 0
+#define GM_MSPLIT_K2 1
+#endif
+#ifndef GM_MSPLIT_H3
+#define GM_MSPLIT_H3 0
+#define GM_MSPLIT_K3 1
+#endif
+namespace ms {
+constexpr uint32_t nb = GM_MSPLIT_NB;
+constexpr uint32_t h[4] = {GM_MSPLIT_H0, GM_MSPLIT_H1, GM_MSPLIT_H2, GM_MSPLIT_H3};
+// Per-M-block K-block width: h[i] * kk[i] is the same for every M-block (one A round size, one ring slot); the
+// resident B is k-row-major (tile k * block_n + c), so any K-block width addresses it. M-block 0 runs the reader's
+// K-blocks (kk[0] == block_k_tiles) so its cumulative waits follow the pushes.
+constexpr uint32_t kk[4] = {GM_MSPLIT_K0, GM_MSPLIT_K1, GM_MSPLIT_K2, GM_MSPLIT_K3};
+constexpr uint32_t tensor_k = (num_k_blocks - 1) * block_k_tiles + last_block_k_tiles;
+static_assert(nb >= 1 && nb <= 4 && h[0] == block_m_tiles && kk[0] == block_k_tiles && !has_epilogue);
+static_assert(block_batches == 1 && !gm_ks::ramp);
+struct ResidentBWait {
+    uint32_t first;
+    ALWI void operator()(uint32_t kb, uint32_t, bool) const {
+        if (first) {

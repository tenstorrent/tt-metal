+    }
+};
+struct ResidentBOffset {
+    uint32_t bk;
+    ALWI uint32_t operator()(uint32_t kb) const { return kb * bk * block_n_tiles; }
+};
+struct Inner {
+    uint32_t nkb, bk, last;

+// =======================================================================================
+// BAKE-OFF (perf_experiments/fold_gather_overlap) -- THE PREFIX FOLD
+// =======================================================================================
+// Same arithmetic as `combine_fold` above, same DEST window, same finalize, same ONE pack
+// -- the ONLY difference is WHEN the addends become visible.  `combine_fold` waits for the
+// whole GATHER_SLOTS window and then does every add; this waits for one RUN at a time and
+// accumulates into the SAME DEST slot across the waits, so run r's adds run while runs
+// r+1.. are still converging over the NoC.  The writer publishes each run under its own
+// arrival semaphore (see the writer's FOLD_RUNS block), which is what makes a prefix
+// window MEAN something: a single cumulative counter says HOW MANY partials landed, not
+// WHICH, so `wait_min(k)` could be satisfied by a slot outside the prefix.
+//
+// BIT-FOR-BIT IDENTICAL TO `combine_fold` ONLY WHEN RUNS == 1: the pairwise walk is now
+// per-run (r-th run halves within itself and accumulates onto the running DEST value), so
+// the summation TREE has a different shape.  fp add is not associative, so the result can
+// differ in the last bits -- measured as rel-RMS in the bench, never assumed.
+// Nothing here reads or changes fp32_dest_acc_en / math_fidelity / math_approx_mode.
+template <
+    uint32_t CB_IN,
+    uint32_t SLOTS,
+    uint32_t RUNS,
+    uint32_t CB_OUT,
+    bool FINALIZE,
+    bool COMPACT_SCOPE,
+    bool WIDE_SCOPE,
+    uint32_t IW_BITS,
+    uint32_t EP_BITS>
+ALWI void combine_fold_prefix() {
+    constexpr uint32_t RUN = SLOTS / RUNS;
+    constexpr uint32_t HALF = RUN / 2;
+    static_assert(
+        SLOTS % RUNS == 0 && RUN % 2 == 0 && HALF >= 1,
+        "rms_norm_ttnn: the prefix fold needs even runs that tile the gather ring");
+    // The first run is waited BEFORE the format reconfigs purely so the ordering matches
+    // `combine_fold`'s (wait, then reconfig, then acquire) and the two are comparable.
+    cb_wait_front(CB_IN, RUN);
+    reconfig_data_format(CB_IN, CB_IN);
+    pack_reconfig_data_format(CB_OUT);
+    add_tiles_init(CB_IN, CB_IN, /*acc_to_dest=*/true);
+    if constexpr (FINALIZE) {
+        rsqrt_tile_init();
+    }
+    tile_regs_acquire();
+    for (uint32_t r = 0; r < RUNS; ++r) {
+        if (r != 0) {
+            // UNPACK-thread wait INSIDE the MATH thread's DEST window -- the same shape a
+            // streaming reduce uses (wait one page, unpack, pop, repeat, one acquire).  The
+            // two threads are independent, so the math never waits on itself.
+            cb_wait_front(CB_IN, RUN);
+        }
+        for (uint32_t p = 0; p < HALF; ++p) {
+            add_tiles(CB_IN, CB_IN, p, HALF + p, 0);
+        }
+        // Frees the run's pages immediately; the tile indices above are relative to the
+        // CB's FRONT, which the pop advances to the next run.
+        cb_pop_front(CB_IN, RUN);
+    }
+    if constexpr (FINALIZE) {
+        if constexpr (COMPACT_SCOPE) {
+            compact_finalize_payload<IW_BITS, EP_BITS, WIDE_SCOPE>(0);
+        } else {
+            stat_finalize_payload<IW_BITS, EP_BITS>(0);
+        }
+    }
+    tile_regs_commit();
+    cb_reserve_back(CB_OUT, 1);
+    tile_regs_wait();
+    pack_tile(0, CB_OUT);
+    tile_regs_release();
+    cb_push_back(CB_OUT, 1);
+}

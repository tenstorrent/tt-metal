+# ---------------------------------------------------------------------------
+# perf_experiments/fold_gather_overlap -- ISOLATED BAKE-OFF KNOBS (not shipped)
+# ---------------------------------------------------------------------------
+# FOLD_RUNS: 0 = the op's current approach (ONE arrival semaphore, ONE
+# wait(sem == GROUP_SIZE - 1), one whole-window fold).  R > 1 = the PREFIX FOLD:
+# the GATHER_SLOTS ring is cut into R contiguous runs, each with its OWN arrival
+# semaphore (D28's mechanism, WITHOUT the tree's extra NoC hop), the root pushes
+# each run the moment it is complete and compute folds it into the SAME DEST
+# window across the waits.  Legal only on the FLAT (non-tree) combine, and only
+# when R divides GATHER_SLOTS into EVEN runs (the pairwise DEST walk halves a run).
+FOLD_RUNS = int(os.environ.get("RMS_FOLD_RUNS", "0"))
+LAST_FOLD_RUNS = 0
+# MCAST_NO_COPY: the root's stat multicast reads STRAIGHT out of cb_stat_handoff
+# instead of first copying it into the landing page (option (d)).
+MCAST_NO_COPY = os.environ.get("RMS_MCAST_NO_COPY", "0") not in ("", "0")
+# ABLATION (perf ceiling only -- the op is WRONG with it on): strip the root fold's
+# payload while keeping every CB handshake and trip count.  Its whole-op delta is the
+# ABSOLUTE CEILING on what hiding the fold in the arrival shadow could ever buy.
+# FOLD_NOPIPE: keep the R per-run semaphores and the R CB publishes, but do EVERY wait
+# before ANY push -- i.e. the prefix fold's COST with none of its overlap.  This is the
+# control that prices the per-publish overhead against the fold work it hides.
+FOLD_NOPIPE = os.environ.get("RMS_FOLD_NOPIPE", "0") not in ("", "0")
+ABLATE_ROOT_SUM = os.environ.get("RMS_ABLATE_ROOT_SUM", "0") not in ("", "0")

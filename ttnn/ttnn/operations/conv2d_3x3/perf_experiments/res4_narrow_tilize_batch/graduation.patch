+// One-tile-wide tap blocks (C_slice 32: res4.x's padded-slab prelude, tap-direct / FIFO preludes at c_in_tiles 1), up to
+// NARROW_TILIZE_BATCH per DEST section (a fp32 half-sync section holds 4 tiles) with one CB reserve / push per section:
+// each tile is the per-tile unpack tilize of its source into DEST tile j, then one pass packs the section's tiles at
+// consecutive output offsets. Same tiles, same order as one section per tile (bit-identical).
+// Raw LLK on a measured win, as the per-tile loop it replaces (compute_kernel_lib::tilize reads at the CB read pointer
+// and, at block width 1, runs tilize_block: one DEST section, math/pack handshake and CB sync per tile). The BH 1-wide
+// tilize is pack-bound (its pack MOP is 32 two-interface PACRs per tile); one section per tile adds the section release
+// and handshake to every tile: 58.1 -> 42.2 ns/tile isolated (1 core, bf16 -> bf8_b, fp32 DEST), res4.x @ LoFi
+// compute_tilize (pack) 2.49 -> 1.87 us, op 13.50 -> 12.83 us (Blackhole p150b).
+constexpr uint32_t NARROW_TILIZE_BATCH = 4;
+template <uint32_t cb_in, uint32_t cb_out>
+struct NarrowTilizeBatch {
+    DataflowBuffer& out;
+    uint32_t j = 0;  // tiles in the open DEST section
+
+    ALWI void tile([[maybe_unused]] uint32_t src) {
+        if (j == 0) {
+            MATH((llk_math_wait_for_dest_available()));
+            PACK((llk_packer_wait_for_math_done()));
+        }
+        UNPACK((direct_unpack_tilize<cb_in>(src)));
+        MATH((llk_math_eltwise_unary_datacopy<DataCopyType::A2D, DST_ACCUM_MODE, BroadcastType::NONE, UnpackToDestEn>(
+            j, cb_in)));
+        if (++j == NARROW_TILIZE_BATCH) {
+            close();
+        }
+    }
+
+    // Packs and pushes the open section (no-op when none is open). Call before any other push to cb_out.
+    ALWI void close() {
+        if (j == 0) {
+            return;
+        }
+        out.reserve_back(j);
+        for (uint32_t i = 0; i < j; ++i) {
+            PACK((llk_pack<DST_ACCUM_MODE, true, PackMode::Default>(i, cb_out, i)));
+        }
+        MATH((llk_math_dest_section_done<DST_ACCUM_MODE>()));
+        PACK((llk_pack_dest_section_done<DST_ACCUM_MODE>()));
+        out.push_back(j);
+        j = 0;
+    }
+};

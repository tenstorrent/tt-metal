--- a/tests/ttnn/unit_tests/operations/conv2d_3x3/test_conv2d_3x3_kw_fold.py
+++ b/tests/ttnn/unit_tests/operations/conv2d_3x3/test_conv2d_3x3_kw_fold.py
@@ -210,3 +210,106 @@ def test_conv2d_3x3_kw_fold_halo_exchange(case, device, monkeypatch):
     ref = ref.permute(0, 2, 3, 1).reshape(1, 1, -1, c_out)
     pcc = 0.997 if dtype == weight_dtype == ttnn.bfloat16 else 0.99
     assert_with_pcc(ref, exchanged.reshape(ref.shape), pcc)
+
+
+# Round 0 from a self-reading partner (WEIGHT_SERVER_R0_SELF_READ, _r0_partner_self_read, conv2d_3x3_weight_server_
+# writer.cpp): the partner's writer reads its part of round 0 on NoC0 and the first server takes WEIGHT_SERVER_R0_SHARE
+# of round 0's slot rows. Forced on every partner here, it must match the halves read by the partners' readers bit for
+# bit, on a program-cache hit too. Chunk rows (C_in tiles) 1 (the split falls inside a slot row), 2 (the partner holds
+# no row of chunk 0), 3, 4, 5 and 8, whole-K and K-blocked (fused side rounds at C_out 64), several M-blocks per core;
+# and the 103-core layer geometry, where the rule itself picks the self-read.
+# (id, H, W, C_in, C_out, cores, forced)
+R0_CASES = [
+    ("cin32_whole_k", 64, 128, 32, 64, 32, True),
+    ("cin64", 32, 64, 64, 64, 16, True),
+    ("cin96", 32, 64, 96, 64, 16, True),
+    ("cin128_kblocked", 32, 64, 128, 128, 16, True),
+    ("cin160", 32, 64, 160, 128, 16, True),
+    ("cin256_n2_kblocked", 32, 64, 256, 64, 16, True),
+    ("multiblock", 64, 128, 64, 64, 8, True),
+    ("rule_103_cores", 128, 256, 128, 128, 103, False),
+]
+
+
+@pytest.mark.parametrize("case", R0_CASES, ids=[c[0] for c in R0_CASES])
+def test_conv2d_3x3_kw_fold_round0_self_read(case, device, monkeypatch):
+    _, H, W, c_in, c_out, cores, forced = case
+    grid = device.compute_with_storage_grid_size()
+    m_tiles = H * W // 32
+    per_core = -(-m_tiles // cores)
+    cores = -(-m_tiles // per_core)
+    if cores >= grid.x * grid.y or (not forced and grid.x < 11):
+        pytest.skip(f"{cores} cores leave no spare core on {grid.x}x{grid.y}")
+    memory_config = ttnn.MemoryConfig(
+        ttnn.TensorMemoryLayout.HEIGHT_SHARDED,
+        ttnn.BufferType.L1,
+        ttnn.ShardSpec(
+            ttnn.num_cores_to_corerangeset(cores, grid, row_wise=True),
+            [per_core * 32, c_in],
+            ttnn.ShardOrientation.ROW_MAJOR,
+        ),
+    )
+    taken = []
+    kw_fold_mode = _pd.kw_fold_mode
+    monkeypatch.setattr(_pd, "_kw_fold_pays", lambda *a: True)
+    monkeypatch.setattr(_pd, "kw_fold_mode", lambda *a: taken.append(kw_fold_mode(*a)) or taken[-1])
+    servers = []
+    real_servers = _pd._weight_servers
+    monkeypatch.setattr(_pd, "_weight_servers", lambda *a, **k: servers.append(real_servers(*a, **k)) or servers[-1])
+    self_reads = []
+    real_rule = _pd._r0_partner_self_read
+    monkeypatch.setattr(
+        _pd, "_r0_partner_self_read", lambda *a: self_reads.append(True if forced else real_rule(*a)) or self_reads[-1]
+    )
+
+    torch.manual_seed(0)
+    torch_input = torch.randn(1, 1, H * W, c_in).to(torch.bfloat16)
+    torch_weight = (torch.randn(c_out, c_in, 3, 3) / (3 * c_in**0.5)).to(torch.bfloat16)
+    torch_bias = torch.randn(c_out).to(torch.bfloat16)
+    kwargs = dict(
+        stride=1,
+        padding=1,
+        dilation=1,
+        input_dtype=ttnn.bfloat8_b,
+        input_layout=ttnn.TILE_LAYOUT,
+        weight_dtype=ttnn.bfloat8_b,
+        input_memory_config=memory_config,
+        device=device,
+    )
+    compute_config = ttnn.init_device_compute_kernel_config(
+        device.arch(), math_fidelity=ttnn.MathFidelity.LoFi, fp32_dest_acc_en=True
+    )
+
+    def run():
+        tt_input = ttnn.from_torch(
+            torch_input, dtype=ttnn.bfloat8_b, layout=ttnn.TILE_LAYOUT, device=device, memory_config=memory_config
+        )
+        tt_output = conv2d_3x3(
+            tt_input,
+            prepare_conv2d_weights(torch_weight, **kwargs),
+            input_height=H,
+            input_width=W,
+            bias=prepare_conv2d_bias(torch_bias, **kwargs),
+            padding=1,
+            stride=1,
+            dilation=1,
+            activation="relu",
+            compute_kernel_config=compute_config,
+        )
+        return ttnn.to_torch(tt_output).float()
+
+    self_read = run()
+    again = run()  # program-cache hit
+    assert taken and all(taken), f"kw-fold not taken: {taken}"
+    assert servers and any(p is not None for _, _, p in servers[-1]), f"no partner server: {servers}"
+    assert any(self_reads), "no partner reads round 0 itself"
+    monkeypatch.setattr(_pd, "WEIGHT_SERVER_R0_SELF_READ", False)
+    device.clear_program_cache()
+    halves = run()
+    assert torch.equal(again, self_read), "program-cache re-run differs"
+    assert torch.equal(self_read, halves), f"{int((self_read != halves).sum())} outputs differ from the halves"
+
+    x = torch_input.float().reshape(1, H, W, c_in).permute(0, 3, 1, 2)
+    ref = torch.relu(torch.nn.functional.conv2d(x, torch_weight.float(), torch_bias.float(), padding=1))
+    ref = ref.permute(0, 2, 3, 1).reshape(1, 1, -1, c_out)
+    assert_with_pcc(ref, self_read.reshape(ref.shape), 0.99)

+    cfg_reg_rmw_tensix<TILE_ROW_SET_MAPPING_2_row_set_mapping_0_ADDR32, 0, 0xffffffff>(0x4);
+    cfg_reg_rmw_tensix<TILE_ROW_SET_MAPPING_3_row_set_mapping_0_ADDR32, 0, 0xffffffff>(0xaaaaaaaa);

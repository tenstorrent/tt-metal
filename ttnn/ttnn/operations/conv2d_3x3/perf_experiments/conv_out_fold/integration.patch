+    TTI_STALLWAIT(p_stall::STALL_CFG, p_stall::PACK);
+    cfg_reg_rmw_tensix<PCK_EDGE_TILE_FACE_SET_SELECT_select_ADDR32, 0, 0x1ff>(0x100 | face_table);

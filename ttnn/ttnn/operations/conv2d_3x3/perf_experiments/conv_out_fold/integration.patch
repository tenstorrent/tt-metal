+    cfg_reg_rmw_tensix<TILE_FACE_SET_MAPPING_2_face_set_mapping_0_ADDR32, 0, 0xffffffff>(0x2);
+    cfg_reg_rmw_tensix<TILE_FACE_SET_MAPPING_3_face_set_mapping_0_ADDR32, 0, 0xffffffff>(0x33);

+// accumulation into Interm.
+template <uint32_t in0_cb, uint32_t in1_cb, uint32_t sb_h, uint32_t sb_w, uint32_t k_tiles, uint32_t out_n>
+ALWI void stream_slice_rows(
+    CircularBuffer& in0,
+    CircularBuffer& in1,
+    CircularBuffer& out,
+    uint32_t in1_offset,
+    uint32_t out_base,
+    uint32_t row0,
+    uint32_t rows) {
+    static_assert(out_n % sb_w == 0);
+    const uint32_t out_cb = out.get_cb_id();
+    reconfig_data_format(in1_cb, in0_cb);
+    PACK((pack_reconfig_data_format(out_cb)));
+    ckernel::matmul_block_init(in0_cb, in1_cb, false, sb_w, sb_h, k_tiles);
+    in0.wait_front((row0 + rows) * k_tiles);
+    in1.wait_front(in1_offset + k_tiles * out_n);
+    for (uint32_t r = row0; r < row0 + rows; r += sb_h) {
+        for (uint32_t nsb = 0; nsb < out_n / sb_w; ++nsb) {
+            tile_regs_acquire();
+            uint32_t in0_index = r * k_tiles;
+            uint32_t in1_index = in1_offset + nsb * sb_w;
+            for (uint32_t k = 0; k < k_tiles; ++k) {
+                ckernel::matmul_block(in0_cb, in1_cb, in0_index, in1_index, 0, false, sb_w, sb_h, k_tiles);

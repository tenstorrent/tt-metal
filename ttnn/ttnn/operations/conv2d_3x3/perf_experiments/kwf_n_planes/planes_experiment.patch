+# kw-fold N planes (perf experiment kwf_n_planes): with every core on one M-block (halo exchange) and the input sharded
+# on fewer cores than the device, split C_out into KWF_N_PLANES planes of N / P output column tiles; each plane runs
+# the whole M range on its own cores (contiguous tile-row ranges, its own halo-exchange chain, its own weight servers
+# streaming only its columns), and the writer stores each core's [bm, N / P] block into the pinned output shards. 1:
+# off (HEAD's layout).
+KWF_N_PLANES = 2
+# Planes only where the plane's n-group keeps >= 2 tiles (1-tile n-groups measured +13.7%, Perf 10).
+KWF_PLANES_MIN_GW = 2
+# Plane core order over the device grid: "rows" = row-major runs (plane p = cores [p c, (p + 1) c) row-major).
+KWF_PLANES_LAYOUT = "cols"
+# "split": each plane is its own kw-fold problem (C_out = N / P), with its own weight servers per plane rectangle
+# streaming only its columns. "stream": every core runs kw-fold over all of C_out but computes only its plane's n-group
+# (plane = n-group, N / P = the n-group width); one weight stream (HEAD's sub-rounds, n-group-interleaved) reaches every
+# work core, which pops the other n-groups' rounds unused, so the planes may interleave freely on the grid ("pairs").
+KWF_PLANES_MODE = "stream"
+# Stream mode: weight slots up to this many (every sub-round resident at 3 NG) where L1 permits; 0: kw_fold_plan's.
+KWF_PLANES_WEIGHT_DEPTH = 0
+# Last plan's layout, for the bench's records.
+DEBUG_INFO = {}
+# Experiment ("table" layout): the placement file and the per-core split thresholds it holds.
+KWF_PLANES_TABLE = str(Path(__file__).parent.parent / "layout_annealed.json")
+KWF_PLANES_TABLE_SPLITS = {}
+
+
+@dataclass(frozen=True)
+class KwfPlanes:
+    planes: int
+    n_p: int  # output column tiles per plane
+    g: Conv3x3Geometry  # the plane's geometry (C_out = n_p tiles): kw-fold's planning geometry
+    walk: Conv3x3Blocking  # select_blocking at the plane's split (reader CT K-blocking)
+    kb: Conv3x3Blocking  # the plane's kw-fold blocking
+    cores: tuple  # per plane: its work cores, M order
+    ranges: tuple  # per plane, per core: (first tile-row, tile-rows)
+    stream: bool = False  # KWF_PLANES_MODE "stream"
+
+
+def _kwf_plane_core_order(grid, planes, per_plane):
+    """Per plane, its work cores in M order (each plane >= per_plane cores), or None.
+    "rows": plane p = cores [p c, (p + 1) c) of the device grid, row-major.
+    "cols" (two planes): plane 0 = the rectangle of the first ceil(x / 2) columns down to the rows it needs, plane 1 =
+    the other columns on every row plus, row-major, what it still needs from the rows below plane 0; each walked
+    row-major, so a plane core's tile-rows sit near the input shards that hold them (the shards are row-major on the
+    device grid and both planes advance down the rows at about the shards' rate)."""
+    cores = [ttnn.CoreCoord(x, y) for y in range(grid.y) for x in range(grid.x)]
+    if KWF_PLANES_LAYOUT == "table":
+        # Experiment: a precomputed placement (fill_model.py: plane p's core j at a row-major position, with its split
+        # fill's shard threshold), {"p,j": [position, split]}.
+        import json
+
+        tab = json.load(open(KWF_PLANES_TABLE))
+        counts = [sum(1 for k in tab if int(k.split(",")[0]) == p) for p in range(planes)]
+        if min(counts) < per_plane:
+            return None
+        KWF_PLANES_TABLE_SPLITS.clear()
+        out = []
+        for p in range(planes):
+            pc = []
+            for j in range(counts[p]):
+                c, q = tab[f"{p},{j}"]
+                pc.append(cores[c])
+                KWF_PLANES_TABLE_SPLITS[(cores[c].x, cores[c].y)] = max(q, 0)
+            out.append(pc)
+        return out
+    if KWF_PLANES_LAYOUT == "pairs":
+        # Plane p's core j at row-major position P j + p: the planes' cores for one tile-row range sit side by side,
+        # near the input shards that hold it (stream mode only: the planes are not multicast rectangles).
+        if planes * per_plane > len(cores):
+            return None
+        return [[cores[planes * j + p] for j in range(per_plane)] for p in range(planes)]
+    if KWF_PLANES_LAYOUT == "rows":
+        if planes * per_plane > len(cores):
+            return None
+        return [cores[p * per_plane : (p + 1) * per_plane] for p in range(planes)]
+    if planes != 2:
+        return None
+    w0 = _div_up(grid.x, 2)
+    h0 = _div_up(per_plane, w0)
+    if h0 > grid.y:
+        return None
+    p0 = [c for c in cores if c.x < w0 and c.y < h0]
+    p1 = [c for c in cores if c.x >= w0]
+    rest = [c for c in cores if c.x < w0 and c.y >= h0]
+    if len(p1) < per_plane:
+        need = per_plane - len(p1)
+        if need > len(rest):
+            return None
+        p1 += rest[:need]
+    return [p0, p1]
+
+
+def _kwf_balanced_ranges(m, k):
+    """M tile-rows over k cores, contiguous, at most ceil(m / k) each (the first ones take the extra row)."""
+    r = _div_up(m, k)
+    big = m - k * (r - 1)
+    out, t = [], 0
+    for i in range(k):
+        n = r if i < big else r - 1
+        out.append((t, n))
+        t += n
+    return out
+
+
+# The split fill's shard split point on a plane core (reader arg 7 / writer arg 12, HEAD: the core's own shard index):
+# "grid" = the core's row-major position on the device grid (the shard index it would hold), so shards at earlier grid
+# positions come in on the reader's NoC0 and later ones on the writer's NoC1, the short way as on HEAD; "rows" = the
+# shard of the core's last tile-row.
+KWF_PLANES_SPLIT = "grid"
+
+
+def _kwf_plane_split_shard(core, input_tensor, m_tile_start, actual_m_tiles, input_shard_rows):
+    if KWF_PLANES_LAYOUT == "table":
+        return KWF_PLANES_TABLE_SPLITS[(core.x, core.y)]
+    if KWF_PLANES_SPLIT == "rows":
+        return (m_tile_start + actual_m_tiles - 1) // max(1, input_shard_rows)
+    grid = input_tensor.device().compute_with_storage_grid_size()
+    return core.y * grid.x + core.x
+
+
+def kw_fold_planes(g, kb, input_tensor, has_bias, l1_budget, math_fidelity, out_tile_bytes):
+    """The N-plane layout (KwfPlanes) or None where it does not apply, fit or lower the busiest core's MACs."""
+    if KWF_N_PLANES < 2 or kb is None or g.k_split or not g.sharded_output or not kw_fold_halo_exchange(kb):
+        return None
+    P = KWF_N_PLANES
+    n = g.tensor_n_tiles
+    if n % P or g.c_out != n * TILE:
+        return None
+    n_p = n // P
+    stream = KWF_PLANES_MODE == "stream"
+    if stream:
+        # One plane per n-group of HEAD's kw-fold (K-blocked sub-rounds of gw >= 3 columns: 1 x gw subblocks).
+        if not kw_fold_kblocked(g) or _kw_fold_group(n) != n_p or n_p < 3:
+            return None
+    elif _kw_fold_group(n_p) < KWF_PLANES_MIN_GW:
+        return None
+    grid = input_tensor.device().compute_with_storage_grid_size()
+    total = grid.x * grid.y
+    shard_set = {(c.x, c.y) for c in shard_cores(input_tensor)}
+    if len(shard_set) >= total:
+        return None
+    m = g.tensor_m_tiles
+    for per_plane in range(total // P, 0, -1):
+        rows = _div_up(m, per_plane)
+        if rows * n_p >= kb.core_m_tiles * n:
+            return None  # no fewer row-equivalents on the busiest core
+        used = _div_up(m, rows)
+        plane_cores = _kwf_plane_core_order(grid, P, used)
+        if plane_cores is None:
+            continue
+        work = {(c.x, c.y) for pc in plane_cores for c in pc}
+        spare = [1 for y in range(grid.y) for x in range(grid.x) if (x, y) not in work and (x, y) not in shard_set]
+        if stream:
+            rects = len(_core_range_set([c for pc in plane_cores for c in pc]).ranges())
+        else:
+            rects = sum(len(_core_range_set(pc).ranges()) for pc in plane_cores)
+        if len(spare) < rects:
+            continue
+        if any(_div_up(m, len(pc)) != rows for pc in plane_cores):
+            continue
+        g_p = g if stream else replace(g, c_out=n_p * TILE)
+        try:
+            walk = select_blocking(g_p, (used, 1), l1_budget)
+        except ValueError:
+            return None
+        # The plane's [bm, N / P] output block is a local CB (the output shard stays the input's).
+        kb_p = kw_fold_plan(g_p, walk, has_bias, l1_budget - rows * n_p * out_tile_bytes, math_fidelity)
+        if kb_p is None or not kw_fold_halo_exchange(kb_p) or kb_p.core_m_tiles != rows:
+            return None
+        if stream and _kw_fold_group(g_p.tensor_n_tiles) != n_p:
+            return None
+        if stream and KWF_PLANES_WEIGHT_DEPTH > kb_p.weight_depth:
+            # Deeper weight slots (up to every sub-round resident): the planes consume the stream at different times.
+            for depth in range(min(KWF_PLANES_WEIGHT_DEPTH, kb_p.num_k_blocks), kb_p.weight_depth, -1):
+                deep = replace(kb_p, weight_depth=depth)
+                if _kw_fold_cb_bytes(g_p, deep) <= l1_budget - rows * n_p * out_tile_bytes:
+                    kb_p = deep
+                    break
+        ranges = tuple(tuple(_kwf_balanced_ranges(m, len(pc))) for pc in plane_cores)
+        return KwfPlanes(P, n_p, g_p, walk, kb_p, tuple(tuple(pc) for pc in plane_cores), ranges, stream)
+    return None
+

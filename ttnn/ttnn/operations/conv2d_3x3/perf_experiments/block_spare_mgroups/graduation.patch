+    table = _balance_cost_table(g, cap, sb_h, sb_w, True)
+    cost = [table[a][n - 1] for a, n in ranges]
+    cheapest = sorted(range(len(ranges)), key=lambda i: (cost[i], -i))[:spare]
+    return tuple(sorted(cheapest))

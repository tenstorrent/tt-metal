diff -ruN '--exclude=__pycache__' op_base/kernels/conv2d_3x3_store_split.hpp op_copy/kernels/conv2d_3x3_store_split.hpp
--- op_base/kernels/conv2d_3x3_store_split.hpp	1970-01-01 00:00:00.000000000 +0000
+++ op_copy/kernels/conv2d_3x3_store_split.hpp	2026-11-21 08:20:46.809120389 +0000

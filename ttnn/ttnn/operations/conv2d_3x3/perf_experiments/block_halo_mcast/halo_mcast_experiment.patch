+def halo_mcast_plan(g: Conv3x3Geometry, core_m_tiles, shard_rows, num_shards, ring_rows_max):
+    """HALO_MCAST over grid-row groups (one M-block each): None where it does not apply, else a dict with
+    `need` (per group: its slab plan's input tile-rows), per shard o: `runs` [(row_lo, row_hi, down_last, up_first)]
+    (multicast chains: down to groups o+1..down_last on NoC0, up to up_first..o-1 on NoC1; down_last == o / up_first ==
+    o for none), `down` / `up` (the flag rectangles: farthest group each way), `cover` per group (the covering shards'
+    bit mask, the last covering shard), `S` (ring rows) and `K` (flag semaphores: no two shards covering one group share
+    one)."""
+    ranges = core_m_ranges(g, core_m_tiles)
+    n_rows = _div_up(g.num_in_px, TILE)
+    need = []
+    for start, actual in ranges:
+        o_first = start * TILE
+        o_last = min((start + actual) * TILE, g.num_out_px) - 1
+        segs = _tile_slab_segments(g, _block_first_tap(g, o_first), _block_band_len(g, o_first, o_last))
+        need.append(sorted({t for a, n in segs for t in range(a, a + n)}))
+    groups = len(ranges)
+    readers_of = {}

+            return None
+        got = set(need[r]) if r in cov else set()
+        for o in cov:
+            if o == r:
+                continue
+            for lo_, hi_, d_last, u_first in runs[o]:
+                if (o < r <= d_last) or (u_first <= r < o):
+                    got |= set(range(lo_, hi_))
+        if not set(need[r]) <= got:
+            return None
+        S = max(S, max(got) - min(got) + 1)
+        K = max(K, max(cov) - min(cov) + 1)
+        cover.append((sum(1 << o for o in cov), max(cov)))
+    if S > ring_rows_max or num_shards > 32:
+        return None
+    return dict(need=need, runs=runs, down=down, up=up, cover=cover, S=S, K=K, n_rows=n_rows)

+def _tile_slab_segments(g: Conv3x3Geometry, f, band_len):
+    """(first input tile-row, count) of each segment of one M-block's TILE slab plan (mirror of the reader's
+    tile_slab_plan: a band starting inside the previous band's tile-rows continues it)."""
+    segs = []
+    prev = None
+    for kh in range(3):
+        v_lo = f + kh * g.dilation * g.input_width
+        lo, hi = max(v_lo, 0), min(v_lo + band_len, g.num_in_px)
+        if lo >= hi:
+            continue
+        t_lo, t_hi = lo // TILE, _div_up(hi, TILE)
+        first_new = prev[1] if prev is not None and t_lo < prev[1] else t_lo
+        if t_hi > first_new:
+            segs.append((first_new, t_hi - first_new))
+        prev = (t_lo, t_hi)
+    return segs

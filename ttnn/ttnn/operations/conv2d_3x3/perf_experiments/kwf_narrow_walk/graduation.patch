+// Subblock k of a pass's row range [lo, lo + n): groups of sbh rows; a full group followed by a single row runs as
+// (sbh - 1) + 2 rows instead, so no 1-row subblock flips the matmul operand choice (two re-inits) mid-pass.
+template <uint32_t sbh>
+inline uint32_t row_groups(uint32_t n) {
+    return (n + sbh - 1) / sbh;
+}
+template <uint32_t sbh>
+inline void row_group(uint32_t lo, uint32_t n, uint32_t k, uint32_t& i0, uint32_t& h) {
+    const uint32_t m = row_groups<sbh>(n);
+    if (sbh > 2 && m >= 2 && n % sbh == 1 && k + 2 >= m) {
+        i0 = lo + (m - 2) * sbh + (k + 1 == m ? sbh - 1 : 0);
+        h = k + 1 == m ? 2 : sbh - 1;
+    } else {
+        i0 = lo + k * sbh;
+        h = n - k * sbh < sbh ? n - k * sbh : sbh;
+    }
+}

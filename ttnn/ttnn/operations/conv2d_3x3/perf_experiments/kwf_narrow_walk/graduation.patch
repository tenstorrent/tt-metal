+// One subblock's K steps with compile-time subblock dims: matmul_block given a runtime ct / rt keeps the unpack and math
+// loops over them (and the ct >= rt operand choice) at run time (see the file comment, "Subblock dims").
+template <uint32_t ct, uint32_t rt, uint32_t kt>
+ALWI void matmul_k(uint32_t cb0, uint32_t cb1, uint32_t in0, uint32_t in1, uint32_t in1_step, uint32_t dst) {
+    for (uint32_t c = 0; c < kt; ++c) {
+        matmul_block(cb0, cb1, in0 + c, in1 + c * in1_step, dst, false, ct, rt, kt);
+    }
+}
+// A subblock of `rows` tile-rows (at most sbh; sbh == 1: one row of sbw columns), dispatched to compile-time dims.
+template <uint32_t sbw, uint32_t sbh, uint32_t kt>
+ALWI void matmul_k_rows(
+    uint32_t cb0, uint32_t cb1, uint32_t in0, uint32_t in1, uint32_t in1_step, uint32_t dst, uint32_t rows) {
+    if constexpr (sbh == 1) {
+        matmul_k<sbw, 1, kt>(cb0, cb1, in0, in1, in1_step, dst);
+    } else if (rows == sbh) {
+        matmul_k<sbw, sbh, kt>(cb0, cb1, in0, in1, in1_step, dst);
+    } else if (rows == 3) {
+        matmul_k<sbw, 3, kt>(cb0, cb1, in0, in1, in1_step, dst);
+    } else if (rows == 2) {
+        matmul_k<sbw, 2, kt>(cb0, cb1, in0, in1, in1_step, dst);
+    } else {
+        matmul_k<sbw, 1, kt>(cb0, cb1, in0, in1, in1_step, dst);
+    }
+}

+template <uint32_t cb>
+ALWI uint32_t ring_cb_base() {
+    return get_local_cb_interface(get_operand_id(cb)).fifo_rd_ptr - 1;
+}
+
+template <uint32_t cb>
+ALWI uint32_t ring_cb_tile() {
+    return get_local_cb_interface(get_operand_id(cb)).fifo_page_size;
+}

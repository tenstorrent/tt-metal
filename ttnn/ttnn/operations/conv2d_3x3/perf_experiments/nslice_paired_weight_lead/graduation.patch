+// N-slice-outer walk, raw LLK.
+//   HELPER BYPASS: compute_kernel_lib::matmul_block runs one subblock shape per call, and that shape must divide the
+// block (width first). An owner slice of bm 7 x out_n 2 (res5.x) therefore only gets 1 x 2 subblocks: the BH matmul
+// unpacker reads rt + rt * ct tiles per k-step when ct >= rt (ct + ct * rt otherwise), 1.5 tile unpacks per tile-MAC,
+// and the walk ran at 19.5 cycles per tile-MAC. 4-long subblocks with a shorter last group (4 + 3 rows) cost 1.25 /
+// 1.33: 17.5 cycles per tile-MAC. This is the helper's LLK sequence (matmul_block_init, per-k ckernel::matmul_block
+// over the same K order, pack_tile<true> to absolute offsets), so the output is bit-identical, with a re-init where the
+// subblock length changes. Measured (Blackhole p150b, LoFi, DEVICE KERNEL DURATION, medians): res5.1 45.4 -> 42.2 us,
+// res5.2 45.4 -> 42.0 us (walk 30.3 -> 26.9 us). Flat: res5 at HiFi4 (math-bound) and the out_n 1 shapes (already
+// 4 x 1).
+//
+// Rows [r0, r0 + rt) x columns [c0, c0 + ct) of the resident [bm, K] in0 times the slice's compact [K, out_n] weights
+// at the weights CB's read pointer, the whole K accumulated in DEST, packed to cb_out at the slice's tile-row-major
+// offsets. The caller inits for (ct, rt), reserves / pushes cb_out and waits / pops the weights.
+template <uint32_t K, uint32_t out_n>
+ALWI void nslice_subblock(
+    uint32_t cb_in0, uint32_t cb_w, uint32_t cb_out, uint32_t r0, uint32_t rt, uint32_t c0, uint32_t ct) {
+    tile_regs_acquire();
+    for (uint32_t k = 0; k < K; ++k) {
+        ckernel::matmul_block(cb_in0, cb_w, r0 * K + k, k * out_n + c0, 0, false, ct, rt, K);
+    }
+    tile_regs_commit();
+    tile_regs_wait();
+    for (uint32_t rr = 0; rr < rt; ++rr) {
+        for (uint32_t cc = 0; cc < ct; ++cc) {
+            pack_tile<true>(rr * ct + cc, cb_out, (r0 + rr) * out_n + c0 + cc);
+        }
+    }
+    tile_regs_release();
+}
+
+// One owner slice in subblocks 4 tiles long (or the whole side, if shorter) along the slice's longer side: rt 4 x ct 1
+// (the unpacker reuses each weight tile across 4 in0 rows) when bm allows at least as long a run as out_n, else 1 x 4.
+// The last group along that side may be shorter. Each slice first runs at the length the previous one ended on, so the
+// init changes at most once per slice. cur_len: the current init's length, 0 before the first.
+template <uint32_t bm, uint32_t K, uint32_t out_n>
+ALWI void nslice_slice_walk(uint32_t cb_in0, uint32_t cb_w, uint32_t cb_out, uint32_t& cur_len) {
+    constexpr uint32_t tall_len = bm < 4 ? bm : 4;
+    constexpr uint32_t wide_len = out_n < 4 ? out_n : 4;
+    constexpr bool tall = tall_len >= wide_len;
+    constexpr uint32_t len = tall ? tall_len : wide_len;
+    constexpr uint32_t extent = tall ? bm : out_n;
+    constexpr uint32_t other = tall ? out_n : bm;
+    constexpr uint32_t full_groups = extent / len;
+    constexpr uint32_t ragged = extent % len;
+    auto run_length = [&](uint32_t l) {
+        if (l != cur_len) {
+            ckernel::matmul_block_init(cb_in0, cb_w, false, tall ? 1 : l, tall ? l : 1, K);
+            cur_len = l;
+        }
+        const uint32_t g_begin = l == len ? 0 : full_groups;
+        const uint32_t g_end = l == len ? full_groups : full_groups + 1;
+        for (uint32_t o = 0; o < other; ++o) {
+            for (uint32_t g = g_begin; g < g_end; ++g) {
+                if constexpr (tall) {
+                    nslice_subblock<K, out_n>(cb_in0, cb_w, cb_out, g * len, l, o, 1);
+                } else {
+                    nslice_subblock<K, out_n>(cb_in0, cb_w, cb_out, o, 1, g * len, l);
+                }
+            }
+        }
+    };
+    if constexpr (ragged == 0) {
+        run_length(len);
+    } else if (cur_len == ragged) {
+        run_length(ragged);
+        run_length(len);
+    } else {
+        run_length(len);
+        run_length(ragged);
+    }
+}

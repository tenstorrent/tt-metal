+# SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+# SPDX-License-Identifier: Apache-2.0
+
+"""conv2d_3x3 stride-2 taps from DEST (the descriptor's S2_TAPS: stride 2, padding 1, dilation 1, TILE input,
+W % 64 == 0): compute builds every im2col tap tile straight from the input's TILE slab, with no untilize, window
+gather or strided tilize.
+
+- every walk it runs on: HEIGHT K-blocked (whole-row and two-row blocks, the image's top / bottom edges with odd H),
+  BLOCK N-slice ring (kernel-row skip), DRAM interleaved; bf8_b and bf16; several M-blocks per core (forced).
+- bit-identical to the untilize / window gather / strided tilize prelude (S2_TAPS = False) on every case, and the
+  fp32 torch conv within PCC.
+"""
+
+import importlib
+
+import pytest
+import ttnn
+
+from tests.ttnn.utils_for_testing import assert_with_pcc
+
+_op_module = importlib.import_module("ttnn.operations.conv2d_3x3.conv2d_3x3")
+_pd = importlib.import_module("ttnn.operations.conv2d_3x3.conv2d_3x3_program_descriptor")
+
+PCC = {ttnn.bfloat16: 0.997, ttnn.bfloat8_b: 0.99}
+
+# (id, ((H, W, C_in), C_out), memory layout, shard shape, grid (num cores row-major or (x, y)), dtype, M-block cap)
+CASES = [
+    ("height_rows", ((32, 64, 128), 128), "height", [256, 128], 8, ttnn.bfloat8_b, None),
+    ("height_rows_bf16", ((32, 64, 128), 128), "height", [256, 128], 8, ttnn.bfloat16, None),
+    # odd H: the last output row's kernel row 2 is below the image; 3 tile-rows per core cross output rows
+    ("height_odd_h", ((33, 64, 64), 64), "height", [352, 64], 6, ttnn.bfloat8_b, None),
+    ("height_w128_two_rows", ((16, 128, 64), 96), "height", [192, 64], 11, ttnn.bfloat8_b, None),
+    ("block_nslice", ((32, 128, 256), 256), "block", [1024, 32], (8, 4), ttnn.bfloat8_b, None),
+    ("block_nslice_bf16", ((32, 64, 128), 128), "block", [512, 32], (4, 4), ttnn.bfloat16, None),
+    ("dram", ((32, 64, 128), 128), "dram", None, None, ttnn.bfloat8_b, None),
+    ("height_mblocks", ((64, 128, 128), 128), "height", [1024, 128], 8, ttnn.bfloat8_b, 2),
+]
+
+
+def _grid(num_cores, grid_x):
+    full_rows, rem = divmod(num_cores, grid_x)
+    ranges = []
+    if full_rows:
+        ranges.append(ttnn.CoreRange(ttnn.CoreCoord(0, 0), ttnn.CoreCoord(grid_x - 1, full_rows - 1)))
+    if rem:
+        ranges.append(ttnn.CoreRange(ttnn.CoreCoord(0, full_rows), ttnn.CoreCoord(rem - 1, full_rows)))
+    return ttnn.CoreRangeSet(ranges)
+
+
+def _memory_config(device, layout, shard, grid):
+    if layout == "dram":
+        return ttnn.DRAM_MEMORY_CONFIG
+    if layout == "height":
+        core_grid = _grid(grid, device.compute_with_storage_grid_size().x)
+        return ttnn.MemoryConfig(
+            ttnn.TensorMemoryLayout.HEIGHT_SHARDED,
+            ttnn.BufferType.L1,
+            ttnn.ShardSpec(core_grid, shard, ttnn.ShardOrientation.ROW_MAJOR),
+        )
+    gx, gy = grid
+    return ttnn.MemoryConfig(
+        ttnn.TensorMemoryLayout.BLOCK_SHARDED,
+        ttnn.BufferType.L1,
+        ttnn.ShardSpec(
+            ttnn.CoreRangeSet([ttnn.CoreRange(ttnn.CoreCoord(0, 0), ttnn.CoreCoord(gx - 1, gy - 1))]),
+            shard,
+            ttnn.ShardOrientation.ROW_MAJOR,
+        ),
+    )
+
+
+def _run(shape, dtype, memory_config, device, torch_input, torch_weight, torch_bias):
+    (H, W, c_in), c_out = shape
+    kwargs = dict(
+        stride=2,
+        padding=1,
+        dilation=1,
+        input_dtype=dtype,
+        input_layout=ttnn.TILE_LAYOUT,
+        weight_dtype=ttnn.bfloat8_b,
+        input_memory_config=memory_config,
+        device=device,
+    )
+    tt_weight = _op_module.prepare_conv2d_weights(torch_weight, **kwargs)
+    tt_bias = _op_module.prepare_conv2d_bias(torch_bias, **kwargs)
+    tt_input = ttnn.from_torch(
+        torch_input, dtype=dtype, layout=ttnn.TILE_LAYOUT, device=device, memory_config=memory_config
+    )
+    tt_output = _op_module.conv2d_3x3(
+        tt_input,
+        tt_weight,
+        input_height=H,
+        input_width=W,
+        bias=tt_bias,
+        padding=1,
+        stride=2,
+        dilation=1,
+        activation="relu",
+    )
+    return ttnn.to_torch(tt_output).float(), ttnn.to_torch(tt_input).float()
+
+
+@pytest.mark.parametrize("case", CASES, ids=[c[0] for c in CASES])
+def test_conv2d_3x3_stride2_taps(case, device, monkeypatch):
+    import torch
+
+    _, shape, layout, shard, grid, dtype, m_block_cap = case
+    (H, W, c_in), c_out = shape
+    if layout == "block" and (grid[0] > device.compute_with_storage_grid_size().x):
+        pytest.skip("shard grid does not fit")
+    torch.manual_seed(0)
+    torch_input = torch.randn(1, 1, H * W, c_in).to(torch.bfloat16)
+    torch_weight = torch.randn(c_out, c_in, 3, 3).to(torch.bfloat16)
+    torch_bias = torch.randn(c_out).to(torch.bfloat16)
+    memory_config = _memory_config(device, layout, shard, grid)
+
+    taken = []
+    real_capable = _pd.s2_taps_capable
+    monkeypatch.setattr(_pd, "s2_taps_capable", lambda g: taken.append(real_capable(g)) or taken[-1])
+    if m_block_cap is not None:
+        # Several M-blocks per core with one K-block per kernel row: the solve rejects larger blocks.
+        real_footprint = _pd._footprint
+
+        def capped(g, core_m_tiles, bm, bk, *args, **kwargs):
+            fit = real_footprint(g, core_m_tiles, bm, bk, *args, **kwargs)
+            if bm > m_block_cap or bk < g.tensor_kkh_tiles:
+                fit = dict(fit, footprint_bytes=1 << 40)
+            return fit
+
+        monkeypatch.setattr(_pd, "_footprint", capped)
+
+    outputs = {}
+    for s2 in (True, False):
+        monkeypatch.setattr(_pd, "S2_TAPS", s2)
+        device.disable_and_clear_program_cache()
+        outputs[s2], x = _run(shape, dtype, memory_config, device, torch_input, torch_weight, torch_bias)
+    assert taken and taken[0], "the stride-2 DEST taps were not taken"
+
+    ref = torch.nn.functional.conv2d(
+        x.reshape(1, H, W, c_in).permute(0, 3, 1, 2), torch_weight.float(), torch_bias.float(), stride=2, padding=1
+    )
+    ref = torch.relu(ref).permute(0, 2, 3, 1).reshape(1, 1, -1, c_out)
+    assert_with_pcc(ref, outputs[True].reshape(ref.shape), PCC[dtype])
+    differ = int((outputs[True] != outputs[False]).sum())
+    assert differ == 0, f"{differ} outputs differ from the untilize / window tilize prelude"

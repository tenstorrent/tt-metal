+// kw-fold (conv2d_3x3_kw_fold.hpp) TILE slab plan: tile_slab_plan's placement (compute's slab_bases mirrors it), but
+// each band's segment holds only the input tile-rows compute reads. Its walk covers tile-rows [lo, hi) = [t0 - ht,
+// t_end + hb), the halo tile-row on a side only where it recomputes it (a block boundary inside an image row, without
+// the halo exchange), and reads row t + (kh - 1) R of each: band kh's live rows are [lo + (kh - 1) R, hi + (kh - 1) R).
+// The footprint rounds every band out by one tile-row on each side (the d-pixel tap reach), so where the halo is
+// exchanged or not needed (a boundary on an image-row edge) up to six slab rows are dead: the fill skips them, their
+// slots stay unwritten and are never read, and the batch pushes (compute's cumulative slab waits) are unchanged.
+// seg_slab[s] is the slab row of seg_first[s]; segments ascend in both. One pass like tile_slab_plan's: planning cost
+// is on the fill's critical start (a separate split of the plan at the dead rows measured ~0.3 us there).
+struct KwfSlabPlan {
+    uint32_t seg_first[3];
+    uint32_t seg_count[3];
+    uint32_t seg_slab[3];
+    uint32_t num_segs;
+};
+
+template <int32_t input_width, int32_t num_in_px, int32_t dilation, bool xchg>
+FORCE_INLINE void kwf_slab_plan(
+    const SlabFootprint& fp, uint32_t t0, uint32_t valid, int32_t (&slab_x_base)[3], KwfSlabPlan& plan) {
+    constexpr int32_t TILE_DIM = 32;
+    constexpr int32_t tpr = input_width / TILE_DIM;
+    constexpr int32_t R = dilation * tpr;
+    // kw_fold.hpp run(): halo_top / halo_bot (the exchange runs on one M-block per core and then replaces both).
+    const int32_t t_end = static_cast<int32_t>(t0 + valid);
+    const int32_t live_lo = static_cast<int32_t>(t0) - (!xchg && t0 % tpr != 0 ? 1 : 0);
+    const int32_t live_hi = t_end + (!xchg && t_end % tpr != 0 && t_end < num_in_px / TILE_DIM ? 1 : 0);
+    uint32_t n = 0;
+    int32_t next_free = 0;
+    int32_t read_hi = 0;  // one past the last live row an earlier band holds
+    bool have_prev = false;
+    int32_t prev_t_lo = 0, prev_t_hi = 0, prev_row = 0;
+    for (int32_t kh = 0; kh < 3; ++kh) {
+        const int32_t v_lo = fp.f + kh * dilation * input_width;
+        const int32_t lo = v_lo > 0 ? v_lo : 0;
+        const int32_t hi = v_lo + fp.band_len < num_in_px ? v_lo + fp.band_len : num_in_px;
+        if (lo >= hi) {
+            slab_x_base[kh] = 0;
+            continue;
+        }
+        const int32_t t_lo = lo / TILE_DIM;
+        const int32_t t_hi = (hi + TILE_DIM - 1) / TILE_DIM;
+        const bool shares = have_prev && t_lo < prev_t_hi;
+        const int32_t row = shares ? prev_row + (t_lo - prev_t_lo) : next_free;
+        int32_t a = live_lo + (kh - 1) * R;
+        a = a > t_lo ? a : t_lo;
+        a = a > read_hi ? a : read_hi;
+        int32_t b = live_hi + (kh - 1) * R;
+        b = b < t_hi ? b : t_hi;
+        if (a < b) {
+            const uint32_t slab = static_cast<uint32_t>(row + (a - t_lo));
+            if (n > 0 && plan.seg_first[n - 1] + plan.seg_count[n - 1] == static_cast<uint32_t>(a) &&
+                plan.seg_slab[n - 1] + plan.seg_count[n - 1] == slab) {
+                plan.seg_count[n - 1] += b - a;  // contiguous in the input and in the slab: one segment
+            } else {
+                plan.seg_first[n] = a;
+                plan.seg_count[n] = b - a;
+                plan.seg_slab[n] = slab;
+                ++n;
+            }
+            read_hi = b;
+        }
+        slab_x_base[kh] = TILE_DIM * (row - t_lo);
+        next_free = row + (t_hi - t_lo);
+        have_prev = true;
+        prev_t_lo = t_lo;
+        prev_t_hi = t_hi;
+        prev_row = row;
+    }
+    plan.num_segs = n;
+}
+
+// tile_batch_rows over a KwfSlabPlan (explicit slab rows).
+template <uint32_t batch_rows, typename Fn>
+FORCE_INLINE void kwf_batch_rows(const KwfSlabPlan& plan, uint32_t batch, Fn&& fn) {
+    const uint32_t b_lo = batch * batch_rows;
+    const uint32_t b_hi = b_lo + batch_rows;
+    for (uint32_t s = 0; s < plan.num_segs; ++s) {
+        const uint32_t seg_lo = plan.seg_slab[s];
+        const uint32_t seg_hi = seg_lo + plan.seg_count[s];
+        const uint32_t lo = b_lo > seg_lo ? b_lo : seg_lo;
+        const uint32_t hi = b_hi < seg_hi ? b_hi : seg_hi;
+        if (lo < hi) {
+            fn(plan.seg_first[s] + (lo - seg_lo), hi - lo, lo - b_lo);
+        }
+    }
+}
+
+// slab_rows_from over a KwfSlabPlan: the first slab row holding a live row >= hi_row, one past the last live slab row
+// (a batch of dead rows only is not handed over).
+FORCE_INLINE SlabSuffix kwf_slab_rows_from(const KwfSlabPlan& plan, uint32_t hi_row) {
+    uint32_t first = 0xFFFFFFFF;
+    uint32_t end = 0;
+    for (uint32_t s = 0; s < plan.num_segs; ++s) {
+        if (first == 0xFFFFFFFF && plan.seg_first[s] + plan.seg_count[s] > hi_row) {
+            first = plan.seg_slab[s] + (hi_row > plan.seg_first[s] ? hi_row - plan.seg_first[s] : 0);
+        }
+        end = plan.seg_slab[s] + plan.seg_count[s];
+    }
+    return {first < end ? first : end, end};
+}

+def _resident_weights(g: Conv3x3Geometry, fit, bk, bn, l1_budget):
+    """The deepest cb_weights, up to num_k_blocks rounds of bk * bn tiles, that the L1 left in `fit` allows (see
+    WEIGHT_DEPTH). K-blocked walk only; the N-slice walk keeps NSLICE_WEIGHT_DEPTH."""
+    if fit["nslice"]:
+        return fit
+    target = min(fit["num_k_blocks"] * fit["max_m_blocks_per_core"], fit["num_k_blocks"], RESIDENT_WEIGHT_MAX_DEPTH)
+    round_bytes = bk * bn * g.weight_tile_bytes
+    for depth in range(target, fit["weight_depth"], -1):
+        extra = (depth - fit["weight_depth"]) * round_bytes
+        if fit["footprint_bytes"] + extra <= l1_budget:
+            return dict(fit, weight_depth=depth, footprint_bytes=fit["footprint_bytes"] + extra)
+    return fit
+

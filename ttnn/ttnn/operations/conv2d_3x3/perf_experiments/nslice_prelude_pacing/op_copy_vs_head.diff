+                src = zero_l1;
+            } else if (one_run && w_lo0 >= 0 && w_lo0 + n <= input_width) {
+                src = slab_l1 + static_cast<uint32_t>(slab_x_base_kh + h_in0 * input_width + w_lo0) * pixel_bytes;

+    invalidate_l1_cache();
+    const uint32_t table = get_local_cb_interface(get_operand_id(cb_table)).fifo_rd_ptr << 4;
+    volatile uint32_t* entry = reinterpret_cast<volatile uint32_t*>(table + slot * 16);
+    for (uint32_t t = 0; t < taps; ++t) {

+    def kid(k):
+        return keys.setdefault(k, len(keys))
+
+    res = []  # per piece and NoC: the resources one row of it loads
+    for ri, oy, _ in pieces:
+        res.append(
+            [
+                [kid(("inj", noc, oy)), kid(("ej", noc, ri))]
+                + [kid(("link", noc, y)) for y in _ring_links(oy, ry_of[ri], noc, ring)]
+                for noc in (0, 1)
+            ]
+        )

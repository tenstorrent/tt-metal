+        for k in res[i][0]:
+            load[k] += n - x1[i]
+        for k in res[i][1]:
+            load[k] += x1[i]
+    while True:
+        best, best_i, best_d = 0, -1, 0
+        for i, (_, _, n) in enumerate(pieces):
+            for d, frm, to in ((1, 0, 1), (-1, 1, 0)):
+                if not 0 <= x1[i] + d <= n:
+                    continue
+                delta = 0
+                for k in res[i][frm]:
+                    v = load[k]
+                    delta += (v - 1) ** 8 - v**8
+                for k in res[i][to]:
+                    v = load[k]
+                    delta += (v + 1) ** 8 - v**8

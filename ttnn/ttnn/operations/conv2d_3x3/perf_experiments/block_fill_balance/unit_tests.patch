+@pytest.mark.parametrize("case_hw,shard,orientation,expect_gate,expect_long_way", FILL_BALANCE_CASES)
+def test_conv2d_3x3_block_sharded_fill_balance(
+    case_hw, shard, orientation, expect_gate, expect_long_way, device, monkeypatch
+):
+    """BLOCK_FILL_BALANCE / BLOCK_FILL_GATE: per column, slab rows of any (core, owner) piece moved between the reader
+    (NoC0) and the writer (NoC1), either way round the column ring, and each RISC issuing the first kernel row's band
+    before the rest, the reader counting the writer's landed batches from NoC1's transaction-id counters; both only
+    where the kernel-row bands are disjoint. Bit-identical to the direction split without the gate, and each mechanism
+    taken where expected."""
+    torch.manual_seed(17)
+    grid = device.compute_with_storage_grid_size()
+    if (grid.x, grid.y) != (11, 10):
+        pytest.skip("pinned to the 11 x 10 grid")
+    (H, W, c_in), c_out, p, s, d = case_hw
+    dtype, layout = ttnn.bfloat8_b, ttnn.TILE_LAYOUT
+    config = _block_config(H * W, c_in, layout, shard, orientation=orientation)
+    torch_weight = torch.randn(c_out, c_in, 3, 3).to(torch.bfloat16)
+    torch_bias = torch.randn(c_out).to(torch.bfloat16)
+    torch_input = torch.randn(1, 1, H * W, c_in).to(torch.bfloat16)
+    real_args, real_balance = _pd._host_fill_args, _pd._balance_fill_nocs
+    gates, long_way = [], []
+
+    def recording_args(*args, **kwargs):
+        reader, writer = real_args(*args, **kwargs)
+        gates.append((reader[0] >> 24) & 0x3F)
+        return reader, writer
+
+    def recording_balance(column, ring, background=None):
+        out = real_balance(column, ring, background)
+        # Writer rows from owners above the reader: NoC1 the long way round the column.
+        long_way.extend(k for (ry, lst), xs in zip(column, out) for (oy, _), k in zip(lst, xs) if oy < ry and k)
+        return out
+
+    monkeypatch.setattr(_pd, "_host_fill_args", recording_args)
+    monkeypatch.setattr(_pd, "_balance_fill_nocs", recording_balance)
+    outputs = {}
+    for on in (True, False):
+        monkeypatch.setattr(_pd, "BLOCK_FILL_BALANCE", on)
+        monkeypatch.setattr(_pd, "BLOCK_FILL_GATE", on)
+        device.disable_and_clear_program_cache()
+        gates.clear()
+        long_way.clear()
+        kwargs = dict(
+            stride=s,
+            padding=p,
+            dilation=d,
+            input_dtype=dtype,
+            input_layout=layout,
+            weight_dtype=ttnn.bfloat8_b,
+            input_memory_config=config,
+            device=device,
+        )
+        tt_weight = prepare_conv2d_weights(torch_weight, **kwargs)
+        tt_bias = prepare_conv2d_bias(torch_bias, **kwargs)
+        tt_input = ttnn.from_torch(torch_input, dtype=dtype, layout=layout, device=device, memory_config=config)
+        tt_output = conv2d_3x3(
+            tt_input,
+            tt_weight,
+            input_height=H,
+            input_width=W,
+            bias=tt_bias,
+            padding=p,
+            stride=s,
+            dilation=d,
+            activation="relu",
+            compute_kernel_config=ttnn.ComputeConfigDescriptor(
+                math_fidelity=ttnn.MathFidelity.LoFi, fp32_dest_acc_en=True, math_approx_mode=False
+            ),
+        )
+        outputs[on] = ttnn.to_torch(tt_output).float()
+        assert gates, "host-planned fill not taken"
+        if on:
+            assert (max(gates) > 0) == expect_gate, f"gate taken: {max(gates) > 0}, expected {expect_gate}"
+            if expect_long_way and device.arch() == ttnn._ttnn.device.Arch.BLACKHOLE:
+                assert long_way, "the balance moved no row onto NoC1 the long way round"
+        else:
+            assert max(gates) == 0 and not long_way
+    assert torch.equal(outputs[True], outputs[False]), "the balanced, gated fill differs from the direction split"
+    expected = _reference(torch_input, torch_weight, torch_bias, H, W, p, s, d, True)
+    assert_with_pcc(expected, outputs[True], PCC[ttnn.bfloat8_b])

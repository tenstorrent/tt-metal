+// pack_reconfig_data_format(cb) with the CB's formats and tile shape folded at compile time: the same register writes
+// as reconfig_packer_data_format (tt_llk_blackhole common/inc/cpack_common.h), whose generic form is noinline and
+// builds every RMW at run time (~200 cycles on the final pass's critical path, against ~50 here).
+template <uint32_t cb>
+inline void pack_reconfig_const(uint32_t tile_size) {
+    constexpr uint32_t src = pack_src_format[cb];
+    constexpr uint32_t dst = pack_dst_format[cb];
+    constexpr uint32_t out_src = masked_data_format(src);
+    constexpr uint32_t out_dst = masked_data_format(dst);
+    constexpr bool fp8 = (dst & 0x1F) == to_underlying(DataFormat::Fp8_e4m3);
+    constexpr uint32_t hw_src = fp8 ? to_underlying(DataFormat::Float16) : out_src;
+    constexpr uint32_t num_faces = pack_tile_num_faces[cb];
+    constexpr uint32_t tile_c_dim = pack_tile_c_dim[cb];
+    pack_config_u config;
+    config.val[2] = 0;
+    config.f.uncompress = 1;
+    config.f.out_data_format = out_dst;
+    config.f.in_data_format = hw_src;
+    TT_SETDMAREG(0, LOWER_HALFWORD(config.val[2]), 0, LO_16(p_gpr_pack::TMP_LO));
+    TTI_STALLWAIT(p_stall::STALL_CFG, p_stall::PACK | p_stall::THCON);
+    TTI_WRCFG(p_gpr_pack::TMP_LO, p_cfg::WRCFG_32b, THCON_SEC0_REG1_Row_start_section_size_ADDR32 + 2);
+    constexpr bool is_32b = src == to_underlying(DataFormat::Int32) || src == to_underlying(DataFormat::UInt32) ||
+                            src == to_underlying(DataFormat::Float32);
+    constexpr bool is_int8 = src == to_underlying(DataFormat::Int8) || src == to_underlying(DataFormat::UInt8);
+    dest_rd_ctrl_u dest_rd_ctrl;
+    dest_rd_ctrl.val = 0;
+    dest_rd_ctrl.f.PCK_DEST_RD_CTRL_Read_32b_data = is_32b || DST_ACCUM_MODE;
+    dest_rd_ctrl.f.PCK_DEST_RD_CTRL_Read_int8 = !(DST_ACCUM_MODE || is_32b) && is_int8;
+    if constexpr (dst == to_underlying(DataFormat::UInt8)) {
+        dest_rd_ctrl.f.PCK_DEST_RD_CTRL_Read_unsigned = 1;
+    }
+    if constexpr ((DST_ACCUM_MODE && src == to_underlying(DataFormat::Float16)) || (!IS_A_FORMAT(src) && fp8)) {
+        dest_rd_ctrl.f.PCK_DEST_RD_CTRL_Round_10b_mant = 1;
+    }
+    cfg_reg_rmw_tensix<
+        PCK_DEST_RD_CTRL_Read_32b_data_ADDR32,
+        PCK_DEST_RD_CTRL_Read_32b_data_SHAMT,
+        PCK_DEST_RD_CTRL_FIELDS_MASK>(dest_rd_ctrl.val);
+    if constexpr (IS_BFP_FORMAT(out_dst)) {
+        cfg_reg_rmw_tensix<THCON_SEC0_REG1_Exp_section_size_RMW>(num_faces);
+    } else if constexpr (out_dst == to_underlying(DataFormat::Lf8) || out_dst == to_underlying(DataFormat::Int8)) {
+        TTI_WRCFG(p_gpr::ZERO, p_cfg::WRCFG_32b, THCON_SEC0_REG1_Row_start_section_size_ADDR32);
+    }
+    cfg_reg_rmw_tensix<THCON_SEC0_REG1_Pac_LF8_4b_exp_RMW>(fp8);
+    TT_SETDMAREG(0, LOWER_HALFWORD(tile_size), 0, LO_16(p_gpr_pack::TILE_HEADER));
+    reconfigure_exp_threshold<DST_ACCUM_MODE>(out_dst);
+    cfg_reg_rmw_tensix<ALU_FORMAT_SPEC_REG2_Dstacc_RMW>(fp8 ? to_underlying(DataFormat::Float16) : out_src);
+    set_packer_strides<PackMode::Default>(out_src, tile_c_dim);
+    TTI_SETADCXX(p_setadc::PAC, FACE_C_DIM - 1, 0x0);
+}
 #endif
 

+def rowstream_khr_plan(g: Conv3x3Geometry, b: Conv3x3Blocking, has_bias, budget, kstep_ok=True):
+    """The row stream over kh reuse's tile ring (ROWSTREAM_KHR "fuse"): blocking b is kh reuse's. Each input tile-row is
+    tilized once into the tile ring; a batch of `rows` output tile-rows (flat over the core, across M-blocks) multiplies
+    ring rows t + kh * W / 32 for the three kernel rows, all of K in DEST. The ring then holds 2 W / 32 + rows tile-rows;
+    the fp32 partials ([bm, bn]) go, a deeper output CB comes. The reader's unit stream and FIFO are kh reuse's."""
+    if not (ROWSTREAM and b.weights_resident and kh_reuse_capable(g, b)):
+        return None
+    if not _rowstream_rule_ok(g, b):
+        return None
+    bm, bn = b.block_m_tiles, b.block_n_tiles
+    sb_h, sb_w = b.out_subblock_h, b.out_subblock_w
+    assert sb_h == 1
+    tw, wt = g.c_in_tiles, g.input_width // TILE
+    row_bytes = 3 * tw * g.in0_tile_bytes
+    mode = 0 if not has_bias else (2 if ROWSTREAM_BIAS == "kstep" and kstep_ok and sb_w >= sb_h else 1)
+    fixed = (
+        b.footprint_bytes
+        - b.khr_ring_rows * row_bytes
+        - bm * bn * TILE_BYTES_FP32
+        - b.out_depth_row_groups * sb_h * bn * g.out_tile_bytes
+    )
+
+    def total(rows, out_rg):
+        return (
+            fixed
+            + max(b.khr_ring_rows, 2 * wt + rows) * row_bytes
+            + (rows * bn * TILE_BYTES_FP32 if mode == 1 else TILE_BYTES_FP32)
+            + out_rg * sb_h * bn * g.out_tile_bytes
+            + (g.in0_tile_bytes if mode == 2 else 0)
+        )
+
+    best_groups = ROWSTREAM_STORE_GROUPS or _div_up(RM_MAX_DRAM_BANKS_STORE, sb_h * bn)
+    for store_groups in range(best_groups, 0, -1):
+        min_out = max(OUT_DEPTH_ROW_GROUPS, 2 * store_groups)
+        for rows in range(ROWSTREAM_ROWS, 0, -1):
+            if total(rows, min_out) > budget:
+                continue
+            out_rg = max(
+                d for d in range(min_out, max(ROWSTREAM_OUT_ROWS, min_out) + 1) if total(rows, d) <= budget
+            )
+            return dict(
+                khr=True,
+                ring_rows=max(b.khr_ring_rows, 2 * wt + rows),
+                bk=b.block_k_tiles,
+                nkb=b.num_k_blocks,
+                store_groups=store_groups,
+                rows=rows,
+                table_units=b.khr_table,
+                out_rg=out_rg,
+                bias_mode=mode,
+                partials_tiles=rows * bn if mode == 1 else 1,
+                footprint=total(rows, out_rg),
+            )
+    return None
+

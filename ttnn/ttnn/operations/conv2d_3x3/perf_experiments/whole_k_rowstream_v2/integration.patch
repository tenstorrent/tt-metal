+def rowstream_plan(g: Conv3x3Geometry, b: Conv3x3Blocking, has_bias, budget, kstep_ok=True):
+    """The row-streamed walk's plan for blocking b (see ROWSTREAM), or None where it does not apply: the ROW_MAJOR ring
+    with resident weights (interleaved, no K split, tap-direct, no center slots, not the C_out fold or kh reuse). Takes
+    the L1 of the fp32 partials ([bm, bn]) and the [bm, bk] in0 back, and spends it on in0 ([rows, K]), the unit FIFO
+    (lag rows), the ring (grown to what the lag needs) and a deeper output CB. Largest batch first, then the longest lag
+    that fits. kstep_ok: the bias K-step's operands match the matmul's (bf16 in0 for the ones tile, the bias in the
+    weights' format)."""
+    if b.khr_ring_rows:
+        return rowstream_khr_plan(g, b, has_bias, budget, kstep_ok) if ROWSTREAM_KHR == "fuse" else None
+    if not (
+        ROWSTREAM
+        and b.rm_ring_px
+        and b.weights_resident
+        and not b.nslice
+        and not g.fold
+        and not g.k_split
+        and not g.sharded_output
+        and not g.tile_input
+        and b.center_mode == CENTER_NONE
+    ):
+        return None
+    if not _rowstream_rule_ok(g, b):
+        return None
+    bm, bk0, bn = b.block_m_tiles, b.block_k_tiles, b.block_n_tiles
+    sb_h, sb_w = b.out_subblock_h, b.out_subblock_w
+    # The walk accumulates all of K in DEST, so the unit's K extent (bk) changes nothing in the arithmetic: one kernel row
+    # per unit (ROWSTREAM_KROW) where it fits, else the blocking's.
+    krow = ROWSTREAM_KROW and bk0 != g.tensor_kkh_tiles and _tap_major(g, g.tensor_kkh_tiles)
+    bks = [g.tensor_kkh_tiles] if krow else []
+    for bk in bks + [bk0]:
+        nkb = g.tensor_k_tiles // bk
+        K = nkb * bk
+        mode = 0 if not has_bias else (2 if ROWSTREAM_BIAS == "kstep" and kstep_ok and sb_w >= sb_h else 1)
+        pixel_bytes = g.c_in_p * BF16_BYTES
+        base_parts = (
+            bm * bk0 * g.in0_tile_bytes
+            + bm * bn * TILE_BYTES_FP32
+            + b.out_depth_row_groups * sb_h * bn * g.out_tile_bytes
+            + _tap_direct_fifo_units(g, bm, bk0, False) * 16
+        )
+        # cb_im2col_rm (the gathered tap blocks, one tap each) keeps its block count, at least two units' worth.
+        depth = max(IM2COL_RM_DEPTH_ROWS, _div_up(b.im2col_rm_depth_rows * bk0, bk))
+        fixed = b.footprint_bytes - base_parts + (depth * bk - b.im2col_rm_depth_rows * bk0) * TILE_BYTES_BF16
+
+        def total(rows, lag, ring_px, out_rg):
+            return (
+                fixed
+                + (ring_px - b.rm_ring_px) * pixel_bytes
+                + rows * K * g.in0_tile_bytes
+                + (rows * bn * TILE_BYTES_FP32 if mode == 1 else TILE_BYTES_FP32)
+                + out_rg * sb_h * bn * g.out_tile_bytes
+                + lag * nkb * 16
+                + (g.in0_tile_bytes if mode == 2 else 0)
+            )
+
+        # The writer stores windows of store_groups row groups (conv2d_3x3_writer.cpp), at best enough to cover every DRAM
+        # bank; the output CB holds at least two windows. Largest window first, then the largest batch, then the lag.
+        best_groups = ROWSTREAM_STORE_GROUPS or _div_up(RM_MAX_DRAM_BANKS_STORE, sb_h * bn)
+        for store_groups in range(best_groups, 0, -1):
+            min_out = max(OUT_DEPTH_ROW_GROUPS, 2 * store_groups)
+            for rows in range(min(ROWSTREAM_ROWS, bm) // sb_h * sb_h, 0, -sb_h):
+                for lag in range(max(ROWSTREAM_TABLE_ROWS, 1), 0, -1):
+                    ring = max(b.rm_ring_px, rowstream_ring_px(g, b.core_m_tiles, bm, lag))
+                    if total(rows, lag, ring, min_out) > budget:
+                        continue
+                    out_rg = max(
+                        d
+                        for d in range(min_out, max(ROWSTREAM_OUT_ROWS, min_out) + 1)
+                        if total(rows, lag, ring, d) <= budget
+                    )
+                    return dict(
+                        bk=bk,
+                        nkb=nkb,
+                        depth=depth,
+                        store_groups=store_groups,
+                        rows=rows,
+                        lag=lag,
+                        table_units=lag * nkb,
+                        ring_px=ring,
+                        out_rg=out_rg,
+                        bias_mode=mode,
+                        in0_tiles=rows * K,
+                        partials_tiles=rows * bn if mode == 1 else 1,
+                        footprint=total(rows, lag, ring, out_rg),
+                    )
+    return None

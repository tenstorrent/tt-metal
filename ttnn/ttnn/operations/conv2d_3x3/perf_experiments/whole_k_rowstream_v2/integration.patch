+def rowstream_store_rate(g: Conv3x3Geometry, b: Conv3x3Blocking):
+    """Bytes / s the row stream's output leaves the work grid at when compute runs at its matmul rate: every work core
+    packs one output tile per K tile-MACs."""
+    cores = b.num_m_groups * b.n_groups
+    return cores * g.out_tile_bytes * ROWSTREAM_CLOCK_HZ / (g.tensor_k_tiles * ROWSTREAM_TILE_MAC_CYCLES)
+
+
+def _rowstream_rule_ok(g: Conv3x3Geometry, b: Conv3x3Blocking):
+    if ROWSTREAM_RULE == "store_rate":
+        return rowstream_store_rate(g, b) <= ROWSTREAM_DRAM_BYTES_PER_S
+    if ROWSTREAM_RULE == "roofline":
+        compute_s, dram_s = rowstream_roofline(g, b)
+        return compute_s >= dram_s
+    return True
+
+
+def rowstream_roofline(g: Conv3x3Geometry, b: Conv3x3Blocking):
+    """(matmul s, DRAM s) of blocking b: the busiest core's tile-MACs (core_m_tiles x K x bn) at
+    ROWSTREAM_TILE_MAC_CYCLES each, and the op's DRAM bytes (the input read once per N group, the output with its
+    32-lane padding) at ROWSTREAM_DRAM_BYTES_PER_S."""
+    compute_s = b.core_m_tiles * g.tensor_k_tiles * b.block_n_tiles * ROWSTREAM_TILE_MAC_CYCLES / ROWSTREAM_CLOCK_HZ
+    dram_bytes = (
+        b.n_groups * g.num_in_px * g.c_in_p * BF16_BYTES + g.tensor_m_tiles * g.tensor_n_tiles * g.out_tile_bytes
+    )
+    return compute_s, dram_bytes / ROWSTREAM_DRAM_BYTES_PER_S
+

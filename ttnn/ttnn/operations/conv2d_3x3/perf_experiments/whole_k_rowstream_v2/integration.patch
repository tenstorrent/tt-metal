+def rowstream_ring_px(g: Conv3x3Geometry, core_m_tiles, bm, lag_rows):
+    """Ring pixels the row-streamed reader needs (mirror of its release / need sequence): before it writes tile-row t's
+    entries it waits for every pixel below rs_row_hi(t), and compute has popped every entry of the tile-rows before
+    t - lag_rows (lag_rows rows of entries in the unit FIFO), so the ring may reuse every slot below rs_row_lo(t -
+    lag_rows) + ring_px."""
+    worst = 0
+    for start, actual in core_m_ranges(g, core_m_tiles):
+        for t in range(_div_up(actual, bm) * bm):
+            m = t // bm
+            o_end = min((start + min((m + 1) * bm, actual)) * TILE, g.num_out_px)
+            hi = _rs_row_hi(g, (start + t) * TILE, o_end)
+            if hi:
+                worst = max(worst, hi - _rs_row_lo(g, (start + max(t - lag_rows, 0)) * TILE))
+    return worst
+

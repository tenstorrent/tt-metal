+def small_flat_band(device, grid, tensor_pages: int, num_banks: int):
+    """Row-major cores of the SMALL_FLAT_BAND placement of `tensor_pages` pages, or None when the plan has
+    a page per grid core or more, or the band cannot hold it."""
+    if tensor_pages >= grid.x * grid.y:
+        return None
+    k = max(1, min(tensor_pages, num_banks, grid.x))
+    rows = -(-tensor_pages // k)
+    if rows > grid.y:
+        return None
+    # The centre line runs half a column west of the westmost interior anchor (the worker just east of
+    # the interior DRAM column); the k columns nearest to it are a contiguous range.
+    anchors = ttnn.device.get_optimal_dram_bank_to_logical_worker_assignment(device, ttnn.NOC.NOC_0)
+    interior = sorted({anchor.x for anchor in anchors if 0 < anchor.x < grid.x})
+    center = interior[0] - 0.5 if interior else (grid.x - 1) / 2
+    cols = sorted(sorted(range(grid.x), key=lambda x: (abs(x - center), -x))[:k])
+    return [(x, y) for y in range(rows) for x in cols][:tensor_pages]
+

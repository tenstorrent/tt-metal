+    TTI_SFPLOADI(0, sfpi::SFPLOADI_MOD0_UPPER, (store_bits << 8) | 0);                       \
+    TTI_SFPCONFIG(0, 4 + (q), 0);
+    MHC_SK_SEQ(0)
+    MHC_SK_SEQ(1)
+    MHC_SK_SEQ(2)
+    MHC_SK_SEQ(3)
+#undef MHC_SK_SEQ

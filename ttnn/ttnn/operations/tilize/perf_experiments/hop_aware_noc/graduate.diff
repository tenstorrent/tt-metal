+// ---------------------------------------------------------------------------
+// Hop-aware write NoC (Perf 2, perf_experiments/hop_aware_noc; host knob HOP_WRITE_MIN_SAVING)
+// ---------------------------------------------------------------------------
+// The writer (BRISC, DM_DEDICATED_NOC on NoC1) sends DRAM bank b's tile writes on NoC0 instead
+// when NoC0's Tensix core -> bank path is at least TILIZE_HOP_WRITE_MIN_SAVING hops shorter (a
+// write's data rides the request, so the request path is the data path). Wormhole routes NoC0
+// east then south and NoC1 west then north on a 10 x 12 torus. A saving of 6 hops moves 28 % of the
+// (Tensix core, bank) pairs on WH n150: NoC0 carries ~1/2.6 of NoC1's DRAM write capacity
+// (LOOSE_CASES[7] writes-only: all on NoC0 41861 ns vs NoC1 15573 ns), so a 50/50 split loses and
+// a hop-picked ~28 % share wins (hop T6 14426 vs a random 28 % 16537 vs head 17167 ns).
+// Output page p lives in bank p mod NUM_DRAM_BANKS (DRAM TensorMemoryLayout::INTERLEAVED: host gate).
+// Compiled in only under the define, so the off programs are HEAD's exact binaries.
+namespace hop_write {
+
+inline uint32_t other_noc_banks = 0;  // bit b set: bank b's writes go on 1 - noc_index (BRISC)
+
+// Raw register read (NOC_CMD_BUF_READ_REG(NOC_NODE_ID), as select_co_read_list): no dataflow API
+// returns the physical coordinate (my_x / my_y hold the translated id, 18.. on Wormhole); the
+// DRAM endpoints dram_bank_to_noc_xy[0][b] are physical (DRAM is not translated). Measured with the
+// counter snapshot (writer_hop_init zone, LOOSE_CASES[7]): 451 cycles p50 per Tensix core, overlapped
+// with compute's first sub-block (writer_wait 394 -> 36 cycles), so ~90 cycles on the critical path.
+FORCE_INLINE void init() {
+    constexpr uint32_t GX = 10, GY = 12;  // Wormhole NoC grid
+    const uint32_t node_id = NOC_CMD_BUF_READ_REG(0, 0, NOC_NODE_ID);
+    const uint32_t mx = node_id & NOC_NODE_ID_MASK;
+    const uint32_t my = (node_id >> NOC_ADDR_NODE_ID_BITS) & NOC_NODE_ID_MASK;
+    uint32_t mask = 0;
+    for (uint32_t b = 0; b < NUM_DRAM_BANKS; ++b) {
+        const uint32_t xy = dram_bank_to_noc_xy[0][b] >> NOC_COORD_REG_OFFSET;
+        const uint32_t x = xy & NOC_NODE_ID_MASK, y = (xy >> NOC_ADDR_NODE_ID_BITS) & NOC_NODE_ID_MASK;
+        const uint32_t east = x >= mx ? x - mx : x + GX - mx, south = y >= my ? y - my : y + GY - my;
+        const uint32_t west = east == 0 ? 0 : GX - east, north = south == 0 ? 0 : GY - south;
+        if (west + north >= east + south + TILIZE_HOP_WRITE_MIN_SAVING) {
+            mask |= 1u << b;
+        }
+    }
+    other_noc_banks = mask;
+}
+FORCE_INLINE uint8_t noc_of_bank(uint32_t banks, uint32_t bank) {
+    return ((banks >> bank) & 1) ? 1 - noc_index : noc_index;
+}
+FORCE_INLINE uint32_t next_bank(uint32_t bank) { return bank + 1 == NUM_DRAM_BANKS ? 0 : bank + 1; }

+// NCRISC's half of the handshake: BRISC also writes on this RISC-V's NoC (NIU 0). At kernel end
+// (the destructor, so every return path of the reader runs it) wait until BRISC's NoC0 writes are
+// all ACKed (its flag), re-arm the flag for the next launch, and re-snapshot this RISC-V's NoC0
+// counters from the NIU so the firmware's kernel-end dedicated-NoC idle ASSERT holds (without it
+// --dev halts NCRISC at NKFW, ncrisck.cc). Raw firmware call noc_local_state_init: no dataflow API
+// re-syncs a RISC-V's software counters with its NIU.
+struct HopReaderResync {
+    volatile tt_l1_ptr uint32_t* flag;
+    explicit HopReaderResync(uint32_t flag_addr) : flag(reinterpret_cast<volatile tt_l1_ptr uint32_t*>(flag_addr)) {}
+    ~HopReaderResync() {
+        MaybeDeviceZoneScope("reader_hop_resync");  // NCRISC waiting on BRISC's final NoC0 ACKs
+        noc_semaphore_wait(flag, 1);
+        noc_semaphore_set(flag, 0);
+        noc_local_state_init(noc_index);
+    }
+};

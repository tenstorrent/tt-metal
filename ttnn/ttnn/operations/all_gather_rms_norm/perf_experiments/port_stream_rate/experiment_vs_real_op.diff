+// port_stream_rate: the port reader's single walk when it also hands the sender each chunk's destination
+// (AGRMS_PSR_DESC). Same chunks, same order as for_each_chunk_of_item; reports every source the reader may use:
+// f(worker_index, landing_addr, input_shard_addr (native HEIGHT own slice), tile_row r, slice column, bytes, last).
+template <typename F>
+FORCE_INLINE void for_each_chunk_of_item_full(const Geom& g, const Entry& e, uint32_t xb, F&& f) {
+    const uint32_t r0 = xb * g.xfer_rows;
+    const uint32_t rows = g.item_rows(xb);
+    if (e.nseg == 0 || e.rows_in(r0, rows) == 0) {
+        return;
+    }
+    const uint32_t q_base = e.q * g.Wt_lp;
+    uint32_t r_last = r0 + rows - 1;
+    if (!e.has_row(r_last)) {
+        --r_last;
+    }
+    uint32_t grp0, li0;
+    g.place(r0, grp0, li0);
+    const uint32_t land_pitch = g.w_pitch * g.page_bytes;
+    const uint32_t in_pitch = g.Wt_lp * g.page_bytes;
+    uint32_t col0 = e.c0;
+    for (uint32_t s = 0; s < e.nseg; ++s) {
+        const uint32_t v = get_arg_val<uint32_t>(e.seg + s);
+        const uint32_t m = v >> 24, off = (v >> 12) & 0xFFF, len = v & 0xFFF;
+        const uint32_t nch = g.chunks_of(len);
+        const uint32_t base_n = len / nch, rem = len - base_n * nch;
+        const uint32_t land0 = g.landing_base + off * g.page_bytes;
+        const uint32_t in0 = g.x_base + (off - q_base) * g.page_bytes;
+        const bool last_seg = s + 1 == e.nseg;
+        uint32_t grp = grp0, li = li0;
+        for (uint32_t r = r0; r < r0 + rows; ++r) {
+            if (e.has_row(r)) {
+                uint32_t land = land0 + li * land_pitch;
+                uint32_t in = in0 + li * in_pitch;
+                const uint32_t w = grp * g.k + m;
+                const bool last_row = last_seg && r == r_last;
+                uint32_t col = col0;
+                for (uint32_t c = 0; c < nch; ++c) {
+                    const uint32_t n = base_n + (c < rem ? 1 : 0);
+                    f(w, land, in, r, col, n * g.page_bytes, last_row && c + 1 == nch);
+                    land += n * g.page_bytes;
+                    in += n * g.page_bytes;
+                    col += n;
+                }
+            }
+            g.advance(grp, li);
+        }
+        col0 += len;
+    }
+}

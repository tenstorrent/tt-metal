+    for (uint32_t j = 0; j < num_tiles; ++j) {
+        const uint32_t tile = base + j * g_tile_bytes + gamma_exp_bytes;
+        noc_async_read_one_packet_with_state(tile, tile + 2 * face_bytes);
+    }
+    noc_async_read_barrier();

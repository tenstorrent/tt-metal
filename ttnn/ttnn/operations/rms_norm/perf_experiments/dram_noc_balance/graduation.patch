+def _noc_swapped_columns(device) -> set:
+    """Logical worker columns whose Tensix cores run the reversed NoC pairing (NOC_SWAP_COLUMNS nearest DRAM bank 0)."""
+    if not NOC_SWAP_COLUMNS:

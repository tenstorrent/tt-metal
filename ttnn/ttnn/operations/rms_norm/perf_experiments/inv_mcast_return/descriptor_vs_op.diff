+def _member_rects(cores):
+    """Cover of a group's logical cores by <= INV_MAX_RECTS member-only rectangles (x0, y0, x1, y1), or None.
+
+    Row spans first (each grid row's members must be one contiguous x range; consecutive rows with the same range
+    merge), then column spans. Every rectangle holds ONLY member cores, so an idle Tensix core inside the group's
+    bounding box is never a multicast destination."""
+    pts = [(int(c.x), int(c.y)) for c in cores]
+
+    def spans(major, minor):
+        lines = {}
+        for p in pts:
+            lines.setdefault(p[major], []).append(p[minor])
+        out = []
+        for a in sorted(lines):
+            v = sorted(lines[a])
+            if v[-1] - v[0] + 1 != len(v):
+                return None
+            if out and out[-1][2] == v[0] and out[-1][3] == v[-1] and out[-1][1] + 1 == a:
+                out[-1][1] = a
+            else:
+                out.append([a, a, v[0], v[-1]])  # major lo, major hi, minor lo, minor hi
+        return out
+
+    for major, minor in ((1, 0), (0, 1)):
+        sp = spans(major, minor)
+        if sp is not None and len(sp) <= INV_MAX_RECTS:
+            if major == 1:
+                return [(s[2], s[0], s[3], s[1]) for s in sp]
+            return [(s[0], s[2], s[1], s[3]) for s in sp]
+    return None
+

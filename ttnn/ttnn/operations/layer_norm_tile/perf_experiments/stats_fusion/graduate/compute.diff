+namespace ckernel::sfpu {
+// One face of rsqrt(x * scale + addend) on the SFPU loads holding tile column 0 only: a load covers
+// 4 rows x 8 columns (dest address bit 1 picks even / odd columns) and dst_reg[k] is address 2k, so
+// column 0 is dst_reg[0], [2], [4], [6]. Half the rsqrt work of a VectorMode::C pass; normalize's col
+// broadcast reads only column 0. Same 23-bit rsqrt body as rsqrt_tile.
+template <bool APPROXIMATION_MODE, bool fp32_dest_acc_en, uint32_t scale_bits>
+inline void calculate_add_rsqrt_col0(uint32_t addend_bits) {
+    const sfpi::vFloat scale = Converter::as_float(scale_bits);
+    const sfpi::vFloat addend = Converter::as_float(addend_bits);
+#pragma GCC unroll 4
+    for (int group = 0; group < 4; ++group) {
+        sfpi::vFloat y = _calculate_sqrt_body_<APPROXIMATION_MODE, true, false>(sfpi::dst_reg[2 * group] * scale + addend);
+        if constexpr (!fp32_dest_acc_en) {
+            y = sfpi::convert<sfpi::vFloat16b>(y, sfpi::RoundMode::Nearest);
+        }
+        sfpi::dst_reg[2 * group] = y;
+    }
+}
+}  // namespace ckernel::sfpu
+#endif

+// ---- norm_impl 3: raw one-window SFPU path (same arithmetic as norm_impl 1: fp32(x*gamma) * rstd_full, SFPU fp32) ----
+// Bypasses eltwise_chain (BinaryFpu + CopyTile + MulBinary): the chain gives every lane its own rstd copy (lane width 2
+// -> 2 tiles per window, one 4 KiB fp32 rstd unpack per tile, a generic per-tile SFPU binary call). Here a window holds
+// up to RS_W product tiles in D0..D{RS_W-1} and ONE rstd_full tile in D{RS_W}; one SFPU pass loads each rstd vector
+// once and multiplies the RS_W product vectors by it. No helper expresses a per-window shared operand slot.
+#include "api/compute/tile_move_copy.h"
+#include "api/compute/bcast.h"
+#include "api/compute/pack.h"
+#include "api/compute/reconfig_data_format.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+constexpr uint32_t RS_W = DEST_AUTO_LIMIT - 1;  // product slots per window (3 with fp32 half-sync DEST)
+#ifdef TRISC_MATH
+template <uint32_t N>
+sfpi_inline void rstd_scale_body() {
+    constexpr uint32_t ts = 32;  // one DEST tile in sfpi rows
+#pragma GCC unroll 8
+    for (uint32_t d = 0; d < 8; ++d) {
+        const sfpi::vFloat r = sfpi::dst_reg[RS_W * ts];
+#pragma GCC unroll 4
+        for (uint32_t t = 0; t < N; ++t) {
+            sfpi::dst_reg[t * ts] = sfpi::dst_reg[t * ts] * r;
+        }
+        sfpi::dst_reg++;
+    }
+}
+#endif
+ALWI void rstd_scale(uint32_t n) {
+#ifdef TRISC_MATH
+    if (n == 3) {
+        _llk_math_eltwise_unary_sfpu_params_(rstd_scale_body<3>, 0, ckernel::VectorMode::RC);
+    } else if (n == 2) {
+        _llk_math_eltwise_unary_sfpu_params_(rstd_scale_body<2>, 0, ckernel::VectorMode::RC);
+    } else {
+        _llk_math_eltwise_unary_sfpu_params_(rstd_scale_body<1>, 0, ckernel::VectorMode::RC);
+    }
+#endif
+}
+static_assert(RS_W >= 1 && RS_W <= 3, "rstd_scale_body instantiations cover 1..3 product slots");
+
+// One window of n tiles (row r, block cols c0..c0+n-1). late: D[j] = x * gamma (FPU, row bcast); ahead: D[j] = xg
+// (exact fp32 copy, xg_idx = front index of the first tile). Then D{RS_W} = rstd_full[r], D[j] *= it, pack -> cb_out.
+template <bool late>
+ALWI void rs_window(uint32_t n, uint32_t x_idx, uint32_t c0, uint32_t r, uint32_t xg_idx) {
+    tile_regs_acquire();
+    if constexpr (late) {
+        reconfig_data_format(cb_x_block, cb_gamma);
+        mul_bcast_rows_init(cb_x_block, cb_gamma);
+        for (uint32_t j = 0; j < n; ++j) {
+            mul_tiles_bcast_rows(cb_x_block, cb_gamma, x_idx + j, c0 + j, j);
+        }
+        reconfig_data_format_srca(cb_rstd_full);
+        copy_init(cb_rstd_full);
+    } else {
+        reconfig_data_format_srca(cb_xg);
+        copy_init(cb_xg);
+        for (uint32_t j = 0; j < n; ++j) {
+            copy_tile(cb_xg, xg_idx + j, j);
+        }
+    }
+    copy_tile(cb_rstd_full, r, RS_W);
+#ifndef AGRN_DIAG_NOSFPU
+    mul_binary_tile_init();
+    rstd_scale(n);
+#endif
+    tile_regs_commit();
+    tile_regs_wait();
+    for (uint32_t j = 0; j < n; ++j) {
+        pack_tile(j, cb_out);
+    }
+    tile_regs_release();
+}
+
+template <bool late>
+ALWI void rs_chunk(uint32_t k) {
+    const ChunkWindow w = chunk_window(k);
+    if constexpr (late) {
+        cb_wait_front(cb_x_block, (k + 1) * chunk_tiles);
+    } else {
+        cb_wait_front(cb_xg, chunk_tiles);
+    }
+    cb_reserve_back(cb_out, chunk_tiles);
+    pack_reconfig_data_format(cb_out);
+    uint32_t t = 0;
+    for (uint32_t rr = 0; rr < w.rows; ++rr) {
+        for (uint32_t c = 0; c < w.cols; c += RS_W) {
+            const uint32_t n = (w.cols - c) < RS_W ? (w.cols - c) : RS_W;
+            rs_window<late>(n, k * chunk_tiles + t, w.c0 + c, w.r0 + rr, t);
+            t += n;
+        }
+    }
+    cb_push_back(cb_out, chunk_tiles);
+    if constexpr (!late) {
+        cb_pop_front(cb_xg, chunk_tiles);
+    }
+}

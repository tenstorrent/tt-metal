namespace ttnn.flatbuffer;

table CoreCoord {
    x: int;
    y: int;
}

table CoreRange {
    start: CoreCoord;
    end: CoreCoord;
}

table CoreRangeSet {
    ranges: [CoreRange];
}

table Tile {
    tile_shape_h: uint32;
    tile_shape_w: uint32;
    transpose_tile: bool;
}

enum TensorMemoryLayout: ushort {
    Interleaved = 0,
    HeightSharded = 2,
    WidthSharded = 3,
    BlockSharded = 4,
    NdSharded = 5,
}

enum BufferType: ushort {
    DRAM = 0,
    L1 = 1,
    SystemMemory = 2,
    L1Small = 3,
    Trace = 4,
}

enum ShardOrientation : ubyte {
    RowMajor = 0,
    ColMajor = 1,
}

enum ShardDistributionStrategy : ubyte {
    ROUND_ROBIN_1D = 0,
    GRID_2D = 1,
    CONTIGUOUS_1D = 2,
}

enum ShardModeDeprecated : ubyte {
    Physical,
    Logical,
}

table ShardShape {
    height: uint32;
    width: uint32;
}

table ShardSpec {
    grid: CoreRangeSet;
    shape_h: uint32;
    shape_w: uint32;
    orientation: ShardOrientation;
    shard_mode_deprecated: ShardModeDeprecated;
    physical_shard_shape_deprecated: ShardShape;
}

table NdShardSpec {
    shard_shape: [uint32];
    grid: CoreRangeSet;
    orientation: ShardOrientation;
    shard_distribution_strategy: ShardDistributionStrategy;
}

enum DataType : ubyte {
    BFloat16 = 0,
    Float32 = 1,
    UInt32 = 2,
    BFloat8B = 3,
    BFloat4B = 4,
    UInt8 = 5,
    UInt16 = 6,
    Int32 = 7,
    Int8 = 8,
    Invalid = 9,
    // Appended after Invalid so existing serialized values keep their meaning.
    MxFp8E4M3 = 10,
    MxFp8E5M2 = 11,
    MxFp6E2M3 = 12,
    MxFp6E3M2 = 13,
    MxFp4 = 14,
    MxInt8 = 15,
    MxInt4 = 16,
    MxInt2 = 17,
    // One per GGUF format, in the order and at the numbers of tt::tt_metal::DataType::GGUF_*.
    GgufQ8_0 = 18,
    GgufQ4_0 = 19,
    GgufIQ4_NL = 20,
    GgufMXFP4 = 21,
    GgufNVFP4 = 22,
    GgufQ6_K = 23,
    GgufQ4_K = 24,
    GgufQ5_K = 25,
    GgufQ3_K = 26,
    GgufQ2_K = 27,
    GgufIQ4_XS = 28,
    GgufTQ2_0 = 29,
    GgufQ2_0 = 30,
    GgufQ1_0 = 31,
    GgufIQ2_XXS = 32,
    GgufIQ1_S = 33,
    GgufIQ2_S = 34,
    GgufIQ3_S = 35,
    GgufIQ3_XXS = 36,
    GgufIQ2_XS = 37,
    GgufIQ1_M = 38,
    GgufQ4_1 = 39,
    GgufQ5_0 = 40,
    GgufQ5_1 = 41,
    GgufTQ1_0 = 42
}

table RowMajorPageConfig {}
table TilePageConfig {
    tile: Tile;
}

union PageConfig {
    row_major: RowMajorPageConfig,
    tile: TilePageConfig,
}

table MemoryConfig {
    memory_layout: TensorMemoryLayout;
    buffer_type: BufferType;
    shard_spec: ShardSpec;
    nd_shard_spec: NdShardSpec;
    created_with_nd_shard_spec: bool;
    per_core_allocation: bool = false;
    range_lockstep_allocation: bool = false;
}

table TensorLayout {
    data_type: DataType;
    page_config: PageConfig;
    memory_config: MemoryConfig;
    alignment: [uint32];
}

table TensorSpec {
    shape: [uint32];
    tensor_layout: TensorLayout;
}

root_type TensorSpec;

+                                                   ? route_manager_.get_forwarding_direction(dest.hops.value())
+                                                   : route_manager_.get_forwarding_direction(sender.device, dest.device.value());
+            routers.insert({direction, sender.link_id});
+        }
+        return routers;
+    };

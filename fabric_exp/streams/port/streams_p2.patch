+        test.name);
+
+    for (const auto& sender : test.senders) {
+        if (sender.stream.has_value()) {
+            TT_FATAL(
+                sender.stream->counts.size() == sender.patterns.size(),
+                "Test '{}': stream program has {} entries for {} patterns",
+                test.name,
+                sender.stream->counts.size(),
+                sender.patterns.size());

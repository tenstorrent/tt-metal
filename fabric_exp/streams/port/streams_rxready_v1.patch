+// Receivers take no part in the device syncs, and a receiver that starts after its sender has sent more packets than
+// its buffer holds finds its first packets overwritten and waits for them forever. The global sync spans only one
+// mesh, so across meshes (and hosts) nothing orders a receiver's start before its senders'. In a sync test the sync
+// cores therefore wait for a release that the host gives only once every receiver, on every host, is running.
+void TestContext::launch_programs() {
+    fixture_->run_programs();
+
+    // Latency tests run no sync kernel, and a mock cluster runs no kernels. The test config and the cluster decide
+    // this, so every host takes the same branch and all of them reach the barrier.
+    if (!global_sync_ || performance_test_mode_ == PerformanceTestMode::LATENCY ||
+        tt::tt_metal::MetalContext::instance().get_cluster().is_mock_or_emulated()) {
+        return;
+    }
+    wait_for_local_receivers_to_start();
+    fixture_->barrier();
+    release_local_sync_cores();
+}
+
+// A receiver writes STARTED to its status word on entry (benchmark-mode receivers then finish at once), and the word
+// was cleared before launch, so any non-zero status means the receiver is running.
+void TestContext::wait_for_local_receivers_to_start() const {
+    constexpr auto timeout = std::chrono::seconds(30);
+    constexpr auto poll_interval = std::chrono::microseconds(100);
+
+    auto& cluster = tt::tt_metal::MetalContext::instance().get_cluster();
+    const auto& control_plane = tt::tt_metal::MetalContext::instance().get_control_plane();
+    const uint32_t status_address =
+        receiver_memory_map_.get_result_buffer_address() + TT_FABRIC_STATUS_INDEX * sizeof(uint32_t);
+
+    struct PendingReceiver {
+        FabricNodeId node_id;
+        ChipId physical_chip_id;
+        CoreCoord logical_core;
+        CoreCoord virtual_core;
+    };
+    std::vector<PendingReceiver> pending;
+    for (const auto& [coord, test_device] : test_devices_) {
+        const auto& node_id = test_device.get_node_id();
+        const auto physical_chip_id = control_plane.get_physical_chip_id_from_fabric_node_id(node_id);
+        for (const auto& [core, _] : test_device.get_receivers()) {
+            pending.push_back({node_id, physical_chip_id, core, fixture_->get_virtual_core_from_logical_core(core)});
+        }
+    }
+
+    const auto deadline = std::chrono::steady_clock::now() + timeout;
+    while (true) {
+        std::erase_if(pending, [&](const PendingReceiver& receiver) {
+            const auto status = cluster.read_core<uint32_t>(
+                receiver.physical_chip_id, receiver.virtual_core, status_address, sizeof(uint32_t));
+            return status.at(0) != 0;
+        });
+        if (pending.empty()) {
+            return;
+        }
+        if (std::chrono::steady_clock::now() > deadline) {
+            // Release anyway: the test then runs as it did without the start gate, and the hang detection sees a
+            // receiver that never runs.
+            log_warning(
+                tt::LogTest,
+                "{} receiver(s) have not started after {}s (first: device {} core {}); releasing the senders anyway",
+                pending.size(),
+                timeout.count(),
+                pending.front().node_id,
+                pending.front().logical_core.str());
+            return;
+        }
+        std::this_thread::sleep_for(poll_interval);
+    }
+}
+
+void TestContext::release_local_sync_cores() const {
+    auto& cluster = tt::tt_metal::MetalContext::instance().get_cluster();
+    const auto& control_plane = tt::tt_metal::MetalContext::instance().get_control_plane();
+    const uint32_t release_address = sender_memory_map_.get_sync_start_release_address();
+    const uint32_t release = 1;
+
+    for (const auto& [coord, test_device] : test_devices_) {
+        const auto physical_chip_id = control_plane.get_physical_chip_id_from_fabric_node_id(test_device.get_node_id());
+        for (const auto& core : test_device.get_sync_kernel_cores()) {
+            cluster.write_core(
+                &release,
+                sizeof(release),
+                tt_cxy_pair(physical_chip_id, fixture_->get_virtual_core_from_logical_core(core)),
+                release_address);
+        }
+    }
+}
 

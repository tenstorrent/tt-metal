+// Study switch (fabric_exp, SLOT_ALLOCATOR.md): the dynamic slot allocator's mesh facts, step 1 (one set for the
+// fabric): the largest dims of its meshes. Read from the control plane here so no builder struct changes layout; step
+// 2 brings per-router facts through the builder instead. Named, not anonymous: this file is built in a unity batch.
+namespace dyn_slots_detail {
+void read_mesh_dims(slot_allocator::RouterShape& shape) {
+    const auto& mesh_graph = tt::tt_metal::MetalContext::instance().get_control_plane().get_mesh_graph();
+    for (const auto& mesh_id : mesh_graph.get_mesh_ids()) {
+        const auto mesh_shape = mesh_graph.get_mesh_shape(mesh_id);
+        if (mesh_shape.dims() != 2) {
+            continue;
+        }
+        for (size_t axis = 0; axis < 2; ++axis) {
+            shape.mesh_dims[axis] = std::max<size_t>(shape.mesh_dims[axis], mesh_shape[axis]);
+        }
+    }
+}

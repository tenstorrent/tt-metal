# The transpose of express_links_8x4_mesh_graph_descriptor.textproto: a single 4x8 BLACKHOLE torus whose express-link
# pattern runs along dim 1 (length 8), so its chords run E/W.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [4, 8] dim_types: [RING, RING] }
  host_topology   { dims: [1, 1] }
  channels { count: 2 }
  express_links { dim_idx: 1  pattern { start: 2  step: 4 } wrap: LINE}
}
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

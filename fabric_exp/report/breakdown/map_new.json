{
 "router": "new",
 "description": "The study router (kernel v2 slot, fabric_erisc_router_v4.cpp and router/*.hpp). Written against the receiver lead v4rxg3 and its sender (router_sender.hpp as of v4rxg3); rules are by function, with content-matched lines (match / from-to text anchors) where one function mixes categories, so they re-apply to the sender-pass builds (v4txo*) as long as the function names stay. Rules tagged legacy cover the older receiver of v4rxv2i3 (router_completions.hpp, acknowledge_arrivals, HeaderWord), which most existing samples ran; they are unresolved on v4rxg3 and that is expected. Sources: the variant directory over git HEAD, never the live tree.",
 "router_files": [
  "edm_fabric/router/",
  "fabric_erisc_router_v2\\.cpp$",
  "fabric_edm_packet_transmission\\.hpp$",
  "fabric_router_flow_control\\.hpp$",
  "fabric_erisc_datamover_channels\\.hpp$"
 ],
 "work_categories": {
  "E0": [
   "eth_send"
  ],
  "E1": [
   "noc"
  ]
 },
 "rules": [
  {
   "id": "tx.poll.registers",
   "file": "router_sender.hpp",
   "fn": "(^|::)(holds_packet|read_free_slots_registers|channels_holding_packets|channels_with_packets)$",
   "cat": "checks",
   "note": "the pass's group read of the channels' free-slots registers and its tests (is there a packet); its latency shows at the first test"
  },
  {
   "id": "tx.poll.semaphores",
   "file": "router_sender.hpp",
   "fn": "(^|::)read_connection_semaphores$",
   "cat": "loop",
   "note": "the worker channels' connection semaphores, read in the same group"
  },
  {
   "id": "tx.send.credit_reads",
   "file": "router_sender.hpp",
   "fn": "(^|::)send$",
   "match": "const uint32_t reported = \\*reinterpret_cast|uint32_t reported_acks = 0;|reported_acks = \\*reinterpret_cast|completions = reported - completed;|acks = reported_acks;",
   "cat": "credits",
   "note": "completion / ack counters read inside the send's post-send load group (placed there to overlap the send); a stall on them can show at the next send line"
  },
  {
   "id": "tx.send",
   "file": "router_sender.hpp",
   "fn": "(^|::)send$",
   "cat": "eth_send",
   "note": "header size read and TX status group, src_ch_id stamp, busy yield, TXQ send, slot advances, free-slots register, busy spin, packets-received update"
  },
  {
   "id": "tx.visit_worker.room",
   "file": "router_sender.hpp",
   "fn": "(^|::)visit_worker$",
   "match": "if \\(has_packet && (far\\.free_slots >= C::far_slots_needed|remote\\.has_room\\()",
   "cat": "checks"
  },
  {
   "id": "tx.visit_worker.send_call",
   "file": "router_sender.hpp",
   "fn": "(^|::)visit_worker$",
   "match": "sent = send<CH>\\(",
   "cat": "eth_send"
  },
  {
   "id": "tx.visit_worker",
   "file": "router_sender.hpp",
   "fn": "(^|::)visit_worker$",
   "cat": "credits",
   "note": "after the send: completion and ack reads (when nothing was sent), free slots, worker credit"
  },
  {
   "id": "tx.visit_fwd.record",
   "file": "router_sender.hpp",
   "fn": "(^|::)(visit_forwarding|visit_channel_with_work)$",
   "match": "ForwardingRecord& r = table\\.records|uint32_t sent = (r|state\\.progress)\\.sent;|uint32_t completed = (r|state\\.progress)\\.completed;|(in_flight|channels_in_flight) = busy \\?|keep_in_memory\\((r|state)\\);",
   "cat": "loop",
   "note": "the forwarding channel's record loaded and stored around the visit"
  },
  {
   "id": "tx.visit_fwd.room",
   "file": "router_sender.hpp",
   "fn": "(^|::)(visit_forwarding|visit_channel_with_work)$",
   "match": "if \\(has_packet && (far\\.free_slots >= C::far_slots_needed|remote\\.has_room\\()",
   "cat": "checks"
  },

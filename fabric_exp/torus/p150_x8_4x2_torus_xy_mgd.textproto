# Study descriptor (2026-11-03, second-LB XY-torus runs): the repo's p150_x8_mesh_graph_descriptor.textproto with the
# mesh as 4x2 (dims [4, 2], the 4-long axis Y = dim 0) and dim_types [ RING, LINE ], passed with TT_MESH_GRAPH_DESC_PATH:
# auto-discovery turns a 4x2 into 2x4 (topology_mapper.cpp, generate_possible_cluster_shapes). The repo's file stays
# untouched. A torus FabricConfig cannot add connectivity the MGD lacks (mesh_graph.cpp requires_more_connectivity), so
# the 4-long axis is declared RING here.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

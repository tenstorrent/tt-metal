# Two cabled BH Galaxies as two meshes, one per host: each an 8x4 2D torus (RING x RING, a Galaxy's own wiring), linked by
# the cables between the hosts (a ring-neighbour pair of a quad has 16 Ethernet connections, 8 ASICs x 2 channels per
# side). Built from the Galaxy multi-mesh descriptors (2_quad_bh_galaxy_2x32x4_torus, dual_bh_galaxy_experimental,
# dual_4x8_z_fallback): no assign_z_direction (as dual_4x8_z_fallback_mesh_graph_descriptor.textproto).
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 8, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    channels { count: 16 policy: STRICT }
    directional: false
    # assign_z_direction not set: the router falls back to Z once N/E/S/W are taken (a torus uses them all)
  }
}
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

# SUPERSEDED (2026-11-05): the Galaxy pair suite uses existing descriptors instead (glxq_pairs.tsv). Kept as history.
# Two cabled BH Galaxies as one 4x16 mesh (LINE x LINE), host_topology 1x2: the transpose of
# tt_metal/fabric/mesh_graph_descriptors/16x4_dual_bh_galaxy_2d_mesh_graph_descriptor.textproto (16x4, host 2x1).
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 16 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 2 ] }
  channels { count: 2 policy: RELAXED }
}
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

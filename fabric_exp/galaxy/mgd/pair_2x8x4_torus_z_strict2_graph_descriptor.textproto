# SUPERSEDED (2026-11-05): the Galaxy pair suite uses existing descriptors instead (glxq_pairs.tsv). Kept as history.
# Two cabled BH Galaxies as two meshes, one per host: each an 8x4 2D torus (RING x RING, a Galaxy's own wiring), linked by
# the one cable between two hosts of different quads (2 Ethernet connections), STRICT: a RELAXED count also passes the
# control plane on hosts with no cable between them, so only STRICT proves the link. For ring-neighbour pairs (16
# connections) use the variant without _strict2. Built from the Galaxy multi-mesh descriptors
# (2_quad_bh_galaxy_2x32x4_torus, dual_bh_galaxy_experimental, dual_4x8_z_fallback): assign_z_direction: the
# inter-mesh links are the meshes' Z direction.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 8, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    channels { count: 2 policy: STRICT }
    directional: false
    assign_z_direction: true
  }
}
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

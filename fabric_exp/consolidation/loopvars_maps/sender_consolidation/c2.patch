+    enum Kind : uint32_t {
+        ATOMICS = 1u << 0,
+        LOCAL_WRITES = 1u << 1,
+        FORWARD_DATA = 1u << 2,
+        FORWARD_CREDITS = 1u << 3,
+        WORKER_CREDITS = 1u << 4,
+    };

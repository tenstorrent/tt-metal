# Two 4x4 meshes packed onto a single BH galaxy (32 ASICs): M0 4x4 RING/RING pinned to the
# "Middle" quadrants (tray 1-4, asic {3,4,7,8}) + M1 4x4 RING/LINE pinned to the complementary
# "Edge" quadrants (tray 1-4, asic {1,2,5,6}), joined by a 16-channel intermesh link. The pins
# constrain each 4x4 to its host-half of the galaxy so the two tile one galaxy disjointly (no
# special PGD grouping required). Maps on the revC and revAB subtorus single-pod quad mocks.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M1"
  arch: BLACKHOLE

  device_topology { dims: [ 4, 4 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 4, 1 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M1" mesh_id: 1 } }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 1 } }
    channels { count: 16 policy: STRICT }
  }
}
# --- Pinnings ---------------------------------------------------------------
# Per-board-revision corner pinnings (mirrors gemma_4galaxy): each 4x4 corner is locked to one
# galaxy tray (1 NW, 2 NE, 3 SW, 4 SE). M0 takes the "Middle" column (asic 3), M1 the "Edge"
# column (asic 2). Rev A/B and Rev C swap the SW/SE corners (chip 3 / chip 12 on M0, chip 0 /
# chip 15 on M1); one extra pin per mesh (loc 7 / loc 6) anchors the corner orientation.

# M0 (Middle, asic 3)
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id: 0 }
  physical_asic_position { tray_id: 1 asic_location: 3 }
}
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id: 1 }
  physical_asic_position { tray_id: 1 asic_location: 7 }
}
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id: 3 }
  physical_asic_position { tray_id: 3 asic_location: 3 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id: 12 }
  physical_asic_position { tray_id: 2 asic_location: 3 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id: 3 }
  physical_asic_position { tray_id: 2 asic_location: 3 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id: 12 }
  physical_asic_position { tray_id: 3 asic_location: 3 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id: 15 }
  physical_asic_position { tray_id: 4 asic_location: 3 }
}

# M1 (Edge, asic 2)
pinnings {
  logical_fabric_node_id { mesh_id: 1 chip_id: 0 }
  physical_asic_position { tray_id: 2 asic_location: 2 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id: 1 chip_id: 15 }
  physical_asic_position { tray_id: 3 asic_location: 2 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id: 1 chip_id: 0 }
  physical_asic_position { tray_id: 3 asic_location: 2 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id: 1 chip_id: 15 }
  physical_asic_position { tray_id: 2 asic_location: 2 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id: 1 chip_id: 3 }
  physical_asic_position { tray_id: 4 asic_location: 2 }
}
pinnings {
  logical_fabric_node_id { mesh_id: 1 chip_id: 12 }
  physical_asic_position { tray_id: 1 asic_location: 2 }
}
pinnings {
  logical_fabric_node_id { mesh_id: 1 chip_id: 13 }
  physical_asic_position { tray_id: 1 asic_location: 6 }
}
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

# Llama + audio enc/decoder on a single quad (tt-blaze #3089), 5-mesh ring option.
# M0 [4,8] head (32 chips) -> M1 [4,4] (16) -> M2 [2,2] (4) -> M2 [2,2] (4) -> M3 [4,16]
# decode (64) -> back to M0.  120 chips used out of 128, 8 free.
# Intermesh topology is a 5-cycle ring (each mesh degree 2). Verbatim from the issue.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 8 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 4 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M1"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 2 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M2"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M3"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 16 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 4, 8 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  # MGD 1.0 compatibility requires the single top-level graph to be a FABRIC graph
  # (a "POD"/other type trips "There can only be one FABRIC level graph").
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M1" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M2" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M2" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "M3" mesh_id: 4 } }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 1  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 2  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 3  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M3" mesh_id: 4  } }
    channels { count: 8 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M3" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    channels { count: 8 policy: RELAXED }
  }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

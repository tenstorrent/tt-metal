# The 4-chip Blackhole box as ONE 1x4 mesh on ONE host. Every link is then intra-mesh, which is
# what deadlock avoidance requires: it is off on inter-mesh routers whatever the topology.
#
# The box is physically a 4-cycle -- 0-2, 2-1, 1-3, 3-0, four links per edge, and NO 0-1 or 2-3.
# So the mesh's logical order follows that cycle and FABRIC_1D_RING closes it.
#
# One rank owns all four chips, so no host-rank boundary exists to split the ring -- the E2H leg
# is a single process, so it needs none.

mesh_descriptors {
  name: "M1x4"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 4 ] }
  host_topology { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M1x4" mesh_id: 0 } }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

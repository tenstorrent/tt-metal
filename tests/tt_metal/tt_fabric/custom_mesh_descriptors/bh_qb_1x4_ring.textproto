# The same 4-chip Blackhole box as bh_qb_dual_1x2_intermesh, as ONE mesh spanning two hosts.
# Every bridged link is then intra-mesh, which is what deadlock avoidance requires: it is switched
# off on inter-mesh routers regardless of topology (erisc_datamover_builder.cpp, !is_inter_mesh).
#
# The box is physically a 4-cycle -- 0-2, 2-1, 1-3, 3-0, four links per edge, and NO 0-1 or 2-3.
# So the mesh's logical order must follow that cycle, and FABRIC_1D_RING closes it.

mesh_descriptors {
  name: "M1x4"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 4 ] }
  # Two hosts, two chips each: the link between them is intra-mesh AND crosses the rank boundary,
  # which is the pair of properties the bridge needs to exercise bubble flow control.
  host_topology { dims: [ 1, 2 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M1x4" mesh_id: 0 } }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

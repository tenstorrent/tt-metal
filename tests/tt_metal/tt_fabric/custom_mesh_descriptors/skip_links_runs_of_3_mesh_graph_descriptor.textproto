# Synthetic tie-break fixture: step 5 skips three rows per block, so the middle leaf of each run is
# equidistant from both anchors. 20 rows RING, one pattern -> one ring [0,4,5,9,10,14,15,19] and four
# runs of three at rows 1-3, 6-8, 11-13, 16-18.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [20, 4] dim_types: [RING, RING] }
  host_topology   { dims: [1, 1] }
  channels { count: 2 policy: RELAXED }
  skip_links { dim_idx: 0  pattern { start: 0  step: 5 } }
}
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

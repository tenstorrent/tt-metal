# Llama + audio enc/decoder on a single quad (tt-blaze #3089), 7-mesh ring.
# Three 4x8 RING/LINE meshes (host_topology 4x4) form the head + decode block; two 4x2
# RING/LINE meshes and two 2x2 LINE/LINE audio meshes complete the ring:
#   4x8(A) -> 4x8(B) -> 4x8(C) -> 4x2 -> 4x2 -> 2x2 -> 2x2 -> back to 4x8(A).
#   3x32 + 2x8 + 2x4 = 120 chips of 128, 8 free.
# Only the two 2x2 audio meshes are pinned (to tray 1); the rest are unpinned.
# Maps (Phase-1 control-plane init) on the SC4 subtorus quad mocks (revAB aisleC, revC aisleC).

mesh_descriptors {
  name: "MB"                                  # big: 4x8, one galaxy
  arch: BLACKHOLE
  device_topology { dims: [ 4, 8 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 4, 4 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M1"                                  # half of the old 4x4
  arch: BLACKHOLE
  device_topology { dims: [ 4, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M2"                                  # 2x2 audio mesh
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  # MGD 1.0 compatibility requires the single top-level graph to be a FABRIC graph
  # (a "POD"/other type trips "There can only be one FABRIC level graph").
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "MB" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "MB" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "MB" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M1" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "M1" mesh_id: 4 } }
  instances { mesh { mesh_descriptor: "M2" mesh_id: 5 } }
  instances { mesh { mesh_descriptor: "M2" mesh_id: 6 } }

  connections {
    nodes { mesh { mesh_descriptor: "MB" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "MB" mesh_id: 1 } }
    channels { count: 8 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "MB" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "MB" mesh_id: 2 } }
    channels { count: 8 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "MB" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 3 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 4 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 5 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 5 } }
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 6 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 6 } }
    nodes { mesh { mesh_descriptor: "MB" mesh_id: 0 } }
    channels { count: 8 policy: RELAXED }
  }
}

# --- Pinnings ---------------------------------------------------------------
# Only the two 2x2 audio meshes are pinned, to tray 1 (many-to-many / all-to-all).
# The two 4x2 meshes are intentionally left UNPINNED: pinning them (tray 3+4 columns)
# over-constrained the inter-mesh ring mapping.
#   mesh 5 -> tray 1 asic {3,4,7,8}
#   mesh 6 -> tray 1 asic {1,2,5,6}
pinnings {
  logical_fabric_node_id { mesh_id: 5 chip_id: 0 }
  logical_fabric_node_id { mesh_id: 5 chip_id: 1 }
  logical_fabric_node_id { mesh_id: 5 chip_id: 2 }
  logical_fabric_node_id { mesh_id: 5 chip_id: 3 }
  physical_asic_position { tray_id: 1 asic_location: 3 }
  physical_asic_position { tray_id: 1 asic_location: 4 }
  physical_asic_position { tray_id: 1 asic_location: 7 }
  physical_asic_position { tray_id: 1 asic_location: 8 }
}
pinnings {
  logical_fabric_node_id { mesh_id: 6 chip_id: 0 }
  logical_fabric_node_id { mesh_id: 6 chip_id: 1 }
  logical_fabric_node_id { mesh_id: 6 chip_id: 2 }
  logical_fabric_node_id { mesh_id: 6 chip_id: 3 }
  physical_asic_position { tray_id: 1 asic_location: 1 }
  physical_asic_position { tray_id: 1 asic_location: 2 }
  physical_asic_position { tray_id: 1 asic_location: 5 }
  physical_asic_position { tray_id: 1 asic_location: 6 }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

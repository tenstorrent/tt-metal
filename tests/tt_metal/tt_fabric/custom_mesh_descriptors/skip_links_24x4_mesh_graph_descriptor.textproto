# 24x4 BLACKHOLE mesh (3 hosts, 3x1 along the 24-row axis) with two dim-0 skip-link
# patterns -- the multi-rank counterpart of skip_links_8x4_mesh_graph_descriptor.textproto.
# device_topology [24,4] dim_types [LINE,RING] -> FABRIC_2D_TORUS_X.
# skip_links dim=0 start=2 step=4:
# blocks along the 24-row LINE ([2,5][6,9][10,13][14,17][18,21]) x 4 columns = 20 skip edges.
# skip_links dim=0 start=0 step=8: 8x4 sub torus skip links (blocks [0,7][8,15][16,23]).
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [24, 4] dim_types: [LINE, RING] }
  host_topology   { dims: [3, 1] }
  channels { count: 2 policy: RELAXED }
  skip_links { dim_idx: 0  pattern { start: 2  step: 4 } }
  skip_links { dim_idx: 0  pattern { start: 0  step: 8 } }
}
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

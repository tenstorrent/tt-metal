# Test descriptor: single 8x4 BLACKHOLE torus with one dim-0 express-link pattern.
# Express links: dim=0 (length 8), start=2, step=4 -> block [2,5]; wrap: LINE drops the block that would
# straddle the boundary, so row 0 <-> row 7 stays the ordinary wrap the RING axis provides rather than
# becoming a chord. Replicated across all 4 columns.
# Used by MeshGraphDescriptorTests.ExpressLinks8x4.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [8, 4] dim_types: [RING, RING] }
  host_topology   { dims: [1, 1] }
  channels { count: 2 }
  express_links { dim_idx: 0  pattern { start: 2  step: 4 } wrap: LINE}
}
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

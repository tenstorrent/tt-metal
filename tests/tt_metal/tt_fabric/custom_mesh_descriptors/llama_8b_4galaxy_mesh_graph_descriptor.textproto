# Llama-8b + audio enc/decoder decode pipeline mapped onto a single Blackhole-galaxy quad
# (128 ASICs). Design tracked in tenstorrent/tt-blaze#3089. 7-mesh ring, order from mesh 0:
#   PASSTHROUGH 4x8 -> 4x2 -> 4x2 -> PASSTHROUGH 2x2 -> PASSTHROUGH 2x2 -> 1x2 -> 1x2 -> (back).
# mesh 0 is a 4x8 RING/LINE (host 1x1, validated as a whole 4x8); meshes 5,6 are 4x8 RING/LINE
# (host 4x4, validated as 1x2 host-slices). Two 4x2 RING/LINE meshes and two 2x2 LINE/LINE audio
# meshes complete the ring.  3x32 + 2x8 + 2x4 = 120 chips of 128, 8 free.
# Only the two 2x2 audio meshes are pinned (to tray 4); the rest are unpinned.
# Inter-mesh links are STRICT: 4x8<->4x8 8, 4x8<->4x2 8, 4x2<->4x2 4, 4x2<->2x2 4, 2x2<->2x2 4, 2x2<->4x8 4.

mesh_descriptors {
  name: "PASSTHROUGH 4x8"                      # 4x8, host 1x1 (whole galaxy in one rank)
  arch: BLACKHOLE
  device_topology { dims: [ 4, 8 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "1x2"                                  # 4x8, host 4x4
  arch: BLACKHOLE
  device_topology { dims: [ 4, 8 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 4, 4 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "4x2"                                  # 4x2 RING/LINE compute mesh (one per ring arm)
  arch: BLACKHOLE
  device_topology { dims: [ 4, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "PASSTHROUGH 2x2"                      # 2x2 audio mesh
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  # MGD 1.0 compatibility requires the single top-level graph to be a FABRIC graph
  # (a "POD"/other type trips "There can only be one FABRIC level graph").
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "PASSTHROUGH 4x8" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "4x2" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "4x2" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "PASSTHROUGH 2x2" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "PASSTHROUGH 2x2" mesh_id: 4 } }
  instances { mesh { mesh_descriptor: "1x2" mesh_id: 5 } }
  instances { mesh { mesh_descriptor: "1x2" mesh_id: 6 } }

  connections {
    nodes { mesh { mesh_descriptor: "PASSTHROUGH 4x8" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "4x2" mesh_id: 1 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "4x2" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "4x2" mesh_id: 2 } }
    channels { count: 4 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "4x2" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "PASSTHROUGH 2x2" mesh_id: 3 } }
    channels { count: 4 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "PASSTHROUGH 2x2" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "PASSTHROUGH 2x2" mesh_id: 4 } }
    channels { count: 4 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "PASSTHROUGH 2x2" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "1x2" mesh_id: 5 } }
    channels { count: 4 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "1x2" mesh_id: 5 } }
    nodes { mesh { mesh_descriptor: "1x2" mesh_id: 6 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "1x2" mesh_id: 6 } }
    nodes { mesh { mesh_descriptor: "PASSTHROUGH 4x8" mesh_id: 0 } }
    channels { count: 8 policy: STRICT }
  }
}

# --- Pinnings ---------------------------------------------------------------
# Only the two 2x2 audio meshes are pinned, to tray 4 (many-to-many / all-to-all).
#   mesh 3 -> tray 4 asic {3,4,7,8}
#   mesh 4 -> tray 4 asic {1,2,5,6}
pinnings {
  logical_fabric_node_id { mesh_id: 3 chip_id: 0 }
  logical_fabric_node_id { mesh_id: 3 chip_id: 1 }
  logical_fabric_node_id { mesh_id: 3 chip_id: 2 }
  logical_fabric_node_id { mesh_id: 3 chip_id: 3 }
  physical_asic_position { tray_id: 4 asic_location: 3 }
  physical_asic_position { tray_id: 4 asic_location: 4 }
  physical_asic_position { tray_id: 4 asic_location: 7 }
  physical_asic_position { tray_id: 4 asic_location: 8 }
}
pinnings {
  logical_fabric_node_id { mesh_id: 4 chip_id: 0 }
  logical_fabric_node_id { mesh_id: 4 chip_id: 1 }
  logical_fabric_node_id { mesh_id: 4 chip_id: 2 }
  logical_fabric_node_id { mesh_id: 4 chip_id: 3 }
  physical_asic_position { tray_id: 4 asic_location: 1 }
  physical_asic_position { tray_id: 4 asic_location: 2 }
  physical_asic_position { tray_id: 4 asic_location: 5 }
  physical_asic_position { tray_id: 4 asic_location: 6 }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

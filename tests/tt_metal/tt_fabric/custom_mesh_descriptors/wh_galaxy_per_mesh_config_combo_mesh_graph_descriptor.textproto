# EXPERIMENTAL Wormhole analog of single_galaxy_per_mesh_config_combo: a single WH galaxy running ALL
# 2D per-mesh fabric configs together -- a TORUS_XY mesh, a TORUS_X mesh, a TORUS_Y mesh, and a plain
# FABRIC_2D (mesh) mesh, ring-connected. Each rank/process owns one mesh and runs that mesh's dim_types
# default config. Mirrors the Blackhole config_combo descriptor
# exactly except for arch, to probe whether WH galaxy routes heterogeneous per-mesh 2D-torus multi-mesh.
mesh_descriptors {
  name: "M_XY"
  arch: WORMHOLE_B0
  device_topology { dims: [ 2, 2 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_X"
  arch: WORMHOLE_B0
  device_topology { dims: [ 2, 4 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_Y"
  arch: WORMHOLE_B0
  device_topology { dims: [ 2, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_2D"
  arch: WORMHOLE_B0
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M_XY" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M_X"  mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M_Y"  mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M_2D" mesh_id: 3 } }

  connections {
    nodes { mesh { mesh_descriptor: "M_XY" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M_X"  mesh_id: 1 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_X"  mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M_Y"  mesh_id: 2 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_Y"  mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M_2D" mesh_id: 3 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_2D" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M_XY" mesh_id: 0 } }
    channels { count: 4 policy: RELAXED }
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

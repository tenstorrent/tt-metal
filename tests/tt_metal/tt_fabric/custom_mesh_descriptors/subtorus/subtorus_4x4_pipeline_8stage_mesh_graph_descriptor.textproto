# --- Meshes ---------------------------------------------------------------
# CPU-only test copy of blitz_decode_quad_galaxy_4x4 (quad-galaxy 4x4 torus pipeline, 8-stage ring).
# Every stage is a 4x4 torus split across 2 host ranks (2x4 + 2x4).

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 2, 1 ] }
  channels { count: 2 policy: STRICT }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 4 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 5 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 6 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 7 } }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 4 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 5 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 5 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 6 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 6 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 7 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 7 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

# --- Pinnings ---------------------------------------------------------------
# All-to-all corner pinning per mesh: the logical corner chips (0, 3, 12, 15) may map to any of the
# tray/asic positions in the set. The solver enforces a bijection, so each chip lands on a distinct ASIC.
#
# A 4x4 subtorus slice occupies 4 trays x 4 asic_locations, and the two slices of a 1x2 split-host galaxy
# use disjoint location columns (3/4/7/8 vs 1/2/5/6). The group below offers both columns, and positions
# absent from a given physical mesh are filtered out, so one set of entries covers even and odd meshes:
# whichever column the assigned physical mesh actually has is the one that survives.
#
# The two 1:1 entries anchor one chip per column to fix orientation (no rotation, folding or reflection).
# Each entry is applied as its own constraint, so the anchor for the column the mesh does not have is
# filtered away and only the matching one takes effect.
#
# mesh_id_regex expands PER matched mesh (one all-to-all group each). chip_id_regex and tray_id_regex use
# the same range/list/regex syntax.
#
# Per-board-revision corner pinnings (same scheme as gemma_4galaxy): each 4x4 corner is locked to one
# galaxy tray. Even meshes (0,2,4,6) take the Middle column (asic 3), odd meshes (1,3,5,7) the Edge
# column (asic 2). Rev A/B and Rev C swap the SW/SE corners (chip 3 / chip 12 on Middle, chip 0 / chip 15
# on Edge); one extra anchor per column (loc 7 / loc 6) fixes orientation. With host_topology [2,1] the
# two corners of each 2x4 rank land on tray pair {1,3}/{2,4} (rev A/B) or {1,2}/{3,4} (rev C).

# Middle column (even meshes, asic 3)
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 0 }
  physical_asic_position { tray_id: 1 asic_location: 3 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 1 }
  physical_asic_position { tray_id: 1 asic_location: 7 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 3 }
  physical_asic_position { tray_id: 3 asic_location: 3 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 12 }
  physical_asic_position { tray_id: 2 asic_location: 3 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 3 }
  physical_asic_position { tray_id: 2 asic_location: 3 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 12 }
  physical_asic_position { tray_id: 3 asic_location: 3 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 15 }
  physical_asic_position { tray_id: 4 asic_location: 3 }
}

# Edge column (odd meshes, asic 2)
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 0 }
  physical_asic_position { tray_id: 2 asic_location: 2 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 15 }
  physical_asic_position { tray_id: 3 asic_location: 2 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 0 }
  physical_asic_position { tray_id: 3 asic_location: 2 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 15 }
  physical_asic_position { tray_id: 2 asic_location: 2 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 3 }
  physical_asic_position { tray_id: 4 asic_location: 2 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 12 }
  physical_asic_position { tray_id: 1 asic_location: 2 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 13 }
  physical_asic_position { tray_id: 1 asic_location: 6 }
}

# --- Mesh Descriptors ------------------------------------------------------
# Subtorus quad-galaxy mock: 4x4 RING+RING torus spanning 4x2 host ranks (1x2 slice per rank, 16 ASICs).

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 4, 2 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

# --- Pinnings (single 4x4 -> Middle column; corners->asic 3, chip 1 -> tray 1 asic 7) --------
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id_regex: "0,3,12,15" }
  physical_asic_position { tray_id_regex: "1-4" asic_location: 3 }
}
pinnings {
  logical_fabric_node_id { mesh_id: 0 chip_id: 1 }
  physical_asic_position { tray_id: 1 asic_location: 7 }
}

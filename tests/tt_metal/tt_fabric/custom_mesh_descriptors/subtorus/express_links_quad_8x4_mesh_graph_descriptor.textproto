# Four single-Galaxy 8x4 tori connected in a Z-direction ring.
# Each mesh enables the dim-0 ex4 express-link pattern.

mesh_descriptors {
  name: "M_8x4"
  arch: BLACKHOLE
  device_topology { dims: [ 8, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
  express_links { dim_idx: 0 pattern { start: 2 step: 4 } }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M_8x4" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M_8x4" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M_8x4" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M_8x4" mesh_id: 3 } }

  connections {
    nodes { mesh { mesh_descriptor: "M_8x4" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M_8x4" mesh_id: 1 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_8x4" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M_8x4" mesh_id: 2 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_8x4" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M_8x4" mesh_id: 3 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_8x4" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M_8x4" mesh_id: 0 } }
    channels { count: 8 policy: RELAXED }
    assign_z_direction: true
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

# Llama + audio enc/decoder on a single quad (tt-blaze #3089), 6-mesh ring variant.
# The 4x4 is split into TWO 4x2 RING,LINE meshes (8 chips each), so the ring is
# M0[4,8] -> 4x2 -> 4x2 -> M2[2,2] -> M2[2,2] -> M3[4,16] -> M0.
#   M0=32 + M1(x2)=16 + M2(x2)=8 + M3=64 = 120 chips of 128, 8 free.  No pinnings.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 8 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 4 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M1"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M2"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M3"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 16 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 4, 8 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  # MGD 1.0 compatibility requires the single top-level graph to be a FABRIC graph
  # (a "POD"/other type trips "There can only be one FABRIC level graph").
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M1" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M1" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M2" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "M2" mesh_id: 4 } }
  instances { mesh { mesh_descriptor: "M3" mesh_id: 5 } }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 1  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 2  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 3  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 4  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "M3" mesh_id: 5  } }
    channels { count: 8 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M3" mesh_id: 5 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    channels { count: 8 policy: RELAXED }
  }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

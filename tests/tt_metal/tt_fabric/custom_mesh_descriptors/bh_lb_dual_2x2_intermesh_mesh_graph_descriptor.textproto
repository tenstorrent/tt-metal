# Blackhole P150 loudbox as TWO 2x2 meshes, one per rank, joined by an inter-mesh fabric link.
#
# The multihost socket tests bind one MeshId per rank (SocketConfig takes a sender and a receiver
# mesh id), which the single-mesh-split-across-host-ranks descriptor cannot express -- there both
# ranks are host ranks of mesh 0. Use that one for BigMeshDualRankTest and this one for anything
# opening a socket between ranks.
#
# The split follows the board's 3-cube: {0,1,4,5} and {2,3,6,7} are each a genuine 2x2 (0-1, 4-5,
# 0-4, 1-5 and 2-3, 6-7, 2-6, 3-7), and the four remaining edges 0-2, 1-3, 4-6, 5-7 are the
# inter-mesh links.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 1 } }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    channels { count: 2 policy: RELAXED }
    directional: false
    assign_z_direction: true
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

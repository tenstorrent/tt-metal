# Single-galaxy "everything combined": a BIG 4x4 TORUS_X mesh split across TWO host ranks (host_topology
# 1x2 -> each process owns a 4x2 half of the one mesh, and the X-ring wraps across the host boundary),
# inter-connected to a 2x2 TORUS_Y mesh and a 2x2 FABRIC_2D mesh. Exercises multi-rank (one mesh over 2
# processes) + multi-mesh + heterogeneous per-mesh configs (TORUS_X / TORUS_Y / FABRIC_2D, incl.
# mesh<->torus inter-mesh links) all at once. Each mesh's config is its dim_types default; both ranks
# of M_BIG run the same TORUS_X.
mesh_descriptors {
  name: "M_BIG"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 2 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_Y"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_2D"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M_BIG" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M_Y"   mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M_2D"  mesh_id: 2 } }

  connections {
    nodes { mesh { mesh_descriptor: "M_BIG" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M_Y"   mesh_id: 1 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_Y"   mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M_2D"  mesh_id: 2 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_2D"  mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M_BIG" mesh_id: 0 } }
    channels { count: 4 policy: RELAXED }
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

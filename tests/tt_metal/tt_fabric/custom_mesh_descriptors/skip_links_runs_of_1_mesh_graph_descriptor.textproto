# Synthetic tie-break fixture: step 3 skips one row per block, so every leaf run has length 1 and
# each lone leaf sits equidistant between two anchors. 24 rows RING, one pattern -> one ring over the
# 16 block endpoints, 8 lone leaves at rows 1,4,7,...,22.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [24, 4] dim_types: [RING, RING] }
  host_topology   { dims: [1, 1] }
  channels { count: 2 policy: RELAXED }
  skip_links { dim_idx: 0  pattern { start: 0  step: 3 } }
}
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

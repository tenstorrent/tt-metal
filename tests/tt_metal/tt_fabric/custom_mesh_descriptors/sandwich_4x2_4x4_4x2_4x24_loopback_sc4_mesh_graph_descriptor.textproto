# Loopback ring on a full SC4 (128 ASICs): 4x2 -> 4x4 -> 4x2 -> 4x24 -> (back to first 4x2).
# The two 4x2 RING/LINE (shared M_4x2, mesh 0 and 2) sandwich the 4x4 RING/RING (mesh 1); together
# 8 + 16 + 8 = 32 = one galaxy. The 4x24 RING/LINE (mesh 3) is the remaining 3 galaxies, mapped via
# the new 4x24_Mesh PGD grouping.
#
# NOTE: does NOT currently map on the SC4 quad mock (success=false). Each mesh finds groupings, but
# there is no mutually-disjoint combination. Disjoint placement counts: M_4x24=1 (locks 3 of the 4
# galaxies), M_4x4=4 (one 4x4_SplitHost_flat_torus_xy per galaxy), M_4x2=28. M_4x4 being 4x4
# RING/RING forces the half-tray-split torus, which cannot tile galaxy 0 disjointly with the two
# 4x2s. Making the 4x4 RING/LINE lets the sandwich galaxy tile. Kept as a shape/coverage case.
mesh_descriptors {
  name: "M_4x2"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_4x4"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_4x24"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 24 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 3 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M_4x2"  mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M_4x4"  mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M_4x2"  mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M_4x24" mesh_id: 3 } }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x2" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M_4x4" mesh_id: 1 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M_4x2" mesh_id: 2 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x2"  mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M_4x24" mesh_id: 3 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x24" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M_4x2"  mesh_id: 0 } }
    channels { count: 2 policy: RELAXED }
  }
}
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

# Gemma decode pipeline on a 4-galaxy SC4 (128 ASICs): eight 4x4 RING/RING meshes -- mesh 0 has
# host_topology [1,1]; the other 7 have host_topology [1,4] (shared M_4x4_h14 descriptor).
# 8 x 16 = 128. Ring-connected 0-1-2-3-4-5-6-7-0.
mesh_descriptors {
  name: "M_4x4_h11"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_4x4_h14"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 4, 1 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M_4x4_h11" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 4 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 5 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 6 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 7 } }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h11" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 1 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 2 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 3 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 4 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 5 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 5 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 6 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 6 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 7 } }
    channels { count: 8 policy: STRICT }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 7 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h11" mesh_id: 0 } }
    channels { count: 8 policy: STRICT }
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

# --- Pinnings ---------------------------------------------------------------
# One pinning per 4x4 corner, even and odd meshes (0-7). Each corner is locked to one
# galaxy tray (1 NW, 2 NE, 3 SW, 4 SE). Even chips 3/12 and odd chips 0/15 swap trays
# 2 and 3 on BH_REV_AB vs BH_REV_C; those pins are ignored on other board types.
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 0 }
  physical_asic_position { tray_id: 1 asic_location: 3 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 1 }
  physical_asic_position { tray_id: 1 asic_location: 7 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 3 }
  physical_asic_position { tray_id: 3 asic_location: 3 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 12 }
  physical_asic_position { tray_id: 2 asic_location: 3 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 3 }
  physical_asic_position { tray_id: 2 asic_location: 3 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 12 }
  physical_asic_position { tray_id: 3 asic_location: 3 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 15 }
  physical_asic_position { tray_id: 4 asic_location: 3 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 0 }
  physical_asic_position { tray_id: 2 asic_location: 2 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 15 }
  physical_asic_position { tray_id: 3 asic_location: 2 }
  board_revision: BH_REV_AB
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 0 }
  physical_asic_position { tray_id: 3 asic_location: 2 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 15 }
  physical_asic_position { tray_id: 2 asic_location: 2 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 3 }
  physical_asic_position { tray_id: 4 asic_location: 2 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 12 }
  physical_asic_position { tray_id: 1 asic_location: 2 }
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 13 }
  physical_asic_position { tray_id: 1 asic_location: 6 }
}

# Gemma decode pipeline on a 4-galaxy SC4 (128 ASICs): eight 4x4 RING/RING meshes -- mesh 0 has
# host_topology [1,1]; the other 7 have host_topology [1,4] (shared M_4x4_h14 descriptor).
# 8 x 16 = 128. Ring-connected 0-1-2-3-4-5-6-7-0.
mesh_descriptors {
  name: "M_4x4_h11"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M_4x4_h14"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 4 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M_4x4_h11" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 4 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 5 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 6 } }
  instances { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 7 } }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h11" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 1 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 2 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 3 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 4 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 5 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 5 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 6 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 6 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 7 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M_4x4_h14" mesh_id: 7 } }
    nodes { mesh { mesh_descriptor: "M_4x4_h11" mesh_id: 0 } }
    channels { count: 2 policy: RELAXED }
  }
}
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

# The fsd_quad_host pod (one 8x4 mesh per host, intra count 2, four RELAXED ring connections with a
# different count on each) plus one RELAXED connection across the pod's diagonal, mesh 0 to mesh 2.
# The four hosts are cabled as a ring, so no factory cable and no live cable exists for that diagonal:
# the connection is logical-only (issue #56762). Placement finishes through the zero-link rung on both
# the rank-binding pass and the control-plane pass, pairing binds nothing across it, and LinkHealth
# files nothing for it (there is no factory cable to be missing). Run on the missing_links captures,
# whose four missing factory cables are still filed exactly as they are without the diagonal.
mesh_descriptors {
  name: "M"
  arch: BLACKHOLE
  device_topology { dims: [ 8, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M" mesh_id: 3 } }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 1 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 2 } }
    channels { count: 8 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 3 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 0 } }
    channels { count: 16 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 2 } }
    channels { count: 4 policy: RELAXED }
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

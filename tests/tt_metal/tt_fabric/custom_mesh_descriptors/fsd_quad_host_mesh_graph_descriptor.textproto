# Four Blackhole galaxies, one mesh per host. A same-host cable then lands inside one mesh
# and a cross-host cable lands across two, which is how a missing connection is classified.
# Intra count 2, relaxed. Chip 0 to chip 8 is the subtorus connection the mesh graph does not
# use, so that hole is unused. Chip 15 to chip 23 is the torus connection (four cables, one
# removed). Chip 0 chan 6 to chip 4 chan 0 is the mesh connection (two cables, one removed).
# Every intermesh connection is RELAXED, and each boundary asks for a different count.
# Mesh 2 to mesh 3 is the boundary missing one factory cable (16 factory, 15 live). Count 4
# is already covered by the live cables, so that cable is unused and 4 channels are registered.
mesh_descriptors {
  name: "M"
  arch: BLACKHOLE
  device_topology { dims: [ 8, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M" mesh_id: 3 } }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 1 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 2 } }
    channels { count: 8 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 3 } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M" mesh_id: 0 } }
    channels { count: 16 policy: RELAXED }
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

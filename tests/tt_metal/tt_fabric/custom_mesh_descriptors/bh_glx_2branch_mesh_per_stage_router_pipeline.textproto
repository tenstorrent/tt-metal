# --- Mesh Descriptors ------------------------------------------------------
# Mesh-per-stage router pipeline: every pipeline stage is its OWN mesh (host [1,1],
# one rank each), so stage shapes are free to differ -- unlike a single BigMesh carved
# by host_topology, which deals one identical slice shape to every rank.
#
# Topology (both branches loop back to the router):
#
#   Branch A: router(4x2) -> 4x1 -> ( 4x1 -> 4x1 -> 4x1 -> 4x1 -> 4x1 -> 4x2 ) x10 -> 4x4 -> router
#   Branch B: router(4x2) -> 4x1 -> ( 4x2 ) x5 -> router
#
# 69 meshes / 69 ranks total:
#   mesh 0            router                4x2
#   mesh 1            branch A head         4x1
#   meshes 2..61      branch A body         ten groups of (4x1 x5 + 4x2)
#   mesh 62           branch A tail         4x4
#   mesh 63           branch B head         4x1
#   meshes 64..68     branch B body         4x2 x5
#
# 352 chips = 11 BLACKHOLE galaxies. The row axis is RING (the 4-row Y ring the
# decoder / lm-head CCLs need); the column axis is LINE. The router sits at fabric degree 4
# -- a_send / a_recv / b_send / b_recv -- which is what a two-branch FABRIC-return fork needs.
#
# Physical placement is NOT encoded here: pass this to
#   tt-run --mesh-graph-descriptor <this file> --hosts <hosts>
# and tt-run's phase-1 (generate_rank_bindings) solves the graph against the real cabling.

mesh_descriptors {
  name: "S4x1"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 1 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

mesh_descriptors {
  name: "S4x2"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

mesh_descriptors {
  name: "S4x4"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  # MGD 1.0 compatibility requires the single top-level graph to be a FABRIC graph
  # (a "POD"/other type trips "There can only be one FABRIC level graph").
  type: "FABRIC"

  instances { mesh { mesh_descriptor: "S4x2" mesh_id: 0 } }  # router (4x2)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 1 } }  # A head (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 2 } }  # A group 0 stage 0 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 3 } }  # A group 0 stage 1 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 4 } }  # A group 0 stage 2 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 5 } }  # A group 0 stage 3 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 6 } }  # A group 0 stage 4 (4x1)
  instances { mesh { mesh_descriptor: "S4x2" mesh_id: 7 } }  # A group 0 join (4x2)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 8 } }  # A group 1 stage 0 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 9 } }  # A group 1 stage 1 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 10 } }  # A group 1 stage 2 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 11 } }  # A group 1 stage 3 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 12 } }  # A group 1 stage 4 (4x1)
  instances { mesh { mesh_descriptor: "S4x2" mesh_id: 13 } }  # A group 1 join (4x2)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 14 } }  # A group 2 stage 0 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 15 } }  # A group 2 stage 1 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 16 } }  # A group 2 stage 2 (4x1)
  instances { mesh { mesh_descriptor: "S4x1" mesh_id: 17 } }  # A group 2 stage 3 (4x1)

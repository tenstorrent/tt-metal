    nodes { mesh { mesh_descriptor: "S4x1" mesh_id: 58 } }
    nodes { mesh { mesh_descriptor: "S4x1" mesh_id: 59 } }
    channels { count: 8 policy: RELAXED }
  }  # A group 9 stage 2 -> A group 9 stage 3
  connections {
    nodes { mesh { mesh_descriptor: "S4x1" mesh_id: 59 } }
    nodes { mesh { mesh_descriptor: "S4x1" mesh_id: 60 } }
    channels { count: 8 policy: RELAXED }
  }  # A group 9 stage 3 -> A group 9 stage 4
  connections {
    nodes { mesh { mesh_descriptor: "S4x1" mesh_id: 60 } }
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 61 } }
    channels { count: 8 policy: RELAXED }
  }  # A group 9 stage 4 -> A group 9 join
  connections {
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 61 } }
    nodes { mesh { mesh_descriptor: "S4x4" mesh_id: 62 } }
    channels { count: 8 policy: RELAXED }
  }  # A group 9 join -> A tail
  connections {
    nodes { mesh { mesh_descriptor: "S4x4" mesh_id: 62 } }
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 0 } }
    channels { count: 8 policy: RELAXED }
  }  # A tail -> router
  # --- Branch B ------------------------------------------------------------
  connections {
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "S4x1" mesh_id: 63 } }
    channels { count: 8 policy: RELAXED }
  }  # router -> B head
  connections {
    nodes { mesh { mesh_descriptor: "S4x1" mesh_id: 63 } }
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 64 } }
    channels { count: 8 policy: RELAXED }
  }  # B head -> B stage 0
  connections {
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 64 } }
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 65 } }
    channels { count: 8 policy: RELAXED }
  }  # B stage 0 -> B stage 1
  connections {
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 65 } }
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 66 } }
    channels { count: 8 policy: RELAXED }
  }  # B stage 1 -> B stage 2
  connections {
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 66 } }
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 67 } }
    channels { count: 8 policy: RELAXED }
  }  # B stage 2 -> B stage 3
  connections {
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 67 } }
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 68 } }
    channels { count: 8 policy: RELAXED }
  }  # B stage 3 -> B stage 4
  connections {
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 68 } }
    nodes { mesh { mesh_descriptor: "S4x2" mesh_id: 0 } }
    channels { count: 8 policy: RELAXED }
  }  # B stage 4 -> router
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

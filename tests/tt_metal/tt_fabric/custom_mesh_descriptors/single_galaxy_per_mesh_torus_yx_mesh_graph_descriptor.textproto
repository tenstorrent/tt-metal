# --- Meshes ---------------------------------------------------------------
# Single-galaxy two-mesh repro exercising PER-MESH fabric configs declared in the MGD: the two connected
# meshes run DIFFERENT 2D torus axes.
#   - M_Y: 2x2 RING,LINE  -> FABRIC_2D_TORUS_Y (ring on dim 0).
#   - M_X: 2x4 LINE,RING  -> FABRIC_2D_TORUS_X (genuine ring on the size-4 dim 1).
# The two meshes (12 ASICs) sit on one 32-ASIC galaxy and are inter-mesh connected. Reuses the generic
# multi-mesh sanity config (topology-agnostic; the MGD fixes the per-mesh configs). Checks that two meshes
# running different torus configs coexist and route inter-mesh without hanging/starving (relates to #56515).
mesh_descriptors {
  name: "M_Y"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels {
    count: 2
    policy: RELAXED
  }
  fabric_config: FABRIC_2D_TORUS_Y
}
mesh_descriptors {
  name: "M_X"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 4 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels {
    count: 2
    policy: RELAXED
  }
  fabric_config: FABRIC_2D_TORUS_X
}
graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M_Y" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M_X" mesh_id: 1 } }

  connections {
    nodes { mesh { mesh_descriptor: "M_Y" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M_X" mesh_id: 1 } }
    channels { count: 4 policy: RELAXED }
  }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

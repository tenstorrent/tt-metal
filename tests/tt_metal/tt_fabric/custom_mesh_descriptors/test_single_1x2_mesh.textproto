# A single 1x2 mesh, with no other mesh and no intermesh connections.
#
# Used by the PGD-to-MGD downgrade tests, where the interesting behaviour is which grouping gets
# committed for this one mesh rather than how several meshes relate to each other.
mesh_descriptors {
  name: "M0"
  arch: WORMHOLE_B0
  device_topology { dims: [ 1, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

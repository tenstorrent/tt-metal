# RELAXED-POLICY variant of t3k_assign_z_conflict_mesh_graph_descriptor.textproto (issue #56762).
# Identical engineered assign_z conflict, but every inter-mesh connection carries `policy: RELAXED`,
# so the boundary that loses mesh 0's single Z lane is tolerated as a ZERO-link (logical-only)
# connection instead of failing control-plane init. The STRICT sibling stays a negative test.
#
# --- Meshes ---------------------------------------------------------------
# Four 1x2 meshes wired in a 2x2 grid (same layout as t3k_1x2), one per N300 board:
#     mesh0 - mesh1
#       |       |
#     mesh2 - mesh3
# Mesh 0's right-hand chip borders BOTH mesh 1 (horizontal) and mesh 2 (vertical); both boundaries are
# assign_z_direction, so that chip's single Z lane is contended. A Z-only boundary that does not get it
# resolves zero routers; under this RELAXED policy that is tolerated (logical-only) and init succeeds. Driven
# by a hard rank binding (TT_VISIBLE_DEVICES 0..3). Used by MultiHost.T3KAssignZConflictLosingBoundaryResolvesZero.
mesh_descriptors {
  name: "M0"
  arch: WORMHOLE_B0
  device_topology { dims: [ 1, 2 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Graphs ---------------------------------------------------------------

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 3 } }

  # mesh 0 <-> mesh 1 (horizontal) : assign_z
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    channels { count: 2 policy: RELAXED }
    assign_z_direction: true
  }
  # mesh 2 <-> mesh 3 (horizontal)
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
    channels { count: 2 policy: RELAXED }
  }

  # mesh 0 <-> mesh 2 (vertical) : assign_z  (CONFLICT -- shares mesh 0's bridge chip Z lane with 0<->1)
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    channels { count: 2 policy: RELAXED }
    assign_z_direction: true
  }
  # mesh 1 <-> mesh 3 (vertical)
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
    channels { count: 2 policy: RELAXED }
  }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

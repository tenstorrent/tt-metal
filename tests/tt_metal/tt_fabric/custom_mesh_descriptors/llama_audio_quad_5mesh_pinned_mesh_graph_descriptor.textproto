# Llama + audio enc/decoder on a single quad (tt-blaze #3089), 5-mesh ring option.
# M0 [4,8] head (32 chips) -> M1 [4,4] (16) -> M2 [2,2] (4) -> M2 [2,2] (4) -> M3 [4,16]
# decode (64) -> back to M0.  120 chips used out of 128, 8 free.
# Intermesh topology is a 5-cycle ring (each mesh degree 2). Verbatim from the issue.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 8 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 4 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M1"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 2 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M2"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
mesh_descriptors {
  name: "M3"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 16 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 4, 8 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  # MGD 1.0 compatibility requires the single top-level graph to be a FABRIC graph
  # (a "POD"/other type trips "There can only be one FABRIC level graph").
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M1" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M2" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M2" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "M3" mesh_id: 4 } }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 1  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M1" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 2  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 3  } }
    channels { count: 4 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M2" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M3" mesh_id: 4  } }
    channels { count: 8 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M3" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    channels { count: 8 policy: RELAXED }
  }
}

# --- Pinnings ---------------------------------------------------------------
# Fully pin both 2x2 audio meshes (M2 instances) to tray 4, many-to-many
# (all-to-all): each entry lists all 4 FNIDs and all 4 ASIC positions, so any
# node may land on any listed position. The two meshes tile all 8 tray-4 ASICs.
#   mesh 2, FNID {0,1,2,3} -> tray 4, asic {3,4,7,8}
#   mesh 3, FNID {0,1,2,3} -> tray 4, asic {1,2,5,6}
pinnings {
  logical_fabric_node_id { mesh_id: 2 chip_id: 0 }
  logical_fabric_node_id { mesh_id: 2 chip_id: 1 }
  logical_fabric_node_id { mesh_id: 2 chip_id: 2 }
  logical_fabric_node_id { mesh_id: 2 chip_id: 3 }
  physical_asic_position { tray_id: 4 asic_location: 3 }
  physical_asic_position { tray_id: 4 asic_location: 4 }
  physical_asic_position { tray_id: 4 asic_location: 7 }
  physical_asic_position { tray_id: 4 asic_location: 8 }
}
pinnings {
  logical_fabric_node_id { mesh_id: 3 chip_id: 0 }
  logical_fabric_node_id { mesh_id: 3 chip_id: 1 }
  logical_fabric_node_id { mesh_id: 3 chip_id: 2 }
  logical_fabric_node_id { mesh_id: 3 chip_id: 3 }
  physical_asic_position { tray_id: 4 asic_location: 1 }
  physical_asic_position { tray_id: 4 asic_location: 2 }
  physical_asic_position { tray_id: 4 asic_location: 5 }
  physical_asic_position { tray_id: 4 asic_location: 6 }
}

# Pin the whole 4x4 mesh (M1, mesh_id 1, FNID 0..15) many-to-many onto tray 1 + tray 2,
# every ASIC location (1..8) -> 16 nodes over 16 positions (tiles both trays exactly).
pinnings {
  logical_fabric_node_id { mesh_id: 1 chip_id: 0 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 1 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 2 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 3 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 4 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 5 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 6 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 7 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 8 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 9 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 10 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 11 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 12 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 13 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 14 }
  logical_fabric_node_id { mesh_id: 1 chip_id: 15 }
  physical_asic_position { tray_id: 1 asic_location: 1 }
  physical_asic_position { tray_id: 1 asic_location: 2 }
  physical_asic_position { tray_id: 1 asic_location: 3 }
  physical_asic_position { tray_id: 1 asic_location: 4 }
  physical_asic_position { tray_id: 1 asic_location: 5 }
  physical_asic_position { tray_id: 1 asic_location: 6 }
  physical_asic_position { tray_id: 1 asic_location: 7 }
  physical_asic_position { tray_id: 1 asic_location: 8 }
  physical_asic_position { tray_id: 2 asic_location: 1 }
  physical_asic_position { tray_id: 2 asic_location: 2 }
  physical_asic_position { tray_id: 2 asic_location: 3 }
  physical_asic_position { tray_id: 2 asic_location: 4 }
  physical_asic_position { tray_id: 2 asic_location: 5 }
  physical_asic_position { tray_id: 2 asic_location: 6 }
  physical_asic_position { tray_id: 2 asic_location: 7 }
  physical_asic_position { tray_id: 2 asic_location: 8 }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

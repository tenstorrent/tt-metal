# Four meshes of four different shapes, chained:
#
#   D (2x2) --- C (1x3) --- B (1x2) --- A (1x1)
#
# 4 + 3 + 2 + 1 = 10 chips, exactly the ten in test_10asic_square_fork.textproto, so the placement
# must use every chip and cannot hide a bad choice in spare room.
#
# On that PSD the chain admits exactly one placement:
#
#   D = {100,101,102,103}   C = {104,105,106}   B = {107,108}   A = {109}
#
# D is forced onto the 4-cycle, the only place a 2x2 fits. C must then touch D, so it must take the
# junction chip 104. From there C can run down either branch, and the branch it takes is the whole
# difficulty: taking the long one, C = {104,107,108}, leaves {105,106} for B and {109} for A, and
# although B still touches C, A is left touching only 108 -- a chip inside C -- so the B--A seam has
# nothing under it. Only C = {104,105,106} leaves B and A room to chain off each other.

# --- Meshes ---------------------------------------------------------------

mesh_descriptors {
  name: "D"  # 2x2
  arch: WORMHOLE_B0
  device_topology { dims: [ 2, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

mesh_descriptors {
  name: "C"  # 1x3
  arch: WORMHOLE_B0
  device_topology { dims: [ 1, 3 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

mesh_descriptors {
  name: "B"  # 1x2
  arch: WORMHOLE_B0
  device_topology { dims: [ 1, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

mesh_descriptors {
  name: "A"  # 1x1
  arch: WORMHOLE_B0
  device_topology { dims: [ 1, 1 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

# --- Graph ----------------------------------------------------------------

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "D" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "C" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "B" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "A" mesh_id: 3 } }

  connections {
    nodes { mesh { mesh_descriptor: "D" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "C" mesh_id: 1 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "C" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "B" mesh_id: 2 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "B" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "A" mesh_id: 3 } }
    channels { count: 2 policy: RELAXED }
  }
}

# --- Instantiation --------------------------------------------------------
top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

# Three Keraunos test chips (keraunos_3chip_cluster_desc.yaml) as a 1x3 line, one link between neighbours.

mesh_descriptors {
  name: "M0"
  arch: QUASAR
  device_topology { dims: [ 1, 3 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 1 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

            src_chan: 2
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 1
            is_local: true
          }
          eth_connections {
            src_chan: 4
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 5
            dst_chan: 3
            is_local: true

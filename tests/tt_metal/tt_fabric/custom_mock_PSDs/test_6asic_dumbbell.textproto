# PSD for the two-descriptor test: six chips in a line, pinched in the middle by a single-channel
# link, with one 4-channel link on the left and one 3-channel link on the right.
#
#     100 == 101 ==== 102 -- 103 ==== 104 == 105
#         2       4        1       3       2
#
# Two descriptors are placed on this at once and neither has any seam to the other, so nothing but
# chip-disjointness keeps them apart. The 4-channel link is the only one that can carry the first
# descriptor's seam and the 3-channel link is the only remaining one that can carry the second's,
# which puts each descriptor on its own side of the 1-channel pinch.

target_device_type: 0
system_graph {
  asic_connectivity_graph {
    host_name: "host0"
    asic_topologies {
      asic_id: 100
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 101
      topology {
        asic_connections {
          dst_asic_id: 100
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true

            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 104
      topology {
        asic_connections {
          dst_asic_id: 103
          eth_connections {
            src_chan: 0
            dst_chan: 1
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 2
            dst_chan: 3
            is_local: true
          }
        }
        asic_connections {
          dst_asic_id: 105
          eth_connections {
            src_chan: 3

#
# A 2x4 grid of ASICs split into two hosts BY ROW -- the mirror of test_8asic_2x4_hosts_by_column,
# so the same host_topology assertions can be made on the other axis and neither is special-cased.
#
#   100 101 102 103
#   ----------------
#   104 105 106 107
#
#   host of each ASIC:
#   h0 h0 h0 h0
#   h1 h1 h1 h1
#
# Every ASIC gets its own (tray_id, asic_location) = (row+1, col+1) so a PGD can name individual
# chips and pinnings stay injective. Links carry 2 channels and are marked non-local exactly when
# they cross a host boundary. Channels 0/1 run along a row, 2/3 along a column.
target_device_type: 0
system_graph {
  asic_connectivity_graph {
    host_name: "host0"
    asic_topologies {
      asic_id: 100
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
        asic_connections {
          dst_asic_id: 104

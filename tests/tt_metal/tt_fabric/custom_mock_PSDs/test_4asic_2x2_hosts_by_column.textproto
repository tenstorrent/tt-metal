      src_chan: 0
      dst_chan: 0
      is_local: false
    }
  }
  exit_connections {
    src_exit_node: 100
    dst_exit_node: 101
    eth_conn {
      src_chan: 1
      dst_chan: 1
      is_local: false
    }
  }
  exit_connections {
    src_exit_node: 102
    dst_exit_node: 103
    eth_conn {
      src_chan: 0
      dst_chan: 0
      is_local: false
    }
  }
  exit_connections {
    src_exit_node: 102
    dst_exit_node: 103
    eth_conn {
      src_chan: 1
      dst_chan: 1
      is_local: false

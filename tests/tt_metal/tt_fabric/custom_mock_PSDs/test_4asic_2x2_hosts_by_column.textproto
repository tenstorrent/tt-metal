#
# A 2x2 grid of ASICs split into two hosts BY COLUMN: the square counterpart of
# test_8asic_2x4_hosts_by_column. Because a 2x2 mesh is symmetric, a declared [2,1] host_topology and
# a declared [1,2] one describe the same partition up to a quarter turn, so a split that straddles
# this boundary in one orientation can still be seated by turning the mesh. On the oblong 2x4 there
# is no such turn.
#
#   100 | 101
#   102 | 103
#
#   host of each ASIC:
#   h0 h1
#   h0 h1
#
# Every ASIC gets its own (tray_id, asic_location) = (row+1, col+1) so a PGD can name individual
# chips and pinnings stay injective. Links carry 2 channels and are marked non-local exactly when
# they cross a host boundary. Channels 0/1 run along a row, 2/3 along a column. Both axes are 2, so
# there are no wrap links: a wrap would duplicate the link already beside it.
target_device_type: 0
system_graph {
  asic_connectivity_graph {
    host_name: "host0"
    asic_topologies {
      asic_id: 100
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: false
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: false
          }
        }
        asic_connections {
          dst_asic_id: 102
          eth_connections {
            src_chan: 2
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 3
            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 102
      topology {
        asic_connections {
          dst_asic_id: 103
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: false
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: false
          }
        }
        asic_connections {
          dst_asic_id: 100
          eth_connections {
            src_chan: 2
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 3
            is_local: true
          }
        }
      }
    }
  }
  asic_connectivity_graph {
    host_name: "host1"
    asic_topologies {
      asic_id: 101
      topology {
        asic_connections {
          dst_asic_id: 100
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: false
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: false
          }
        }
        asic_connections {
          dst_asic_id: 103
          eth_connections {
            src_chan: 2
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 3
            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 103
      topology {
        asic_connections {
          dst_asic_id: 102
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: false
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: false
          }
        }
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 2
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 3
            is_local: true
          }
        }
      }
    }
  }
  host_connectivity_graph {
    src_host_name: "host0"
    host_connections {
      dst_host_name: "host1"
      exit_node_connections {
        src_exit_node: 100
        dst_exit_node: 101
        eth_conn {
          src_chan: 0
          dst_chan: 0
          is_local: false
        }
      }
      exit_node_connections {
        src_exit_node: 100
        dst_exit_node: 101
        eth_conn {
          src_chan: 1
          dst_chan: 1
          is_local: false
        }
      }
      exit_node_connections {
        src_exit_node: 102
        dst_exit_node: 103
        eth_conn {
          src_chan: 0
          dst_chan: 0
          is_local: false
        }
      }
      exit_node_connections {
        src_exit_node: 102
        dst_exit_node: 103
        eth_conn {
          src_chan: 1
          dst_chan: 1
          is_local: false
        }
      }
    }
  }
  host_connectivity_graph {
    src_host_name: "host1"
    host_connections {
      dst_host_name: "host0"
      exit_node_connections {
        src_exit_node: 101
        dst_exit_node: 100
        eth_conn {
          src_chan: 0
          dst_chan: 0
          is_local: false
        }
      }
      exit_node_connections {
        src_exit_node: 101
        dst_exit_node: 100
        eth_conn {
          src_chan: 1
          dst_chan: 1
          is_local: false
        }
      }
      exit_node_connections {
        src_exit_node: 103
        dst_exit_node: 102
        eth_conn {
          src_chan: 0
          dst_chan: 0
          is_local: false
        }
      }
      exit_node_connections {
        src_exit_node: 103
        dst_exit_node: 102
        eth_conn {
          src_chan: 1
          dst_chan: 1
          is_local: false
        }
      }
    }
  }
}

#
# A 2x3 grid of ASICs split into two hosts BY ROW, so the host grid is [2,1]. The odd third
# column is the point: a declared host_topology of [1,3] divides this mesh into three ranks, more
# ranks than there are hosts, yet every one of them is a column with a chip on each host. Being
# finer than the machine does not help a split that runs across the boundary instead of along it.
#
#   100 101 102   host0
#   -------------------
#   103 104 105   host1
#
# Every ASIC gets its own (tray_id, asic_location) = (row+1, col+1) so a PGD can name individual
# chips and pinnings stay injective. Links carry 2 channels and are marked non-local exactly when
# they cross a host boundary. Channels 0/1 run along a row, 2/3 along a column. There are no wrap
# links: these are plain grids.
target_device_type: 0
system_graph {
  asic_connectivity_graph {
    host_name: "host0"
    asic_topologies {
      asic_id: 100
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
        asic_connections {
          dst_asic_id: 103
          eth_connections {
            src_chan: 2
            dst_chan: 2
            is_local: false

# Minimal PSD for testing adjacency-guided placement.
#
# Four ASICs wired in a line, two ethernet channels per link:
#
#   100 == 101 == 102 == 103
#
# Contrast with test_4asic_2mesh.textproto, which has the same four ASICs but as two
# disconnected pairs. The pair of files isolates the seam constraint: a descriptor with two
# connected 1x2 meshes must place here and must fail there.
target_device_type: 0
system_graph {
  asic_connectivity_graph {
    host_name: "host0"
    asic_topologies {
      asic_id: 100
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 101
      topology {
        asic_connections {
          dst_asic_id: 100
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
        asic_connections {
          dst_asic_id: 102
          eth_connections {
            src_chan: 2
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 3
            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 102
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 2
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 3
            is_local: true
          }
        }
        asic_connections {
          dst_asic_id: 103
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 103
      topology {
        asic_connections {
          dst_asic_id: 102
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
      }
    }
  }
}
asic_descriptors {
  asic_id: 100
  asic_descriptor {
    tray_id: 0
    asic_location: 0
    board_type: 1
    unique_id: 100
    host_name: "host0"
  }
}
asic_descriptors {
  asic_id: 101
  asic_descriptor {
    tray_id: 0
    asic_location: 1
    board_type: 1
    unique_id: 101
    host_name: "host0"
  }
}
asic_descriptors {
  asic_id: 102
  asic_descriptor {
    tray_id: 0
    asic_location: 2
    board_type: 1
    unique_id: 102
    host_name: "host0"
  }
}
asic_descriptors {
  asic_id: 103
  asic_descriptor {
    tray_id: 0
    asic_location: 3
    board_type: 1
    unique_id: 103
    host_name: "host0"
  }
}
host_to_rank {
  host_name: "host0"
  rank: 0
}
ethernet_firmware_version {
  major: 1
  minor: 0
  patch: 0
}

# PSD for the channel-policy tests: three chips in a line whose two links are different widths.
#
#     100 == 101 ==== 102
#         2       4
#
# Two single-chip meshes are placed on this. Which pair they take is decided entirely by how many
# channels their seam asks for and whether that count is a requirement or a preference:
#
#   a seam wanting 4 channels can only be met on 101-102,
#   a seam wanting more than 4 cannot be met anywhere, and what happens then is the policy's business
#   -- STRICT has no placement, RELAXED should still place and take the widest seam it can, 101-102.

target_device_type: 0
system_graph {
  asic_connectivity_graph {
    host_name: "host0"
    asic_topologies {
      asic_id: 100
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 101
      topology {
        asic_connections {
          dst_asic_id: 100
          eth_connections {
            src_chan: 0
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 1
            is_local: true
          }
        }
        asic_connections {
          dst_asic_id: 102
          eth_connections {
            src_chan: 2
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 1
            is_local: true
          }
          eth_connections {
            src_chan: 4
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 5
            dst_chan: 3
            is_local: true
          }
        }
      }
    }
    asic_topologies {
      asic_id: 102
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 0
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 3
            is_local: true
          }
          eth_connections {
            src_chan: 2
            dst_chan: 4
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 5
            is_local: true
          }
        }
      }
    }
  }
}
asic_descriptors {
  asic_id: 100
  asic_descriptor {
    tray_id: 0
    asic_location: 0
    board_type: 1
    unique_id: 100
    host_name: "host0"
  }
}
asic_descriptors {
  asic_id: 101
  asic_descriptor {
    tray_id: 0
    asic_location: 1
    board_type: 1
    unique_id: 101
    host_name: "host0"
  }
}
asic_descriptors {
  asic_id: 102
  asic_descriptor {
    tray_id: 0
    asic_location: 2
    board_type: 1
    unique_id: 102
    host_name: "host0"
  }
}
host_to_rank {
  host_name: "host0"
  rank: 0
}
ethernet_firmware_version {
  major: 1
  minor: 0
  patch: 0
}

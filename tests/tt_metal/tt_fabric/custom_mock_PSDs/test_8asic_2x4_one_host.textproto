#
# A 2x4 grid of ASICs on a single host: the undivided-machine baseline for the MGD host_topology
# tests. Nothing here can cut a declared mesh host rank, so every host_topology should be accepted.
#
#   100 101 102 103
#   104 105 106 107
#
#   host of each ASIC:
#   h0 h0 h0 h0
#   h0 h0 h0 h0
#
# Every ASIC gets its own (tray_id, asic_location) = (row+1, col+1) so a PGD can name individual
# chips and pinnings stay injective. Links carry 2 channels and are marked non-local exactly when
# they cross a host boundary. Channels 0/1 run along a row, 2/3 along a column.
target_device_type: 0
system_graph {
  asic_connectivity_graph {
    host_name: "host0"
    asic_topologies {
      asic_id: 100
      topology {
        asic_connections {
          dst_asic_id: 101

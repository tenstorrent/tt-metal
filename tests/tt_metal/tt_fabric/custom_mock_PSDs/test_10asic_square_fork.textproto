# PSD for the mixed-shape placement test: ten ASICs, two ethernet channels per link.
#
#   100 == 101
#    ||     ||
#   103 == 102 == 104 == 107 == 108 == 109
#                  ||
#                 105 == 106
#
# Three regions, each of which admits only one mesh shape:
#
#   the 4-cycle 100-101-102-103 is the only place a 2x2 mesh can sit,
#   the short branch 104-105-106 and the long branch 104-107-108-109 are plain paths,
#   and 104 is the junction joining all three.
#
# The branches are deliberately uneven so that a 1x3 mesh fits either way out of 104, which is
# what makes the wrong choice available to the search.

target_device_type: 0

# Minimal PSD for the inter-mesh connectivity case: six ASICs wired in a ring,
# two ethernet channels per link.
#
#     100 == 101 == 102 == 103 == 104 == 105
#      '-------------------------------------'
#
# Every chip has exactly two neighbours, so a mesh footprint that is not placed in ring
# order will strand one of its seams.
target_device_type: 0
system_graph {
  asic_connectivity_graph {
    host_name: "host0"
    asic_topologies {
      asic_id: 100
      topology {
        asic_connections {
          dst_asic_id: 101
          eth_connections {
            src_chan: 2
            dst_chan: 0
            is_local: true
          }
          eth_connections {
            src_chan: 3
            dst_chan: 1
            is_local: true
          }
        }
        asic_connections {
          dst_asic_id: 105
          eth_connections {
            src_chan: 0
            dst_chan: 2
            is_local: true
          }
          eth_connections {
            src_chan: 1
            dst_chan: 3
            is_local: true
          }
        }
      }
    }
    asic_topologies {

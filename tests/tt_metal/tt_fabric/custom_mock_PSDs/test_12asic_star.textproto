# PSD for the heterogeneous star test: a 2x2 block of chips with three line branches hanging off
# three different chips of the block, and a different number of channels on each branch's first link.
#
#                       104 == 105 == 106          branch X, first link 2 channels
#                      /
#         100 == 101 =/
#          ||    ||
#         102 == 103 ==== 107 == 108 == 109        branch Y, first link 4 channels
#          |
#          +==== 110 == 111                        branch Z, first link 3 channels
#
# Every link carries 2 channels except the three that attach a branch to the block: 101-104 has 2,
# 103-107 has 4 and 102-110 has 3. The block is the only 4-cycle in the graph, so it is the only
# place a 2x2 mesh can sit; the branches are plain lines, so more than one spoke shape fits on more
# than one branch and the channel counts are what decide which spoke goes where.

target_device_type: 0

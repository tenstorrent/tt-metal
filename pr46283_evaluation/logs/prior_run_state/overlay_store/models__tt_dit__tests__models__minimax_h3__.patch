+    audio_vae = AutoencoderKLMiniMaxH3Audio.from_pretrained(str(weights), subfolder="audio_vae").to(device).eval()
+    return SimpleNamespace(
+        vae=vae,
+        audio_vae=audio_vae,
+        patch_size=(1, 2, 2),

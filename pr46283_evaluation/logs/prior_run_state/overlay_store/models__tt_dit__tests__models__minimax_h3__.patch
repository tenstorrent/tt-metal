+        video_patch_dim=video_patch_dim,
+        audio_channels=audio_channels,
+        head_dim=model_kwargs["attention_head_dim"],
+        rope_freq_dim=rope_freq_dim,
+        rope_theta=rope_theta,
+    )
+
+    tt_model = MiniMaxH3Transformer3DModel(

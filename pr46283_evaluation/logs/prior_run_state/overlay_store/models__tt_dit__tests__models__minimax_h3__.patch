+# Frame counts follow the 17n+5 -> 5n+2 rule at 24 fps: 5 s = 124 frames, 10 s = 243.
+PRODUCTION_CONFIGS = [
+    pytest.param(1344, 768, 124, id="768P_5s"),
+    pytest.param(1344, 768, 243, id="768P_10s"),

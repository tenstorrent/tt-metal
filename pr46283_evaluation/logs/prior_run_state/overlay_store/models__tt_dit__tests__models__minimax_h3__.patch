+REFERENCE_PCC = 0.99  # floor set by the encoder's ttnn.group_norm calls (no fp32 path)
+# 17*1 + 5: smallest multi-chunk count (7 latent frames); the reference video VAE encode is CPU-hours at 124.
+VIDEO_FRAMES = 22

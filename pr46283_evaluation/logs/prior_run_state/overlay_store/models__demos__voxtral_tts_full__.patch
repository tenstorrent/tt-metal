+# SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+# SPDX-License-Identifier: Apache-2.0
+"""Native TT-NN port of `VoxtralDecoderLayer` (Voxtral-TTS backbone, Block 1).
+
+Reference: `modeling_layers.VoxtralDecoderLayer.forward` -- one pre-norm GQA + SwiGLU block:
+
+    h = input_layernorm(x)
+    x = x + self_attn(h, cis, bias, cache, prefix)
+    h = post_attention_layernorm(x)
+    x = x + mlp(h)
+
+The attention half is the graduated `_stubs/attention.py` port, imported rather than copied:
+its RoPE handling (an interleaved-to-halves weight permutation, see that module) is the one
+subtle piece in this block, and a second transcription of it is a second thing to keep in
+step. The norms and the SwiGLU are inlined -- both are a single line of ttnn and carry no
+convention to get wrong.
+
+CACHE. `VoxtralAttention` appends to a KV cache when the layer is given one, which is how the
+backbone's decode path reuses prefill work. That is host-owned mutable state (the reference
+mutates the caller's dict in place), so it stays with the host-side generation loop; this port
+implements the prefill/full-sequence path, which is what `VoxtralTtsBackbone.forward` runs and
+what the PCC test exercises.
+"""
+from __future__ import annotations
+
+import torch
+import ttnn
+
+from models.demos.voxtral_tts_full._stubs.attention import COMPUTE_CONFIG, TtVoxtralAttention
+
+# `voxtral_common_ref.NORM_EPS` -- the backbone's RMSNorm epsilon. Read off the module when
+# it is present so a re-tuned checkpoint cannot silently disagree with this default.
+_NORM_EPS = 1e-5
+
+
+class TtVoxtralDecoderLayer:
+    def __init__(self, attn, weights, eps):
+        self.attn = attn
+        self.__dict__.update(weights)
+        self.eps = eps
+
+    @classmethod
+    def build(cls, device, torch_module):
+        def stage(t):
+            return ttnn.from_torch(
+                t.detach().float().t().contiguous().to(torch.bfloat16),
+                dtype=ttnn.bfloat16,
+                layout=ttnn.TILE_LAYOUT,
+                device=device,
+            )
+
+        def stage_vector(t):
+            return ttnn.from_torch(
+                t.detach().float().contiguous().to(torch.bfloat16),
+                dtype=ttnn.bfloat16,
+                layout=ttnn.TILE_LAYOUT,
+                device=device,
+            )
+
+        mlp = torch_module.mlp
+        weights = {
+            "attn_norm": stage_vector(torch_module.input_layernorm.weight),

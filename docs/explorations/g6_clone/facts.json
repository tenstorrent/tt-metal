  "open_questions": [
    {
      "id": "Q1",
      "question": "The contract says the copy takes 'the dtype and memory placement the call asks for' (contract.md:10), but no production call passes a dtype or a memory configuration (contract.md:39). The spec has no dtype or memory_config keyword and the output always takes the input's dtype and placement. Confirm, or name the keywords the call needs.",
      "owner": "lead",
      "blocks": "nothing"
    },
    {
      "id": "Q2",
      "question": "The brief projects dtype and layout from scenario dicts so that only the five production (dtype, layout) pairs are built; projecting dtype has no precedent in a shipped suite. Accept, or iterate dtype and accept non-production cells?",
      "owner": "golden-tests",
      "blocks": "golden suite"
    },
    {
      "id": "Q3",
      "question": "Can the suite's host-to-device path carry NaN payloads and subnormals unchanged into a tensor, so that the random-bit-pattern generator can include them?",
      "owner": "golden-tests",
      "blocks": "nothing"
    }
  ],
  "decisions": [
    {
      "id": "D1",
      "decision": "Name g6_clone, kind op, one call computes out = x.clone(). Source: lead",
      "why": "sources/local/contract.md:8-10"
    },
    {
      "id": "D2",
      "decision": "Boundary: one call is one device program, never merged or split. Source: lead",
      "why": "sources/local/contract.md:17-20"
    },
    {
      "id": "D3",
      "decision": "Tensors at the boundary: 29 cases, one input each, output with the input's shape, dtype, layout and DRAM-interleaved placement. Source: lead",
      "why": "sources/local/contract.md:26-39; sources/local/scenarios.json"
    },
    {
      "id": "D4",
      "decision": "memory_format of the reference is not a parameter",
      "why": "a device tensor has no strides; no call passes it"
    },
    {
      "id": "D5",
      "decision": "No dtype or memory_config keyword; the output takes the input's dtype and placement",
      "why": "no production call passes one (contract.md:39); a conversion is not a copy; Q1"
    },
    {
      "id": "D6",
      "decision": "The oracle returns the input dtype without a float32 round trip",
      "why": "int32 and uint32 above 2^24 are not exact in float32 (oracle probe)"
    },
    {
      "id": "D7",
      "decision": "Phase 0: float32, TILE, DRAM interleaved, every rank and alignment",
      "why": "largest TILE calls of the model and the flagged cases p1, p2; float32 shows an engine path first"
    },
    {
      "id": "D8",
      "decision": "Registry axes dtype and layout projected from scenario dicts; no alignment, rank or memory_layout axis",
      "why": "BB-22: only production pairs; no kernel path differs by alignment or rank"
    },
    {
      "id": "D9",
      "decision": "Gate: bitwise exact for every dtype. Source: lead, bitwise comparison of bit patterns is mine",
      "why": "sources/local/contract.md:73"
    },
    {
      "id": "D10",
      "decision": "Oracle evidence E1: torch.clone of the installed torch 2.11.0, the pinned commit",
      "why": "the contract names the PyTorch function as the reference (contract.md:72)"
    },
    {
      "id": "D11",
      "decision": "Perf focus on p1 to p4. Source: lead",
      "why": "sources/local/contract.md:50-57"
    },
    {
      "id": "D12",
      "decision": "The cores rule stands in the spec",
      "why": "no golden case fails on a single core; p4 is one tile row"
    },
    {
      "id": "D13",
      "decision": "Advice: no bullet kept in the spec; lessons RB-036 and RB-053 kept",
      "why": "model-bringup filter; see DOSSIER.md"
    }

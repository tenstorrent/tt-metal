+constexpr auto stats_dram_args = TensorAccessorArgs<14>();
+constexpr auto forward_route =
+    ccl_routing_utils::get_line_multicast_route_info_from_args<stats_dram_args.next_compile_time_args_offset()>();
+constexpr auto backward_route = ccl_routing_utils::get_line_multicast_route_info_from_args<
+    stats_dram_args.next_compile_time_args_offset() + ccl_routing_utils::num_line_multicast_args>();
+constexpr uint32_t num_waves = get_compile_time_arg_val(
+    stats_dram_args.next_compile_time_args_offset() + 2 * ccl_routing_utils::num_line_multicast_args);
+static_assert(num_waves == 2, "wave forwarder runs exactly two waves (two 16-bit semaphore fields)");
+static_assert(max_rounds == num_waves, "one forwarder round (scratch page) per wave");
+constexpr uint32_t kWaveFieldBits = 16u;
+constexpr uint32_t kWaveFieldMask = (1u << kWaveFieldBits) - 1u;
+
+void kernel_main() {
+    size_t arg_idx = 0;
+    const uint32_t stats_dram_addr = get_arg_val<uint32_t>(arg_idx++);
+    // out_ready_sem: a GlobalSemaphore that PEER forwarders fuse-inc over fabric (same L1 addr on every chip).
+    const uint32_t out_ready_sem_addr = get_arg_val<uint32_t>(arg_idx++);
+    // Group worker NoC coords, wave-major and in slot order within a wave.
+    uint32_t worker_x[group_size];
+    uint32_t worker_y[group_size];
+    for (uint32_t i = 0; i < group_size; i++) {
+        worker_x[i] = get_arg_val<uint32_t>(arg_idx++);
+        worker_y[i] = get_arg_val<uint32_t>(arg_idx++);
+    }
+    // Wave bounds (num_waves + 1 entries): wave w = workers [bound[w], bound[w+1]).
+    uint32_t wave_bound[num_waves + 1];
+    for (uint32_t w = 0; w <= num_waves; w++) {
+        wave_bound[w] = get_arg_val<uint32_t>(arg_idx++);
+    }
+    Noc noc;
+    CircularBuffer cb_pkt_hdr(reserved_packet_header_cb);
+    CircularBuffer cb_packet(packet_cb);
+    Semaphore<> fwd_arrival_sem(arrival_sem_id);
+    Semaphore<> group_go_sem(go_sem_id);
+
+    // Fabric connection (fwd+bwd) for this forwarder's link.
+    auto fabric_connection =
+        FabricConnectionManager::build_from_args<FabricConnectionManager::BUILD_AND_OPEN_CONNECTION_START_ONLY>(
+            arg_idx);
+
+    cb_pkt_hdr.reserve_back(1);
+    auto pkt_hdr_fwd_addr = cb_pkt_hdr.get_write_ptr();
+    cb_pkt_hdr.push_back(1);
+    cb_pkt_hdr.reserve_back(1);
+    auto pkt_hdr_bwd_addr = cb_pkt_hdr.get_write_ptr();
+    cb_pkt_hdr.push_back(1);
+    volatile PACKET_HEADER_TYPE* pkt_hdr_fwd = reinterpret_cast<volatile PACKET_HEADER_TYPE*>(pkt_hdr_fwd_addr);
+    volatile PACKET_HEADER_TYPE* pkt_hdr_bwd = reinterpret_cast<volatile PACKET_HEADER_TYPE*>(pkt_hdr_bwd_addr);
+    ccl_routing_utils::fabric_set_line_multicast_route(pkt_hdr_fwd, forward_route);
+    ccl_routing_utils::fabric_set_line_multicast_route(pkt_hdr_bwd, backward_route);
+    if (fabric_connection.is_logically_connected()) {
+        fabric_connection.open_finish();
+    }
+
+    const auto stats_dram = TensorAccessor(stats_dram_args, stats_dram_addr);
+    const uint32_t packet_base = cb_packet.get_read_ptr();         // packet_cb is depth-2; indexed by wave
+    const uint32_t packet_tile_bytes = cb_packet.get_tile_size();  // = unit_packet_bytes (one slot)
+
+    const uint64_t out_ready_sem_noc = safe_get_noc_addr(my_x[0], my_y[0], out_ready_sem_addr, 0);
+    volatile tt_l1_ptr uint32_t* out_ready_sem_ptr = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(out_ready_sem_addr);
+    volatile tt_l1_ptr uint32_t* arrival_ptr =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_semaphore(arrival_sem_id));
+
+    uint32_t sent = 0;
+    uint32_t released = 0;
+    while (released < num_waves) {
+        invalidate_l1_cache();
+        if (sent < num_waves) {
+            const uint32_t shift = sent * kWaveFieldBits;
+            const uint32_t need = wave_bound[sent + 1] - wave_bound[sent];
+            if (((*arrival_ptr >> shift) & kWaveFieldMask) >= need) {
+                DeviceZoneScopedN("F_SEND");
+                // packet_buf[wave] -> page (my_device, forwarder, wave) on every chip, fused with the
+                // wave's field inc of every peer's out_ready (flush=true: payload lands before the inc).
+                const uint32_t page_idx = my_device_index * num_chunks_per_device + forwarder_index * max_rounds + sent;
+                const uint64_t dram_dest = tt::tt_fabric::linear::addrgen_detail::get_noc_address(stats_dram, page_idx, 0);
+                size_t l1_read_addr = packet_base + sent * packet_tile_bytes;
+                fused_write_atomic_and_advance_local_read_address_for_fabric_write(
+                    dram_dest,
+                    pkt_hdr_fwd,
+                    pkt_hdr_bwd,
+                    fabric_connection,
+                    l1_read_addr,
+                    need * stick_bytes,
+                    out_ready_sem_noc,
+                    /*val=*/1u << shift,
+                    /*flush=*/true);
+                sent++;
+                continue;
+            }
+        }
+        if (released < sent) {
+            const uint32_t shift = released * kWaveFieldBits;
+            if (((*out_ready_sem_ptr >> shift) & kWaveFieldMask) >= ring_size - 1) {
+                DeviceZoneScopedN("F_GO");
+                // Our own local write of this wave's page must have landed before its workers read it.
+                noc.async_write_barrier();
+                for (uint32_t i = wave_bound[released]; i < wave_bound[released + 1]; i++) {
+                    group_go_sem.up(noc, worker_x[i], worker_y[i], 1);
+                }
+                released++;
+            }
+        }
+    }
+    noc.async_write_barrier();
+    noc.async_atomic_barrier();
+
+    // Reset both op-managed semaphores this core owns (trace replay doesn't re-run the host init).
+    noc_semaphore_set(out_ready_sem_ptr, 0);
+    fwd_arrival_sem.set(0);
+    if (fabric_connection.is_logically_connected()) {
+        fabric_connection.close_start();
+        fabric_connection.close_finish();
+    }
+}

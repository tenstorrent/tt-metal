@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+
+/*
+ * Destination-aware dual-NoC output drain (Blackhole, interleaved DRAM output).
+ *
+ * Returns a bitmask over DRAM banks: bit b set -> tiles destined for bank b are written on
+ * NoC1 (by the reader, NCRISC), clear -> on NoC0 (by the worker writer, BRISC). Each bank is
+ * sent on the NoC with the shorter torus path from THIS core to that bank's per-NoC endpoint.
+ *
+ * NoC0 routes +x/+y, NoC1 routes -x/-y on a 17x12 torus; the DRAM columns are x=0 (channels
+ * 0-3) and x=9 (channels 4-7). With NoC0 only, a core left of x=9 sends every x=0 tile the
+ * long way round through the whole right half (and a right-half core every x=9 tile), so the
+ * eastern links carry everybody's traffic. Splitting by core position alone does not help:
+ * one of the two DRAM columns is always the far one on a given NoC.
+ *
+ * Hop counts use the core's PHYSICAL NoC0 coordinate (NOC_NODE_ID; my_x/my_y hold the
+ * translated id, which ignores column harvesting). The endpoints are the soc descriptor's
+ * per-NoC worker endpoints (blackhole_140_arch.yaml dram_views), bank b == channel b (8 banks,
+ * no DRAM harvesting). Anything else returns 0: everything stays on NoC0.
+ */
+inline uint32_t dit_rmsnorm_drain_noc1_bank_mask() {
+#if defined(ARCH_BLACKHOLE) && (NUM_DRAM_BANKS == 8)
+    constexpr uint32_t kGridX = 17u;
+    constexpr uint32_t kGridY = 12u;
+    constexpr uint8_t kBankX[8] = {0, 0, 0, 0, 9, 9, 9, 9};
+    constexpr uint8_t kNoc0EpY[8] = {11, 2, 9, 5, 11, 3, 8, 6};
+    constexpr uint8_t kNoc1EpY[8] = {1, 10, 4, 7, 1, 10, 4, 7};
+    const uint32_t node_id = NOC_CMD_BUF_READ_REG(0, 0, NOC_NODE_ID);
+    const uint32_t x = node_id & NOC_NODE_ID_MASK;
+    const uint32_t y = (node_id >> NOC_ADDR_NODE_ID_BITS) & NOC_NODE_ID_MASK;
+    uint32_t mask = 0;
+    for (uint32_t b = 0; b < 8u; b++) {
+        const uint32_t hops_noc0 = (kBankX[b] + kGridX - x) % kGridX + (kNoc0EpY[b] + kGridY - y) % kGridY;
+        const uint32_t hops_noc1 = (x + kGridX - kBankX[b]) % kGridX + (y + kGridY - kNoc1EpY[b]) % kGridY;
+        if (hops_noc1 < hops_noc0) {
+            mask |= 1u << b;
+        }
+    }
+    return mask;
+#else
+    return 0u;
+#endif
+}
+
+inline bool dit_rmsnorm_drain_on_noc1(uint32_t noc1_bank_mask, uint32_t page_id) {
+    return (noc1_bank_mask >> (page_id % NUM_DRAM_BANKS)) & 1u;
+}

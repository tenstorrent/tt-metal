+        for (uint32_t col_tile = 0; noc1_bank_mask != 0 && col_tile < num_tile_cols; col_tile += block_size) {
+            const uint32_t tiles_in_block =
+                ((num_tile_cols - col_tile) >= block_size) ? block_size : (num_tile_cols - col_tile);
+            cb_output.wait_front(col_tile + block_size);
+            uint32_t rd = row_rd + col_tile * output_tile_bytes;
+            for (uint32_t i = 0; i < tiles_in_block; i++) {
+                const uint32_t c = col_tile + i;
+                const uint32_t h = c / head_dim_tiles;
+                const uint32_t t_col = c - h * head_dim_tiles;
+                const uint32_t out_idx = h * total_num_tile_rows * head_dim_tiles + tile_row * head_dim_tiles + t_col;
+                if (dit_rmsnorm_drain_on_noc1(noc1_bank_mask, out_idx)) {
+                    noc.async_write(
+                        CoreLocalMem<uint32_t>(rd), output_accessor, output_page_bytes, {}, {.page_id = out_idx});
+                }
+                rd += output_tile_bytes;

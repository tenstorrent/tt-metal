+
+    // A worker with no rows has nothing to drain and its writer never waits drain_sem.
+    if (reader_drain && tile_row_start < tile_row_end) {
+        DeviceZoneScopedN("R_DRAIN");
+        const uint32_t noc1_bank_mask = dit_rmsnorm_drain_noc1_bank_mask();

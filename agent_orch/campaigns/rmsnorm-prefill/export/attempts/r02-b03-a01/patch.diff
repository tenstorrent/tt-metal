+        noc.async_write_barrier();
+        Semaphore<> drain_sem(drain_sem_id);
+        drain_sem.up(noc, my_x[noc.get_noc_id()], my_y[noc.get_noc_id()], 1);
+        noc.async_atomic_barrier();
+    }
 }

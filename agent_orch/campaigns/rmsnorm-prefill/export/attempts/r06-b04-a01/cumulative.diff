+    cb_pkt_hdr.push_back(1);
+    cb_pkt_hdr.reserve_back(1);
+    auto pkt_hdr_bwd_addr = cb_pkt_hdr.get_write_ptr();
+    cb_pkt_hdr.push_back(1);

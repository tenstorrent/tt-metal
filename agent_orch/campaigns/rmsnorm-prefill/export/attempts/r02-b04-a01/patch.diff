+        for (uint32_t w = 0; w < num_workers; w++) {
+            const uint32_t k = w / static_cast<uint32_t>(grid_size.y);
+            worker_cores[w] = CoreCoord(grid_size.x - 1 - k * col_stride, w % grid_size.y);

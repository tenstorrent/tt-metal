+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "adaptive_chunk.hpp"
+
+// Cross-group pacing of the weight stream (reader only).
+//
+// The row groups of a layout stream their experts' weights at once and share the DRAM/NoC
+// bandwidth unevenly by grid position: on identical first experts the topmost active group's
+// gate/up ran 1.4-3x longer than the bottom group's (r07-b02-a01 profile), and which group loses
+// depends on the live set of streams, so a static plan or offset cannot follow it (r06-b02-a01,
+// r07-b04-a01). Instead the column-0 weight sender of every group issues its next weight block
+// (gate/up or down; every group walks the same block sequence per chunk) only while no other group
+// of the phase is more than kSlack blocks behind it. A group that is ahead backs off, its reads
+// leave the shared links, and the groups behind take the bandwidth. One column per group is enough:
+// the group's row (x / activated) and column (weight) streams hold its other columns within about
+// a block of column 0.
+//
+// The group furthest behind never waits, so the pacing cannot deadlock; a wait also gives up after
+// kTimeout cycles. A group that has finished (or has no expert) is waited for only up to its own
+// block total, which every core derives from the shared plan. Only the issue time of a read moves:
+// the same bytes land in the same slots.
+//
+// Board: the four words of one semaphore's 16-byte L1 slot. Word s counts the blocks issued by the
+// s-th OTHER group of the layout (groups in order, skipping this one), phase A in the low 16 bits
+// and phase B in the high 16. Peers increment it with NoC atomics. The dispatcher only re-inits word
+// 0 per launch, so the kernel clears all four at its start, before the counts broadcast; no peer can
+// count into them before then, because its first block follows the counts and its plan.
+namespace unified_routed_expert_ffn {
+
+// Built at -Os: it runs once per weight block, and every RISC binary of a core shares the kernel
+// config buffer, which the h7168 programs nearly fill.
+#pragma GCC push_options
+#pragma GCC optimize("Os")
+struct GroupPacer {
+    static constexpr uint32_t kSlack = 2;
+    static constexpr uint32_t kTimeout = 32768;  // cycles, ~24 us
+
+    uint32_t board_l1 = 0;
+    uint32_t nx = 0;
+    uint32_t shift = 0;
+    uint32_t groups = 0;  // 0 = this core does not pace in this phase
+    uint32_t me = 0;
+    uint32_t taken = 0;
+    uint32_t total[adaptive_chunk::kLayoutMaxGroups];
+    uint32_t ny[adaptive_chunk::kLayoutMaxGroups];
+
+    static void clear_board(uint32_t l1) {
+        volatile tt_l1_ptr uint32_t* w = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(l1);
+        for (uint32_t s = 0; s < 4; ++s) {
+            w[s] = 0;
+        }
+    }
+
+    // Phase setup on a group's column-0 weight sender (other cores pass pacing = false). (nx, my_ny)
+    // is this core's NoC coordinate, grid row my_gy; the host checked that column 0's NoC y steps
+    // with the grid row. owner[e] / tiles_of(e) are the phase's expert -> group map and tile-rows.
+    template <uint32_t NumExperts, typename TilesOf>
+    __attribute__((noinline)) void begin(
+        bool pacing,
+        uint32_t l1,
+        uint32_t phase,
+        const adaptive_chunk::GroupLayout& l,
+        uint32_t my_group,
+        uint32_t my_nx,
+        uint32_t my_ny,
+        uint32_t my_gy,
+        const uint8_t (&owner)[NumExperts],
+        const TilesOf& tiles_of,
+        uint32_t per_core_M_max,
+        uint32_t blocks_per_chunk) {
+        groups = (pacing && l.groups > 1) ? l.groups : 0;
+        board_l1 = l1;
+        nx = my_nx;
+        shift = 16 * phase;
+        me = my_group;
+        taken = 0;
+        uint32_t b = 0;
+        for (uint32_t g = 0; g < groups; ++g) {
+            total[g] = 0;
+            ny[g] = my_ny + b + adaptive_chunk::sender_row_in_group(0, b, l.rows[g]) - my_gy;
+            b += l.rows[g];
+        }
+        for (uint32_t e = 0; e < NumExperts && groups > 0; ++e) {
+            const uint32_t g = owner[e];
+            if (g < groups) {
+                total[g] += adaptive_chunk::num_chunks(tiles_of(e), per_core_M_max * l.rows[g]) * blocks_per_chunk;
+            }
+        }
+    }
+
+    // Take the next weight block. With wait == false, returns false instead of waiting while another
+    // group is more than kSlack blocks behind; call it last in a look-ahead's condition.
+    __attribute__((noinline)) bool take(bool wait) {
+        if (groups == 0) {
+            return true;
+        }
+        if (taken >= kSlack) {
+            const uint32_t floor = taken - kSlack;
+            volatile tt_l1_ptr uint32_t* board = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(board_l1);
+            volatile tt_reg_ptr uint32_t* clock_lo =
+                reinterpret_cast<volatile tt_reg_ptr uint32_t*>(RISCV_DEBUG_REG_WALL_CLOCK_L);
+            const uint32_t t0 = clock_lo[0];
+            while (true) {
+                bool ok = true;
+                for (uint32_t g = 0, s = 0; g < groups; ++g) {
+                    if (g != me) {
+                        const uint32_t need = (total[g] < floor) ? total[g] : floor;
+                        ok = ok && ((board[s] >> shift) & 0xFFFFu) >= need;
+                        ++s;
+                    }
+                }
+                if (ok) {
+                    break;
+                }
+                if (!wait) {
+                    return false;
+                }
+                if (clock_lo[0] - t0 > kTimeout) {
+                    break;
+                }
+            }
+        }
+        ++taken;
+        // This group's word on each peer's board is its rank among that peer's other groups. The
+        // caller issues this outside any open linked multicast on NoC 0, as it does its DRAM reads.
+        for (uint32_t g = 0; g < groups; ++g) {
+            if (g != me) {
+                const uint32_t s = (me < g) ? me : me - 1;
+                noc_semaphore_inc(get_noc_addr(nx, ny[g], board_l1 + 4 * s, 0), 1u << shift, 0);
+            }
+        }
+        return true;
+    }
+};
+#pragma GCC pop_options
+
+}  // namespace unified_routed_expert_ffn

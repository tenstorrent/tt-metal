+// ---------------------------------------------------------------------------------------------
+// Start-up stagger. At kernel start every group issues its first gate/up blocks (weights and x) at
+// the same moment, and under that burst the TOP grid rows' reads are served last: their first x
+// block lands 20-60 us after the bottom row's, the later the more groups compete, while every row
+// streams at about the same rate once running. The top groups are the critical ones on most plans,
+// so the reader of a lower group holds its first DRAM read for kStaggerCyclesPerRow per grid row
+// between its group and the top, letting the groups above start first. A group with more modelled
+// work in that phase than the top group is not held (it is the likelier tail). Every core of a
+// group gets the same delay, so the group's own handshakes stay in step, and the first phase's
+// multicasts never cross groups. Applied once, before the core's first read of the first phase
+// that runs; the data and its order are unchanged.
+constexpr uint32_t kStaggerCyclesPerRow = 3375;  // 2.5 us at 1.35 GHz
+
+// `owner` is the first phase's expert -> group map, `g` / `base` / `rows` this core's group, its first
+// grid row and height there, `top_rows` the height of group 0. Per-group work is compared as
+// sum(ceil(tiles / rows) + 1), group_cost's single-chunk value; out of line and division-based,
+// because it runs once and every byte of the reader binary counts.
+template <uint32_t NumExperts, typename TilesOf>
+__attribute__((noinline)) uint32_t startup_stagger_cycles(
+    const uint8_t (&owner)[NumExperts],
+    const TilesOf& tiles_of,
+    uint32_t g,
+    uint32_t base,
+    uint32_t rows,
+    uint32_t top_rows) {
+    uint32_t load[2] = {0, 0};  // [0] = the top group, [1] = this core's group
+    for (uint32_t e = 0; e < NumExperts; ++e) {
+        const uint32_t o = owner[e];
+        if (o == g || o == 0) {
+            const uint32_t r = (o == 0) ? top_rows : rows;
+            load[o != 0] += (tiles_of(e) + r - 1) / r + 1;
+        }
+    }
+    return (load[1] <= load[0]) ? kStaggerCyclesPerRow * base : 0u;
+}
+
 }  // namespace adaptive_chunk

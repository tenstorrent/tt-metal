+// NoC-1 DRAM port remap (RE_DRAM_EP_REMAP, writer only). A Blackhole DRAM bank has three NoC tiles in
+// its DRAM column, all forwarding to the same GDDR controller. The accessor always targets the soc
+// descriptor's NoC-1 endpoint tile, whose response first runs north along the DRAM column and wraps
+// round it for most grid rows. The host picks, per core, the bank's tile the fewest north hops above
+// the core and passes `(default_xy << 16) | alt_xy` per bank (xy = (y << 6) | x, translated coords);
+// a run's address keeps its bank offset and swaps only the coordinate. No match leaves it unchanged.
+struct DramPortRemap {
+    static constexpr uint32_t kBanks = 8;
+    uint32_t pair[kBanks];
+
+    FORCE_INLINE uint64_t apply(uint64_t addr) const {
+        const uint32_t xy = static_cast<uint32_t>(addr >> NOC_ADDR_COORD_SHIFT);
+        for (uint32_t b = 0; b < kBanks; ++b) {
+            if ((pair[b] >> 16) == xy) {
+                constexpr uint64_t kLocalMask = (uint64_t(1) << NOC_ADDR_COORD_SHIFT) - 1;
+                return (uint64_t(pair[b] & 0xFFFF) << NOC_ADDR_COORD_SHIFT) | (addr & kLocalMask);

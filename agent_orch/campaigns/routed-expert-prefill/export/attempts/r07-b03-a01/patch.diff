+// NoC-1 DRAM port remap (RE_DRAM_EP_REMAP, writer only). A Blackhole DRAM bank has three NoC tiles in
+// its DRAM column, all forwarding to the same GDDR controller. The accessors always target the soc
+// descriptor's NoC-1 endpoint tile (UMD port 1), whose response first runs north along the DRAM column
+// and wraps round it for most grid rows. The host picks, per core, the tile each bank is read through
+// (its NoC-1 endpoint or its free tile, never its NoC-0 endpoint). The writer toggles those
+// coordinates into its own (BRISC-local) NoC-1 row of the firmware's bank -> NoC xy table around each
+// weight read loop and back right after, so the reads cost nothing per tile and every other NoC-1
+// DRAM access keeps the default endpoint. The table row is 8 uint16 = 4 words; runtime args
+// [ArgIdx, ArgIdx + 4) hold (remapped word - default word) mod 2^32. Each call adds them and negates
+// them in place, so calls must come in pairs (the second restores the table and the args).
+template <uint32_t ArgIdx>
+__attribute__((noinline)) void dram_port_remap_toggle() {
+    // Dependent on ArgIdx so it only fires where the toggle is instantiated (Blackhole, 8 banks).
+    static_assert(ArgIdx == ~0u || sizeof(dram_bank_to_noc_xy[1]) == 4 * sizeof(uint32_t), "8 x uint16 NoC-1 DRAM bank table");
+    typedef uint32_t __attribute__((may_alias)) word_t;
+    word_t* table = reinterpret_cast<word_t*>(&dram_bank_to_noc_xy[1][0]);
+    tt_l1_ptr uint32_t* delta = reinterpret_cast<tt_l1_ptr uint32_t*>(get_arg_addr(ArgIdx));
+    for (uint32_t i = 0; i < 4; ++i) {
+        table[i] += delta[i];
+        delta[i] = 0u - delta[i];
+    }
+}

+// ---- Weight-reuse matmul (rt = per_core_M, ct = 1) -------------------------------------------
+// A 1 x w subblock (ct >= rt) makes the LLK keep the x tile in SrcB and unpack a NEW bf4 weight tile
+// into SrcA for every tile-mult, and on BH that SrcA unpack does not overlap the FPU: ~16 FPU +
+// ~17.5 unpacker-0 cycles per mult, back to back (r03-b02-a03's counters). With rt > ct the LLK
+// reuses the weight tile in SrcA for rt mults and streams the x tiles through SrcB instead
+// (_llk_unpack_AB_matmul_ !reuse_a: SrcB steps TILE_SIZE_B * KT_DIM, i.e. one x tile-row), the mode
+// big GEMMs run near the LoFi ideal in. Same operands in the same Src registers, same MVMUL replay,
+// same K order per dst tile, so the result is bit-identical to the 1 x w path.
+//
+// Used from per_core_M >= kReuseWeightMinM only: at rt = 2 one call is 2 mults, too little work to
+// hide the per-call TRISC overhead. rt must also fit one dst half.
+constexpr uint32_t kMatmulDstHalf = (FP32_DEST_ACC_EN != 0) ? 4u : 8u;
+constexpr uint32_t kReuseWeightMinM = 3;
+FORCE_INLINE bool use_weight_reuse(uint32_t rows) { return rows >= kReuseWeightMinM && rows <= kMatmulDstHalf; }
+
+// Output columns [n0, n0 + w) of tile-rows [0, rows), K-tiles [0, k_steps) of the current block, in
+// one dst acquire (w * rows <= kMatmulDstHalf). Column j occupies dst [j * rows, (j + 1) * rows);
+// tile (m, n) is packed to the absolute partials slot m * row_tiles + n, the slot the 1 x w path
+// packs it to. Needs matmul_block_init(in0, in1, 0, /*ct=*/1, /*rt=*/rows, kt_dim) first.
+FORCE_INLINE void matmul_cols_reuse_w(
+    uint32_t in0_cb_id,
+    uint32_t in1_cb_id,
+    uint32_t partials_cb_id,
+    uint32_t rows,
+    uint32_t n0,
+    uint32_t w,
+    uint32_t k_steps,
+    uint32_t kt_dim,
+    uint32_t in1_row_tiles,
+    uint32_t row_tiles) {
+    tile_regs_acquire();
+    for (uint32_t j = 0; j < w; ++j) {
+        uint32_t in1_index = n0 + j;
+        for (uint32_t k = 0; k < k_steps; ++k) {
+            matmul_block(
+                in0_cb_id, in1_cb_id, k, in1_index, /*dst_index=*/j * rows, /*transpose=*/0, 1, rows, kt_dim);
+            in1_index += in1_row_tiles;
+        }
+    }
+    tile_regs_commit();
+    tile_regs_wait();
+    for (uint32_t m = 0; m < rows; ++m) {
+        for (uint32_t j = 0; j < w; ++j) {
+            pack_tile<true>(j * rows + m, partials_cb_id, m * row_tiles + n0 + j);
+        }
+    }
+    tile_regs_release();
+}
+
+// All real columns [0, real_cols) of one K-block, in dst-half-sized column chunks.
+FORCE_INLINE void matmul_block_reuse_w(
+    uint32_t in0_cb_id,
+    uint32_t in1_cb_id,
+    uint32_t partials_cb_id,
+    uint32_t rows,
+    uint32_t real_cols,
+    uint32_t k_steps,
+    uint32_t kt_dim,
+    uint32_t in1_row_tiles,
+    uint32_t row_tiles) {
+    const uint32_t chunk = kMatmulDstHalf / rows;
+    for (uint32_t n0 = 0; n0 < real_cols; n0 += chunk) {
+        const uint32_t w = (real_cols - n0) < chunk ? (real_cols - n0) : chunk;
+        matmul_cols_reuse_w(
+            in0_cb_id, in1_cb_id, partials_cb_id, rows, n0, w, k_steps, kt_dim, in1_row_tiles, row_tiles);
+    }
+}

+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+
+#include "tools/profiler/kernel_profiler.hpp"
+
+// Per-wait-site cycle counters for the dataflow kernels, compiled in only under the device profiler.
+// A zone per K-block would overflow the per-RISC profiler buffer, so each site accumulates its
+// wall-clock cycles in a local counter and the kernel emits them at exit, two counters per
+// DeviceTimestampedData record (`RE_PROF_EMIT2`). Without PROFILE_KERNEL every macro is empty and
+// the counters fold away.
+#if defined(PROFILE_KERNEL)
+namespace re_prof {
+inline __attribute__((always_inline)) uint32_t now() {
+    return reinterpret_cast<volatile tt_reg_ptr uint32_t*>(RISCV_DEBUG_REG_WALL_CLOCK_L)[0];
+}
+}  // namespace re_prof
+#define RE_PROF_T(v) const uint32_t v = re_prof::now()
+#define RE_PROF_ACC(acc, t0) ((acc) += re_prof::now() - (t0))
+// Two counters per record: `hi` in the upper 32 bits of the payload, `lo` in the lower.
+#define RE_PROF_EMIT2(name, hi, lo) DeviceTimestampedData(name, (static_cast<uint64_t>(hi) << 32) | (lo))
+#else
+#define RE_PROF_T(v)
+#define RE_PROF_ACC(acc, t0)
+#define RE_PROF_EMIT2(name, hi, lo)
+#endif

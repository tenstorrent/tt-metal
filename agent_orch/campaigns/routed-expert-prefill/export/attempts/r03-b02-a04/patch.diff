+__attribute__((noinline, noclone)) void mm_group(
+    uint32_t in0_cb_id,
+    uint32_t in1_cb_id,
+    uint32_t partials_cb_id,
+    uint32_t in0_base,
+    uint32_t rows,
+    uint32_t n0,
+    uint32_t ct,
+    uint32_t k_steps,
+    uint32_t kt_dim,
+    uint32_t in1_w,

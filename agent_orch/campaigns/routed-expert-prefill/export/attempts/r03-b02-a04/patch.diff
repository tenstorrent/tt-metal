+// matmul_block_init for (ct, rows, kt_dim) blocks. For a CS shape (ct < rows) the SrcB MOP steps
+// through the rows by TILE_SIZE_B * KT_DIM, and TILE_SIZE_B is only refreshed by a format-changing
+// reconfig, so pin it to this in0 CB's tile size.
+__attribute__((noinline, noclone)) void mm_init(
+    uint32_t in0_cb_id, uint32_t in1_cb_id, uint32_t ct, uint32_t rows, uint32_t kt_dim) {
+    matmul_block_init(in0_cb_id, in1_cb_id, /*transpose=*/0, ct, rows, kt_dim);
+    if (ct < rows) {
+        UNPACK(({
+            const uint32_t in0_tile_size = get_local_cb_interface(get_operand_id(in0_cb_id)).fifo_page_size;
+            TT_SETDMAREG(0, LOWER_HALFWORD(in0_tile_size), 0, LO_16(p_gpr_unpack::TILE_SIZE_B));
+        }));
+    }

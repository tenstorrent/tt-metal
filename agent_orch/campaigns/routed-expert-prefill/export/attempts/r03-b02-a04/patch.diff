+// ---- Matmul groups: 1 x W subblocks, or column streaming (weight tile held in SrcA) ----------
+//
+// A 1 x W subblock (ct >= rt, the LLK's reuse_a mode) holds one in0 (x / activated, bf8) tile in
+// SrcB and streams a bf4 weight tile through SrcA for EVERY tile-mult. Measured with r03-b02-a03's
+// MATH perf counters: the FPU is busy 16 cycles per mult, the SrcA unpacker ~17.5, and the two
+// barely overlap, so a mult costs ~30-33 cycles on the compute-bound shapes. With ct < rt the LLK
+// runs the other way round: each weight tile is unpacked into SrcA once and the rt in0 tiles of its
+// column stream through SrcB (the mode big BH GEMMs run in, out_subblock_h > out_subblock_w). Every
+// output tile still accumulates the same K-tiles in the same order through the same MVMUL sequence,
+// so dst -- and the packed partials -- are bit-identical; only operand delivery and pack order move.
+//
+// "Column streaming" (CS) groups take all per_core_M rows at once and are used for the non-last
+// gate/up K-blocks and the down K-loop when per_core_M >= kCsMinRows. Rows per weight-tile unpack
+// is what pays; at 2 rows the per-call unpack bookkeeping (one context round per 2 mults) likely
+// costs more than it saves, so those keep the 1 x W walk.
+constexpr uint32_t kCsMinRows = 3;
+constexpr uint32_t kDstHalfTiles = (FP32_DEST_ACC_EN != 0) ? 4u : 8u;
+
+// CS group width for `rows` streamed rows: the widest ct with ct < rows (keeps the LLK in its
+// SrcA-reuse mode) and rows * ct <= one dst half. 0 = column streaming not used at this height.
+FORCE_INLINE uint32_t cs_cols(uint32_t rows) {
+    if (rows < kCsMinRows || rows > kDstHalfTiles) {
+        return 0;
+    }
+    const uint32_t ct = kDstHalfTiles / rows;
+    return ct < rows ? ct : rows - 1;
+}

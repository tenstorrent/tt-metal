 // contiguous run exists: run() collapses to 1 and this degenerates to the per-tile read.
 namespace unified_routed_expert_ffn {
 
+// UP_SPLIT: leading `up` K-rows of each gate/up block that grid row `gy`'s reader issues on NoC 0
+// (its writer reads the rest on NoC 1). The host picks `avg_rows` for the ~60/40 NoC balance; this
+// tilts it by row, 0 on the top row to 2 * avg_rows on the bottom one, with the same mean. With
+// all groups streaming gate/up at once, NoC 0 serves the bottom rows' reads first and the top
+// groups ran the first expert up to ~3x slower than the bottom ones for the same work (r06-b01-a01).
+// The reader and writer of a core both call this with their own gy, so they agree on the split.
+inline uint32_t up_head_rows_for_row(uint32_t avg_rows, uint32_t block_w, uint32_t gy, uint32_t grid_y) {
+    if (grid_y < 2) {
+        return avg_rows;
+    }
+    const uint32_t h = (2 * avg_rows * gy + (grid_y - 1) / 2) / (grid_y - 1);
+    return (h < block_w) ? h : block_w;
+}

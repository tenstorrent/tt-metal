+// Row-group schedule.
+//
+// The grid's kGridY M-rows split into kGridY / rows groups of `rows` consecutive
+// M-rows. Each group runs a disjoint subset of the local experts concurrently: its
+// rows split one expert's tokens, the weight multicast spans only the group's rows,
+// and different groups never synchronise with each other. rows == kGridY is the
+// classic schedule (every expert on the whole grid, one after another).
+//
+// rows is the smallest power of two (>= kMinGroupRows) whose single chunk
+// (rows * per_core_M_max tile-rows) holds the LARGEST local expert, so with
+// rows < kGridY every expert is exactly one chunk and its weights are read exactly
+// once, as in the classic schedule. It then grows while there would be more groups
+// than active experts (an idle group buys nothing, a wider one splits the work
+// further).
+//
+// Every RISC of every core derives this from the same counts vector, so all of
+// them agree on the groups, the expert -> group assignment and the row mapping.
+//
+// Groups have at least two rows: a one-row group makes every core its own weight
+// reader, so the row's x reads can no longer sit on a core without weight reads
+// (the host's fixed x sender at column gy + 1 is collision-free with the group
+// weight sender group_base + gx % rows only for rows >= 2).
+constexpr uint32_t kMinGroupRows = 2;
+inline uint32_t group_rows(uint32_t max_count_tiles, uint32_t num_active, uint32_t per_core_M_max) {
+    uint32_t rows = kMinGroupRows;
+    while (rows < kGridY && max_count_tiles > rows * per_core_M_max) {
+        rows <<= 1;
+    }
+    while (rows < kGridY && kGridY / rows > num_active) {
+        rows <<= 1;
+    }
+    return rows;
+}
+
+// group_rows() over the local experts; count_tiles_of(e) returns local expert e's
+// clamped tile-row count (0 = inactive).
+template <typename CountTilesOf>
+inline uint32_t plan_group_rows(const CountTilesOf& count_tiles_of, uint32_t experts, uint32_t per_core_M_max) {
+    uint32_t max_count_tiles = 0;
+    uint32_t num_active = 0;
+    for (uint32_t e = 0; e < experts; ++e) {
+        const uint32_t ct = count_tiles_of(e);
+        if (ct > 0) {
+            ++num_active;
+            max_count_tiles = (ct > max_count_tiles) ? ct : max_count_tiles;
+        }
+    }
+    return group_rows(max_count_tiles, num_active, per_core_M_max);
+}
+
+// Walks the local experts in order and deals the active ones round-robin to the
+// groups. next(count_tiles) returns whether that expert belongs to `my_group`.
+struct GroupDealer {
+    uint32_t num_groups;
+    uint32_t my_group;
+    uint32_t rank = 0;
+    bool next(uint32_t count_tiles) {
+        if (count_tiles == 0) {
+            return false;
+        }
+        const bool mine = (rank % num_groups) == my_group;
+        ++rank;
+        return mine;
+    }
+};

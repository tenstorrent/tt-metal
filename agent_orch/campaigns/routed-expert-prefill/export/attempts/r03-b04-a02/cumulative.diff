+// ceil(count_tiles / rows) for 0 < count_tiles <= per_core_M_max * rows (a single-chunk expert's
+// per_core_M), by at most per_core_M_max additions instead of a divide.
+__attribute__((always_inline)) inline uint32_t single_chunk_per_core_M(uint32_t count_tiles, uint32_t rows) {
+    uint32_t per_core_M = 1;
+    for (uint32_t covered = rows; covered < count_tiles; covered += rows) {
+        ++per_core_M;
+    }
+    return per_core_M;
+}
+
+// expert_cost below for an expert that needs more than one chunk.
+__attribute__((noinline)) inline uint32_t multi_chunk_expert_cost(
+    uint32_t count_tiles, uint32_t rows, uint32_t per_core_M_max) {
+    const uint32_t max_chunk = per_core_M_max * rows;
+    const uint32_t chunks = num_chunks(count_tiles, max_chunk);
+    uint32_t units = (count_tiles / max_chunk) * per_core_M_max;
+    if (count_tiles % max_chunk != 0) {
+        units += per_core_M_for_chunk(chunks - 1, count_tiles, max_chunk, rows);
+    }
+    return units + chunks;
+}
+
+// Modelled cost of one expert on a group of `rows` M-rows, in units of one per-core tile-row of
+// work: the per_core_M summed over its chunks, plus one unit per chunk for the chunk's fixed
+// pipeline fill/drain and its full re-read of the expert's weights. 0 for an expert with no rows.
+// Prefill experts nearly always fit one chunk: that case is ceil(count_tiles / rows) + 1 with no
+// divide (the general path's tail rule; a full chunk is per_core_M_max either way).
+__attribute__((always_inline)) inline uint32_t expert_cost(
+    uint32_t count_tiles, uint32_t rows, uint32_t per_core_M_max) {
+    if (count_tiles <= per_core_M_max * rows) {
+        return (count_tiles != 0) ? single_chunk_per_core_M(count_tiles, rows) + 1 : 0u;
+    }
+    return multi_chunk_expert_cost(count_tiles, rows, per_core_M_max);
+}
+
+// The schedulers' name for expert_cost.
+__attribute__((always_inline)) inline uint32_t group_cost(
+    uint32_t count_tiles, uint32_t rows, uint32_t per_core_M_max) {
+    return expert_cost(count_tiles, rows, per_core_M_max);
+}
+
+constexpr uint8_t kNoGroup = 0xFF;
+constexpr uint32_t kNoSchedule = 0xFFFFFFFFu;
+
+// ---------------------------------------------------------------------------------------------
+// Planner input.
+//
+// Every RISC plans before its first DRAM read, so the planner sits on the critical path of every
+// call, and it walks the experts' tile counts a few dozen times (uniform, mixed and two-phase
+// candidates). The caller's `tiles_of` reads two L1 words and band-filters / clamps them, so
+// PlanTiles reads every count ONCE into a local byte array, and also keeps the active experts in
+// largest-first order (tile-rows descending, expert index ascending), the order every
+// largest-first walk below needs. A count that does not fit a byte (kTilesEscape) is re-read
+// through `tiles_of`, so the plan is the same for any count.
+template <bool FitsByte>
+struct ExpertIndexType {
+    using type = uint16_t;
+};
+template <>
+struct ExpertIndexType<true> {
+    using type = uint8_t;
+};
+
+template <uint32_t NumExperts, typename TilesOf>
+struct PlanTiles {
+    static constexpr uint32_t kNumExperts = NumExperts;
+    static constexpr uint32_t kTilesEscape = 0xFF;
+    using Index = typename ExpertIndexType<(NumExperts <= 256)>::type;
+
+    const TilesOf& tiles_of_l1;
+    uint8_t cache[NumExperts];
+    Index order[NumExperts];  // [0, active): active experts, largest first, index order on ties
+    uint32_t active = 0;
+    uint32_t t_max = 0;
+
+    explicit PlanTiles(const TilesOf& tiles_of) : tiles_of_l1(tiles_of) {
+        for (uint32_t e = 0; e < NumExperts; ++e) {
+            const uint32_t t = tiles_of_l1(e);
+            cache[e] = static_cast<uint8_t>((t < kTilesEscape) ? t : kTilesEscape);
+            if (t == 0) {
+                continue;
+            }
+            t_max = (t > t_max) ? t : t_max;
+            // Stable insertion: e goes after every expert with at least as many tile-rows.
+            uint32_t i = active++;
+            for (; i > 0 && (*this)(order[i - 1]) < t; --i) {
+                order[i] = order[i - 1];
+            }
+            order[i] = static_cast<Index>(e);
+        }
+    }
+    __attribute__((always_inline)) inline uint32_t operator()(uint32_t e) const {
+        const uint32_t t = cache[e];
+        return (t != kTilesEscape) ? t : tiles_of_l1(e);
+    }
+};
+
+// Uniform layouts: list scheduling in expert order, each expert to the least-loaded group (lowest
+// index on a tie). Returns the makespan; fills owner[] when given.
+template <typename TilesOf>
+inline uint32_t schedule_in_order(
+    const GroupLayout& l, const TilesOf& tiles_of, uint32_t num_experts, uint32_t per_core_M_max, uint8_t* owner) {
+    uint32_t loads[kLayoutMaxGroups] = {0};
+    for (uint32_t e = 0; e < num_experts; ++e) {
+        const uint32_t cost = group_cost(tiles_of(e), l.rows[0], per_core_M_max);
+        uint32_t best = 0;
+        if (cost > 0) {
+            for (uint32_t g = 1; g < l.groups; ++g) {
+                if (loads[g] < loads[best]) {
+                    best = g;
+                }
+            }
+            loads[best] += cost;
+        }
+        if (owner != nullptr) {
+            owner[e] = (cost > 0) ? static_cast<uint8_t>(best) : kNoGroup;
+        }
+    }
+    uint32_t makespan = 0;
+    for (uint32_t g = 0; g < l.groups; ++g) {
+        makespan = (loads[g] > makespan) ? loads[g] : makespan;
+    }
+    return makespan;
+}
+
+// In-order makespans of the kNumUniformLayouts uniform layouts (schedule_in_order without an owner
+// map), all three in ONE walk of the experts: make_plan's uniform pick and plan_groups both start
+// from them, so the planner schedules each uniform layout once instead of twice.
+template <typename TilesOf>
+inline void uniform_makespans(
+    const TilesOf& tiles_of, uint32_t num_experts, uint32_t per_core_M_max, uint32_t (&makespan)[kNumUniformLayouts]) {
+    uint32_t loads[kNumUniformLayouts][kLayoutMaxGroups] = {};
+    for (uint32_t e = 0; e < num_experts; ++e) {
+        const uint32_t t = tiles_of(e);
+        if (t == 0) {
+            continue;
+        }
+        for (uint32_t li = 0; li < kNumUniformLayouts; ++li) {
+            const GroupLayout& l = layout_at(kGridY, li);
+            uint32_t best = 0;
+            for (uint32_t g = 1; g < l.groups; ++g) {
+                if (loads[li][g] < loads[li][best]) {
+                    best = g;
+                }
+            }
+            loads[li][best] += group_cost(t, l.rows[0], per_core_M_max);
+        }
+    }
+    for (uint32_t li = 0; li < kNumUniformLayouts; ++li) {
+        uint32_t m = 0;
+        for (uint32_t g = 0; g < layout_at(kGridY, li).groups; ++g) {
+            m = (loads[li][g] > m) ? loads[li][g] : m;
+        }
+        makespan[li] = m;
+    }
+}
+
+// Mixed layouts: largest expert first (ties by index), each to the group where it is cheapest
+// among those it fits in under `cap` (ties -> lower load -> lower index). Returns the makespan, or
+// kNoSchedule when some expert fits nowhere. Walks PlanTiles' largest-first order once.
+template <typename Tiles>
+inline uint32_t schedule_lpt(const GroupLayout& l, const Tiles& tiles, uint32_t per_core_M_max, uint32_t cap, uint8_t* owner) {
+    uint32_t loads[kLayoutMaxGroups] = {0};
+    if (owner != nullptr) {
+        for (uint32_t e = 0; e < Tiles::kNumExperts; ++e) {
+            owner[e] = kNoGroup;
+        }
+    }
+    uint32_t cur = 0;
+    uint32_t cost[kLayoutMaxGroups] = {0};
+    for (uint32_t i = 0; i < tiles.active; ++i) {
+        const uint32_t e = tiles.order[i];
+        const uint32_t t = tiles(e);
+        if (t != cur) {
+            cur = t;
+            for (uint32_t g = 0; g < l.groups; ++g) {
+                cost[g] = group_cost(t, l.rows[g], per_core_M_max);
+            }
+        }
+        uint32_t best = kLayoutMaxGroups;
+        for (uint32_t g = 0; g < l.groups; ++g) {
+            if (loads[g] + cost[g] > cap) {
+                continue;
+            }
+            if (best == kLayoutMaxGroups || cost[g] < cost[best] || (cost[g] == cost[best] && loads[g] < loads[best])) {
+                best = g;
+            }
+        }
+        if (best == kLayoutMaxGroups) {
+            return kNoSchedule;
+        }
+        loads[best] += cost[best];
+        if (owner != nullptr) {
+            owner[e] = static_cast<uint8_t>(best);
+        }
+    }
+    uint32_t makespan = 0;
+    for (uint32_t g = 0; g < l.groups; ++g) {
+        makespan = (loads[g] > makespan) ? loads[g] : makespan;
+    }
+    return makespan;
+}
+
+// False when NO assignment of the experts to `l`'s groups keeps every group's load within `cap`:
+// some expert costs more than `cap` on every group, or the cheapest placements already sum past
+// `cap` on every group. schedule_lpt can only succeed under `cap` when an assignment exists, so
+// skipping it then changes nothing; it saves a whole scheduling pass per hopeless layout.
+template <typename Tiles>
+inline bool lpt_may_fit(const GroupLayout& l, const Tiles& tiles, uint32_t per_core_M_max, uint32_t cap) {
+    uint32_t sum = 0;
+    uint32_t cur = 0;
+    uint32_t cheapest = 0;
+    for (uint32_t i = 0; i < tiles.active; ++i) {
+        const uint32_t t = tiles(tiles.order[i]);
+        if (t != cur) {
+            cur = t;
+            cheapest = kNoSchedule;
+            for (uint32_t g = 0; g < l.groups; ++g) {
+                const uint32_t c = group_cost(t, l.rows[g], per_core_M_max);
+                cheapest = (c < cheapest) ? c : cheapest;
+            }
+            if (cheapest > cap) {
+                return false;
+            }
+        }
+        sum += cheapest;
+    }
+    uint32_t total_cap = 0;
+    for (uint32_t g = 0; g < l.groups; ++g) {
+        total_cap += cap;
+    }
+    return sum <= total_cap;
+}
+
+// The layout with the smallest modelled makespan, and owner[e] = the group (within that layout)
+// that runs local expert e, kNoGroup for an expert with no rows. `uniform` holds the uniform
+// layouts' in-order makespans (uniform_makespans).
+//
+// Uniform layouts are compared first, ties keeping the larger groups, so a single expert or large
+// token counts stay on the whole-grid schedule. A mixed layout replaces the winner only when it is
+// STRICTLY better: it is scheduled under a cap one below the best makespan so far.
+template <uint32_t NumExperts, typename Tiles>
+inline uint32_t plan_groups(
+    const Tiles& tiles,
+    uint32_t per_core_M_max,
+    const uint32_t (&uniform)[kNumUniformLayouts],
+    uint8_t (&owner)[NumExperts]) {
+    uint32_t best_layout = 0;
+    uint32_t best = kNoSchedule;
+    for (uint32_t li = 0; li < kNumUniformLayouts; ++li) {
+        if (uniform[li] < best) {
+            best = uniform[li];
+            best_layout = li;
+        }
+    }
+    uint32_t best_cap = 0;
+    for (uint32_t li = kNumUniformLayouts; li < num_layouts(kGridY); ++li) {
+        if (best < 2) {
+            break;  // no rows at all: nothing to improve on
+        }
+        const uint32_t cap = best - 1;
+        const GroupLayout& l = layout_at(kGridY, li);
+        if (!lpt_may_fit(l, tiles, per_core_M_max, cap)) {
+            continue;  // no assignment fits under the cap, so schedule_lpt would fail too
+        }
+        const uint32_t m = schedule_lpt(l, tiles, per_core_M_max, cap, nullptr);
+        if (m < best) {
+            best = m;
+            best_layout = li;
+            best_cap = cap;
+        }
+    }
+    if (best_layout < kNumUniformLayouts) {
+        schedule_in_order(layout_at(kGridY, best_layout), tiles, NumExperts, per_core_M_max, owner);
+    } else {
+        schedule_lpt(layout_at(kGridY, best_layout), tiles, per_core_M_max, best_cap, owner);
+    }
+    return best_layout;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Two-phase schedule.
+//
+// One group size for the whole launch leaves a tail whenever the experts do not divide into the
+// groups: 12 experts on 5 two-row groups run 3/3/2/2/2, so for the last third of the call two
+// groups stream an expert each at per_core_M 2 (compute-bound) while three groups and half the
+// DRAM bandwidth sit idle. The plan below instead runs the full waves on the picked group size
+// (phase A) and then the LEFTOVER experts on larger groups (phase B), where per_core_M drops and
+// the remaining streams are DRAM-bound again. No weight byte is read twice and every expert still
+// runs whole on one group, so the numerics are unchanged.
+//
+// Phase A deals its experts round-robin, so every phase-A group runs the same number of experts,
+// and the plan requires them all to take the same number of chunks. Every core has therefore
+// pushed the same number of blocks into every ring when it enters phase B, which is what the
+// phase-B weight multicast relies on: a sender writes into each receiver's ring at its OWN write
+// pointer, and phase-B column groups span rows of different phase-A groups. A phase-B group
+// needs no barrier: its multicasts wait on receiver acks, and phase A uses its own weight
+// semaphore pair, so an early phase-B ack never reaches a core still sending for phase A.
+
+// Membership and order. Phase A takes the n_a experts with the most tile-rows: every expert with
+// more than `thresh`, then the first `quota_eq` (in expert order) with exactly `thresh` -- i.e. the
+// first n_a experts of PlanTiles' largest-first order. Phase B takes the rest of that order.
+// rows_a == 0 means there is no phase A and phase B is today's single-phase schedule.
+struct Plan {
+    uint32_t rows_a = 0;
+    uint32_t rows_b = kGridY;
+    uint32_t thresh = 0;
+    uint32_t quota_eq = 0;
+    // Two-phase plans only: phase B's layout (uniform or mixed-height). Phase B runs each leftover
+    // expert alone on one group, the k-th largest on group k (taller groups come first in a layout).
+    uint32_t layout_b = 0;
+    // Two-phase plans only: phase A's expert count (= the first n_a experts of the largest-first order).
+    uint32_t n_a = 0;
+};
+
+// Index of the uniform layout with `rows` rows per group (the first kNumUniformLayouts table
+// entries are kGridY, kGridY / 2, kGridY / 4 rows per group; layouts_valid checks that order).
+inline uint32_t uniform_layout_index(uint32_t rows) { return (rows >= kGridY) ? 0u : (rows >= kGridY / 2) ? 1u : 2u; }
+
+// Uniform group size (rows per group) with the smallest in-order makespan; ties keep the larger
+// group. The same pick plan_groups makes among its uniform layouts. `uniform` holds their
+// makespans (uniform_makespans).
+inline uint32_t pick_group_rows(const uint32_t (&uniform)[kNumUniformLayouts]) {
+    uint32_t best_rows = kGridY;
+    uint32_t best = kNoSchedule;
+    for (uint32_t li = 0; li < kNumUniformLayouts; ++li) {
+        if (uniform[li] < best) {
+            best = uniform[li];
+            best_rows = layout_at(kGridY, li).rows[0];
+        }
+    }
+    return best_rows;
+}
+
+// Phase A's deal: walking the experts in expert order, the j-th phase-A member goes to group
+// j % groups_a. Membership: more than `thresh` tile-rows, or exactly `thresh` and among the first
+// `quota_eq` such experts in expert order. Calls deal(e, tiles, group) for every member.
+template <typename Tiles, typename Deal>
+inline void deal_phase_a(const Plan& plan, const Tiles& tiles, uint32_t num_experts, uint32_t groups_a, const Deal& deal) {
+    uint32_t eq_seen = 0;
+    uint32_t g = 0;
+    for (uint32_t e = 0; e < num_experts; ++e) {
+        const uint32_t t = tiles(e);
+        if (t == 0 || t < plan.thresh || (t == plan.thresh && eq_seen++ >= plan.quota_eq)) {
+            continue;
+        }
+        deal(e, t, g);
+        g = (g + 1 == groups_a) ? 0 : g + 1;
+    }
+}
+
+// Time model used to choose the plan, in hundredths of `c` = the time to stream one expert's
+// weights at the full DRAM rate. An expert costs its per-core compute (kModelRow per tile-row of
+// per_core_M, kModelChunk per chunk) or its share of DRAM while `streams` groups stream at once,
+// whichever is larger. Calibrated on r01-b04-a04's per-group end times: the full waves run at the
+// DRAM share, and a lone 2-row group runs a 4-tile expert in ~3.3 c (2 x kModelRow).
+constexpr uint32_t kModelRow = 163;
+constexpr uint32_t kModelChunk = 20;
+constexpr uint32_t kModelStream = 100;
+constexpr uint32_t kModelPhaseSwitch = 20;
+// A two-phase plan must beat the single-phase one by this many percent.
+constexpr uint32_t kModelMarginPct = 5;
+
+inline uint32_t model_expert(uint32_t tiles, uint32_t rows, uint32_t per_core_M_max, uint32_t streams) {
+    const uint32_t chunks = num_chunks(tiles, per_core_M_max * rows);
+    const uint32_t row_units = (chunks == 1) ? single_chunk_per_core_M(tiles, rows)  // sum of per_core_M
+                                             : expert_cost(tiles, rows, per_core_M_max) - chunks;
+    const uint32_t compute = kModelRow * row_units + kModelChunk * chunks;
+    const uint32_t dram = kModelStream * streams * chunks;
+    return (compute > dram) ? compute : dram;
+}
+
+// Modelled makespan of the single-phase schedule on the uniform layout of `rows` rows per group:
+// experts dealt in expert order to the least-loaded group (schedule_in_order's deal). The i-th
+// expert of a group overlaps with the i-th of every other group that has one, so it streams
+// alongside that many groups.
+template <uint32_t NumExperts, typename Tiles>
+inline uint32_t model_single_phase(const Tiles& tiles, uint32_t rows, uint32_t per_core_M_max) {
+    const uint32_t groups = layout_at(kGridY, uniform_layout_index(rows)).groups;
+    uint8_t group_of[NumExperts];
+    uint32_t loads[kLayoutMaxGroups] = {0};
+    uint32_t count[kLayoutMaxGroups] = {0};
+    for (uint32_t e = 0; e < NumExperts; ++e) {
+        const uint32_t t = tiles(e);
+        if (t == 0) {
+            continue;
+        }
+        uint32_t best = 0;
+        for (uint32_t g = 1; g < groups; ++g) {
+            if (loads[g] < loads[best]) {
+                best = g;
+            }
+        }
+        loads[best] += expert_cost(t, rows, per_core_M_max);
+        ++count[best];
+        group_of[e] = static_cast<uint8_t>(best);
+    }
+    uint32_t time[kLayoutMaxGroups] = {0};
+    uint32_t seen[kLayoutMaxGroups] = {0};
+    for (uint32_t e = 0; e < NumExperts; ++e) {
+        const uint32_t t = tiles(e);
+        if (t == 0) {
+            continue;
+        }
+        const uint32_t g = group_of[e];
+        ++seen[g];
+        uint32_t streams = 0;
+        for (uint32_t h = 0; h < groups; ++h) {
+            streams += (count[h] >= seen[g]) ? 1u : 0u;
+        }
+        time[g] += model_expert(t, rows, per_core_M_max, streams);
+    }
+    uint32_t m = 0;
+    for (uint32_t g = 0; g < groups; ++g) {
+        m = (time[g] > m) ? time[g] : m;
+    }
+    return m;
+}
+
+// The two-phase candidate: full waves on the best uniform size followed by the leftover experts on
+// a larger uniform layout or a mixed-height one, when the model predicts a clear gain; otherwise
+// rows_a == 0 (no phase A). A mixed phase B gives an odd leftover a group each without leaving rows
+// idle: dsv3's 3 leftover 5-tile experts run per_core_M 2 on 4+3+3 rows (3 streams), where the
+// uniform layouts either keep them at per_core_M 3 on 2-row groups or need two rounds on 5-row ones.
+//
+// Phase B must finish the leftover in ONE round (one leftover expert per phase-B group at most).
+// A phase-B group's stream rate is capped by its 11 column senders, not by DRAM (r02-b03-a01:
+// a lone 5-row group pulls ~250 GB/s), so a second phase-B round on a big group runs far slower
+// than the model's DRAM share says, and loses to the uniform layout's one-round tail.
+template <uint32_t NumExperts, typename Tiles>
+inline Plan make_plan(const Tiles& tiles, uint32_t per_core_M_max, const uint32_t (&uniform)[kNumUniformLayouts]) {
+    Plan single;
+    single.rows_b = pick_group_rows(uniform);
+    const uint32_t rows_a = single.rows_b;
+    if (rows_a >= kGridY) {
+        return single;
+    }
+    const uint32_t layout_a = uniform_layout_index(rows_a);
+    const uint32_t groups_a = layout_at(kGridY, layout_a).groups;
+    const uint32_t active = tiles.active;
+    uint32_t n_a = 0;
+    while (n_a + groups_a <= active) {
+        n_a += groups_a;
+    }
+    if (n_a == 0 || n_a == active) {
+        return single;
+    }
+    // thresh = the n_a-th largest tile count; `above` experts have more.
+    const uint32_t thresh = tiles(tiles.order[n_a - 1]);
+    uint32_t above = n_a - 1;
+    while (above > 0 && tiles(tiles.order[above - 1]) == thresh) {
+        --above;
+    }
+    // Ring alignment at the phase switch needs equal units per phase-A group: every phase-A expert
+    // must take the same number of chunks (monotonic in tiles, so compare the extremes).
+    const uint32_t chunk_a = per_core_M_max * rows_a;
+    if (num_chunks(tiles.t_max, chunk_a) != num_chunks(thresh, chunk_a)) {
+        return single;
+    }
+    Plan two;
+    two.rows_a = rows_a;
+    two.thresh = thresh;
+    two.quota_eq = n_a - above;
+    two.n_a = n_a;
+
+    // The leftover experts (phase B), largest first: the tail of the largest-first order.
+    // n_left < groups_a <= kMaxGroups.
+    const uint32_t n_left = active - n_a;
+    uint32_t left[kMaxGroups];
+    for (uint32_t k = 0; k < n_left; ++k) {
+        left[k] = tiles(tiles.order[n_a + k]);
+    }
+    // Phase-B candidates: every layout with a group per leftover expert (one round), other than phase
+    // A's own. Uniform layouts come first, so a mixed one must be strictly better to replace them.
+    auto candidate = [&](uint32_t li) {
+        const GroupLayout& l = layout_at(kGridY, li);
+        return !(li == layout_a || l.groups < n_left || (li < kNumUniformLayouts && l.rows[0] < rows_a));
+    };
+    bool any_candidate = false;
+    for (uint32_t li = 0; li < num_layouts(kGridY); ++li) {
+        any_candidate = any_candidate || candidate(li);
+    }
+    if (!any_candidate) {
+        return single;
+    }
+
+    const uint32_t t_single = model_single_phase<NumExperts>(tiles, rows_a, per_core_M_max);
+    // Phase A: every group runs n_a / groups_a experts, so each streams alongside all groups_a.
+    uint32_t time_a[kLayoutMaxGroups] = {0};
+    deal_phase_a(two, tiles, NumExperts, groups_a, [&](uint32_t, uint32_t t, uint32_t g) {
+        time_a[g] += model_expert(t, rows_a, per_core_M_max, groups_a);
+    });
+    uint32_t t_a = 0;
+    for (uint32_t g = 0; g < groups_a; ++g) {
+        t_a = (time_a[g] > t_a) ? time_a[g] : t_a;
+    }
+    Plan best = single;
+    uint32_t best_t = t_single * (100 - kModelMarginPct);
+    for (uint32_t li = 0; li < num_layouts(kGridY); ++li) {
+        if (!candidate(li)) {
+            continue;
+        }
+        const GroupLayout& l = layout_at(kGridY, li);
+        uint32_t t_b = 0;
+        for (uint32_t k = 0; k < n_left; ++k) {
+            const uint32_t t = model_expert(left[k], l.rows[k], per_core_M_max, n_left);
+            t_b = (t > t_b) ? t : t_b;
+        }
+        const uint32_t t_two = (t_a + t_b + kModelPhaseSwitch) * 100;
+        if (t_two < best_t) {
+            best_t = t_two;
+            best = two;
+            best.rows_b = l.rows[0];
+            best.layout_b = li;
+        }
+    }
+    return best;
+}
+
+// ---------------------------------------------------------------------------------------------
+// The launch plan every kernel runs: up to two phases, each a row-group layout (index into the
+// layout table, which the host's per-layout topology sets follow) and owner[phase][e] = the group
+// (within that phase's layout) that runs local expert e in that phase, kNoGroup otherwise.
+//
+// A two-phase plan (make_plan) is taken when the model says it clearly beats the uniform layouts.
+// Otherwise phase A is empty and phase B is plan_groups' single layout, uniform or mixed-height.
+constexpr uint32_t kNoLayout = 0xFFFFFFFFu;
+
+struct LaunchPlan {
+    uint32_t layout[2] = {kNoLayout, 0};
+};
+
+template <uint32_t NumExperts, typename TilesOf>
+inline LaunchPlan plan_launch(const TilesOf& tiles_of, uint32_t per_core_M_max, uint8_t (&owner)[2][NumExperts]) {
+    const PlanTiles<NumExperts, TilesOf> tiles(tiles_of);
+    uint32_t uniform[kNumUniformLayouts];
+    uniform_makespans(tiles, NumExperts, per_core_M_max, uniform);
+
+    LaunchPlan lp;
+    const Plan two = make_plan<NumExperts>(tiles, per_core_M_max, uniform);
+    for (uint32_t e = 0; e < NumExperts; ++e) {
+        owner[0][e] = kNoGroup;
+    }
+    if (two.rows_a == 0) {
+        lp.layout[1] = plan_groups(tiles, per_core_M_max, uniform, owner[1]);
+        return lp;
+    }
+    lp.layout[0] = uniform_layout_index(two.rows_a);
+    lp.layout[1] = two.layout_b;
+    deal_phase_a(two, tiles, NumExperts, layout_at(kGridY, lp.layout[0]).groups, [&](uint32_t e, uint32_t, uint32_t g) {
+        owner[0][e] = static_cast<uint8_t>(g);
+    });
+    // Phase B: the leftover experts (fewer than phase A's groups); the k-th largest (ties -> lower
+    // index) runs on group k, matching make_plan's model.
+    for (uint32_t e = 0; e < NumExperts; ++e) {
+        owner[1][e] = kNoGroup;
+    }
+    for (uint32_t k = 0; two.n_a + k < tiles.active; ++k) {
+        owner[1][tiles.order[two.n_a + k]] = static_cast<uint8_t>(k);
+    }
+    return lp;
+}
 
 }  // namespace adaptive_chunk

+// acquire each -- on whatever L1 the x / gate / up CBs hold. No wait_front, so no wait for the reader can
+// enter the window: MATH's perf-counter window (re_hw phase kPhaseProbe) is the matmul pipeline alone,
+// unpacker + FPU + dst hand-off. Its cycles per tile-mult against the RE-GU window's tells how much of the
+// gate/up time is the matmul and how much is waiting for data. The products are dropped: PACK releases
+// each dst half without packing, and the release zeroes it (clear_dest) before any real subblock uses it.
+template <uint32_t in0_block_w, uint32_t out_subblock_w, uint32_t in1_per_core_w>
+FORCE_INLINE void re_probe_gu(uint32_t x_cb_id, uint32_t gate_cb_id, uint32_t up_cb_id) {
+    matmul_block_init(x_cb_id, gate_cb_id, /*transpose=*/0, out_subblock_w, /*rt=*/1, in0_block_w);
+    RE_HW_BEGIN(re_hw::kPhaseProbe);
+#pragma GCC unroll 1
+    for (uint32_t s = 0; s < 2; ++s) {
+        const uint32_t in1_cb_id = (s == 0) ? gate_cb_id : up_cb_id;
+        tile_regs_acquire();
+        uint32_t in1_index = 0;
+#pragma GCC unroll 1
+        for (uint32_t k = 0; k < in0_block_w; ++k) {
+            matmul_block(
+                x_cb_id, in1_cb_id, k, in1_index, /*dst_index=*/0, /*transpose=*/0, out_subblock_w, /*rt=*/1, in0_block_w);
+            in1_index += in1_per_core_w;
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        tile_regs_release();
+    }
+    // The MATH RISC only issues; hold the counter window open until the last MVMUL has retired.
+    MATH(ckernel::tensix_sync());
+    RE_HW_END(re_hw::kPhaseProbe, 2 * in0_block_w * out_subblock_w);

+    }
+    if (count_tiles > per_core_M_max * rows) {
+        return expert_cost(count_tiles, rows, per_core_M_max);
+    }
+    uint32_t per_core_M = 1;
+    for (uint32_t covered = rows; covered < count_tiles; covered += rows) {
+        ++per_core_M;
+    }
+    return per_core_M + 1;

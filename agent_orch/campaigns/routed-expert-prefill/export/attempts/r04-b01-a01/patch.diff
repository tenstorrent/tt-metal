+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Op-local matmul unpack MOP (UNPACK thread only).
+//
+// The stock BH matmul unpack MOP (tt_llk_blackhole/llk_lib/llk_unpack_AB_matmul.h,
+// _llk_unpack_AB_matmul_mop_config_) streams the non-reused operand one tile per iteration and
+// moves the context's L1 base address on with
+//     UNPACR -> RDCFG -> ADDDMAREG -> STALLWAIT(STALL_CFG, THCON) -> WRCFG -> NOP
+// i.e. a config read into a GPR, an add, a THCON stall and a config write per streamed tile.
+// This header re-records the streamed-SrcA (reuse-A) replay with the one-instruction form BH uses
+// in its hot loops (llk_unpack_tilize.h per-row replay, llk_pack_untilize.h, custom_mm unpack):
+//     UNPACR -> CFGSHIFTMASK(Base_address[ctx] += SCRATCH_SEC0) -> NOP
+// with SCRATCH_SEC0 preloaded to in1's tile size. The same tiles are unpacked from the same L1
+// addresses in the same order, so results are bit-identical. The stock execute
+// (_llk_unpack_AB_matmul_: per-call address setup, SrcB unpack, TT_MOP over ct_dim with the
+// config-context mask) is unchanged; only the replay it plays differs.
+//
+// Call after the stock matmul init (which programs everything else and the stock MOP). Every
+// re-entry to matmul after another unpack op (tilize, copy, bcast) must call it again: those inits
+// reprogram the replay buffer, and the tilize one also rewrites SCRATCH_SEC0.
+
+#pragma once
+
+#include <cstdint>
+
+#ifdef TRISC_UNPACK
+namespace re_mm {
+
+__attribute__((noipa)) inline void shiftmask_mop(
+    const std::uint32_t in1_cb_id, const std::uint32_t ct_dim, const std::uint32_t rt_dim) {
+    const std::uint32_t in1_id = get_operand_id(in1_cb_id);
+    // Reuse-B (SrcB streamed) and partial-face SrcA keep the stock MOP.
+    if (ct_dim < rt_dim || get_operand_partial_face(in1_id)) {
+        return;
+    }
+    // In1 -> SrcA. CB page sizes are already in unpacker L1 address units (16 B words), the same
+    // units as the TILE_SIZE_A GPR the stock chain adds.
+    const std::uint32_t tile_size = get_local_cb_interface(in1_id).fifo_page_size;
+
+    // Preload the increment through the Tensix pipe (in order with any queued tilize unpacks whose
+    // own CFGSHIFTMASKs still read the previous scratch value), as llk_unpack_tilize's init does.
+    TT_SETDMAREG(0, LOWER_HALFWORD(tile_size), 0, LO_16(p_gpr_unpack::TMP0));
+    TT_SETDMAREG(0, UPPER_HALFWORD(tile_size), 0, HI_16(p_gpr_unpack::TMP0));
+    TTI_STALLWAIT(p_stall::STALL_CFG, p_stall::THCON);
+    TTI_WRCFG(p_gpr_unpack::TMP0, 0, SCRATCH_SEC0_val_ADDR32);
+    TTI_NOP;
+
+    constexpr std::uint32_t run_len = 3;
+    load_replay_buf(0, 2 * run_len, [] {
+        // Config context 0.
+        TTI_UNPACR(SrcA, 0, 0, 0, 0, 1 /*Set OvrdThreadId*/, 1 /*Set Dvalid*/, p_unpacr::RAREFYB_DISABLE, 0, 0, 0, 0, 1);
+        // THCON_SEC0_REG3_Base_address += SCRATCH_SEC0_val (next in1 tile of the row)
+        TTI_CFGSHIFTMASK(1, 0b011, 32 - 1, 0, 0, THCON_SEC0_REG3_Base_address_ADDR32);
+        TTI_NOP;  // CFGSHIFTMASK takes 2 cycles; the next UNPACR reads the address
+        // Config context 1.
+        TTI_UNPACR(SrcA, 0, 0, 0, 0, 1 /*Set OvrdThreadId*/, 1 /*Set Dvalid*/, p_unpacr::RAREFYB_DISABLE, 0, 0, 0, 0, 1);
+        TTI_CFGSHIFTMASK(1, 0b011, 32 - 1, 0, 0, THCON_SEC0_REG3_Base_cntx1_address_ADDR32);
+        TTI_NOP;
+    });
+
+    // Same template shape as the stock reuse-A MOP: A0 runs in context 0, the skip-A slot (zmask
+    // 0xff) in context 1.
+    ckernel_unpack_template tmp = ckernel_unpack_template(
+        false,
+        false,
+        lltt::replay_insn(0, run_len),
+        0,
+        0,
+        0,
+        lltt::replay_insn(run_len, run_len),
+        0,
+        0);
+    tmp.program();
+}
+
+}  // namespace re_mm
+#endif

+    words[1] = lp.layout[1];
+    volatile uint8_t* bytes = reinterpret_cast<volatile uint8_t*>(l1_addr + 8);
+    for (uint32_t e = 0; e < NumExperts; ++e) {
+        bytes[e] = owner[0][e];
+        bytes[NumExperts + e] = owner[1][e];
+    }
+}

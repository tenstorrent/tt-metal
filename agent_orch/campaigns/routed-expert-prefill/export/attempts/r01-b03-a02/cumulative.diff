+// Gate/up K-blocks of x carried per x CB block (row-major x path). The x CBs are sized for
+// per_core_M_max tile-rows of one K-block; a chunk with fewer rows leaves the rest of the block as
+// padding, so it fits floor(per_core_M_max / per_core_M) K-blocks instead. Batching them pays the
+// x handshake/multicast and the compute's tilize init + matmul re-init once per batch rather than
+// once per K-block. Capped at kMaxXKBlockBatch (the compute instantiates one tilize width per
+// batch size). Reader and compute both call this with the same per_core_M, so they agree on the
+// batch boundaries; the last batch of the K-loop may be shorter (min(batch, blocks left)).
+constexpr uint32_t kMaxXKBlockBatch = 4;
+
+inline uint32_t x_kblock_batch(uint32_t per_core_M, uint32_t per_core_M_max) {
+    uint32_t b = (per_core_M > 0) ? per_core_M_max / per_core_M : 1u;
+    if (b > kMaxXKBlockBatch) {
+        b = kMaxXKBlockBatch;
+    }
+    return (b < 1) ? 1u : b;
+}

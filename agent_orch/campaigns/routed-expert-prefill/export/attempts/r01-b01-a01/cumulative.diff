+// ---------------------------------------------------------------------------------------------
+// Expert-parallel row groups.
+//
+// Routed experts are small (a few tile-rows each in prefill), so spreading ONE expert over all
+// kGridY M-rows leaves most rows computing padding and runs the experts strictly one after
+// another. Instead the kGridY rows split into kGridY / rows groups of `rows` consecutive M-rows;
+// each group runs its own subset of experts, all groups concurrently. A group's rows cover an
+// expert with per_core_M = ceil(count_tiles / rows), each group-column has its own weight
+// multicast sender, and the x / activated multicasts are per M-row, so groups share nothing.
+//
+// `rows` is picked at RUNTIME from the device-side counts. Every RISC of every core runs the
+// identical integer schedule below over the same counts, so they agree on the group size and on
+// which group owns which expert without any host sync. An expert outside a core's group is
+// skipped exactly like a count-0 expert (the uniform skip every kernel already agrees on).
+constexpr uint32_t kMinGroupRows = 2;
+constexpr uint32_t kMaxGroups = kGridY / kMinGroupRows;
+
+// Index of a group size in the host's per-topology runtime-arg sets: rows 8 -> 0, 4 -> 1, 2 -> 2.
+inline uint32_t group_rows_index(uint32_t rows) { return (rows >= kGridY) ? 0u : (rows >= kGridY / 2) ? 1u : 2u; }
+
+// Modelled cost of one expert on a group of `rows` M-rows, in units of one per-core tile-row of
+// work: the per_core_M summed over its chunks, plus one unit per chunk for the chunk's fixed
+// pipeline fill/drain and its full re-read of the expert's weights. 0 for an expert with no rows.
+inline uint32_t expert_cost(uint32_t count_tiles, uint32_t rows, uint32_t per_core_M_max) {
+    const uint32_t max_chunk = per_core_M_max * rows;
+    const uint32_t chunks = num_chunks(count_tiles, max_chunk);
+    if (chunks == 0) {
+        return 0;
+    }
+    uint32_t units = (count_tiles / max_chunk) * per_core_M_max;
+    if (count_tiles % max_chunk != 0) {
+        units += per_core_M_for_chunk(chunks - 1, count_tiles, max_chunk, rows);
+    }
+    return units + chunks;
+}
+
+// List scheduling in expert order: each expert goes to the least-loaded group (lowest index on a
+// tie). Deterministic, so every kernel that feeds it the same costs in the same order derives the
+// same owner for every expert.
+struct GroupScheduler {
+    uint32_t groups = 1;
+    uint32_t loads[kMaxGroups] = {0};
+
+    void init(uint32_t num_groups) {
+        groups = num_groups;
+        for (uint32_t g = 0; g < kMaxGroups; ++g) {
+            loads[g] = 0;
+        }
+    }
+    // Charge `cost` (> 0) to the least-loaded group and return that group.
+    uint32_t assign(uint32_t cost) {
+        uint32_t best = 0;
+        for (uint32_t g = 1; g < groups; ++g) {
+            if (loads[g] < loads[best]) {
+                best = g;
+            }
+        }
+        loads[best] += cost;
+        return best;
+    }
+    uint32_t makespan() const {
+        uint32_t m = 0;
+        for (uint32_t g = 0; g < groups; ++g) {
+            m = (loads[g] > m) ? loads[g] : m;
+        }
+        return m;
+    }
+};
+
+// Group size (rows per group) with the smallest modelled makespan; ties keep the larger group, so
+// a single expert or large token counts stay on the whole-grid schedule. `tiles_of(e)` returns
+// local expert e's (band-filtered, clamped) tile-row count.
+template <typename TilesOf>
+inline uint32_t pick_group_rows(const TilesOf& tiles_of, uint32_t num_experts, uint32_t per_core_M_max) {
+    uint32_t best_rows = kGridY;
+    uint32_t best = 0xFFFFFFFFu;
+    for (uint32_t rows = kGridY; rows >= kMinGroupRows; rows /= 2) {
+        GroupScheduler sched;
+        sched.init(kGridY / rows);
+        for (uint32_t e = 0; e < num_experts; ++e) {
+            const uint32_t cost = expert_cost(tiles_of(e), rows, per_core_M_max);
+            if (cost > 0) {
+                sched.assign(cost);
+            }
+        }
+        const uint32_t m = sched.makespan();
+        if (m < best) {
+            best = m;
+            best_rows = rows;
+        }
+    }
+    return best_rows;
+}
+
 }  // namespace adaptive_chunk

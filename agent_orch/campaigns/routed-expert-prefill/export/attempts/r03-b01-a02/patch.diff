+// ---------------------------------------------------------------------------------------------
+// The plan is computed ONCE per core, by the reader, and shared with the writer and compute
+// (UNPACK) through a one-page L1 scratch CB (cb_plan_scratch). Running plan_launch in all three
+// RISCs put three copies of the planner in the core's kernel binaries (~10 KB on TRISC0 at -O3),
+// which overflowed the kernel config buffer on the h7168 shapes.
+//
+// Page layout: [layout[0] u32][layout[1] u32][owner[0][0..E) u8][owner[1][0..E) u8], padded.
+// The host sizes the page with the same formula.
+constexpr uint32_t plan_page_bytes(uint32_t num_experts) { return (8 + 2 * num_experts + 31) & ~31u; }
+
+template <uint32_t NumExperts>
+inline void store_plan(uint32_t l1_addr, const LaunchPlan& lp, const uint8_t (&owner)[2][NumExperts]) {
+    volatile uint32_t* words = reinterpret_cast<volatile uint32_t*>(l1_addr);
+    words[0] = lp.layout[0];
+    words[1] = lp.layout[1];
+    volatile uint8_t* bytes = reinterpret_cast<volatile uint8_t*>(l1_addr + 8);
+    for (uint32_t e = 0; e < NumExperts; ++e) {
+        bytes[e] = owner[0][e];
+        bytes[NumExperts + e] = owner[1][e];
+    }
+}
+
+template <uint32_t NumExperts>
+inline LaunchPlan load_plan(uint32_t l1_addr, uint8_t (&owner)[2][NumExperts]) {
+    const volatile uint32_t* words = reinterpret_cast<const volatile uint32_t*>(l1_addr);
+    LaunchPlan lp;
+    lp.layout[0] = words[0];
+    lp.layout[1] = words[1];
+    const volatile uint8_t* bytes = reinterpret_cast<const volatile uint8_t*>(l1_addr + 8);
+    for (uint32_t e = 0; e < NumExperts; ++e) {
+        owner[0][e] = bytes[e];
+        owner[1][e] = bytes[NumExperts + e];
+    }
+    return lp;
+}
+
 }  // namespace adaptive_chunk

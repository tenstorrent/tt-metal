+#ifdef ARCH_BLACKHOLE
+// Preserve the previous FP32 state through unpack and arithmetic. The packer
+// adds it to the current chunk without an extra SrcA/B round-trip.
+template <uint32_t rows, uint32_t cols, bool pop_scale, bool accumulate = true>
+void rescale_accumulate_fp32(uint32_t prev_cb, uint32_t scale_cb, uint32_t cur_cb) {
+    CircularBuffer prev(prev_cb), scale(scale_cb), cur(cur_cb);
+    prev.wait_front(rows * cols);
+    scale.wait_front(rows);
+    if constexpr (accumulate) {
+        cur.wait_front(rows * cols);
+    } else {
+        cur.reserve_back(rows * cols);
+    }
+    pack_reconfig_data_format(cur_cb);
+    PACK((llk_pack_reconfig_l1_acc(accumulate)));
+    for (uint32_t row = 0; row < rows; ++row) {
+        for (uint32_t col = 0; col < cols; ++col) {
+            tile_regs_acquire();
+            reconfig_data_format_srca(scale_cb);
+            unary_bcast_init<BroadcastType::COL>(scale_cb);
+            unary_bcast<BroadcastType::COL>(scale_cb, row, 1);
+            unary_bcast_uninit<BroadcastType::COL>(scale_cb);
+            reconfig_data_format_srca(prev_cb);
+            unary_bcast_init<BroadcastType::NONE>(prev_cb);
+            unary_bcast<BroadcastType::NONE>(prev_cb, row * cols + col, 0);
+            unary_bcast_uninit<BroadcastType::NONE>(prev_cb);
+            mul_binary_tile_init();
+            mul_binary_tile(0, 1, 0);
+            tile_regs_commit();
+            tile_regs_wait();
+            pack_tile(0, cur_cb);
+            tile_regs_release();
+        }
+    }
+    PACK((llk_pack_reconfig_l1_acc(false)));
+    prev.pop_front(rows * cols);
+    if constexpr (pop_scale) {
+        scale.pop_front(rows);
+    }
+    if constexpr (accumulate) {
+        cur.pop_front(rows * cols);
+        cur.reserve_back(rows * cols);
+    }
+    cur.push_back(rows * cols);
+}
+#endif

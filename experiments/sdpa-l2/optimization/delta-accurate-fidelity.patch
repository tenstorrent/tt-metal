+template <uint32_t scale_fp32, int iterations>
+inline void calculate_sdpa_exp_bf16() {
+    constexpr float scale = __builtin_bit_cast(float, scale_fp32);
+    for (int i = 0; i < iterations; ++i) {
+        sfpi::vFloat x = sfpi::dst_reg[0];
+        sfpi::vFloat encoded = x * (256.0f * 1.4426950408889634f * scale) + 32512.0f;
+        sfpi::vMag bits = sfpi::convert<sfpi::vUInt16>(encoded, sfpi::RoundMode::Nearest);
+        sfpi::vFloat linear = sfpi::as<sfpi::vFloat>(bits << 15);
+        sfpi::vInt exponent = sfpi::exexp(linear, sfpi::ExponentMode::Biased);
+        sfpi::vFloat mantissa = sfpi::setexp(linear, 127);
+        sfpi::vFloat polynomial = mantissa * (mantissa * 0.33718944f - 0.01674259f) + 0.68127795f;
+        sfpi::vFloat y = sfpi::setexp(polynomial, exponent);
+        y = sfpi::convert<sfpi::vFloat16b>(y, sfpi::RoundMode::Nearest);
+        v_if(x < -87.0f / scale) { y = 0.0f; }
+        v_endif;
+        sfpi::dst_reg[0] = y;
+        sfpi::dst_reg++;
+    }
+}
+
+template <uint32_t scale_fp32>
+inline void calculate_sdpa_exp_correction() {
+    constexpr float scale = __builtin_bit_cast(float, scale_fp32);
+    for (int d = 0; d < 4; ++d) {
+        sfpi::vFloat x = sfpi::dst_reg[0];
+        sfpi::dst_reg[0] = _sfpu_exp_fp32_accurate_(x * scale) - 1.0f;
+        sfpi::dst_reg += 2;
+    }
+}

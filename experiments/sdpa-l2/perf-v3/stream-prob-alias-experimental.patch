+template <int iterations, uint32_t scale_fp32>
+inline void calculate_sdpa_exp_hifi2_fused() {
+    addr_mod_t{.srca = {.incr = 0}, .srcb = {.incr = 0}, .dest = {.incr = 0}}.set(ADDR_MOD_7);
+    constexpr float ga = 1024.0f * 1.4426950408889634f * __builtin_bit_cast(float, scale_fp32);
+    constexpr float gb = 31.0f * 1024.0f - 4.0f * (32512.0f - 32500.818359375f);
+    constexpr float a = 0.07901999f * 1.0002f;
+    constexpr float b = -0.01293332f * 1.0002f;
+    constexpr float c = 0.48564498f * 1.0002f;
+    constexpr float d = 0.44808037f * 1.0002f;
+    TTI_SFPLOADI(0, 0xA, sdpa_lo16(a)); TTI_SFPLOADI(0, 0x8, sdpa_hi16(a)); TTI_SFPCONFIG(0, 11, 0);
+    TTI_SFPLOADI(0, 0xA, sdpa_lo16(b)); TTI_SFPLOADI(0, 0x8, sdpa_hi16(b)); TTI_SFPCONFIG(0, 12, 0);
+    TTI_SFPLOADI(0, 0xA, sdpa_lo16(c)); TTI_SFPLOADI(0, 0x8, sdpa_hi16(c)); TTI_SFPCONFIG(0, 13, 0);
+    TTI_SFPLOADI(0, 0xA, sdpa_lo16(d)); TTI_SFPLOADI(0, 0x8, sdpa_hi16(d)); TTI_SFPCONFIG(0, 14, 0);
+    TTI_SFPLOADI(6, 0xA, sdpa_lo16(ga)); TTI_SFPLOADI(6, 0x8, sdpa_hi16(ga));
+    TTI_SFPLOADI(7, 0xA, sdpa_lo16(gb)); TTI_SFPLOADI(7, 0x8, sdpa_hi16(gb));
+#pragma GCC unroll 4
+    for (int i = 0; i < iterations; i += 2) {
+        TTI_SFPLOAD(0, 0, ADDR_MOD_7, 0);
+        TTI_SFPLOAD(1, 0, ADDR_MOD_7, 2);
+        TTI_SFPMAD(6, 0, 7, 0, 0);
+        TTI_SFPMAD(6, 1, 7, 1, 0);
+        TTI_SFP_STOCH_RND(0, 0, 0, 0, 0, 7);
+        TTI_SFP_STOCH_RND(0, 0, 0, 1, 1, 7);
+        TTI_SFPMOV(0, 0, 2, 0);
+        TTI_SFPMOV(0, 1, 3, 0);
+        TTI_SFPSHFT(13, 2, 2, 1);
+        TTI_SFPSHFT(13, 3, 3, 1);
+        TTI_SFPSETSGN(0, 2, 0, 0);
+        TTI_SFPSETSGN(0, 3, 1, 0);
+        TTI_SFPSETEXP(127, 0, 2, 1);
+        TTI_SFPSETEXP(127, 1, 3, 1);
+        TTI_SFPMAD(2, 11, 12, 4, 0);
+        TTI_SFPMAD(3, 11, 12, 5, 0);
+        TTI_SFPMAD(2, 4, 13, 4, 0);
+        TTI_SFPMAD(3, 5, 13, 5, 0);
+        TTI_SFPMAD(2, 4, 14, 4, 0);
+        TTI_SFPMAD(3, 5, 14, 5, 0);
+        TTI_SFPEXEXP(0, 0, 2, 1);
+        TTI_SFPEXEXP(0, 1, 3, 1);
+        TTI_SFPIADD(96, 2, 2, sfpi::SFPIADD_MOD1_ARG_IMM | sfpi::SFPIADD_MOD1_CC_NONE);
+        TTI_SFPIADD(96, 3, 3, sfpi::SFPIADD_MOD1_ARG_IMM | sfpi::SFPIADD_MOD1_CC_NONE);
+        TTI_SFPSETEXP(0, 4, 2, 0);
+        TTI_SFPSETEXP(0, 5, 3, 0);
+        TTI_SFPSHFT(0xfff, 2, 2, 1);
+        TTI_SFPSHFT(0xfff, 3, 3, 1);
+        TTI_SFP_STOCH_RND(0, 0, 0, 2, 2, sfpi::SFPSTOCHRND_MOD1_FP32_TO_FP16B);
+        TTI_SFP_STOCH_RND(0, 0, 0, 3, 3, sfpi::SFPSTOCHRND_MOD1_FP32_TO_FP16B);
+        TTI_SFPSHFT(1, 2, 2, 1);
+        TTI_SFPSHFT(1, 3, 3, 1);
+        TTI_SFPSETSGN(0, 2, 0, 0);
+        TTI_SFPSETSGN(0, 3, 1, 0);
+        TTI_SFPSTORE(0, 0, ADDR_MOD_7, 0);
+        TTI_SFPSTORE(1, 0, ADDR_MOD_7, 2);
+        sfpi::dst_reg += 2;
+    }
+    // LREG11 is conventionally -1 outside this self-contained raw sequence.
+    TTI_SFPLOADI(0, 0xA, 0); TTI_SFPLOADI(0, 0x8, 0xbf80); TTI_SFPCONFIG(0, 11, 0);
+}

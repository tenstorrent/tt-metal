+inline void calculate_sdpa_fp32_recip() {
+    addr_mod_t{.srca = {.incr = 0}, .srcb = {.incr = 0}, .dest = {.incr = 0}}.set(ADDR_MOD_7);
+    sfpi::vConstFloatPrgm0 = 2.0f;
+    for (int d = 0; d < 4; ++d) {
+        sfpi::dst_reg[0] = sfpu_reciprocal_iter<2>(sfpi::dst_reg[0]);
+        sfpi::dst_reg += 2;
+    }
+}

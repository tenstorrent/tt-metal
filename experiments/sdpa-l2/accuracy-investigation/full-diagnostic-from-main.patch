+inline void calculate_sdpa_fp32_normalize() {
+    addr_mod_t{.srca = {.incr = 0}, .srcb = {.incr = 0}, .dest = {.incr = 0}}.set(ADDR_MOD_7);
+    for (int i = 0; i < 32; ++i) {
+        sfpi::vFloat out = sfpi::dst_reg[0];
+        sfpi::vFloat inv = sfpi::dst_reg[32];
+        sfpi::dst_reg[0] = out * inv;
+        sfpi::dst_reg++;
+    }
+}

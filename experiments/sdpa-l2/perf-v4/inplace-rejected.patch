+        TTI_SFPIADD(96, 3, 3, sfpi::SFPIADD_MOD1_ARG_IMM | sfpi::SFPIADD_MOD1_CC_NONE);
+        TTI_SFPSETEXP(0, 4, 2, 0);
+        TTI_SFPSETEXP(0, 5, 3, 0);
+        TTI_SFPSHFT(0xfff, 2, 2, 1);
+        TTI_SFPSHFT(0xfff, 3, 3, 1);
+        TTI_SFP_STOCH_RND(0, 0, 0, 2, 2, sfpi::SFPSTOCHRND_MOD1_FP32_TO_FP16B);
+        TTI_SFP_STOCH_RND(0, 0, 0, 3, 3, sfpi::SFPSTOCHRND_MOD1_FP32_TO_FP16B);
+        TTI_SFPSHFT(1, 2, 2, 1);
+        TTI_SFPSHFT(1, 3, 3, 1);
+        TTI_SFPSETSGN(0, 2, 0, 0);
+        TTI_SFPSETSGN(0, 3, 1, 0);
+        TTI_SFPSTORE(0, 0, ADDR_MOD_7, 0);
+        TTI_SFPSTORE(1, 0, ADDR_MOD_7, 2);
+        sfpi::dst_reg += 2;
+    }
+    // LREG11 is conventionally -1 outside this self-contained raw sequence.
+    TTI_SFPLOADI(0, 0xA, 0); TTI_SFPLOADI(0, 0x8, 0xbf80); TTI_SFPCONFIG(0, 11, 0);
+}

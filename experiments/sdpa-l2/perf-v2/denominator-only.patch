+// Compute the small online-softmax correction accurately with the full scale.
+// The sum update subsequently forms correction - 1 for the L1 numerator update.
+template <uint32_t scale_fp32>
+inline void calculate_sdpa_exp_correction() {
+    constexpr float scale = __builtin_bit_cast(float, scale_fp32);
+    for (int d = 0; d < 4; ++d) {
+        sfpi::vFloat x = sfpi::dst_reg[0];
+        sfpi::dst_reg[0] = _sfpu_exp_fp32_accurate_(x * scale);
+        sfpi::dst_reg += 2;
+    }
+}
+
+// Experimental negative-logit grid: trade exponent range for 10 fraction bits
+// in the fast-exp macro's signed-magnitude INT16 encoding. Values below about
+// -21.45 after scaling are zeroed by packer ReLU. This is not a general exp.
+template <uint32_t scale_fp32>
+inline void init_sdpa_exp_grid() {
+    constexpr float a = 1024.0f * 1.4426950408889634f * __builtin_bit_cast(float, scale_fp32);
+    constexpr float b = 31.0f * 1024.0f - 4.0f * (32512.0f - 32500.818359375f);
+    TTI_SFPLOADI(0, 0xA, sdpa_lo16(a));
+    TTI_SFPLOADI(0, 0x8, sdpa_hi16(a));
+    TTI_SFPCONFIG(0, 12, 0);
+    TTI_SFPLOADI(0, 0xA, sdpa_lo16(b));
+    TTI_SFPLOADI(0, 0x8, sdpa_hi16(b));
+    TTI_SFPCONFIG(0, 13, 0);
+    TTI_SFPLOADI(0, 0xA, 13);
+    TTI_SFPLOADI(0, 0x8, 0);
+    TTI_SFPCONFIG(0, 14, 0);
+}
+
+template <int iterations>
+inline void calculate_sdpa_exp_hifi2() {
+    addr_mod_t{.srca = {.incr = 0}, .srcb = {.incr = 0}, .dest = {.incr = 0}}.set(ADDR_MOD_6);
+    addr_mod_t{.srca = {.incr = 0}, .srcb = {.incr = 0}, .dest = {.incr = 2}}.set(ADDR_MOD_7);
+    TTI_SFPLOADI(0, 0xA, sdpa_lo16(0.07901999f * 1.0002f));
+    TTI_SFPLOADI(0, 0x8, sdpa_hi16(0.07901999f * 1.0002f));
+    TTI_SFPLOADI(1, 0xA, sdpa_lo16(-0.01293332f * 1.0002f));
+    TTI_SFPLOADI(1, 0x8, sdpa_hi16(-0.01293332f * 1.0002f));
+    TTI_SFPLOADI(2, 0xA, sdpa_lo16(0.48564498f * 1.0002f));
+    TTI_SFPLOADI(2, 0x8, sdpa_hi16(0.48564498f * 1.0002f));
+    TTI_SFPLOADI(4, 0xA, sdpa_lo16(0.44808037f * 1.0002f));
+    TTI_SFPLOADI(4, 0x8, sdpa_hi16(0.44808037f * 1.0002f));
+#pragma GCC unroll 4
+    for (int i = 0; i < iterations; i += 2) {
+        TTI_SFPLOAD(3, InstrModLoadStore::FP32, ADDR_MOD_6, 0);
+        TTI_SFPLOAD(5, InstrModLoadStore::FP32, ADDR_MOD_6, 2);
+        TTI_SFPSETEXP(127, 3, 3, 1);
+        TTI_SFPSETEXP(127, 5, 5, 1);
+        TTI_SFPMAD(3, 0, 1, 6, 0);
+        TTI_SFPMAD(5, 0, 1, 7, 0);
+        TTI_SFPMAD(3, 6, 2, 6, 0);
+        TTI_SFPMAD(5, 7, 2, 7, 0);
+        TTI_SFPMAD(3, 6, 4, 6, 0);
+        TTI_SFPMAD(5, 7, 4, 7, 0);
+        TTI_SFPLOAD(3, InstrModLoadStore::FP32, ADDR_MOD_6, 0);
+        TTI_SFPEXEXP(0, 3, 5, 1);
+        TTI_SFPIADD(96, 5, 5, 5);
+        TTI_SFPSETEXP(0, 6, 5, 0);
+        TTI_SFPSETSGN(0, 5, 3, 0);
+        TTI_SFPSHFT(0xfff, 3, 3, 1);
+        TTI_SFP_STOCH_RND(0, 0, 0, 3, 3, sfpi::SFPSTOCHRND_MOD1_FP32_TO_FP16B);
+        TTI_SFPSHFT(1, 3, 3, 1);
+        TTI_SFPSTORE(3, InstrModLoadStore::FP32, ADDR_MOD_7, 0);
+        TTI_SFPLOAD(5, InstrModLoadStore::FP32, ADDR_MOD_6, 0);
+        TTI_SFPEXEXP(0, 5, 3, 1);
+        TTI_SFPIADD(96, 3, 3, 5);
+        TTI_SFPSETEXP(0, 7, 3, 0);
+        TTI_SFPSETSGN(0, 3, 5, 0);
+        TTI_SFPSHFT(0xfff, 5, 5, 1);
+        TTI_SFP_STOCH_RND(0, 0, 0, 5, 5, sfpi::SFPSTOCHRND_MOD1_FP32_TO_FP16B);
+        TTI_SFPSHFT(1, 5, 5, 1);
+        TTI_SFPSTORE(5, InstrModLoadStore::FP32, ADDR_MOD_7, 0);
+    }
+}

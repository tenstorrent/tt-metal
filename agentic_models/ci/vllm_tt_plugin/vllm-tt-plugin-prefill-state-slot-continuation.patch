+def _alloc_preserved_prefill_state_slots(runner, row_req_ids: list[str]) -> list[int]:
+    """``_alloc_prefill_state_slots`` for a model declaring
+    ``preserve_prefill_state_slots``: keep continuing prefills in their owned
+    slots. New requests prefer their decode row when free, without displacing any
+    live owner.
+
+    Exhaustion is unreachable: holders and new requests both count against
+    ``max_num_seqs``, which is ``n_slots``. Getting here means the map has stopped
+    describing the device, and nothing on the host can recover it, so fail rather
+    than guess and return plausible, wrong text.
+    """
+    n_slots = runner.tt_per_lane_max_num_seqs
+    if len(row_req_ids) > n_slots:
+        raise RuntimeError(
+            f"{len(row_req_ids)} prefill(s) exceed the {n_slots} device state "
+            "slots; admission is the scheduler's job, not this function's"
+        )
+    owners = {
+        req_id: slot
+        for req_id, slot in runner._req_state_slot.items()
+        if req_id in runner.requests
+    }
+    # Reserve continuations before assigning newcomers: row order need not
+    # match the slot order from the preceding chunk, and prefill has no gather.
+    held = set(owners.values())
+    slots: list[int] = []
+    for row, req_id in enumerate(row_req_ids):
+        if req_id in owners:
+            slot = owners[req_id]
+        elif row not in held:
+            slot = row
+        else:
+            free = [s for s in range(n_slots) if s not in held]
+            if not free:
+                raise RuntimeError(
+                    f"no free device state slot for {len(row_req_ids)} prefill(s): "
+                    f"held={sorted(held)}, capacity={n_slots}, "
+                    f"map={runner._req_state_slot}"
+                )
+            slot = free[0]
+        held.add(slot)
+        runner._req_state_slot[req_id] = slot
+        slots.append(slot)
+    return slots
+

+# --- ``preserve_prefill_state_slots``: continuing prefills keep their slot ---
+
+
+def _preserving_runner(slots=SLOTS):
+    r = _runner(slots=slots)
+    r.model = SimpleNamespace(model_capabilities={"preserve_prefill_state_slots": True})
+    return r
+
+
+@pytest.mark.parametrize("rows", [["C", "B"], ["B", "C"], ["B", "A"]])
+def test_prefill_continuation_keeps_state_when_rows_change(rows):
+    r = _preserving_runner(slots=3)
+    _prefill(r, ["A", "B"])
+    state = ["A", "B", None]
+    old_slots = dict(r._req_state_slot)
+
+    slots = _prefill(r, rows)
+    for req_id, slot in zip(rows, slots):
+        if req_id in old_slots:
+            assert slot == old_slots[req_id]
+            assert state[slot] == req_id
+        else:
+            assert state[slot] is None
+            state[slot] = req_id
+    _assert_state_found(r, state)
+
+
+def test_prefill_continuation_reserves_owner_after_peer_release():
+    r = _preserving_runner(slots=3)
+    _prefill(r, ["A", "B", "C"])
+    state = ["A", "B", "C"]
+    _release(r, preempted={"C"})
+    state[2] = None
+    slots = _prefill(r, ["D", "B"])
+    assert slots == [2, 1]
+    state[slots[0]] = "D"
+    # A preempted request remains in requests but owns no state until resumed.
+    r.requests.pop("C")
+    _assert_state_found(r, state)
+
+
+@pytest.mark.parametrize(
+    "capabilities", [None, {}, {"preserve_prefill_state_slots": False}]
+)
+@pytest.mark.parametrize(
+    "rows,expected", [(["B", "A"], [0, 1]), (["C", "B"], [1, 2]), (["A", "B"], [0, 1])]
+)
+def test_without_the_capability_the_slot_choice_is_unchanged(
+    capabilities, rows, expected
+):
+    """Undeclared, a continuation is re-placed by row exactly as before the opt-in
+    existed: only live requests that are not prefilling this step hold slots."""
+    r = _runner(slots=3)
+    if capabilities is not None:
+        r.model = SimpleNamespace(model_capabilities=capabilities)
+    assert _prefill(r, ["A", "B"]) == [0, 1]
+    assert _prefill(r, rows) == expected
+
+
+@pytest.mark.parametrize("value", [0, 1, "true", None, []])
+def test_a_non_boolean_declaration_is_rejected(value):
+    r = _runner(slots=3)
+    r.model = SimpleNamespace(
+        model_capabilities={"preserve_prefill_state_slots": value}
+    )
+    with pytest.raises(ValueError, match="preserve_prefill_state_slots"):
+        _prefill(r, ["A"])
+    assert r._req_state_slot == {}
+
+
+def test_preempted_mid_prefill_resume_takes_a_free_slot_without_moving_peers():
+    """Preemption during a chunked prefill, then the resume. Under vLLM 0.32 the
+    release of the preempted slot precedes the step's prefill allocation (in
+    ``_update_states``), whether the resume lands in that same step (V2 shape,
+    rebuilt from ``scheduled_new_reqs``) or later. The resume is a newcomer: it
+    must not reclaim its old slot from, or displace, a continuing peer."""
+    r = _preserving_runner(slots=3)
+    assert _prefill(r, ["A", "B"]) == [0, 1]  # both mid-prefill
+    state = ["A", "B", None]
+
+    # A is preempted; C is admitted ahead of A's resume and B continues at row 1.
+    _release(r, preempted={"A"})
+    state[0] = None
+    slots = _prefill(r, ["C", "B"])
+    assert slots == [0, 1]
+    state[slots[0]] = "C"
+
+    # A resumes (re-prefill from zero) while B still continues, at a reordered row.
+    _release(r)
+    slots = _prefill(r, ["B", "A"])
+    assert slots[0] == 1, "the continuing peer keeps its slot"
+    assert slots[1] == 2, "the resume takes the only free slot"
+    state[slots[1]] = "A"
+    _assert_state_found(r, state)
+
+    # Same-step preempt-and-resume: the release and the allocation share a step.
+    _release(r, preempted={"B"})
+    state[1] = None
+    slots = _prefill(r, ["A", "B"])
+    assert slots == [2, 1], "A continues in place; B re-prefills into its freed slot"
+    state[1] = "B"
+    _assert_state_found(r, state)
+
+
+def test_platform_rejects_a_non_boolean_preserve_declaration(monkeypatch):
+    from vllm.config import (
+        CacheConfig,
+        DeviceConfig,
+        ModelConfig,
+        ParallelConfig,
+        SchedulerConfig,
+        VllmConfig,
+    )
+
+    from tests.test_block_scheduler import (
+        LOCAL_MODEL_CONFIG,
+        _stub_model_resolution,
+        _StubModel,
+    )
+
+    monkeypatch.setattr(
+        _StubModel,
+        "model_capabilities",
+        {"preserve_prefill_state_slots": 1},
+        raising=False,
+    )
+    model_config = ModelConfig(
+        model=str(LOCAL_MODEL_CONFIG),
+        dtype="float16",
+        seed=42,
+        skip_tokenizer_init=True,
+    )
+    with (
+        _stub_model_resolution(),
+        pytest.raises(ValueError, match="preserve_prefill_state_slots"),
+    ):
+        VllmConfig(
+            model_config=model_config,
+            scheduler_config=SchedulerConfig(
+                max_model_len=model_config.max_model_len,
+                is_encoder_decoder=model_config.is_encoder_decoder,
+            ),
+            cache_config=CacheConfig(block_size=128),
+            parallel_config=ParallelConfig(),
+            device_config=DeviceConfig(device="cpu"),
+        )

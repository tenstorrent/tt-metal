+def resolve_tt_preserve_prefill_state_slots(model_capabilities: dict | None) -> bool:
+    """Validate the opt-in that keeps a continuing prefill in its owned slot."""
+    preserve = (model_capabilities or {}).get("preserve_prefill_state_slots", False)
+    if not isinstance(preserve, bool):
+        raise ValueError(
+            "model_capabilities['preserve_prefill_state_slots'] must be a boolean, "
+            f"got {preserve!r}"
+        )
+    return preserve
+

@@ -0,0 +1,184 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+"""Opt-in completion-row sampling; model behavior below is a host test double."""
+
+from dataclasses import replace
+from types import MethodType, SimpleNamespace
+
+import pytest
+import torch
+from vllm.sampling_params import SamplingParams
+from vllm.v1.worker.gpu_input_batch import CachedRequestState
+
+from tests.test_lane_model_runner import _lane_batch
+from tests.test_model_runner import (
+    VOCAB_SIZE,
+    _batch_with_one_request,
+    _fake_runner,
+    _prepare,
+)
+from vllm_tt_plugin import config
+from vllm_tt_plugin.model_runner import TTModelRunner
+
+
+class MaskedModel:
+    def __init__(self, declaration):
+        self.model_capabilities = {"supports_sample_on_device": True}
+        if declaration is not None:
+            self.model_capabilities["supports_prefill_sampling_mask"] = declaration
+        self.calls = []
+        self.draws = []
+
+    def prefill_forward(self, **kwargs):
+        self.calls.append(kwargs)
+        count = len(kwargs["prompt_lens"])
+        mask = kwargs.get("prefill_sampling_mask", [True] * count)
+        device = "sampling_params" in kwargs
+        self.draws = [int(device and may_emit) for may_emit in mask]
+        if device:
+            return torch.tensor([[7 if may_emit else 0] for may_emit in mask])
+        return torch.zeros(count, 1, VOCAB_SIZE)
+
+
+def _runner(declaration, ends, host_compat=False):
+    params = SamplingParams(
+        temperature=0.0, allowed_token_ids=[1, 2] if host_compat else None
+    )
+    batch, request = _batch_with_one_request(8, 0, 0, params)
+    runner = _fake_runner(batch, request)
+    for row in range(1, len(ends)):
+        req = CachedRequestState(
+            req_id=f"r{row}",
+            prompt_token_ids=list(range(8)),
+            mm_features=None,
+            sampling_params=params,
+            generator=None,
+            block_ids=([row],),
+            num_computed_tokens=0,
+            output_token_ids=[],
+        )
+        batch.add_request(req)
+        runner.requests[req.req_id] = req
+    batch.refresh_logitsprocs()
+    runner.model = MaskedModel(declaration)
+    runner.model_config.logits_processors = []
+    runner.sample_on_device_mode = "all"
+    runner.seeded_sampling_policy = "auto"
+    runner.num_devices = 4
+    runner.supports_device_grammar = False
+    runner.supports_topk_logprobs = False
+    runner.check_perform_device_sampling = MethodType(
+        TTModelRunner.check_perform_device_sampling, runner
+    )
+    runner.kv_caches = object()
+    runner.trace_mode = "all"
+    runner.request_specific_rope = False
+    runner.async_decode = SimpleNamespace(note_prefill_submitted=lambda: None)
+    rows = [("r" if i == 0 else f"r{i}", end, 0, 0) for i, end in enumerate(ends)]
+    return runner, _prepare(runner, *rows)
+
+
+@pytest.mark.parametrize("declaration", [None, False, True])
+@pytest.mark.parametrize("ends", [[2], [2, 8], [8, 2], [8, 8]])
+@pytest.mark.parametrize("host_compat", [False, True])
+def test_prefill_mask_routing_and_submission(declaration, ends, host_compat):
+    runner, model_input = _runner(declaration, ends, host_compat)
+    has_intermediate = any(end < 8 for end in ends)
+    expected_device = not host_compat and (not has_intermediate or declaration is True)
+    assert model_input.perform_device_sampling is expected_device
+    result = TTModelRunner.submit_prefill(runner, model_input, [len(ends)])
+    call = runner.model.calls[-1]
+    expected_mask = [end == 8 for end in ends]
+    if declaration is True:
+        assert call["prefill_sampling_mask"] == expected_mask
+        assert runner.model.draws == [
+            int(expected_device and final) for final in expected_mask
+        ]
+    else:
+        assert "prefill_sampling_mask" not in call
+    assert ("sampling_params" in call) is expected_device
+    assert result.shape[0] == len(ends)
+
+
+@pytest.mark.parametrize(
+    "mask", [torch.tensor([1]), torch.tensor([[True]]), torch.tensor([True, False])]
+)
+def test_submission_rejects_invalid_intermediate_mask_before_model(mask):
+    runner, model_input = _runner(True, [2])
+    model_input = replace(model_input, intermediate_prefill_mask=mask)
+    with pytest.raises(ValueError, match="intermediate_prefill_mask"):
+        TTModelRunner.submit_prefill(runner, model_input, [1])
+    assert not runner.model.calls
+
+
+def test_no_intermediate_metadata_means_all_final_rows():
+    runner, model_input = _runner(True, [8, 8])
+    model_input = replace(model_input, intermediate_prefill_mask=None)
+    TTModelRunner.submit_prefill(runner, model_input, [2])
+    assert runner.model.calls[-1]["prefill_sampling_mask"] == [True, True]
+
+
+@pytest.mark.parametrize("invalid", [0, 1, "true", None, []])
+def test_capability_rejects_non_boolean(invalid):
+    model = SimpleNamespace(
+        model_capabilities={"supports_prefill_sampling_mask": invalid}
+    )
+    with pytest.raises(ValueError, match="supports_prefill_sampling_mask.*boolean"):
+        config.get_model_supports_prefill_sampling_mask(model)
+
+
+@pytest.mark.parametrize(
+    "model", [None, SimpleNamespace(), SimpleNamespace(model_capabilities={})]
+)
+def test_absent_capability_defaults_false(model):
+    assert config.get_model_supports_prefill_sampling_mask(model) is False
+
+
+@pytest.mark.parametrize("ends", [[2], [2, 8], [8, 2]])
+def test_device_output_suppresses_intermediate_emissions(ends):
+    runner, model_input = _runner(True, ends)
+    runner.vocab_size = VOCAB_SIZE
+    runner._is_block_output_model = False
+    tt_out = TTModelRunner.submit_prefill(runner, model_input, [len(ends)])
+    tokens, logprobs = TTModelRunner._get_output_tokens(
+        runner,
+        tt_out,
+        None,
+        model_input.tt_sampling_params,
+        model_input,
+        [len(ends)],
+        True,
+        False,
+    )
+    runner._apply_sampled_tokens_to_state = lambda *args, **kwargs: None
+    result = TTModelRunner._build_chunked_prefill_output(
+        runner,
+        model_input.row_req_ids,
+        tokens[0],
+        logprobs[0],
+        model_input.intermediate_prefill_mask.numpy(),
+    )
+    assert result.sampled_token_ids == [[7] if end == 8 else [] for end in ends]
+
+
+def test_lane_device_output_accepts_opted_in_mixed_mask():
+    batch = _lane_batch()
+    runner = SimpleNamespace(model=MaskedModel(True))
+    model_input = SimpleNamespace(
+        perform_device_sampling=True,
+        intermediate_prefill_mask=torch.tensor([True, False]),
+        tt_sampling_params=SimpleNamespace(
+            enable_log_probs=torch.zeros(2, dtype=torch.bool)
+        ),
+        max_num_logprobs=[None],
+        grammar_bitmask=[None],
+    )
+    tokens, logprobs = batch.extract_output(
+        runner,
+        torch.tensor([[0], [7]]),
+        None,
+        model_input,
+        [4, 1],

+def resolve_tt_prefix_cache_recurrent_state_in_model(
+    model_capabilities: dict | None,
+) -> bool:
+    """Validate the declaration that the model snapshots its own recurrent state
+    for prefix caching (so vLLM only manages attention KV blocks)."""
+    in_model = (model_capabilities or {}).get(
+        "prefix_cache_recurrent_state_in_model", False
+    )
+    if not isinstance(in_model, bool):
+        raise ValueError(
+            "model_capabilities['prefix_cache_recurrent_state_in_model'] must be a "
+            f"boolean, got {in_model!r}"
+        )
+    return in_model

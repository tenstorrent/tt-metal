+def _install_prefix_hit_clip() -> None:
+    """Clip vLLM attention prefix-cache hits to what the model can restore.
+
+    Installed only for a model declaring
+    ``prefix_cache_recurrent_state_in_model`` with prefix caching on. Such a
+    model snapshots its own recurrent state and may register
+    ``vllm_tt_plugin.prefix_hit_clip(token_ids, n) -> m`` (the longest
+    restorable prefix ``m <= n``, block aligned). Without the clip, a hit whose
+    recurrent state is not snapshotted makes the model re-prefill the whole
+    prefix inside one scheduler step that vLLM budgeted as a few tokens, stalling
+    every decoder; clipping keeps vLLM's token budget and chunking in charge of
+    the re-prefill. With no clip registered the wrapper returns vLLM's result.
+    """
+    from vllm.v1.core.kv_cache_manager import KVCacheManager
+
+    if getattr(KVCacheManager.get_computed_blocks, "_tt_prefix_hit_clip", False):
+        return
+    original = KVCacheManager.get_computed_blocks
+
+    def get_computed_blocks(self, request):
+        result = original(self, request)
+        blocks, num_computed = result[0], result[1]
+        import vllm_tt_plugin
+
+        clip = getattr(vllm_tt_plugin, "prefix_hit_clip", None)
+        if clip is None or num_computed <= 0:
+            return result
+        keep = int(clip(request.all_token_ids, num_computed))
+        if keep >= num_computed:
+            return result
+        if keep <= 0:
+            return (self.empty_kv_cache_blocks, 0, *result[2:])
+        return (self.truncate_computed_blocks(blocks, keep), keep, *result[2:])
+
+    get_computed_blocks._tt_prefix_hit_clip = True
+    KVCacheManager.get_computed_blocks = get_computed_blocks
+    logger.info(
+        "Prefix caching: hits clipped to model-restorable recurrent-state snapshots."
+    )
+
+
 def _install_block_output_streaming_input_patch() -> None:
     """Reject streaming-input sessions before vLLM creates a final request."""
     import vllm.v1.engine.async_llm as async_llm
@@ -2291,6 +2333,16 @@ class TTPlatform(Platform):

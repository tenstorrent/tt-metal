+        if vllm_config.cache_config.enable_prefix_caching and (
+            resolve_tt_prefix_cache_recurrent_state_in_model(model_capabilities)
+        ):
+            # A hybrid model that snapshots its own recurrent state and exposes
+            # only attention KV to vLLM uses plain attention prefix caching:
+            # core's hybrid "align" mode (recurrent state in KV blocks,
+            # block-aligned chunk splits) does not apply.
+            if getattr(vllm_config.cache_config, "mamba_cache_mode", "none") != "none":
+                _renormalize_mamba_cache_config(vllm_config)
+            _install_prefix_hit_clip()
         logger.info(
             "Automatic prefix caching is %s",
             "enabled" if vllm_config.cache_config.enable_prefix_caching else "disabled",

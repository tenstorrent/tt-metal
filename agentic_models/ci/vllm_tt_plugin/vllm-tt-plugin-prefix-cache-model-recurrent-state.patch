index 0000000..fe85fec
--- /dev/null
+++ b/tests/test_prefix_cache_model_state.py
@@ -0,0 +1,161 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+"""``prefix_cache_recurrent_state_in_model``: a hybrid model that snapshots its
+own recurrent state gets plain attention prefix caching.
+
+Only the declaration together with ``--enable-prefix-caching`` changes the
+config (``mamba_cache_mode`` -> ``none``) and installs the prefix-hit clip;
+``supports_prefix_caching`` alone (K2) leaves both as they were.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+from vllm.config import (
+    CacheConfig,
+    DeviceConfig,
+    ModelConfig,
+    ParallelConfig,
+    SchedulerConfig,
+    VllmConfig,
+)
+from vllm.v1.core.kv_cache_manager import KVCacheManager
+
+import vllm_tt_plugin
+from tests.test_block_scheduler import (
+    LOCAL_MODEL_CONFIG,
+    _stub_model_resolution,
+    _StubModel,
+)
+from vllm_tt_plugin import config as tt_config
+from vllm_tt_plugin.platform import _install_prefix_hit_clip
+
+APC = {"supports_prefix_caching": True, "supports_chunked_prefill": True}
+IN_MODEL = {**APC, "prefix_cache_recurrent_state_in_model": True}
+
+
+@pytest.fixture(autouse=True)
+def _no_registered_clip(monkeypatch):
+    # tests/conftest.py restores KVCacheManager.get_computed_blocks after each test.
+    monkeypatch.delattr(vllm_tt_plugin, "prefix_hit_clip", raising=False)
+
+
+def _is_wrapped() -> bool:
+    return bool(
+        getattr(KVCacheManager.get_computed_blocks, "_tt_prefix_hit_clip", False)
+    )
+
+
+def _config(monkeypatch, capabilities, *, prefix_caching=True):
+    monkeypatch.setattr(_StubModel, "model_capabilities", capabilities, raising=False)
+    model_config = ModelConfig(
+        model=str(LOCAL_MODEL_CONFIG),
+        dtype="float16",
+        seed=42,
+        skip_tokenizer_init=True,
+    )
+    cache_config = (
+        CacheConfig(
+            block_size=128,
+            enable_prefix_caching=True,
+            mamba_cache_mode="align",
+            mamba_block_size=256,
+        )
+        if prefix_caching
+        else CacheConfig(block_size=128, enable_prefix_caching=False)
+    )
+    with _stub_model_resolution():
+        return VllmConfig(
+            model_config=model_config,
+            scheduler_config=SchedulerConfig(
+                max_model_len=model_config.max_model_len,
+                is_encoder_decoder=model_config.is_encoder_decoder,
+            ),
+            cache_config=cache_config,
+            parallel_config=ParallelConfig(),
+            device_config=DeviceConfig(device="cpu"),
+        )
+
+
+def test_declared_with_prefix_caching_uses_plain_attention_apc(monkeypatch):
+    cfg = _config(monkeypatch, IN_MODEL)
+    assert cfg.cache_config.enable_prefix_caching is True
+    assert cfg.cache_config.mamba_cache_mode == "none"
+    assert cfg.cache_config.mamba_block_size == cfg.model_config.max_model_len
+    assert _is_wrapped()
+
+
+@pytest.mark.parametrize(
+    "capabilities",
+    [APC, {**APC, "prefix_cache_recurrent_state_in_model": False}],
+    ids=["k2-like-supports-prefix-caching-only", "declared-false"],
+)
+def test_undeclared_keeps_the_config_and_the_cache_manager(monkeypatch, capabilities):
+    cfg = _config(monkeypatch, capabilities)
+    assert cfg.cache_config.enable_prefix_caching is True
+    assert cfg.cache_config.mamba_cache_mode == "align"
+    assert cfg.cache_config.mamba_block_size == 256
+    assert not _is_wrapped()
+
+
+def test_declared_without_prefix_caching_changes_nothing(monkeypatch):
+    cfg = _config(monkeypatch, IN_MODEL, prefix_caching=False)
+    assert cfg.cache_config.enable_prefix_caching is False
+    assert cfg.cache_config.mamba_cache_mode == "none"
+    assert not _is_wrapped()
+
+
+@pytest.mark.parametrize("value", [0, 1, "true", None, []])
+def test_a_non_boolean_declaration_is_rejected(value):
+    with pytest.raises(ValueError, match="prefix_cache_recurrent_state_in_model"):
+        tt_config.resolve_tt_prefix_cache_recurrent_state_in_model(
+            {"prefix_cache_recurrent_state_in_model": value}
+        )
+
+
+class _Manager:
+    """Just what the wrapper reads from ``self``."""
+
+    empty_kv_cache_blocks = "EMPTY"
+
+    def truncate_computed_blocks(self, blocks, keep):
+        return (blocks, "truncated", keep)
+
+
+def _wrapped(monkeypatch, hit):
+    monkeypatch.setattr(
+        KVCacheManager,
+        "get_computed_blocks",
+        lambda self, request: ("BLOCKS", hit, 7),
+    )
+    _install_prefix_hit_clip()
+    _install_prefix_hit_clip()  # idempotent
+    assert _is_wrapped()
+    request = SimpleNamespace(all_token_ids=list(range(1000)))
+    return KVCacheManager.get_computed_blocks(_Manager(), request)
+
+
+def test_the_clip_is_a_no_op_until_a_model_registers_one(monkeypatch):
+    assert _wrapped(monkeypatch, 512) == ("BLOCKS", 512, 7)
+
+
+@pytest.mark.parametrize(
+    "hit,keep,expected",
+    [
+        (512, 600, ("BLOCKS", 512, 7)),
+        (512, 512, ("BLOCKS", 512, 7)),
+        (512, 256, (("BLOCKS", "truncated", 256), 256, 7)),
+        (512, 0, ("EMPTY", 0, 7)),
+        (0, 0, ("BLOCKS", 0, 7)),
+    ],
+)
+def test_a_registered_clip_shortens_the_hit(monkeypatch, hit, keep, expected):
+    seen = []
+
+    def clip(token_ids, n):
+        seen.append(n)
+        return keep
+
+    monkeypatch.setattr(vllm_tt_plugin, "prefix_hit_clip", clip, raising=False)
+    assert _wrapped(monkeypatch, hit) == expected
+    assert seen == ([hit] if hit > 0 else [])

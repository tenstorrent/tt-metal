 src/vllm_tt_plugin/config.py       | 11 ++++++
 src/vllm_tt_plugin/model_runner.py | 19 +++++++--
 tests/test_device_top_k_routing.py | 63 ++++++++++++++++++++++++++++++
 tests/test_sample_time_grammar.py  | 37 ++++++++++++++++++

# Single-rank single-galaxy mesh for the LTX-2.3 multihost CI (bh_sc1) legs.
# LTX's 4x8sp1tp0nl2_ring config uses FabricConfig FABRIC_1D_RING, which requires the MGD to
# provide TORUS_XY connectivity (BOTH dims wrap). A FabricConfig can only *restrict* topology
# (torus->mesh), not add links, so a single-axis ring (TORUS_X, i.e. dim_types [LINE, RING]) fails
# at mesh_graph init with "requires more connectivity than MGD provides". Both dims are therefore
# RING, matching the proven tt_metal/fabric single_bh_galaxy_torus_xy descriptor (that one is [8,4];
# here it is [4,8] because the LTX test requests a 4x8 mesh). One rank owns the whole 32-device
# galaxy (confirmed on bh_sc1: a single rank sees all 32 chips).
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 8 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels {
    count: 2
    policy: RELAXED
  }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

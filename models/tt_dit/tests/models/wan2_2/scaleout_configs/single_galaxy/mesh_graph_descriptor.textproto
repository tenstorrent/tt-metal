# Single-rank single-galaxy mesh for the Wan2.2 multihost CI (bh_sc1) legs.
# The 4x8sp1tp0nl2_ring configs use FabricConfig FABRIC_1D_RING, which requires the MGD to provide
# TORUS_XY connectivity (BOTH dims wrap). A FabricConfig can only *restrict* topology (torus->mesh),
# not add links, so a single-axis ring (dim_types [LINE, RING]) fails at mesh_graph init with
# "requires more connectivity than MGD provides". Both dims are therefore RING -- identical to the
# LTX-2.3 single_galaxy descriptor, which is proven on bh_sc1. The 4x8 orientation matches the wan
# 4x8* parametrization ids; the repo-level tt_metal/fabric single_bh_galaxy_torus_xy descriptor is
# [8,4], the wrong orientation for these tests.
# channels count 2 matches BHGLX's 2 ethernet links per neighbour pair (models/common/modules/tt_ccl.py
# get_num_links); the nl4 parametrizations cannot run here and self-skip via
# skip_if_unsupported_num_links. One rank owns the whole 32-device galaxy.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 8 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels {
    count: 2
    policy: RELAXED
  }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

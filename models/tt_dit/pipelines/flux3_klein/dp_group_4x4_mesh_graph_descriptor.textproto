# Two FLUX 3 Klein data-parallel groups of a Blackhole Galaxy as one process's mesh (dp_processes.py): 4 x 4 chips, the 4-chip
# column axis a ring (the Galaxy's wrap-around links), the other axis a line, two links between neighbours.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

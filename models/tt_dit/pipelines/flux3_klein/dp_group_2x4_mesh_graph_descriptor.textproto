# Two FLUX 3 Klein DP8 groups of a Blackhole Galaxy as one process's mesh (dp_processes.py): a 2 x 4 block, both
# axes lines (the block closes no ring), two links between neighbours.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 4 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

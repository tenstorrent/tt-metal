# credentials — NEVER commit
.env.agent
.env
# run artifacts (large; per-run)
runs/
.cache/
# --persist run memory: ledger, baselines, caches, agent transcripts, the live report.
# In the repo so everything a run produces is in one place, and ignored so a fourteen-hour
# run does not leave the working tree dirty (which blocks the NEXT run's isolation check).
.state/
# python bytecode
__pycache__/
*.pyc
.benchmarks/
generated/
.pytest_cache/

# scratch / local
_run_*.sh
_synth_responses/
*.log
model_cache/

# provisional learned knobs — local only; only GRADUATED_* (cross-model-proven) is committed/pushed
GUIDELINES/LEARNED_*.md

# per-run scratch mcp configs
cc_optimize/.mcp_config_*.json

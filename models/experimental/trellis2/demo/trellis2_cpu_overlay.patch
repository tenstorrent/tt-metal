new file mode 100644
index 0000000..248e89e
--- /dev/null
+++ b/trellis2/modules/sparse/conv/conv_torch.py
@@ -0,0 +1,89 @@
+import math
+import torch
+import torch.nn as nn
+from .. import SparseTensor
+
+
+# Pure-torch submanifold conv with flex_gemm's weight layout and offset order, so flex_gemm checkpoints load
+# unchanged: weight (Co, K0, K1, K2, Ci), offset index ij-ordered over coords[:, 1], [:, 2], [:, 3], and
+# out[i] = sum_k W[k] @ in[coord_i + offset_k] (cross-correlation, like dense conv3d).
+
+
+def sparse_conv3d_init(self, in_channels, out_channels, kernel_size, stride=1, dilation=1, padding=None, bias=True, indice_key=None):
+    assert stride == 1 and (padding is None), 'torch backend only supports submanifold sparse convolution (stride=1, padding=None)'
+
+    self.in_channels = in_channels
+    self.out_channels = out_channels
+    self.kernel_size = tuple(kernel_size) if isinstance(kernel_size, (list, tuple)) else (kernel_size, ) * 3
+    self.stride = tuple(stride) if isinstance(stride, (list, tuple)) else (stride, ) * 3
+    self.dilation = tuple(dilation) if isinstance(dilation, (list, tuple)) else (dilation, ) * 3
+
+    self.weight = nn.Parameter(torch.empty((out_channels, in_channels, *self.kernel_size)))
+    if bias:
+        self.bias = nn.Parameter(torch.empty(out_channels))
+    else:
+        self.register_parameter("bias", None)
+
+    torch.nn.init.kaiming_uniform_(self.weight, a=math.sqrt(5))
+    if self.bias is not None:
+        fan_in, _ = torch.nn.init._calculate_fan_in_and_fan_out(self.weight)
+        if fan_in != 0:
+            bound = 1 / math.sqrt(fan_in)
+            torch.nn.init.uniform_(self.bias, -bound, bound)
+
+    # (Co, Ci, K0, K1, K2) -> (Co, K0, K1, K2, Ci), the flex_gemm checkpoint layout
+    self.weight = nn.Parameter(self.weight.permute(0, 2, 3, 4, 1).contiguous())
+
+
+def build_neighbor_map(coords: torch.Tensor, spatial_shape, kernel_size, dilation) -> torch.Tensor:
+    """[V, N] int64 map: row k holds the index of coord_i + offset_k, or -1 if that voxel is inactive."""
+    W, H, D = (int(s) for s in spatial_shape)
+    c = coords.long()
+    keys = ((c[:, 0] * W + c[:, 1]) * H + c[:, 2]) * D + c[:, 3]
+    sorted_keys, order = torch.sort(keys)
+    N = c.shape[0]
+    axes = [torch.arange(-(k // 2) * d, k // 2 * d + 1, d) for k, d in zip(kernel_size, dilation)]
+    offsets = torch.stack(torch.meshgrid(*axes, indexing='ij'), dim=-1).reshape(-1, 3).tolist()
+    nbr = torch.empty((len(offsets), N), dtype=torch.long, device=coords.device)
+    for k, (dx, dy, dz) in enumerate(offsets):
+        x, y, z = c[:, 1] + dx, c[:, 2] + dy, c[:, 3] + dz
+        valid = (x >= 0) & (x < W) & (y >= 0) & (y < H) & (z >= 0) & (z < D)
+        q = ((c[:, 0] * W + x) * H + y) * D + z
+        pos = torch.searchsorted(sorted_keys, q).clamp_(max=N - 1)
+        hit = valid & (sorted_keys[pos] == q)
+        nbr[k] = torch.where(hit, order[pos], torch.full_like(pos, -1))
+    return nbr
+
+
+def sparse_conv3d_forward(self, x: SparseTensor) -> SparseTensor:
+    Co, K0, K1, K2, Ci = self.weight.shape
+    neighbor_cache_key = f'SubMConv3d_torch_neighbor_cache_{K0}x{K1}x{K2}_dilation{self.dilation}'
+    nbr = x.get_spatial_cache(neighbor_cache_key)
+    if nbr is None:
+        nbr = build_neighbor_map(x.coords, x.spatial_shape, (K0, K1, K2), self.dilation)
+        x.register_spatial_cache(neighbor_cache_key, nbr)
+
+    feats = x.feats
+    weight = self.weight.reshape(Co, K0 * K1 * K2, Ci).to(feats.dtype)
+    out = feats.new_zeros((feats.shape[0], Co))
+    # Accumulate per offset (gather + matmul) instead of one im2col, so a 1024^3 decoder level fits in RAM.
+    for k in range(nbr.shape[0]):
+        idx = nbr[k]
+        rows = (idx >= 0).nonzero(as_tuple=True)[0]
+        if rows.numel() == 0:
+            continue
+        if rows.numel() == idx.numel():
+            out += feats[idx] @ weight[:, k].T
+        else:
+            out.index_add_(0, rows, feats[idx[rows]] @ weight[:, k].T)
+    if self.bias is not None:
+        out += self.bias.to(feats.dtype)
+    return x.replace(out)
+
+
+def sparse_inverse_conv3d_init(self, *args, **kwargs):
+    raise NotImplementedError('SparseInverseConv3d with the torch backend is not implemented')
+
+
+def sparse_inverse_conv3d_forward(self, x: SparseTensor) -> SparseTensor:
+    raise NotImplementedError('SparseInverseConv3d with the torch backend is not implemented')

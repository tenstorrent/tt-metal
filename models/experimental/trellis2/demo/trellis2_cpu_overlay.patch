new file mode 100644
index 0000000..2199da4
--- /dev/null
+++ b/trellis2/utils/fdg_torch.py
@@ -0,0 +1,98 @@
+from typing import *
+import numpy as np
+import torch
+
+# Pure-torch copy of o_voxel.convert.flexible_dual_grid_to_mesh (inference path, TRELLIS.2 75fbf018) for hosts
+# without CUDA: o_voxel's _C hashmap is replaced by sorted linearised keys + searchsorted. Same outputs.
+
+__all__ = ["flexible_dual_grid_to_mesh"]
+
+_EDGE_NEIGHBOR_VOXEL_OFFSET = [
+    [[0, 0, 0], [0, 0, 1], [0, 1, 1], [0, 1, 0]],     # x-axis
+    [[0, 0, 0], [1, 0, 0], [1, 0, 1], [0, 0, 1]],     # y-axis
+    [[0, 0, 0], [0, 1, 0], [1, 1, 0], [1, 0, 0]],     # z-axis
+]
+_QUAD_SPLIT_1 = [0, 1, 2, 0, 2, 3]
+_QUAD_SPLIT_2 = [0, 1, 3, 3, 1, 2]
+
+
+def _lookup(coords: torch.Tensor, queries: torch.Tensor, grid_size: torch.Tensor) -> torch.Tensor:
+    """Index of each query voxel in coords, or -1 if absent or outside the grid."""
+    g = grid_size.long().tolist()
+    c = coords.long()
+    keys = (c[:, 0] * g[1] + c[:, 1]) * g[2] + c[:, 2]
+    sorted_keys, order = torch.sort(keys)
+    q = queries.long()
+    inside = ((q >= 0) & (q < grid_size.long().to(q.device))).all(dim=-1)
+    qk = (q[:, 0] * g[1] + q[:, 1]) * g[2] + q[:, 2]
+    pos = torch.searchsorted(sorted_keys, qk).clamp_(max=sorted_keys.shape[0] - 1)
+    hit = inside & (sorted_keys[pos] == qk)
+    return torch.where(hit, order[pos], torch.full_like(pos, -1))
+
+
+@torch.no_grad()
+def flexible_dual_grid_to_mesh(
+    coords: torch.Tensor,
+    dual_vertices: torch.Tensor,
+    intersected_flag: torch.Tensor,
+    split_weight: Union[torch.Tensor, None],
+    aabb: Union[list, tuple, np.ndarray, torch.Tensor],
+    voxel_size: Union[float, list, tuple, np.ndarray, torch.Tensor] = None,
+    grid_size: Union[int, list, tuple, np.ndarray, torch.Tensor] = None,
+    train: bool = False,
+):
+    assert not train, "fdg_torch covers inference only"
+    device = coords.device
+
+    if isinstance(aabb, (list, tuple)):
+        aabb = np.array(aabb)
+    if isinstance(aabb, np.ndarray):
+        aabb = torch.tensor(aabb, dtype=torch.float32, device=device)
+
+    if voxel_size is not None:
+        if isinstance(voxel_size, float):
+            voxel_size = [voxel_size, voxel_size, voxel_size]
+        if isinstance(voxel_size, (list, tuple)):
+            voxel_size = np.array(voxel_size)
+        if isinstance(voxel_size, np.ndarray):
+            voxel_size = torch.tensor(voxel_size, dtype=torch.float32, device=device)
+        grid_size = ((aabb[1] - aabb[0]) / voxel_size).round().int()
+    else:
+        assert grid_size is not None, "Either voxel_size or grid_size must be provided"
+        if isinstance(grid_size, int):
+            grid_size = [grid_size, grid_size, grid_size]
+        if isinstance(grid_size, (list, tuple)):
+            grid_size = np.array(grid_size)
+        if isinstance(grid_size, np.ndarray):
+            grid_size = torch.tensor(grid_size, dtype=torch.int32, device=device)
+        voxel_size = (aabb[1] - aabb[0]) / grid_size
+
+    N = dual_vertices.shape[0]
+    offset = torch.tensor(_EDGE_NEIGHBOR_VOXEL_OFFSET, dtype=torch.int, device=device).unsqueeze(0)
+    edge_neighbor_voxel = coords.reshape(N, 1, 1, 3) + offset                      # (N, 3, 4, 3)
+    connected_voxel = edge_neighbor_voxel[intersected_flag]                        # (M, 4, 3)
+    M = connected_voxel.shape[0]
+    connected_voxel_indices = _lookup(coords, connected_voxel.reshape(-1, 3), grid_size).reshape(M, 4)
+    connected_voxel_valid = (connected_voxel_indices >= 0).all(dim=1)
+    quad_indices = connected_voxel_indices[connected_voxel_valid].int()           # (L, 4)
+
+    mesh_vertices = (coords.float() + dual_vertices) * voxel_size + aabb[0].reshape(1, 3)
+    split_1 = torch.tensor(_QUAD_SPLIT_1, dtype=torch.long, device=device)
+    split_2 = torch.tensor(_QUAD_SPLIT_2, dtype=torch.long, device=device)
+    if split_weight is None:
+        t0 = quad_indices[:, split_1]
+        n0 = torch.cross(mesh_vertices[t0[:, 1]] - mesh_vertices[t0[:, 0]], mesh_vertices[t0[:, 2]] - mesh_vertices[t0[:, 0]], dim=-1)
+        n1 = torch.cross(mesh_vertices[t0[:, 2]] - mesh_vertices[t0[:, 1]], mesh_vertices[t0[:, 3]] - mesh_vertices[t0[:, 1]], dim=-1)
+        align0 = (n0 * n1).sum(dim=1, keepdim=True).abs()
+        t1 = quad_indices[:, split_2]
+        n0 = torch.cross(mesh_vertices[t1[:, 1]] - mesh_vertices[t1[:, 0]], mesh_vertices[t1[:, 2]] - mesh_vertices[t1[:, 0]], dim=-1)
+        n1 = torch.cross(mesh_vertices[t1[:, 2]] - mesh_vertices[t1[:, 1]], mesh_vertices[t1[:, 3]] - mesh_vertices[t1[:, 1]], dim=-1)
+        align1 = (n0 * n1).sum(dim=1, keepdim=True).abs()
+        mesh_triangles = torch.where(align0 > align1, t0, t1).reshape(-1, 3)
+    else:
+        sw = split_weight[quad_indices]
+        sw02 = sw[:, 0] * sw[:, 2]
+        sw13 = sw[:, 1] * sw[:, 3]
+        mesh_triangles = torch.where(sw02 > sw13, quad_indices[:, split_1], quad_indices[:, split_2]).reshape(-1, 3)
+
+    return mesh_vertices, mesh_triangles

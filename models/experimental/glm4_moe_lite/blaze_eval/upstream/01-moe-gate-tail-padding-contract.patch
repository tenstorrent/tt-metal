+from dataclasses import dataclass
+
 import torch
 import ttnn
 
@@ -17,6 +30,165 @@ from ...blaze_op import BlazeOp, Input, MicroOp, Output
 from ...fused_program import CBHandle, FusedProgram, MultiOutput
 from ...utils import _float_to_bits
 
+#: ``num_total_experts`` values the top-k kernel accepts. The SFPU sorts whole
+#: 128-lane blocks and static_asserts ``>= 128`` and ``% 128 == 0``
+#: (``ckernel_sfpu_generic_moe_gate_topk.h:176``,
+#: ``ckernel_sfpu_generic_moe_gate_topk_top8.h:178``), so a smaller expert count
+#: is a *compile* error, not a slow path.
+GENERIC_GATE_SUPPORTED_EXPERTS = (128, 256, 384, 512)
+
+
+def round_up_num_total_experts(num_experts: int) -> int:
+    """Round a model's real expert count up to a kernel-supported ``num_total_experts``.
+
+    Callers must pad the gate inputs over ``[num_experts, num_total_experts)``:
+    the kernel unconditionally ranks every lane it is told about and never
+    initialises the tail itself. Pad ``act`` with ``0.0`` and ``bias`` with a
+    large negative value, as :func:`create_gate_tensors` does, so padding lanes
+    can never win top-k and route to an expert that has no weights.
+    """
+    for size in GENERIC_GATE_SUPPORTED_EXPERTS:
+        if num_experts <= size:
+            return size
+    raise ValueError(
+        f"num_experts={num_experts} exceeds the largest supported num_total_experts "
+        f"{GENERIC_GATE_SUPPORTED_EXPERTS[-1]}"
+    )
+
+
+#: The routers assemble gate logits into one 16x16 bf16 face on the sender.
+GATE_FACE_HEIGHT = 16
+GATE_FACE_WIDTH = 16
+GATE_FACE_LANES = GATE_FACE_HEIGHT * GATE_FACE_WIDTH
+
+#: Expert columns one gate-MM core owns (its weight shard is ``[K, 32]``).
+GATE_MM_LANES_PER_CORE = 32
+
+
+@dataclass(frozen=True)
+class GateFacePaddingPlan:
+    """How many gate-face lanes get written vs. how many the kernel ranks.
+
+    The two numbers are set by different things and they do not have to agree:
+
+    * ``gathered_lanes`` is a property of the *gather* — one 32-wide page per
+      gate-MM core, so ``ceil(num_experts/32) * 32``.
+    * ``num_total_experts`` is a property of the *kernel*, which sorts whole
+      128-lane blocks and so must be rounded up to a supported block size.
+
+    When they differ, the lanes in between are ranked but never written, and
+    the caller must initialise them. This dataclass is pure Python so it can be
+    asserted on a CPU-only runner.
+    """
+
+    num_experts: int
+    num_total_experts: int
+    gathered_lanes: int
+    face_lanes: int
+
+    @property
+    def needs_zeroed_tail(self) -> bool:
+        """True when the gate ranks lanes the gather never writes."""
+        return self.num_total_experts > self.gathered_lanes
+
+    @property
+    def tail_lanes(self) -> int:
+        return max(0, self.num_total_experts - self.gathered_lanes)
+
+
+def gate_face_padding_plan(
+    num_experts: int,
+    *,
+    lanes_per_gate_core: int = GATE_MM_LANES_PER_CORE,
+    face_lanes: int = GATE_FACE_LANES,
+) -> GateFacePaddingPlan:
+    """Resolve the gate face's written / ranked lane counts for ``num_experts``."""
+    if num_experts <= 0:
+        raise ValueError(f"num_experts must be positive; got {num_experts}")
+    if num_experts > face_lanes:
+        raise ValueError(
+            f"num_experts={num_experts} does not fit the {face_lanes}-lane gate face "
+            f"the routers assemble on the sender; a larger face needs a different "
+            f"gather destination geometry."
+        )
+    num_total_experts = round_up_num_total_experts(num_experts)
+    gathered = -(-num_experts // lanes_per_gate_core) * lanes_per_gate_core
+    if num_total_experts > face_lanes:
+        raise ValueError(
+            f"num_experts={num_experts} rounds up to num_total_experts={num_total_experts}, "
+            f"which exceeds the {face_lanes}-lane gate face."
+        )
+    return GateFacePaddingPlan(
+        num_experts=num_experts,
+        num_total_experts=num_total_experts,
+        gathered_lanes=gathered,
+        face_lanes=face_lanes,
+    )
+
+
+def make_gate_gather_dst(
+    f: FusedProgram,
+    *,
+    name: str,
+    core_ranges: ttnn.CoreRangeSet,
+    plan: GateFacePaddingPlan,
+) -> CBHandle:
+    """Gather destination for the gate logit face, zero-backed when it must be.
+
+    ``plan.needs_zeroed_tail == False`` (every model whose experts fill the
+    ranked block: 128, 256, ...) returns exactly the ``f.cb_scratch`` CB this
+    used to be — same name, page size, tile and core ranges.
+
+    Otherwise the face is backed by a dedicated zero-filled L1 tensor instead of
+    a scratch arena slot. Three properties make that hold across invocations,
+    which a scratch slot does not have:
+
+    * ``f.named_tensor`` allocations are folded into the compiled program's
+      ``lifetime_tensors`` GC pin list (``blaze/compiler.py:317-329``), so the
+      buffer is never returned to the allocator and never re-let to another CB.
+      Scratch CBs are arena slots with documented temporal reuse, which is
+      exactly why their tail holds whatever shared them last.
+    * The gather writes ``sender_idx * data_size_bytes`` bytes from the base
+      (``ops/gather/kernels/op.hpp:108``), i.e. only the leading
+      ``gathered_lanes``; nothing else writes this buffer after ``from_torch``
+      uploads the zeros at compile time.
+    * The CB is one page deep and the gate pops that page every iteration
+      (``generic_moe_gate/kernels/op.hpp:92``), so the write pointer returns to
+      the base rather than advancing over the tail.
+
+    The caller still owns the *bias* tail over ``[num_experts,
+    num_total_experts)``: zeroed act lanes make the biased score exactly the pad
+    bias, which only loses top-k if that bias is negative.
+    """
+    tile = ttnn.Tile([GATE_FACE_HEIGHT, GATE_FACE_WIDTH])
+    tile_desc = ttnn.TileDescriptor(tile)
+    page_size = tile.get_tile_size(ttnn.bfloat16)
+
+    if not plan.needs_zeroed_tail:
+        return f.cb_scratch(
+            name=name,
+            num_pages=1,
+            core_ranges=core_ranges,
+            data_format=ttnn.bfloat16,
+            tile=tile_desc,
+            page_size=page_size,
+        )
+
+    num_cores = core_ranges.num_cores()
+    backing = f.named_tensor(
+        name=f"{name}_zeros",
+        torch_tensor=torch.zeros(num_cores * GATE_FACE_HEIGHT, GATE_FACE_WIDTH, dtype=torch.bfloat16),
+        dtype=ttnn.bfloat16,
+        layout=ttnn.TILE_LAYOUT,
+        memory_config=ttnn.MemoryConfig(
+            ttnn.TensorMemoryLayout.HEIGHT_SHARDED,
+            ttnn.BufferType.L1,
+            ttnn.ShardSpec(core_ranges, [GATE_FACE_HEIGHT, GATE_FACE_WIDTH], ttnn.ShardOrientation.ROW_MAJOR),
+        ),
+        tile=tile,
+    )
+    return f.cb_from_tensor(backing, tile=tile_desc, page_size=page_size)
+
 
 def create_gate_tensors(
     act_torch: torch.Tensor,
@@ -171,7 +343,25 @@ class GenericMoeGate(MicroOp):
         zero_tail: bool = False,
         full_sort: bool = False,

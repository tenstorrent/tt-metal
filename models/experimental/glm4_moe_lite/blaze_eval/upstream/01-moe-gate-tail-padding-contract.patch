@@ -0,0 +1,197 @@
+# SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+# SPDX-License-Identifier: Apache-2.0
+
+"""CPU-only guards on the gate face's padded-lane contract.
+
+`round_up_num_total_experts` rounds a model's expert count up to a kernel block
+size and its docstring requires the caller to pad BOTH the activation and the
+bias over the lanes it adds. `glm_moe_router` padded only the bias, and every
+existing test still passed: the device tests all run 128 or 256 experts, where
+the rounding is a no-op and the tail does not exist, and the micro-op tests hand
+the gate a fully populated activation face so there is no unwritten tail either.
+
+These tests fail on the half-padded configuration without a device. They cover
+the two independent halves of the bug:
+
+  * the bookkeeping -- lanes gathered vs. lanes ranked, and whether a tail
+    therefore has to be initialised (`gate_face_padding_plan`);
+  * the numerics -- that a -100 bias sentinel does NOT on its own keep an
+    unwritten lane out of top-k, which is the step the earlier fix assumed.
+
+NOT RUN -- written without device access, but nothing here needs one.
+"""
+
+import pytest
+
+pytestmark = [
+    pytest.mark.device("cpu"),
+    pytest.mark.level("micro"),
+]
+
+import torch
+
+from blaze.ops.generic_moe_gate.op import (
+    GATE_FACE_LANES,
+    GATE_MM_LANES_PER_CORE,
+    GENERIC_GATE_SUPPORTED_EXPERTS,
+    GenericMoeGate,
+    gate_face_padding_plan,
+    round_up_num_total_experts,
+)
+
+PAD_BIAS = -100.0
+"""The sentinel `test_glm5_routed_expert.py` writes into the bias tail."""
+
+
+# ---------------------------------------------------------------------------
+# 1. Bookkeeping: which lanes get written, which get ranked.
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "num_experts, num_total, gathered, needs_tail",
+    [
+        (32, 128, 32, True),  # 1 gate-MM core
+        (64, 128, 64, True),  # GLM-4.7-Flash: 2 gate-MM cores, the failing case
+        (96, 128, 96, True),
+        (128, 128, 128, False),  # exact block: no tail
+        (160, 256, 160, True),
+        (200, 256, 224, True),  # not a multiple of 32: gather overshoots too
+        (256, 256, 256, False),  # GLM-5 / DeepSeek-V4: no tail
+    ],
+)
+def test_padding_plan_table(num_experts, num_total, gathered, needs_tail):
+    plan = gate_face_padding_plan(num_experts)
+    assert plan.num_total_experts == num_total
+    assert plan.gathered_lanes == gathered
+    assert plan.needs_zeroed_tail is needs_tail
+    assert plan.tail_lanes == max(0, num_total - gathered)
+
+
+def test_shipping_configs_keep_the_plain_scratch_path():
+    """GLM-5 and DeepSeek-V4 must not change: no tail, no dedicated allocation."""
+    for num_experts in (128, 256):
+        plan = gate_face_padding_plan(num_experts)
+        assert not plan.needs_zeroed_tail
+        assert plan.tail_lanes == 0
+        assert plan.num_total_experts == num_experts
+
+
+def test_every_ranked_lane_is_either_written_or_declared_a_tail():
+    """The invariant the routers violated, over every count that fits the face.
+
+    A lane the gate ranks is either filled by the gather or accounted for as a
+    tail the caller has to initialise. There is no third option, and the old
+    code took it anyway.
+    """
+    for num_experts in range(1, GATE_FACE_LANES + 1):
+        plan = gate_face_padding_plan(num_experts)
+        assert plan.gathered_lanes + plan.tail_lanes >= plan.num_total_experts
+        assert plan.gathered_lanes % GATE_MM_LANES_PER_CORE == 0
+        assert plan.gathered_lanes >= plan.num_experts
+        assert plan.num_total_experts in GENERIC_GATE_SUPPORTED_EXPERTS
+
+
+def test_plan_rejects_counts_that_do_not_fit_the_face():
+    with pytest.raises(ValueError, match="gate face"):
+        gate_face_padding_plan(GATE_FACE_LANES + 1)
+    with pytest.raises(ValueError, match="positive"):
+        gate_face_padding_plan(0)
+
+
+def test_round_up_is_unchanged_for_supported_counts():
+    for n in GENERIC_GATE_SUPPORTED_EXPERTS:
+        assert round_up_num_total_experts(n) == n
+

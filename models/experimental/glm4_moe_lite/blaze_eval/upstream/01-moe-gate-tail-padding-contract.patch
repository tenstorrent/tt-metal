+# ---------------------------------------------------------------------------
+# 2. Numerics: why padding the bias alone is not enough.
+# ---------------------------------------------------------------------------
+
+
+def _gate_face(num_experts, num_total, tail_act, *, seed=0):
+    """Build a (1, num_total) act/bias pair in the router's post-sigmoid domain.
+
+    Real lanes carry sigmoid outputs, so they live in (0, 1) -- that bound is
+    the whole reason a -100 bias sentinel looks sufficient. Padded lanes carry
+    `tail_act`, which stands in for whatever the shared scratch arena last held.
+    """
+    g = torch.Generator().manual_seed(seed)
+    act = torch.empty(1, num_total, dtype=torch.float32)
+    act[0, :num_experts] = torch.sigmoid(torch.randn(num_experts, generator=g))
+    act[0, num_experts:] = tail_act
+
+    bias = torch.zeros(1, num_total, dtype=torch.float32)
+    bias[0, :num_experts] = torch.randn(num_experts, generator=g) * 0.01
+    bias[0, num_experts:] = PAD_BIAS
+    return act, bias
+
+
+@pytest.mark.parametrize("k", [4, 8])
+def test_bias_sentinel_alone_does_not_protect_an_uninitialised_tail(k):
+    """The half-fix, reproduced: -100 in the bias does not bound act + bias.
+
+    Scratch L1 is not small. Any tail lane above ~100 outranks every real lane
+    even after the sentinel, and top-k then returns expert ids in [64, 128) --
+    ids with no weights behind them. This is the state `glm_moe_router` was in
+    when it returned PCC 0.0235.
+    """
+    num_experts, num_total = 64, 128
+    tail = torch.full((num_total - num_experts,), 1.0e4)
+    act, bias = _gate_face(num_experts, num_total, tail)
+
+    _, indices = GenericMoeGate.golden(act, bias, num_selected_experts=k)
+    selected = indices[0].tolist()
+    assert all(e >= num_experts for e in selected), (
+        f"expected the padded lanes to win top-{k} and prove the sentinel " f"insufficient, got {selected}"
+    )
+
+
+@pytest.mark.parametrize("k", [4, 8])
+@pytest.mark.parametrize("tail_value", [1.0e4, 3.402823e38, float("nan"), 1.0, 0.51])
+def test_zeroed_tail_makes_the_sentinel_sufficient_for_any_garbage(k, tail_value):
+    """With the act tail zeroed, a padded lane scores exactly PAD_BIAS and loses.
+
+    Parametrised over values a live arena plausibly holds -- a large float, a
+    bf16 max, a NaN, and two values small enough that the sentinel alone would
+    have coped -- to show the fix does not depend on how big the garbage is.
+    """
+    num_experts, num_total = 64, 128
+    tail = torch.full((num_total - num_experts,), tail_value)
+
+    dirty_act, bias = _gate_face(num_experts, num_total, tail)
+    clean_act = dirty_act.clone()
+    clean_act[0, num_experts:] = 0.0
+
+    _, indices = GenericMoeGate.golden(clean_act, bias, num_selected_experts=k)
+    selected = indices[0].tolist()
+    assert all(e < num_experts for e in selected), f"padded lane still selected: {selected}"
+
+
+@pytest.mark.parametrize("k", [4, 8])
+def test_zeroed_tail_reproduces_the_unpadded_result_exactly(k):
+    """Padding must be inert, not merely safe: same experts, same scores."""
+    num_experts, num_total = 64, 128
+    act, bias = _gate_face(num_experts, num_total, torch.zeros(num_total - num_experts))
+
+    padded_scores, padded_idx = GenericMoeGate.golden(act, bias, num_selected_experts=k)
+    ref_scores, ref_idx = GenericMoeGate.golden(
+        act[:, :num_experts].contiguous(), bias[:, :num_experts].contiguous(), num_selected_experts=k
+    )
+    assert padded_idx.tolist() == ref_idx.tolist()
+    torch.testing.assert_close(padded_scores, ref_scores)
+
+
+def test_normalization_denominator_only_sums_the_k_selected():
+    """A padded lane that loses top-k cannot leak into the normalized score.
+
+    Worth pinning: `normalize=True` dividing by a sum over all ranked lanes
+    rather than the k winners would make the tail matter even when it never
+    wins, and that would need a different fix from zeroing it.
+    """
+    num_experts, num_total, k = 64, 128, 4
+    act, bias = _gate_face(num_experts, num_total, torch.zeros(num_total - num_experts))
+
+    scores, idx = GenericMoeGate.golden(act, bias, num_selected_experts=k, scaling_factor=1.8, normalize=True)
+    picked = act[0, idx[0]]
+    torch.testing.assert_close(scores[0], picked / picked.sum() * 1.8)

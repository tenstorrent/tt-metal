-        """Emit Generic MoE gate. Returns MultiOutput with .out_scores and .out_indices."""
+        """Emit Generic MoE gate. Returns MultiOutput with .out_scores and .out_indices.
+
+        ``pop_act`` is INERT and kept only so the CT-arg list matches the kernel.
+        ``kernels/op.hpp:47`` declares it and never reads it; act and bias are
+        popped unconditionally at ``kernels/op.hpp:92-93``. Retiring it means
+        deleting the declaration too, so both sides stay in sync. Do not add
+        call sites that pass it expecting an effect — a parameter that looks
+        live but is not is how ``num_total_experts=256`` stayed hardcoded here.
+        """
+        # Mirror the kernel's own bound (ckernel_sfpu_generic_moe_gate_topk.h:176-177)
+        # so an unrounded model expert count fails here with the name of the
+        # helper that fixes it, not as a static_assert deep in a JIT build.
+        if num_total_experts % 128 != 0 or not (128 <= num_total_experts <= 1024):
+            raise ValueError(
+                f"num_total_experts={num_total_experts} is not a multiple of 128 in [128, 1024]. "
+                f"Pass round_up_num_total_experts(num_experts) and pad the gate act and bias "
+                f"over the lanes it adds -- see gate_face_padding_plan."
+            )
+
         if isinstance(act, CBHandle):
             act_handle = act
         else:

diff --git a/tests/blaze/micro_ops/moe/test_moe_router_gate_wiring.py b/tests/blaze/micro_ops/moe/test_moe_router_gate_wiring.py
new file mode 100644
index 000000000..97febbcbb
--- /dev/null
+++ b/tests/blaze/micro_ops/moe/test_moe_router_gate_wiring.py
@@ -0,0 +1,154 @@
+# SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+# SPDX-License-Identifier: Apache-2.0
+
+"""CPU-only structural guards on how the MoE routers wire up their gate.
+
+The gate-face padding bug was not a numerical mistake, it was a wiring one: a
+parameter accepted at `compose()` and then dropped before the call that needed
+it, and a destination buffer allocated from the wrong pool. Neither shows up in
+a device test that only runs the expert counts where both happen to be
+harmless, which is why `glm_moe_router` shipped broken with a green suite.
+
+These tests read the call graph with `ast` -- no device, no emit, no tracing --
+and assert the two wiring facts that must hold. They are deliberately
+structural: the numerical consequence is covered by
+`test_gate_tail_padding_contract.py`, and by the time you can observe it you
+need a Galaxy.
+
+NOT RUN -- written without device access, but nothing here needs one.
+"""
+
+import ast
+import inspect
+from pathlib import Path
+
+import pytest
+
+pytestmark = [
+    pytest.mark.device("cpu"),
+    pytest.mark.level("micro"),
+]
+
+from blaze.ops.deepseekv4_moe_router.op import DeepseekV4MoERouter
+from blaze.ops.glm_moe.op import GLMMoE
+from blaze.ops.glm_moe_no_shared.op import GLMMoENoShared
+from blaze.ops.glm_moe_router.op import GLMMoERouter
+from blaze.ops.glm_routed_expert.op import GLMRoutedExpert
+
+#: Routers fixed by the gate-tail work. `gptoss_moe_router`,
+#: `deepseekv4_moe_large_router` and `ffn_interleaved`'s GLM branch still build
+#: the face from `f.cb_scratch` and pass an unrounded `num_total_experts`; that
+#: combination cannot corrupt silently because an unrounded count trips the
+#: kernel's `static_assert(num_total_experts % 128 == 0)` first. Add them here
+#: if they are ever routed through `round_up_num_total_experts`.
+_PLANNED_ROUTERS = [GLMMoERouter, DeepseekV4MoERouter]
+
+
+def _emit_ast(cls) -> ast.AST:
+    return ast.parse(inspect.cleandoc(inspect.getsource(cls.emit)))
+
+
+def _called_names(tree: ast.AST) -> set[str]:
+    out = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call):
+            fn = node.func
+            if isinstance(fn, ast.Name):
+                out.add(fn.id)
+            elif isinstance(fn, ast.Attribute):
+                out.add(fn.attr)
+    return out
+
+
+def _calls_to(tree: ast.AST, qualname: str) -> list[ast.Call]:
+    """Every `X.y(...)` call in `tree` matching the dotted `qualname`."""
+    want = qualname.split(".")
+    found = []
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call):
+            continue
+        parts, fn = [], node.func
+        while isinstance(fn, ast.Attribute):
+            parts.append(fn.attr)
+            fn = fn.value
+        if isinstance(fn, ast.Name):
+            parts.append(fn.id)
+        if list(reversed(parts))[-len(want) :] == want:
+            found.append(node)
+    return found
+
+
+def _kwarg(call: ast.Call, name: str) -> ast.expr | None:
+    return next((kw.value for kw in call.keywords if kw.arg == name), None)
+
+
+@pytest.mark.parametrize("cls", _PLANNED_ROUTERS, ids=lambda c: c.__name__)
+def test_gate_face_comes_from_the_planned_allocator(cls):
+    """The gate face must not be an arena slot the gate can rank past.
+
+    `f.cb_scratch` hands out a temporally reused arena slot, so any lane the
+    gather does not write holds whatever shared that slot last. Below a kernel
+    block size the gate ranks exactly those lanes.
+    """
+    called = _called_names(_emit_ast(cls))
+    assert "make_gate_gather_dst" in called
+    assert "cb_scratch" not in called, "gate face is back on the scratch arena; its tail is not zero"
+
+
+@pytest.mark.parametrize("cls", _PLANNED_ROUTERS, ids=lambda c: c.__name__)
+def test_num_total_experts_is_derived_not_literal(cls):
+    """`num_total_experts` must track the model, and must come from the plan.
+
+    The original defect was the literal 256. Passing `num_experts` raw is the
+    other half: it is what the plan rounds, not the rounded result.
+    """
+    call = _calls_to(_emit_ast(cls), "GenericMoeGate.emit")
+    assert len(call) == 1
+    arg = _kwarg(call[0], "num_total_experts")
+    assert isinstance(arg, ast.Attribute) and arg.attr == "num_total_experts", (
+        "expected num_total_experts=plan.num_total_experts, got " f"{ast.dump(arg) if arg else None}"
+    )
+    assert isinstance(arg.value, ast.Name) and arg.value.id == "plan"
+
+
+@pytest.mark.parametrize("cls", _PLANNED_ROUTERS, ids=lambda c: c.__name__)
+def test_dead_pop_act_is_not_passed_to_the_gate(cls):
+    """`pop_act` is declared by the gate kernel and never read (op.hpp:47).
+
+    Passing it reads as a live control on whether the gathered CB is popped.
+    It is not one, and a comment here once claimed it was.
+    """
+    call = _calls_to(_emit_ast(cls), "GenericMoeGate.emit")[0]
+    assert _kwarg(call, "pop_act") is None
+
+
+@pytest.mark.parametrize("cls", [GLMMoE, GLMMoENoShared], ids=lambda c: c.__name__)
+def test_num_experts_reaches_the_routed_expert(cls):
+    """Accepting `num_experts` at compose() and dropping it is the whole bug.
+
+    Both wrappers took the parameter, defaulted it to 256, and never forwarded
+    it, so the production op sized its gate for 256 experts regardless of the
+    model. Every hop has to pass it.
+    """
+    call = _calls_to(_emit_ast(cls), "GLMRoutedExpert.emit")
+    assert len(call) == 1
+    arg = _kwarg(call[0], "num_experts")
+    assert isinstance(arg, ast.Name) and arg.id == "num_experts", "num_experts is dropped before GLMRoutedExpert.emit"
+
+
+def test_routed_expert_forwards_num_experts_to_the_router():
+    call = _calls_to(_emit_ast(GLMRoutedExpert), "GLMMoERouter.emit")
+    assert len(call) == 1
+    arg = _kwarg(call[0], "num_experts")
+    assert isinstance(arg, ast.Name) and arg.id == "num_experts"
+
+
+def test_no_router_reintroduces_a_hardcoded_expert_count():
+    """Catch the literal itself, anywhere in the fixed routers' emit bodies."""
+    for cls in _PLANNED_ROUTERS:
+        src = Path(inspect.getfile(cls)).read_text()
+        for node in ast.walk(ast.parse(src)):
+            if isinstance(node, ast.Call):
+                arg = _kwarg(node, "num_total_experts")
+                if isinstance(arg, ast.Constant):
+                    pytest.fail(f"{inspect.getfile(cls)}:{node.lineno} passes a literal num_total_experts={arg.value}")

_ test_layer_pcc_launders_a_degraded_sublayer[blackhole-eps1e-3-mesh_device0] __

mesh_device = MeshDevice(1x1 grid, 1 devices), eps_rel = 0.001
reset_seeds = None

    @pytest.mark.parametrize("mesh_device", [TestFactory.SINGLE_CARD_MESH_SHAPE], indirect=True)
    @pytest.mark.parametrize("eps_rel", [1e-3, 1e-2], ids=["eps1e-3", "eps1e-2"])
    @torch.no_grad()
    def test_layer_pcc_launders_a_degraded_sublayer(mesh_device, eps_rel, reset_seeds):
        """Measure how much of a sublayer error the residual stream hides, on THIS layer.

        Appendix E's caveat is an observation about one oracle run. This is the measurement, and it is
        what tells a reviewer what ``G-LAYER`` is worth: inject an i.i.d. relative perturbation of size
        ``eps_rel`` into one sublayer's output in torch, then report

        * the PCC of that **sublayer** output against the clean one, and
        * the PCC of the resulting **layer** output against the clean one,

        for both sublayers. The ratio of the two error terms is the attenuation the residual add buys —
        i.e. exactly how much a degraded sublayer is laundered. No device involved (the point is a
        property of the residual topology, not of any kernel), but it runs in the gate so the number is
        re-measured rather than remembered.

        The assert is deliberately one-sided: attenuation **must** be > 1 (otherwise Appendix E's whole
        caveat, and this package's rule that G-LAYER is never sublayer evidence, would be wrong).
        """
        seq_len = 128
        _, hf_config, cfg, state, x, cos_meta, sin_meta, cos_hf, sin_hf = _setup(mesh_device, seq_len)
        eps = hf_config.rms_norm_eps
        gen = torch.Generator().manual_seed(7)

        clean_layer = _torch_layer(x, state, cos_hf, sin_hf, cfg, eps)

        # Recompute the two clean sublayer outputs and the residual they are added into.
        h1 = _torch_rms_norm(x, state["input_layernorm.weight"], eps)
        attn_clean = _torch_attention(h1, _sub(state, "self_attn"), cos_hf, sin_hf, cfg)
        mid = x + attn_clean
        h2 = _torch_rms_norm(mid, state["post_attention_layernorm.weight"], eps)
        mlp_clean = _torch_mlp_q(h2, _sub(state, "mlp"), lambda t, _dt: t)

        results = {}
        for name in ("attn", "mlp"):
            clean = attn_clean if name == "attn" else mlp_clean
            noise = torch.randn(clean.shape, generator=gen) * (eps_rel * clean.abs().mean())
            dirty = clean + noise
            if name == "attn":
                mid_d = x + dirty
                h2_d = _torch_rms_norm(mid_d, state["post_attention_layernorm.weight"], eps)
                layer_d = mid_d + _torch_mlp_q(h2_d, _sub(state, "mlp"), lambda t, _dt: t)
            else:
                layer_d = mid + dirty
            _, sub_pcc = comp_pcc(clean, dirty, 0.0)
            _, layer_pcc = comp_pcc(clean_layer, layer_d, 0.0)
            atten = (1.0 - float(sub_pcc)) / max(1.0 - float(layer_pcc), 1e-30)
            results[name] = (float(sub_pcc), float(layer_pcc), atten)
            logger.info(
                f"[G-LAYER] masking probe (rel eps {eps_rel:g}, {name}): sublayer PCC = {sub_pcc} -> "
                f"layer PCC = {layer_pcc} | the residual stream hides {atten:.1f}x of the error"
            )
>           assert atten > 1.0, (
                f"a {name} degradation of {1 - float(sub_pcc):.2e} produced a LARGER layer error "
                f"({1 - float(layer_pcc):.2e}); Appendix E's masking caveat does not hold here and "
                f"§5.1's rule needs re-deriving"
            )
E           AssertionError: a attn degradation of 2.84e-07 produced a LARGER layer error (3.42e-07); Appendix E's masking caveat does not hold here and §5.1's rule needs re-deriving

"""Pure-TTNN NemotronH MoE router for `nemotron_h_topk_router`.

HF reference (modeling_nemotron_h.py `NemotronHTopkRouter.forward`):

    hidden_states = hidden_states.view(-1, hidden_size)
    router_logits = F.linear(hidden_states.float(), weight.float())   # (T, n_experts)
    return router_logits

The router's `forward` ONLY produces the raw logits -- sigmoid, the bias
correction, and top-k expert SELECTION all live in a separate method,
`NemotronHMoE.route_tokens_to_experts`, which is not part of this submodule
(and is exercised, redundantly re-derived from these same logits, inside the
graduated `nemotron_h_mo_e` sibling). So this component is just one replicated
matmul.

Tensor-parallel (TP=2): the router weight is tiny (n_experts x hidden) and
its full-width output feeds every chip's expert selection, so per the general
TP principles ("keep... router logits REPLICATED") it is NOT split -- every
chip holds the full weight and computes the full (T, n_experts) logits
redundantly; the gathered per-chip outputs are identical to the single-device
golden with no collective needed.
"""
from __future__ import annotations
import torch
import ttnn


class NemotronHTopkRouter:
    def __init__(self, device, torch_module):
        self.device = device

        sd = torch_module.state_dict()
        w = sd["weight"]  # (n_experts, hidden)
        self.hidden_size = int(w.shape[1])
        self.n_routed_experts = int(w.shape[0])

        # gate weight stored transposed (hidden, n_experts), fp32, REPLICATED.
        self._gate_w = self._dev(w.t().contiguous().float())

        self.ckc = ttnn.WormholeComputeKernelConfig(
            math_fidelity=ttnn.MathFidelity.HiFi4,
            math_approx_mode=False,
            fp32_dest_acc_en=True,
            packer_l1_acc=True,
        )

    # ----------------------------- helpers ---------------------------- #
    def _is_mesh(self):
        try:
            if isinstance(self.device, ttnn.MeshDevice):
                return True
        except AttributeError:
            pass
        return hasattr(self.device, "get_device_ids") or hasattr(self.device, "get_devices")

    def _dev(self, torch_tensor, layout=ttnn.TILE_LAYOUT):
        """Upload an fp32 torch constant to device, mesh-replicated."""
        if self._is_mesh():
            try:
                return ttnn.from_torch(
                    torch_tensor, dtype=ttnn.float32, layout=layout, device=self.device,
                    mesh_mapper=ttnn.ReplicateTensorToMesh(self.device),
                )
            except Exception:
                pass
        return ttnn.from_torch(torch_tensor, dtype=ttnn.float32, layout=layout, device=self.device)

    def _fp32(self, t):
        if isinstance(t, ttnn.Tensor):
            if t.dtype != ttnn.float32:
                return ttnn.typecast(t, ttnn.float32)
            return t
        return self._dev(t.float())

    # ------------------------------ forward --------------------------- #
    def __call__(self, hidden_states, **kwargs):
        hs = self._fp32(hidden_states)
        if hs.layout != ttnn.TILE_LAYOUT:
            hs = ttnn.to_layout(hs, ttnn.TILE_LAYOUT)
        shape = list(hs.shape)
        if len(shape) == 3:
            hs = ttnn.reshape(hs, [shape[0] * shape[1], shape[2]])

        # router_logits = F.linear(hidden_states.float(), weight.float())
        logits = ttnn.matmul(hs, self._gate_w, compute_kernel_config=self.ckc)  # (T, n_experts)
        return logits


def build(device, torch_module):
    return NemotronHTopkRouter(device, torch_module)


_instance = None


def nemotron_h_topk_router(*args, **kwargs):
    global _instance
    if _instance is None:
        raise RuntimeError(
            'Synthesized TTNN module requires `build(device, torch_module)`. '
            'Call it from the PCC test\'s `_build_ttnn_port`.'
        )
    return _instance(*args, **kwargs)

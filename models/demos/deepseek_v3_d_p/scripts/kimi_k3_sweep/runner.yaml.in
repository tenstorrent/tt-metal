# Kimi-K3, 93 layers over 4 galaxies (24/24/24/21), traced, @USERS@ slots at the full 1M window.
# drive.sh fills the @...@ fields.
rank_bindings:
  - {rank: 0, mesh_id: 0, mesh_host_rank: 0, env_overrides: {}}
  - {rank: 1, mesh_id: 1, mesh_host_rank: 0, env_overrides: {}}
  - {rank: 2, mesh_id: 2, mesh_host_rank: 0, env_overrides: {}}
  - {rank: 3, mesh_id: 3, mesh_host_rank: 0, env_overrides: {PREFILL_LAYER_ACK_D2H: "@ACK3@"}}
mesh_graph_desc_path: models/demos/common/prefill/runners/topology_configuration/pipeline_prefill_4galaxy_connected_mesh_graph_descriptor.textproto
global_env:
  PYTHONPATH: "@HOME@:@HOME@/ttnn:@HOME@/tools"
  PREFILL_MANIFEST: "models/demos/deepseek_v3_d_p/tt/runners/manifests/kimi_k3.json"
  PREFILL_MODEL: "kimi_k3"
  PREFILL_NUM_LAYERS: "93"
  PREFILL_NUM_USERS: "@USERS@"
  PREFILL_MAX_SEQ_LEN: "1049600"
  PREFILL_USE_TRACE: "1"
  PREFILL_HF_MODEL: "/mnt/weka/model-weights/llm/moonshotai/Kimi-K3-dequantized"
  PREFILL_H2D_SERVICE_ID: "ds_prefill"
  PREFILL_LAYER_ACK_D2H: "1"
  PREFILL_LAYER_ACK_FIFO_BYTES: "65536"
  PREFILL_SYNC_PER_CHUNK: "1"
  PREFILL_TIMING_DIR: "@DIR@/timing"
  PREFILL_FABRIC_MODE: "2d_torus_xy"
  TT_METAL_CACHE: "@SCRATCH@/jit"
  TMPDIR: "@SCRATCH@/cc"
  TT_METAL_PINNED_MEMORY_CACHE_LIMIT_BYTES: "0"
  # Traced multi-user K3 is refused on main; see the README.
  K3_PERF_SHARED_KDA_CARRY: "1"
  LOGURU_LEVEL: "INFO"

# Single Blackhole galaxy carved to one [2,4] tray: MiniMax-M3's pipeline-prefill stage (SP 2 x TP 4), lines on both
# axes - the stage meshes of single_bh_galaxy_4x4x2_z_chain / quad_bh_galaxy_16stage_2x4_z_chain, one at a time.
#
# Usage: select with TT_MESH_GRAPH_DESC_PATH, pair with FabricConfig.FABRIC_2D, open a (2,4) mesh_device, and restrict
# TT_VISIBLE_DEVICES to one tray's 8 chips (e.g. 0-7, as the pipeline bindings give a stage). Single host / single
# rank. RELAXED tolerates the 8-chip slice mapping onto a partial 32-chip UBB board.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 4 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

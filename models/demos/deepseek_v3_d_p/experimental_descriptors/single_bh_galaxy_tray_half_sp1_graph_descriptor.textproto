# One 4x4 prefill stage on its own: a single tray half of a BH Galaxy (pin it with TT_VISIBLE_DEVICES: the half's 16
# chips, gen_pipeline_binding.py --layout 4x4), for single-process op and module tests at the 4x4-stage layout of
# #61481. Inside a half only the 4-wide X axis (mesh axis 1) keeps its ring, so SP runs on axis 1 and TP on axis 0:
# dim_types [LINE, RING]. Open it with FABRIC_2D_TORUS_X. (A copy of #61481's single_4x4_sp1_mgd.textproto.)

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

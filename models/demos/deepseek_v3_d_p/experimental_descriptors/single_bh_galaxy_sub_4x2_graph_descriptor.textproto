# Single Blackhole galaxy carved to one tray as a [4,2] mesh: a MiniMax-M3 stage with SP 4 x TP 2 (the [2,4] tray of
# single_bh_galaxy_sub_2x4 with its axes swapped), lines on both axes.
#
# Usage: select with TT_MESH_GRAPH_DESC_PATH, pair with FabricConfig.FABRIC_2D, open a (4,2) mesh_device, and restrict
# TT_VISIBLE_DEVICES to one tray's 8 chips (e.g. 0-7). Single host / single rank. RELAXED tolerates the 8-chip slice
# mapping onto a partial 32-chip UBB board.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 2 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

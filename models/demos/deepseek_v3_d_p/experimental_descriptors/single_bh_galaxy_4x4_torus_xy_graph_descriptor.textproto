# Four adjacent rows of a Blackhole Galaxy as one 4x4 torus.
#
# device_topology [4,4] [RING, RING]: axis 1 (the 4 chips of a Galaxy row) is a ring closed by the in-tray wrap cable;
# axis 0 (4 rows) a ring only where the Galaxy's row links close it, which is per-Galaxy (some carves embed as a 4x4
# mesh but not a torus; the solver then fails at placement).
#
# Usage: one process, TT_VISIBLE_DEVICES = the 16 chips of a 4x4 that closes both rings (galaxy_carve.py 4x4 prints the
# carves; the map is per-Galaxy), select this file with TT_MESH_GRAPH_DESC_PATH, open a (4,4) mesh with
# FabricConfig.FABRIC_2D_TORUS_XY. Unpinned: the placement solver picks the embedding among the visible chips.
# RELAXED, 2 channels per axis, as the 2x4 descriptors.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

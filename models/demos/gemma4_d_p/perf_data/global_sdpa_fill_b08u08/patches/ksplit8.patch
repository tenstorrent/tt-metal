 // [begin, end), or with stride > 1 the chunks k in [begin, end) where (end - 1 - k) % stride == residue.
 struct KSplitRange {
@@ -85,4 +85,22 @@ inline KSplitRange sliding_ksplit_range(uint32_t num_items, uint32_t split_idx,
     return ksplit_range(num_items, split_idx, split_count);

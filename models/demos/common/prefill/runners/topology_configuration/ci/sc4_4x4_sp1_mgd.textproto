# Kimi-K3 prefill on SC4 as 8 stages of 4x4: two per Galaxy, chained top(H) -> bottom(H) -> top(H+1).
# Even meshes are top tray halves (rows 0-3, chips 0-15 on aisle C), odd meshes bottom halves
# (rows 4-7, chips 16-31). Host ring order: c07u08, c07u02, c08u02, c08u08.
#
# Inside a half only the 4-wide X axis (mesh axis 1) keeps its ring, so SP runs on axis 1 and TP on
# axis 0: dim_types [LINE, RING].
#
# Seams, measured from the Rev C subtorus aisle C cabling descriptors:
#   - top(H) -> bottom(H), same host: the in-host Y links (rows 3<->4, the 2<->5 chord, the 0<->7
#     wrap), 28 links. assign_z_direction routes them as the Z hop between meshes.
#   - bottom(H) -> top(H+1): the inter-Galaxy cables (row 7<->0 and row 6<->1), 16 links.
# RELAXED on both until the seams are measured on the target cluster.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 4, 4 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 4 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 5 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 6 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 7 } }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    channels { count: 28 policy: RELAXED }
    assign_z_direction: true
  }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    channels { count: 16 policy: RELAXED }
  }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
    channels { count: 28 policy: RELAXED }
    assign_z_direction: true
  }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 3 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 4 } }
    channels { count: 16 policy: RELAXED }
  }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 4 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 5 } }
    channels { count: 28 policy: RELAXED }
    assign_z_direction: true
  }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 5 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 6 } }
    channels { count: 16 policy: RELAXED }
  }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 6 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 7 } }
    channels { count: 28 policy: RELAXED }
    assign_z_direction: true
  }
}

# --- Pinnings ---------------------------------------------------------------
# D2D pairs the two halves by mesh coordinate, so the bottom half is mirrored: TP row t on physical
# row 7-t, which puts each top/bottom pair 1, 3, 1, 1 hops apart instead of 4, 2, 2, 4. The mapper
# does not take that from TT_VISIBLE_DEVICES order; pinning mesh chips 0 and 1 (row 0, cols 0 and
# 1) fixes both axes, since row 0 must sit on an end row of the half. Rev C only: on Rev A/B the
# bottom half is trays 2 and 4. Positions from assemble_pipeline_binding.py predict, which derives
# them per host from the cabling and checks that all SC4 hosts agree.
# top halves: row 0 on physical row 0 (tray 1)
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 0 }
  physical_asic_position { tray_id: 1 asic_location: 1 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "0,2,4,6" chip_id: 1 }
  physical_asic_position { tray_id: 1 asic_location: 5 }
  board_revision: BH_REV_C
}
# bottom halves: row 0 on physical row 7 (tray 3)
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 0 }
  physical_asic_position { tray_id: 3 asic_location: 1 }
  board_revision: BH_REV_C
}
pinnings {
  logical_fabric_node_id { mesh_id_regex: "1,3,5,7" chip_id: 1 }
  physical_asic_position { tray_id: 3 asic_location: 5 }
  board_revision: BH_REV_C
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }

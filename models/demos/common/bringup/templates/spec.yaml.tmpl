# Model spec for the gated bring-up framework (models/demos/common/bringup). Written by the /bringup intake skill,
# approved by a person (python -m models.demos.common.bringup approve intake --spec <this file>).
model: $model                      # slug: package models/demos/<model>, commit tag [<model>][<task>]
hf_id: $hf_id
model_dir: models/demos/$model
hooks: models.demos.$model.bringup.hooks
num_layers: $num_layers
prior: null                        # models/demos/<slug> of an earlier bring-up of this checkpoint (other mesh or config):
                                   #   shares its hf/ and goldens, briefs list its files (`new --prior` writes this)
layers: all                        # or a subset, e.g. "0-1,29" (a subset result is never reported as full-model)
box:
  mesh: $mesh                      # [rows, cols]
  chip_dram_gb: $chip_dram_gb
  device_params: {fabric_config: FABRIC_2D, l1_small_size: 24576}
  test_timeout_s: 3600             # pytest timeout of the ladder, contract and profile tests (the repo default is 300)
target: {seq: $seq, chunk: $chunk, dtype: bf16}
ladder:                            # rungs in order; the first rung with full_dumps feeds component and swap tests
$ladder
block_types:                       # every layer exactly once; representative = the layer swap tests use
$block_types
state:
  kind: $state_kind                # kv | recurrent | mixed (documentation only)
  tensors: [key, value]            # names state_tensors() returns per layer (with by_block_type: all names used)
  format: separate_k_v
  # by_block_type: {<block type>: [names]}   # layer types with different state (e.g. MLA latent vs recurrent state)
  # fixed: [names]                           # tensors that do not grow along the sequence (recurrent state, conv
  #                                          #   tail): goldens snapshot them at chunk starts (F48)
thresholds: {component: 0.99, block: 0.98, layer: 0.97, state: 0.97, final_hidden: 0.97, top5: 0.9}
                                   # swap tests (F49) also gate each swapped step vs the CPU step on the same inputs:
                                   #   swap_step_rel 0.02 (rel L2; tightened to 2x the step's component-gate error,
                                   #   not below 0.005), swap_step_row 0.05 (worst row), swap_step_ratio 0.02 (every
                                   #   row norm within 1 +- this); optional keys, add them here to override
text:                              # the canonical prompt, built once at R.1 (reference/prompt.py)
  source: models/tt_transformers/tests/tale-of-two-cities.txt.bz2
  wrap: raw                        # raw (base checkpoints) | model_turn (instruction-tuned) | user_turn
  min_top1: 0.4                    # HF next-token accuracy floor on the prompt (intake sanity gate)
hf:
  revision: null                   # commit sha of the checkpoint (from the download metadata)
  parity_seq: 2048                 # must exceed any sliding window
intake:
  smoke: null                      # the model card's usage example: {prompt: "...", expect: "..."}
checkpoint:
  expect: {}                       # tensor glob -> shape ("*" = any); filled by intake from the checkpoint index
  config: {}                       # text-config fields that must match
contract: {adapter: $model}
agents:
  model: null
  timeout_s: 14400
  rules: []                        # the owner's rules, shown in every brief (e.g. "always use 2D fabric")
  read: {}                         # per role: files every brief of that role lists
  policy: {}                       # per role: {attempts, escalate: debugger | stop}
  swap_review: none                # swap tests freeze without a test-role review (F49): none | all | [block types]
dashboard: {styles: [standard]}    # standard | teletext | both
paths: {}                          # defaults: art /localdev/$$USER/bringup/<model>; hf, golden, tt_cache under it

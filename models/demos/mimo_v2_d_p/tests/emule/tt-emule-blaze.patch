+// ---- Per-header 2D unicast stateful sends (silicon mesh/api.h: set_state takes the explicit destination
+// (dst_dev_id, dst_mesh_id) instead of a hop count). set_state records the UNICAST_2D route through the
+// route setter (as silicon's fabric_set_unicast_route does) and then lays the command fields through the
+// linear form, whose own route stamp is compiled out under EMULE_FABRIC_2D, so the 2D route survives.
+// with_state is identical to the linear form (the route lives with the header). ----
+template <UnicastWriteUpdateMask UpdateMask = UnicastWriteUpdateMask::None, typename CommandHeaderT = std::nullptr_t>
+inline void fabric_unicast_noc_unicast_write_set_state(
+    volatile PACKET_HEADER_TYPE* packet_header,
+    uint8_t dst_dev_id,
+    uint16_t dst_mesh_id,
+    CommandHeaderT command_header = nullptr,
+    uint16_t packet_size_bytes = 0) {
+    fabric_set_unicast_route(packet_header, dst_dev_id, dst_mesh_id);
+    linear::experimental::fabric_unicast_noc_unicast_write_set_state<UpdateMask>(
+        packet_header, 0, command_header, packet_size_bytes);
+}
+

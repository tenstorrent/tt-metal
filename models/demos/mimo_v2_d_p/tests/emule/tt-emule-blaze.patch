+// Non-blocking twin of cb_reserve_back (silicon: the free-space check without the wait): true when n pages can be
+// reserved now; otherwise yields (the consumer is a peer fiber on this pool) and returns false.
+inline bool cb_pages_reservable_at_back(int32_t operand, int32_t num_pages) {
+    const uint32_t cb_id = static_cast<uint32_t>(operand);
+    const uint32_t n = static_cast<uint32_t>(num_pages);
+    auto& cb = __emule_self->cbs[cb_id];
+    __emule_self->cb_self_produce_mask |= (1ull << cb_id);
+    tt_emule::cb_register_producer(cb, __emule_self);
+    uint32_t free_pages;
+    if (__emule_self->kind == ThreadCommonCtx::Kind::Compute) {
+        const uint32_t rc = cb.received_compute.load(std::memory_order_acquire);
+        const uint32_t ak = cb.acked.load(std::memory_order_acquire);
+        const uint32_t outstanding = (rc > ak) ? (rc - ak) : 0u;
+        free_pages = (cb.num_pages > outstanding) ? (cb.num_pages - outstanding) : 0u;
+    } else {
+        free_pages = cb.num_pages - cb.occupied.load(std::memory_order_acquire);
+    }
+    if (free_pages >= n) {
+        return true;
+    }
+    __emule_fiber_yield();
+    return false;
+}

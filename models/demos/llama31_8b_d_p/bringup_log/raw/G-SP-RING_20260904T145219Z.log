__ test_wrong_kv_actual_isl_collapses[blackhole-mesh_device0-device_params0] ___

mesh_device = MeshDevice(4x8 grid, 32 devices), reset_seeds = None

    @requires_galaxy
    @requires_ring_fabric
    @torch.no_grad()
    @pytest.mark.parametrize("device_params", [galaxy_device_params()], indirect=True)
    @pytest.mark.parametrize("mesh_device", [GALAXY_MESH_SHAPE], indirect=True)
    def test_wrong_kv_actual_isl_collapses(mesh_device, reset_seeds):
        """Pass `kv_actual = 0` for a chunk that really starts at 512; the PCC must collapse.

        `kv_actual_isl` is what tells the op where this chunk's Q rows sit in the global sequence, so
        getting it wrong is a causal-mask off-by-`kv_actual` — the exact failure the dense path refuses
        rather than approximating. A numeric control, because this one *is* a numeric claim: unlike the
        head->column mapping (§2.5), an off-by-N mask changes the values everywhere and PCC sees it.
        """
        hf = llama_config_dims()

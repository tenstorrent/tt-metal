            f"[G-CHUNK-ATTN] {num_layers} layers on {(sp, tp)}: layer 0 (attention-independent) "
            f"K={layer0['mutual_k']:.5f} V={layer0['mutual_v']:.5f}; layers 1-{num_layers - 1} "
            f"ring-vs-bootstrap min K={worst['mutual_k']:.5f} min V={worst['mutual_v']:.5f} "

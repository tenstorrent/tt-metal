+    def _encode_timed(self, input_ids: torch.Tensor, attention_mask: torch.Tensor | None):
+        """Traced encode with a device sync between phases; appends one JSON line per call to EMB_TIMING_LOG.
+
+        Comparison instrumentation (serving-path latency study), not for production: the syncs remove overlap.
+        """
+        t0 = time.perf_counter()
+        host = self.prepare_inputs(input_ids, attention_mask)
+        t1 = time.perf_counter()
+        tr = self._traces[(host.batch, host.seq_len)]
+        ttnn.copy_host_to_device_tensor(host.input_ids, tr.input_ids)
+        ttnn.copy_host_to_device_tensor(host.keep, tr.keep)
+        ttnn.synchronize_device(self.device)
+        t2 = time.perf_counter()
+        ttnn.execute_trace(self.device, tr.trace_id, cq_id=0, blocking=False)
+        ttnn.synchronize_device(self.device)
+        t3 = time.perf_counter()
+        out = self.read_embedding(tr.embedding, host.batch)
+        t4 = time.perf_counter()
+        rec = dict(
+            pid=os.getpid(),
+            t=t0,
+            batch=host.batch,
+            bucket=host.seq_len,
+            tokens=int(host.logical_seq_len),
+            prep_ms=(t1 - t0) * 1e3,
+            h2d_ms=(t2 - t1) * 1e3,
+            device_ms=(t3 - t2) * 1e3,
+            d2h_ms=(t4 - t3) * 1e3,
+        )
+        with open(_TIMING_LOG, "a") as f:
+            f.write(json.dumps(rec) + "\n")
+        return out
+

+@pytest.mark.parametrize("M,K,N", [(2048, 256, 2048), (2048, 512, 1536), (1600, 768, 2304), (1024, 2560, 1024)])
+@pytest.mark.parametrize("transpose_core_grid", [True, False], ids=["transposed", "untransposed"])
+@pytest.mark.parametrize("fuse_swiglu", [False, True], ids=["plain", "swiglu"])
+def test_linear_n_outer(device, M, K, N, transpose_core_grid, fuse_swiglu):
+    """MinimalMatmulConfig.n_outer: N-outer block order with in1 resident across M blocks matches the default order
+    (2, 3, 4 and 10 K blocks; several M and N blocks per core; padded M)."""
+    torch.manual_seed(0)
+    a, b = torch.randn(1, 1, M, K), torch.randn(1, 1, K, N)
+    tt_a = ttnn.from_torch(a, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
+    tt_b = ttnn.from_torch(b, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
+    ckc = ttnn.init_device_compute_kernel_config(
+        device.arch(), math_fidelity=ttnn.MathFidelity.HiFi2, fp32_dest_acc_en=False, packer_l1_acc=True
+    )
+    outs = []
+    for n_outer in (False, True):
+        cfg = ttnn.MinimalMatmulConfig(
+            M_block_size=4,
+            K_block_size=4 if K <= 512 else 8,
+            N_block_size=4,
+            subblock_h=1,
+            subblock_w=4,
+            compute_with_storage_grid_size=device.compute_with_storage_grid_size(),
+            transpose_core_grid=transpose_core_grid,
+            n_outer=n_outer,
+        )
+        assert cfg.n_outer == n_outer
+        kw = dict(config=cfg, compute_kernel_config=ckc)
+        if fuse_swiglu:
+            kw["fuse_swiglu"] = True
+        outs.append(ttnn.to_torch(ttnn.experimental.minimal_matmul(tt_a, tt_b, **kw)))
+    # The default order runs K backwards on alternate N blocks (in0 reuse), n_outer always forward: equal up to the
+    # accumulation order.
+    assert comp_pcc(outs[0], outs[1], 0.99995)[0], "n_outer changed the result"
+    ref = a @ b
+    if fuse_swiglu:  # adjacent tile pairs are (gate, up)
+        t = ref.reshape(1, 1, M, N // 64, 2, 32)
+        ref = (torch.nn.functional.silu(t[..., 0, :]) * t[..., 1, :]).reshape(1, 1, M, N // 2)
+    check_result = assert_quality(ref, outs[1])
+    assert check_result["pcc"] > 0.999
+
+

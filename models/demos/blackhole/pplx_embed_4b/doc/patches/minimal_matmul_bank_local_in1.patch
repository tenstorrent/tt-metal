+BankLocalLayout build_bank_local_layout(const std::vector<CoreCoord>& workers, const CoreCoord& grid_size) {
+    const uint32_t num_banks = workers.size();
+    const uint32_t num_cores = grid_size.x * grid_size.y;
+    TT_FATAL(num_banks > 0 && num_cores % num_banks == 0, "bank_local_in1: {} cores over {} banks", num_cores, num_banks);
+    const uint32_t per_group = num_cores / num_banks;
+    auto dist = [](const CoreCoord& a, const CoreCoord& b) {
+        return static_cast<uint32_t>(
+            (a.x > b.x ? a.x - b.x : b.x - a.x) + (a.y > b.y ? a.y - b.y : b.y - a.y));
+    };
+    for (const auto& w : workers) {
+        TT_FATAL(w.x < grid_size.x && w.y < grid_size.y, "bank_local_in1: worker {} outside the grid", w);
+    }
+    // Greedy: closest (core, bank) pairs first, each bank capped at per_group; workers seed their own group.
+    std::vector<CoreCoord> cores;
+    for (uint32_t y = 0; y < grid_size.y; ++y) {
+        for (uint32_t x = 0; x < grid_size.x; ++x) {
+            cores.push_back({x, y});
+        }
+    }
+    std::map<CoreCoord, uint32_t> group_of;
+    std::vector<uint32_t> fill(num_banks, 0);
+    for (uint32_t b = 0; b < num_banks; ++b) {
+        TT_FATAL(!group_of.contains(workers[b]), "bank_local_in1: worker {} serves two banks", workers[b]);
+        group_of[workers[b]] = b;
+        fill[b]++;
+    }
+    std::vector<std::tuple<uint32_t, uint32_t, uint32_t>> pairs;  // (distance, core index, bank)
+    for (uint32_t c = 0; c < cores.size(); ++c) {

+// MinimalMatmulConfig::bank_local_in1: one group of cores per DRAM bank around that bank's optimal worker. Group b
+// carries in1_idx = b (its N range is bank b's shard); a core's in0_idx is its position in its group's in1 chain,
+// which starts at the worker. The in0 chain of position i visits the i-th core of every group, starting at bank 0's.
+struct BankLocalLayout {
+    std::map<CoreCoord, std::pair<uint32_t, uint32_t>> idx;  // core -> (in0_idx, in1_idx)
+    std::vector<std::vector<CoreCoord>> in0_chains;          // [in0_idx] -> cores in chain order
+    std::vector<std::vector<CoreCoord>> in1_chains;          // [in1_idx] -> cores in chain order

+            pairs.emplace_back(dist(cores[c], workers[b]), c, b);
+        }
+    }
+    std::sort(pairs.begin(), pairs.end());
+    for (const auto& [d, c, b] : pairs) {
+        if (!group_of.contains(cores[c]) && fill[b] < per_group) {
+            group_of[cores[c]] = b;
+            fill[b]++;
+        }
+    }
+    // Pairwise swaps (never moving a worker) while they shorten the total core-to-worker distance.
+    for (bool improved = true; improved;) {
+        improved = false;
+        for (uint32_t i = 0; i < cores.size(); ++i) {

# QuietBox 4x p150b: one 1x4 LINE mesh (three of the four ring links), the
# logical shape the model's Linear collectives assume (larger hosts auto-discover
# a 4x1 line; the QuietBox auto-discovers a 2x2 from its ring).  Exported as
# TT_MESH_GRAPH_DESC_PATH by run_qwen38_chat_server.sh.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 4 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 4 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

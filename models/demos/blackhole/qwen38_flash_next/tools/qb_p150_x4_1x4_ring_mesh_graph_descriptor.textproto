# QuietBox 4x p150b: one 1x4 RING mesh (all four ring links) for the ring A/B
# against the 1x4 LINE descriptor.  Set through TT_MESH_GRAPH_DESC_PATH by
# the launcher that opens the ring (run_qwen38_chat_server.sh exports the LINE descriptor).
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 4 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 4 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

# perfstack.env: recommended Hy4-Preview perf-stack flags (branch ssinghal/hy4-preview-perfstack = verify 68d6c11104a + vopt ff0ad5dfc6e + attnfuse ed6c980b557/8af3ea15e0a; hostoh c0788da194f is an ancestor).
# Usage: set -a; . perfstack.env; set +a   (or pass as -e VAR=val). Product base flags (TP32 stack) are in BASE below.
HY4_TP32_PACK=u16
HY4_FUSE_AR=1
HY4_TP32_TAIL=oneshot
HY4_MTP_NORM=fused
HY4_HEAD_FAST=1
HY4_DRAFT_HEAD=bfp8
HY4_ATTN_HM=1
HY4_IDX_BLK=1
HY4_GATE_FOLD=1
HY4_SPEC_PIPE=1
HY4_TP32_ROUTE=local
# BASE (product3 TP32 stack, from verify-opt/se.sh):
# HY4_POOL=1 HY4_POOL_PF=1 HY4_KV_FMT=scaled_fp8 HY4_OPT=all HY4_IHC_FUSED=1 HY4_FUSE=sparse,xchg HY4_XM_NSPLIT=8 HY4_SKINNY=shared,router,oproj,hproj HY4_PF_OPT=all,moeall MOE_RING_FAST=1 HY4_TP32_ONLY=1 HY4_MOE_TP32=1 HY4_TP32_PF=1 HY4_SPEC_SAMPLED=0 HY4_SPEC_K=3

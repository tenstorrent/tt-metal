#
# Pinned flags for sequence-parallel prefill on the single-chip model classes (tt/sp_prefill_sc.py,
# QWEN36_SP_IMPL=sc in tests/test_sp_prefill.py) on 11x10 p300c dies. Source it before the test:
#   source models/demos/blackhole/qwen36/demo/sp_sc_flags.env
#
# The prefill-relevant flags that demo/run_bench_e2e_p150.sh pins (its runner defaults), with these
# overrides:
#   QWEN36_GDN_PCFG=nv1np4       11x10 grid: NV=1 NP=4 row-local (runner: nv1np5 for P150 13x10)
#   QWEN36_M3_REPACK_TRACE=0     the conv-history repack is decode-only (SP hands off to TP decode)
#   QWEN36_M5_TAIL_TRACE=0       SP runs the tail inline on the last die
# Test-harness-only / sampling / vLLM-serving flags of the runner are left out.

# ---- item flags (runner defaults unless noted) ----
export QWEN36_ONDEV_ARGMAX=1
export QWEN36_I1_D3=1
export QWEN36_I1_D15=1
export QWEN36_I1_D4A=0
export QWEN36_I1_D6=1
export QWEN36_I1_P5=1
export QWEN36_I1_ROPEWARM=1
export QWEN36_I2_S1=2
export QWEN36_I2_S2=0
export QWEN36_I2_S3=0
export QWEN36_I2_PICKER=1
export QWEN36_M1_S2=1
export QWEN36_M1_S3=1
export QWEN36_M1_S4=1
export QWEN36_M2_NOWHERE=1
export QWEN36_M2_REPACK_LATE=0
export QWEN36_M2_LASTROW=1
export QWEN36_M3_ZB=1
export QWEN36_M3_REPACK_TRACE=0
export QWEN36_C2_SGRN=1
export QWEN36_R3_FLA_IN_L1=1
export QWEN36_R3_SGRN_GAB_L1=1
export QWEN36_R3_O_L1=1
export QWEN36_M4_R4A=1
export QWEN36_M4_R4B=1
export QWEN36_M5_TAIL_TRACE=0
export QWEN36_M5_ADDNORM=1
export QWEN36_F_MLP_GU_BF8=1
export QWEN36_N_GAMMA_L1=1
export QWEN36_I3_FA_PROGCFG=1
export QWEN36_I3_MLP_PROGCFG=1
export QWEN36_I3_MLP_FUSED_GU=0
# I-3 LM head A3 (as the runner): 10 DRAM width-sharded chunks [2048, 24832] (98 tiles/bank), built at load
# from tpc.i3_a3_lm_plan (grid-aware: 11x10 and 13x10 give the same plan); the unsplit weight is freed.
# -1.75 ms SP TTFT vs the split-8 minimal_matmul head; not bit-identical (~8% of logits <= 1 bf16 ulp).
export QWEN36_I3_LMHEAD=A3
export QWEN36_LAYER_RESID_L1=1
export QWEN36_LAYER_L1_MAX_T=0
export QWEN36_GDN_DECODE_FUSED=2
export QWEN36_GDN_CONV_REPACK=batched
export QWEN36_GDN_CONV_KDA_TILED=1
export QWEN36_GDN_PCFG=nv1np4
export QWEN36_GDN_WYINV=sfpu
export QWEN36_I4_SDPA_Q64=1
export QWEN36_I4_SDPA_EXP_COMPAT=1
# P300 (tp_common P300 table): the one-die mmsweep's 11x10 / M=1024 prefill matmul configs (MLP gate|up
# minimal 11x8 mb4kb4nb18 1x6; MLP down, GDN q|k|v, GDN z|a|0|b|0, attention q|k|v / o_proj / gate, GDN o_proj
# 2D mcast bw16). Not bit-identical. _C_L1 / _D1_L1 = 0: the GDN q|k|v / z|a|0|b|0 outputs back to DRAM
# (fallback if an L1 placement clashes with a later op's static CBs).
export QWEN36_P300_MM=1
export QWEN36_P300_MM_C_L1=1
export QWEN36_P300_MM_D1_L1=1

# ---- fixed flags (as pinned by the runner) ----
export QWEN35_GDN_DECODE_BF16=0
export QWEN35_GDN_STATE_BF16=0
export QWEN35_TP_DECODE_EAGER=0
export QWEN35_TP_PREFILL_EAGER=0
export QWEN36_ATTN_FUSED_QKV=1
export QWEN36_ATTN_GATE_FUSED=1
export QWEN36_ATTN_KV_BF8=0
export QWEN36_ATTN_L1_MAX_T=2048
export QWEN36_ATTN_QKNORM_HIFI2=1
export QWEN36_DECODE_PROGCFG=1
export QWEN36_GDN_CONV_KDA=1
export QWEN36_GDN_CONV_KDA_FP32ACC=0
export QWEN36_GDN_CONV_LEGACY=0
export QWEN36_GDN_CONV_SILU_SHARDED=0
export QWEN36_GDN_CONV_T3_MAX=0
export QWEN36_GDN_CONV_TILED_SPLIT=0
export QWEN36_GDN_FUSED_PREFILL=1
export QWEN36_GDN_GATE_CLIP=0
export QWEN36_GDN_GATE_FUSED=1
export QWEN36_GDN_GB_LAYOUT=0
export QWEN36_GDN_L1_MAX_T=0
export QWEN36_GDN_NATIVE_CONV1D=1
export QWEN36_GDN_POST_L1=1
export QWEN36_GDN_POST_L1_OUTPROJ=1
export QWEN36_GDN_POST_L1_SCAN=1
export QWEN36_GDN_SPLIT_PROJ=1
export QWEN36_LMHEAD_MINIMAL=1
export QWEN36_LMHEAD_SPLIT=8
export QWEN36_MLP_FUSED_SWIGLU=1
export QWEN36_MLP_L1_OUT=1
export QWEN36_MLP_LEGACY_SHORT=0
export QWEN36_MLP_MINIMAL_MM=1
export QWEN36_PREFILL_DEBUG=0
export QWEN36_PREFILL_MINIMAL_CFG=1
export QWEN36_PREFILL_MM_FP32_ACC=0
export QWEN36_PREFILL_MM_PACKER_L1_ACC=1
export QWEN36_PREFILL_OVERLAP=1
export QWEN36_PREFILL_PROGCFG=1
export QWEN36_PREFILL_PROGCFG_OVERRIDES=1
export QWEN36_ROPE_DEVICE_TABLE=1
export QWEN36_ROPE_LEGACY=0
export QWEN9B_MLP_DOWN_AUTO=0
export QWEN9B_MLP_UP_AUTO=0
export QWEN9B_SDPA_QK64=0
export QWEN_BATCHED_GROUPED=1
export QWEN_GDN_DIAG_ALPHA=0.25
export QWEN_GDN_FLAT_GB=1
export QWEN_GDN_FP32_STATE=0
export QWEN_GDN_INV_DOUBLING=0
export QWEN_SDPA_BF8=0
export QWEN_GDN_PATH=fused

# ---- trace guard (runner default on: Metal's trace-allocation tracker) ----
export QWEN36_TRACE_GUARD=1
export TT_METAL_TRACE_ALLOC_TRACKING=1

# ---- SP per-die T=1024 tuning ----
# Re-gate the T == 2048 paths to the per-die span lengths: R3 (FLA in/out L1, O_L1) and M5 ADDNORM
# (tp_common R3_T_SET / M5_ADDNORM_T_SET, comma lists: membership test). 896 / 1152 cover uneven per-die spans
# (QWEN36_SP_SPANS, e.g. "1152,1024,1024,896"); with uniform 1024 spans only 1024 is ever hit, so this is the
# same as the old single 1024. GDN post-norm bf16 output, and GDN L1 intermediates up to T=1152 (a <= threshold;
# overrides the QWEN36_GDN_L1_MAX_T=0 pinned above; 1024 spans unchanged). The 896 / 1152 L1 placements are
# unverified extrapolations of the 1024 ones (a larger T means larger L1 tensors: check for CB clashes).
export QWEN36_R3_T=896,1024,1152
export QWEN36_M5_ADDNORM_T=896,1024,1152
export QWEN36_GDN_POST_NORM_BF16OUT=1
export QWEN36_GDN_L1_MAX_T=1152

# ---- round 6: bf8 KV + SDPA (validated HF PCC 0.99526, TTFT ~29.0 ms) ----
# Overrides the earlier QWEN36_ATTN_KV_BF8=0 (and restates QWEN36_M4_R4B=1). QWEN36_ATTN_GATE_CAST exists because of a
# fused b-activation multiply bug: ttnn.multiply(..., input_tensor_b_activations=...) gives wrong results for mixed a/b
# dtypes (e.g. bf8 a / bf16 b: PCC ~0.66 standalone), so the gate is typecast to the SDPA output dtype before the
# fused multiply (ttnn_gated_attention.py).
export QWEN36_ATTN_KV_BF8=1
export QWEN36_ATTN_GATE_CAST=1
export QWEN36_M4_R4B=1
export QWEN36_SDPA_FP32ACC=0
export QWEN36_SDPA_GRID=11x8

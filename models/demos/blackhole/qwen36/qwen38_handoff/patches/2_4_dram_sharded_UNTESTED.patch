index 5d09a4d73b2..39e2e5765be 100644
--- a/models/demos/blackhole/qwen36/tt/tp_common.py
+++ b/models/demos/blackhole/qwen36/tt/tp_common.py
@@ -97,6 +97,170 @@ def resolve_mlp_down_dtype(down_dtype=None):
     return ttnn.bfloat4_b if on else ttnn.bfloat8_b
 
 
+# ---------------------------------------------------------------------------------------------
+# QWEN36_BFP4_DSHARD (default 1): DRAM-sharded MULTI-READER decode matmuls for the BFP4 weight groups
+# (implementation B's decode program, models/demos/qwen38_27b_qb2/tt/decoder.py `_linear`). Applies only to a
+# group whose BFP4 flag is on: MLP down (QWEN36_BFP4_MLP_DOWN), attention QKV and wo (QWEN36_BFP4_ATTN), GDN
+# in-proj (QWEN36_BFP4_GDN_IN). Each such group loads an EXTRA DRAM-WIDTH_SHARDED copy of its weight under a new
+# cache stem ("<stem>.dsh4"); the interleaved copy stays for prefill / flag-off. =0: no extra copies, the 1D path.
+# ---------------------------------------------------------------------------------------------
+BFP4_DSHARD_ENV = "QWEN36_BFP4_DSHARD"
+_DSHARD_LOGGED = False
+_DSH_WARNED = set()
+# group -> (in0 cores, in0_block_w, num_workers_per_dram_bank). Each is validated against the actual per-device
+# [K, N] in dsh_geometry (TP=4 27B: down 4352x5120, gdn_in 5120x4160->4608, qkv 5120x3584, wo 1536x5120).
+DSH_PARAMS = {
+    "down": (8, 17, 2),
+    "gdn_in": (10, 16, 2),
+    "qkv": (10, 16, 2),
+    "wo": (8, 6, 2),
+}
+
+
+def bfp4_dshard_enabled():
+    return os.environ.get(BFP4_DSHARD_ENV, "1") == "1"
+
+
+def dshard_group_enabled(group):
+    """True when `group` (down / qkv / wo / gdn_in) is BFP4 AND QWEN36_BFP4_DSHARD=1. Logs the set once."""
+    global _DSHARD_LOGGED
+    bfp4 = {
+        "down": bfp4_mlp_down_enabled(),
+        "qkv": bfp4_attn_enabled(),
+        "wo": bfp4_attn_enabled(),
+        "gdn_in": bfp4_gdn_in_enabled(),
+    }
+    on = bfp4_dshard_enabled()
+    if not _DSHARD_LOGGED:
+        _DSHARD_LOGGED = True
+        groups = [g for g in DSH_PARAMS if on and bfp4[g]]
+        logger.info(
+            f"{BFP4_DSHARD_ENV}={int(on)}: DRAM-sharded multi-reader decode matmuls for "
+            f"{groups if groups else 'no groups'} (others keep the 1D path)"
+        )
+    return on and bfp4[group]
+
+
+def dsh_padded_n(group, n, banks):
+    """N padded up to a multiple of banks * readers * 32 (every reader of every bank needs a whole tile column)."""
+    align = banks * DSH_PARAMS[group][2] * TILE_SIZE
+    return -(-n // align) * align
+
+
+def dsh_geometry(group, k, n, banks, grid_x):
+    """Geometry of the DRAM-sharded multi-reader matmul for a per-device [k, n] weight (n already padded), or None
+    if the shape can't use it (callers then keep the 1D path)."""
+    cores, block, readers = DSH_PARAMS[group]
+    t = TILE_SIZE
+    if banks < 1 or grid_x < cores or k % (t * cores) or n % (t * banks * readers):
+        return None
+    shard_tiles_k = k // t // cores
+    if shard_tiles_k % block:
+        return None
+    shard_width = n // banks
+    return dict(
+        cores=cores,
+        block=block,
+        readers=readers,
+        banks=banks,
+        shard_width=shard_width,
+        in_width=shard_tiles_k * t,
+        per_core_n=(shard_width // t * banks + cores - 1) // cores,
+    )
+
+
+def dsh_weight_memcfg(k, geom):
+    """DRAM WIDTH_SHARDED over the DRAM banks, shard [k, n/banks] (B: decoder_tp.py:274-292)."""
+    bank_grid = ttnn.CoreRangeSet({ttnn.CoreRange(ttnn.CoreCoord(0, 0), ttnn.CoreCoord(geom["banks"] - 1, 0))})
+    return ttnn.MemoryConfig(
+        ttnn.TensorMemoryLayout.WIDTH_SHARDED,
+        ttnn.BufferType.DRAM,
+        ttnn.ShardSpec(bank_grid, [k, geom["shard_width"]], ttnn.ShardOrientation.ROW_MAJOR),
+    )
+
+
+def dsh_in_memcfg(geom):
+    """Activation: one tile-row (M<=32) width-sharded [32, K/cores] over the first `cores` cores of row 0."""
+    grid = ttnn.CoreRangeSet({ttnn.CoreRange(ttnn.CoreCoord(0, 0), ttnn.CoreCoord(geom["cores"] - 1, 0))})
+    return ttnn.MemoryConfig(
+        ttnn.TensorMemoryLayout.WIDTH_SHARDED,
+        ttnn.BufferType.L1,
+        ttnn.ShardSpec(grid, [TILE_SIZE, geom["in_width"]], ttnn.ShardOrientation.ROW_MAJOR),
+    )
+
+
+def dsh_geometry_for_mesh(group, mesh, k, n):
+    return dsh_geometry(group, k, n, mesh.dram_grid_size().x, mesh.compute_with_storage_grid_size().x)
+
+
+def load_dsh_weight(group, torch_w, mesh, dim, k, n, cache_path, dtype=None):
+    """Extra DRAM-width-sharded copy of a BFP4 weight (torch [out, in]; per-device [k, n], n already padded to
+    dsh_padded_n) under its own cache stem, or None when the group is off / the shape is ineligible."""
+    if not dshard_group_enabled(group):
+        return None
+    geom = dsh_geometry_for_mesh(group, mesh, k, n)
+    if geom is None:
+        if (group, k, n) not in _DSH_WARNED:
+            _DSH_WARNED.add((group, k, n))
+            logger.warning(f"{BFP4_DSHARD_ENV}=1 but the {group} weight [{k}, {n}] can't use the DRAM-sharded layout")
+        return None
+    return shard_w(
+        torch_w,
+        mesh,
+        dim=dim,
+        memory_config=dsh_weight_memcfg(k, geom),
+        cache_path=cache_path,
+        dtype=ttnn.bfloat4_b if dtype is None else dtype,
+    )
+
+
+class DShardMatmul:
+    """Decode matmul on a DRAM-sharded BFP4 weight copy with `readers` workers per DRAM bank.
+
+    x [.., M<=32, K] (any layout) -> L1 width-shard [32, K/cores] on `cores` cores -> DRAM-sharded matmul (bf16 out,
+    L1 width-sharded) -> `out_memory_config` via sharded_to_interleaved (the consumers -- slices, all-reduce reshard,
+    tt_all_reduce -- all expect an interleaved tensor, exactly as with the 1D path)."""
+
+    def __init__(self, group, weight, mesh):
+        k, n = weight.shape[-2], weight.shape[-1]
+        geom = dsh_geometry_for_mesh(group, mesh, k, n)
+        assert geom is not None, f"{group} DSH weight [{k}, {n}] has no valid geometry"
+        self.group = group
+        self.weight = weight
+        self.n = n
+        self.in_mem = dsh_in_memcfg(geom)
+        self.progcfg = ttnn.MatmulMultiCoreReuseMultiCastDRAMShardedProgramConfig(
+            in0_block_w=geom["block"],
+            per_core_M=1,
+            per_core_N=geom["per_core_n"],
+            fused_activation=None,
+            num_workers_per_dram_bank=geom["readers"],
+        )
+
+    def __call__(self, x, compute_cfg, out_memory_config):
+        x_sh = ttnn.to_memory_config(x, self.in_mem)
+        out = ttnn.linear(
+            x_sh,
+            self.weight,
+            compute_kernel_config=compute_cfg,
+            program_config=self.progcfg,
+            memory_config=ttnn.L1_WIDTH_SHARDED_MEMORY_CONFIG,
+            dtype=ttnn.bfloat16,
+        )
+        if x_sh is not x:
+            ttnn.deallocate(x_sh)
+        res = ttnn.sharded_to_interleaved(out, out_memory_config)
+        ttnn.deallocate(out)
+        return res
+
+
+def make_dsh(group, weight, mesh):
+    """DShardMatmul for `weight` (an extra DSH copy, or None) if the flag is on, else None."""
+    if weight is None or not dshard_group_enabled(group):
+        return None
+    return DShardMatmul(group, weight, mesh)
+
+
 # Grid helpers
 def prefill_grid_default():
     """BH P150: (8,10); WH: (8,8). y capped at 10 on BH (grid_x=10 breaks matmul)."""

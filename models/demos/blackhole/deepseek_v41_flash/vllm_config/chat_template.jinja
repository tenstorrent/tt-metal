{#- DeepSeek-V4.1 chat (non-thinking) prompt format = encoding/encoding.py encode_messages(thinking_mode="chat") for system / user / assistant turns. Content is a string or a list of parts (vLLM "openai" content format): text parts and one <｜deepseek_image｜> per image part, joined by a blank line like the encoding's content blocks. -#}
{%- macro content(c) -%}
{%- if c is string -%}{{ c }}
{%- else -%}
{%- for part in c -%}
{%- if not loop.first -%}{{ "\n\n" }}{%- endif -%}
{%- if part['type'] == 'text' -%}{{ part['text'] }}
{%- elif part['type'] in ('image', 'image_url') -%}<｜deepseek_image｜>
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}
{{- bos_token -}}
{%- for m in messages -%}
{%- if m['role'] == 'system' -%}<｜System｜>{{ content(m['content']) }}
{%- elif m['role'] == 'user' -%}<｜User｜>{{ content(m['content']) }}
{%- elif m['role'] == 'assistant' -%}<｜Assistant｜></think>{{ content(m['content']) }}{{ eos_token }}
{%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}<｜Assistant｜></think>{%- endif -%}

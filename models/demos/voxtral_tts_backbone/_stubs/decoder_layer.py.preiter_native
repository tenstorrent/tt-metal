"""Native TTNN port of `decoder_layer` (`MistralDecoderLayer`) for
`/localdev/lserbedzija/hf_models/voxtral-tts-backbone`.

    h  = x + self_attn(input_layernorm(x))
    out = h + mlp(post_attention_layernorm(h))

The self-attention math is the already-graduated sibling stub
(`_stubs/attention.py::TtAttention`) rather than a second copy of it, so the
layer and the standalone attention component cannot drift apart. The RMSNorm
call mirrors `models/common/rmsnorm.py` (ROW_MAJOR weight shaped
`[1, 1, dim/32, 32]`, HiFi2 + fp32 accumulate) and the MLP is the SwiGLU of
`models/tt_transformers/tt/mlp.py`.

`__init__`/`build` stage weights with torch (they come from an HF checkpoint);
`__call__` is pure ttnn — `models/common/native_probe.py` counts what actually
executes, so any torch op in the forward would disqualify it.
"""
from __future__ import annotations

import torch
import ttnn

from models.demos.voxtral_tts_backbone._stubs.attention import (
    TtAttention,
    _replicate_mapper,
    _stage,
)

TILE = 32


def _stage_norm_weight(weight: torch.Tensor, device):
    """RMSNorm gain, staged the way `ttnn.rms_norm` wants it: ROW_MAJOR,
    reshaped to [1, 1, dim/TILE, TILE]."""
    dim = int(weight.shape[-1])
    host = weight.detach().to(torch.float32).reshape(1, 1, dim // TILE, TILE).to(torch.bfloat16)
    mapper = _replicate_mapper(device)
    if mapper is not None:
        return ttnn.from_torch(
            host,
            dtype=ttnn.bfloat16,
            layout=ttnn.ROW_MAJOR_LAYOUT,
            device=device,
            mesh_mapper=mapper,
        )
    return ttnn.from_torch(host, dtype=ttnn.bfloat16, layout=ttnn.ROW_MAJOR_LAYOUT, device=device)


class TtRMSNorm:
    def __init__(self, device, weight, eps, compute_kernel_config=None):
        self.weight = weight
        self.eps = float(eps)
        self.compute_kernel_config = compute_kernel_config

    @classmethod
    def build(cls, device, torch_module, compute_kernel_config=None):
        eps = getattr(torch_module, "variance_epsilon", None)
        if eps is None:
            eps = getattr(torch_module, "eps", 1e-5)
        return cls(device, _stage_norm_weight(torch_module.weight, device), eps, compute_kernel_config)

    def __call__(self, x):
        return ttnn.rms_norm(
            x,
            epsilon=self.eps,
            weight=self.weight,
            compute_kernel_config=self.compute_kernel_config,
        )


class TtMLP:
    """SwiGLU: down(silu(gate(x)) * up(x))."""

    def __init__(self, device, weights, compute_kernel_config=None):
        self.w_gate, self.w_up, self.w_down = weights
        self.compute_kernel_config = compute_kernel_config

    @classmethod
    def build(cls, device, torch_module, compute_kernel_config=None):
        act = getattr(torch_module, "act_fn", None)
        act_name = type(act).__name__.lower() if act is not None else ""
        if "silu" not in act_name and "swish" not in act_name:
            raise RuntimeError(
                f"MLP activation is {act_name or '<unknown>'}, not SiLU; this port implements SwiGLU only"
            )
        weights = (
            _stage(torch_module.gate_proj.weight, device),
            _stage(torch_module.up_proj.weight, device),
            _stage(torch_module.down_proj.weight, device),
        )
        return cls(device, weights, compute_kernel_config)

    def __call__(self, x):
        mm = {"compute_kernel_config": self.compute_kernel_config} if self.compute_kernel_config else {}
        gate = ttnn.silu(ttnn.linear(x, self.w_gate, **mm))
        up = ttnn.linear(x, self.w_up, **mm)
        return ttnn.linear(ttnn.multiply(gate, up), self.w_down, **mm)


class TtDecoderLayer:
    def __init__(self, attn, mlp, input_norm, post_attn_norm):
        self.attn = attn
        self.mlp = mlp
        self.input_norm = input_norm
        self.post_attn_norm = post_attn_norm

    @classmethod
    def build(cls, device, torch_module):
        if torch_module is None:
            raise RuntimeError("decoder_layer build needs the HF MistralDecoderLayer to read weights from")
        try:
            hifi2 = ttnn.init_device_compute_kernel_config(
                device.arch(),
                math_fidelity=ttnn.MathFidelity.HiFi2,
                math_approx_mode=False,
                fp32_dest_acc_en=True,
                packer_l1_acc=True,
            )
        except Exception:  # noqa: BLE001 - accuracy tuning is best-effort
            hifi2 = None
        attn = TtAttention.build(device, torch_module.self_attn)
        mlp = TtMLP.build(device, torch_module.mlp, compute_kernel_config=attn.compute_kernel_config)
        return cls(
            attn,
            mlp,
            TtRMSNorm.build(device, torch_module.input_layernorm, compute_kernel_config=hifi2),
            TtRMSNorm.build(device, torch_module.post_attention_layernorm, compute_kernel_config=hifi2),
        )

    def __call__(self, hidden_states, attention_mask=None, position_embeddings=None, **_ignored):
        attn_out = self.attn(
            self.input_norm(hidden_states),
            position_embeddings=position_embeddings,
            attention_mask=attention_mask,
        )
        hidden_states = ttnn.add(hidden_states, attn_out)
        mlp_out = self.mlp(self.post_attn_norm(hidden_states))
        return ttnn.add(hidden_states, mlp_out)


# Module-level `build` — primary test entry point.
def build(device, torch_module=None):
    return TtDecoderLayer.build(device, torch_module)


# Legacy slug-named shim.
def decoder_layer(device, torch_module=None):
    return TtDecoderLayer.build(device, torch_module)

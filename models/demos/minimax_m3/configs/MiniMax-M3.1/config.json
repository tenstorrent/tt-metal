  "swiglu_alpha": 1.702,
  "swiglu_limit": 7.0,
  "intermediate_size": 3072,
  "dense_intermediate_size": 12288,
  "shared_intermediate_size": 3072,
  "num_local_experts": 128,
  "num_experts_per_tok": 4,
  "n_shared_experts": 1,
  "scoring_func": "sigmoid",
  "use_routing_bias": true,

mesh_graph_desc_path: @PKG_DIR@/quad_bh_galaxy_16stage_2x4_z_chain.textproto

global_env:
  PREFILL_FABRIC_MODE: "2d"
  PREFILL_SP: "2"
  PREFILL_TP: "4"
  PREFILL_NUM_LAYERS: "60"
  PREFILL_MAX_SEQ_LEN: "@MAX_SEQ_LEN@"
  PREFILL_H2D_SERVICE_ID: "ds_prefill"
  PREFILL_PP_D2D_FIFO_BYTES: "32768"
  LOGURU_LEVEL: "INFO"
  PREFILL_MANIFEST: "@MANIFEST@"
  TT_CACHE_PATH: "@TT_CACHE_PATH@"

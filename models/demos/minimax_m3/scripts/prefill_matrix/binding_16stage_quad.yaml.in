  - {rank: 10, mesh_id: 10, mesh_host_rank: 0, env_overrides: {TT_VISIBLE_DEVICES: "16,17,18,19,20,21,22,23"}}
  - {rank: 11, mesh_id: 11, mesh_host_rank: 0, env_overrides: {TT_VISIBLE_DEVICES: "8,9,10,11,12,13,14,15"}}

# Keep raw diagnostics local; commit compact summaries and report tables.
*.pt
*.refpt
*.tensorbin
**/raw/
**/__pycache__/

# Native per-op dumps stay local; compact derived tables are retained.
tracy/*/ops.csv

# Large historical dumps and generated corpus expansions remain local.
tracy/expert_candidate/decode_perf_report.csv
actual_text_long/actual_text_tokens.json
actual_text_long/actual_text_source.txt
stress_comparison_layer0.json
stress_comparison_layer5.json

# Pytest scratch directories and convenience symlinks are not evidence.
pytest*_tmp/


+def _is_falcon3_7b_base(model_config) -> bool:
+    """Recognize the supported Falcon3 checkpoint and its autoport alias."""
+    hf_config = model_config.hf_config
+    candidates = (
+        getattr(model_config, "model", ""),
+        getattr(hf_config, "name_or_path", ""),
+        getattr(hf_config, "_name_or_path", ""),
+    )
+    normalized = [str(value).lower().replace("-", "_") for value in candidates]
+    return any("falcon3_7b_base" in value for value in normalized)
+
+
 def register_tt_models(register_test_models=False) -> None:
     from vllm.model_executor.models.registry import ModelRegistry
 
@@ -374,6 +386,13 @@ def register_tt_models(register_test_models=False) -> None:
     # Llama3.1/3.2 - Text
     _register_model_if_missing(ModelRegistry, "TTLlamaForCausalLM", path_llama_text)
 
+    # Falcon3 publishes the generic HF LlamaForCausalLM architecture even
+    # though its TT implementation has a distinct TP4/cache/sampling contract.
+    _register_model_if_missing(
+        ModelRegistry,
+        "TTFalcon3ForCausalLM",
+        "models.autoports.tiiuae_falcon3_7b_base.tt.generator_vllm:Falcon3ForCausalLM",
+    )
     # Llama3.2 - Vision
     _register_model_if_missing(
         ModelRegistry,
@@ -630,6 +649,8 @@ class TTPlatform(Platform):
         # For TT models, prepend "TT" to the architecture name,
         # e.g. "TTLlamaForCausalLM"
         arch_names = vllm_config.model_config.hf_config.architectures
+        if _is_falcon3_7b_base(vllm_config.model_config):
+            arch_names[:] = ["TTFalcon3ForCausalLM"]
         for i in range(len(arch_names)):
             if not arch_names[i].startswith("TT"):
                 arch_names[i] = "TT" + arch_names[i]
diff --git a/plugins/vllm-tt-plugin/tests/test_platform_falcon3.py b/plugins/vllm-tt-plugin/tests/test_platform_falcon3.py
new file mode 100644
index 000000000..ba38e030f
--- /dev/null
+++ b/plugins/vllm-tt-plugin/tests/test_platform_falcon3.py
@@ -0,0 +1,24 @@
+from types import SimpleNamespace
+
+from vllm_tt_plugin.platform import _is_falcon3_7b_base
+
+
+def _model_config(model, *, hf_name=""):
+    return SimpleNamespace(
+        model=model,
+        hf_config=SimpleNamespace(name_or_path=hf_name, _name_or_path=hf_name),
+    )
+
+
+def test_falcon3_official_id_selects_dedicated_tt_architecture():
+    assert _is_falcon3_7b_base(_model_config("tiiuae/Falcon3-7B-Base"))
+
+
+def test_falcon3_hf_snapshot_and_autoport_alias_are_recognized():
+    snapshot = "/cache/models--tiiuae--Falcon3-7B-Base/snapshots/deadbeef"
+    assert _is_falcon3_7b_base(_model_config(snapshot))
+    assert _is_falcon3_7b_base(_model_config("tiiuae_falcon3_7b_base"))
+
+
+def test_generic_llama_does_not_select_falcon3_adapter():
+    assert not _is_falcon3_7b_base(_model_config("meta-llama/Llama-3.1-8B"))

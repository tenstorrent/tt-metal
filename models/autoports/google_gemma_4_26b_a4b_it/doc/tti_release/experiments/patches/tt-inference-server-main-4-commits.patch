+# SPDX-License-Identifier: Apache-2.0
+#
+# SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+
+from types import SimpleNamespace
+
+import pytest
+
+from llm_module.runner import RunnerResult
+from test_module.context import MediaContext
+from test_module.llm_tests import llm_performance_tests as performance
+
+
+def _context(*, server_url, service_port, remote_server, disable_trace_capture=False):
+    return MediaContext(
+        all_params=[],
+        model_spec=SimpleNamespace(hf_model_repo="custom/model"),
+        device=SimpleNamespace(name="P300X2"),
+        output_path="/tmp/llm-performance-test",
+        service_port=service_port,
+        runtime_config=SimpleNamespace(
+            disable_trace_capture=disable_trace_capture,
+        ),
+        server_url=server_url,
+        remote_server=remote_server,
+    )
+
+
+def _run_and_capture(monkeypatch, ctx):
+    captured = {}
+
+    class FakeRemoteController:
+        def __init__(self, **kwargs):
+            captured["remote_controller"] = kwargs
+
+    class FakeHttpController:
+        def __init__(self, **kwargs):
+            captured["http_controller"] = kwargs
+
+    class FakeRunner:
+        def __init__(self, *, driver, server_controller):
+            captured["server_controller"] = server_controller
+
+        def run(self, configs, server, context, **kwargs):
+            captured["server"] = server
+            captured["runner_kwargs"] = kwargs
+            return RunnerResult()
+
+    monkeypatch.setattr(performance, "RemoteOpenAIController", FakeRemoteController)
+    monkeypatch.setattr(performance, "HttpServerController", FakeHttpController)
+    monkeypatch.setattr(performance, "LLMPerformanceRunner", FakeRunner)
+    monkeypatch.setattr(performance, "accept_blocks", lambda *args, **kwargs: None)
+
+    performance.run_llm_performance(
+        ctx,
+        driver=object(),
+        configs=[SimpleNamespace(isl=8, osl=8)],
+    )
+    return captured
+
+
+def test_remote_host_only_url_includes_service_port(monkeypatch):
+    captured = _run_and_capture(
+        monkeypatch,
+        _context(
+            server_url="http://127.0.0.1",
+            service_port=8123,
+            remote_server=True,
+        ),
+    )
+
+    assert captured["server"].base_url == "http://127.0.0.1:8123"
+    assert captured["server"].url_with_port == "http://127.0.0.1:8123"
+    assert captured["remote_controller"]["base_url"] == "http://127.0.0.1:8123"
+
+
+def test_remote_explicit_port_wins_over_service_port(monkeypatch):
+    captured = _run_and_capture(
+        monkeypatch,
+        _context(
+            server_url="http://127.0.0.1:9000",
+            service_port=8123,
+            remote_server=True,
+        ),
+    )
+
+    assert captured["server"].url_with_port == "http://127.0.0.1:9000"
+    assert captured["remote_controller"]["base_url"] == "http://127.0.0.1:9000"
+
+
+def test_local_connection_preserves_split_host_and_port(monkeypatch):
+    captured = _run_and_capture(
+        monkeypatch,
+        _context(server_url=None, service_port=8123, remote_server=False),
+    )
+
+    assert captured["server"].base_url == "http://127.0.0.1"
+    assert captured["server"].service_port == 8123
+    assert captured["server"].url_with_port == "http://127.0.0.1:8123"
+    assert captured["http_controller"]["base_url"] == "http://127.0.0.1"
+    assert captured["http_controller"]["service_port"] == 8123
+
+
+@pytest.mark.parametrize("disabled", [False, True])
+def test_disable_trace_capture_propagates_to_runner(monkeypatch, disabled):
+    captured = _run_and_capture(
+        monkeypatch,
+        _context(
+            server_url="http://127.0.0.1",
+            service_port=8123,
+            remote_server=True,
+            disable_trace_capture=disabled,
+        ),
+    )
+
+    assert captured["runner_kwargs"]["skip_trace_capture"] is disabled

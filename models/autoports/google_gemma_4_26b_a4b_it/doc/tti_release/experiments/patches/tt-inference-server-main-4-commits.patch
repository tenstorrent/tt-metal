+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+
+from types import SimpleNamespace
+
+from llm_module.eval_command import build_eval_command
+from reference_config.evals.eval_config import EvalTask
+
+
+def _model_spec(max_context):
+    return SimpleNamespace(
+        hf_model_repo="org/model",
+        model_id="model-id",
+        device_model_spec=SimpleNamespace(
+            max_context=max_context,
+            max_concurrency=32,
+            eval_max_retries=None,
+        ),
+    )
+
+
+def _model_args(command):
+    return command[command.index("--model_args") + 1]
+
+
+def test_local_completions_uses_device_spec_max_context():
+    command = build_eval_command(
+        EvalTask(task_name="ifeval", apply_chat_template=False),
+        _model_spec(32768),
+        "p300x2",
+        "/tmp/evals",
+        8000,
+    )
+
+    assert "max_length=32768" in _model_args(command).split(",")
+
+
+def test_device_spec_overrides_legacy_task_max_length_without_mutation():
+    task = EvalTask(
+        task_name="ifeval",
+        apply_chat_template=False,
+        model_kwargs={"max_length": "2048", "add_bos_token": "True"},
+    )
+
+    command = build_eval_command(
+        task, _model_spec(32768), "p300x2", "/tmp/evals", 8000
+    )
+    model_args = _model_args(command).split(",")
+
+    assert "max_length=32768" in model_args
+    assert "max_length=2048" not in model_args
+    assert "add_bos_token=True" in model_args
+    assert task.model_kwargs["max_length"] == "2048"
+
+
+def test_legacy_task_max_length_is_retained_when_spec_has_none():
+    command = build_eval_command(
+        EvalTask(
+            task_name="ifeval",
+            apply_chat_template=False,
+            model_kwargs={"max_length": "4096"},
+        ),
+        _model_spec(None),
+        "p300x2",
+        "/tmp/evals",
+        8000,
+    )
+
+    assert "max_length=4096" in _model_args(command).split(",")

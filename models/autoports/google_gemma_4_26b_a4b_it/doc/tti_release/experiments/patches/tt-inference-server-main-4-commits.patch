+# SPDX-License-Identifier: Apache-2.0
+#
+# SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+
+from __future__ import annotations
+
+import json
+from unittest.mock import patch
+
+import pytest
+
+import run_workflows
+from workflow_module import command_factory
+from workflows.model_spec import MODEL_SPECS
+from workflows.runtime_config import RuntimeConfig
+
+
+def _write_combined_custom_spec(tmp_path, *, runtime_model=None, runtime_device=None):
+    model_spec = next(iter(MODEL_SPECS.values())).get_serialized_dict()
+    model_spec["model_id"] = "id_custom_Custom-Base-Model_custom-device"
+    model_spec["model_name"] = "Custom-Base-Model-Not-In-Catalog"
+    model_spec["impl"] = {
+        "impl_id": "custom_autoport",
+        "impl_name": "custom-autoport",
+        "repo_url": "https://example.invalid/custom",
+        "code_path": "models/autoports/custom_base_model",
+    }
+    device = model_spec["device_type"].lower()
+    runtime_config = RuntimeConfig(
+        model=runtime_model or model_spec["model_name"],
+        workflow="benchmarks",
+        device=runtime_device or device,
+        impl="custom-autoport",
+        engine=model_spec["inference_engine"],
+        server_url="http://127.0.0.1",
+    ).to_dict()
+    path = tmp_path / "combined_runtime_spec.json"
+    path.write_text(
+        json.dumps(
+            {
+                "runtime_model_spec": model_spec,
+                "runtime_config": runtime_config,
+            }
+        ),
+        encoding="utf-8",
+    )
+    return path, model_spec, runtime_config
+
+
+def _argv(spec_path, model="Custom-Base-Model-Not-In-Catalog", device=None):
+    if device is None:
+        data = json.loads(spec_path.read_text(encoding="utf-8"))
+        device = data["runtime_model_spec"]["device_type"].lower()
+    return [
+        "run_workflows.py",
+        "--model",
+        model,
+        "--workflow",
+        "benchmarks",
+        "--device",
+        device,
+        "--runtime-model-spec-json",
+        str(spec_path),
+    ]
+
+
+def test_custom_runtime_spec_bypasses_catalog_and_preserves_autoport(tmp_path):
+    spec_path, model_spec, _ = _write_combined_custom_spec(tmp_path)
+    with patch("sys.argv", _argv(spec_path)):
+        args = run_workflows.parse_args()
+
+    with patch.object(command_factory, "get_runtime_model_spec") as catalog_lookup:
+        context = command_factory._build_context(args)
+
+    catalog_lookup.assert_not_called()
+    assert context.model_spec.model_name == model_spec["model_name"]
+    assert context.model_spec.impl.code_path == "models/autoports/custom_base_model"
+    assert context.runtime_config.model == model_spec["model_name"]
+
+
+def test_non_catalog_model_without_runtime_spec_is_rejected(capsys):
+    argv = [
+        "run_workflows.py",
+        "--model",
+        "Custom-Base-Model-Not-In-Catalog",
+        "--workflow",
+        "benchmarks",
+        "--device",
+        "p300x2",
+    ]
+    with patch("sys.argv", argv), pytest.raises(SystemExit) as exc_info:
+        run_workflows.parse_args()
+
+    assert exc_info.value.code == 2
+    assert "argument --model: invalid choice" in capsys.readouterr().err
+
+
+@pytest.mark.parametrize("kind", ["missing", "malformed"])
+def test_invalid_runtime_spec_errors_without_catalog_fallback(tmp_path, capsys, kind):
+    spec_path = tmp_path / "runtime.json"
+    if kind == "malformed":
+        spec_path.write_text("{not-json", encoding="utf-8")
+
+    with patch("sys.argv", _argv(spec_path, device="p300x2")):
+        with pytest.raises(SystemExit) as exc_info:
+            run_workflows.parse_args()
+
+    assert exc_info.value.code == 2
+    assert "could not load --runtime-model-spec-json" in capsys.readouterr().err
+
+
+@pytest.mark.parametrize(

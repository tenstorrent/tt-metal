+def _assert_frequency_batch_controls(mixed, homogeneous, solo):
+    assert len(mixed) >= 2, "mixed penalty check requires both policies"
+    groups = {0.0: [], 2.0: []}
+    for index, response in enumerate(mixed):
+        penalty = 0.0 if index % 2 == 0 else 2.0
+        ids = response.choices[0].token_ids
+        assert ids, "every request must return generated token IDs"
+        assert ids == homogeneous[penalty][index].choices[0].token_ids, (
+            f"slot {index}: mixed and homogeneous penalty={penalty} differ"
+        )
+        assert ids == solo[penalty].choices[0].token_ids, (
+            f"slot {index}: mixed and solo penalty={penalty} differ"
+        )
+        groups[penalty].append(ids)
+    assert groups[0.0][0] != groups[2.0][0], (
+        "frequency penalty must change the generated token sequence"
+    )
+

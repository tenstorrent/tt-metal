diff --git a/tests/test_sampling_token_contract.py b/tests/test_sampling_token_contract.py
new file mode 100644
index 0000000..8ddbc2e
--- /dev/null
+++ b/tests/test_sampling_token_contract.py
@@ -0,0 +1,74 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+"""Token-level variety and per-policy penalty controls reject real failures."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from tests.tt.test_seeding_and_variety import _first_generated_token_ids
+from tests.tt.test_tt_penalties import _assert_frequency_batch_controls
+from tests.tt.utils import assert_pairwise_varied, assert_varied
+
+
+def response(ids, text=" a"):
+    return SimpleNamespace(choices=[SimpleNamespace(token_ids=ids, text=text)])
+
+
+def controls():
+    clean, penalized = response([10, 10, 10]), response([10, 11, 12])
+    return (
+        [clean, penalized, clean, penalized],
+        {0.0: [clean] * 4, 2.0: [penalized] * 4},
+        {0.0: clean, 2.0: penalized},
+    )
+
+
+def test_first_tokens_can_vary_with_the_same_first_character():
+    rows = [response([10], " A"), response([11], " B")]
+    with pytest.raises(AssertionError):
+        assert_varied([row.choices[0].text[:1] for row in rows], 2, "characters")
+    assert_varied(_first_generated_token_ids(rows), 2, "tokens")
+    with pytest.raises(AssertionError):
+        assert_varied(_first_generated_token_ids([rows[0], rows[0]]), 2, "tokens")
+
+
+def test_penalty_effect_does_not_require_a_character_count_change():
+    mixed, homogeneous, solo = controls()
+    assert mixed[0].choices[0].text.count("a") == mixed[1].choices[0].text.count("a")
+    _assert_frequency_batch_controls(mixed, homogeneous, solo)
+
+
+def test_mixed_slot_contamination_is_rejected():
+    mixed, homogeneous, solo = controls()
+    mixed[2] = response([99])
+    with pytest.raises(AssertionError, match="slot 2"):
+        _assert_frequency_batch_controls(mixed, homogeneous, solo)
+
+
+def test_missing_penalty_effect_is_rejected():
+    row = response([10, 10, 10])
+    with pytest.raises(AssertionError, match="must change"):
+        _assert_frequency_batch_controls(
+            [row] * 4, {0.0: [row] * 4, 2.0: [row] * 4}, {0.0: row, 2.0: row}
+        )
+
+
+def test_pairwise_first_tokens_preserve_threshold_with_shared_characters():
+    first = [response([10], "Random"), response([11], "Right")]
+    second = [response([12], "Red"), response([13], "Round")]
+    with pytest.raises(AssertionError):
+        assert_pairwise_varied(["R", "R"], ["R", "R"], 2, "characters")
+    assert_pairwise_varied(
+        _first_generated_token_ids(first),
+        _first_generated_token_ids(second),
+        2,
+        "tokens",
+    )
+    with pytest.raises(AssertionError):
+        assert_pairwise_varied(
+            _first_generated_token_ids(first),
+            _first_generated_token_ids([second[0], first[1]]),
+            2,
+            "tokens",
+        )

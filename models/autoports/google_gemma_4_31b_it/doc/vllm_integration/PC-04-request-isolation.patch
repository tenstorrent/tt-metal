+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+"""Stable route controls preserve original requests and still reject contamination."""
+
+from dataclasses import asdict
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from tests.tt import test_request_isolation as isolation
+
+
+def test_original_parameters_and_native_subset_are_preserved(monkeypatch):
+    captured = []
+
+    def batch(server, model, configs):
+        captured.append(configs)
+        return [config.prompt for config in configs]
+
+    monkeypatch.setattr(isolation, "run_concurrent_batch", batch)
+    suite = isolation.TestBatchIsolation()
+    suite.test_mixed_params_batch(None, "model", 32)
+    suite.test_mixed_params_batch_native(None, "model", 32)
+    original = isolation._mixed_parameter_configs()
+    assert len(original) == 10
+    for source, host in zip(original, captured[0]):
+        assert asdict(host) == asdict(source) | {"logit_bias": {0: 0.0}}
+    assert captured[2] == [original[i] for i in (0, 1, 4, 5, 6, 9)]
+    for first, shuffled in ((captured[0], captured[1]), (captured[2], captured[3])):
+        assert sorted(map(repr, first)) == sorted(map(repr, shuffled))
+
+
+def test_isolation_still_rejects_changed_response(monkeypatch):
+    calls = 0
+
+    def batch(server, model, configs):
+        nonlocal calls
+        calls += 1
+        return [config.prompt if calls == 1 else "contaminated" for config in configs]
+
+    monkeypatch.setattr(isolation, "run_concurrent_batch", batch)
+    with pytest.raises(AssertionError, match="deterministic/reproducible"):
+        isolation.TestBatchIsolation().test_mixed_params_batch(None, "model", 32)
+
+
+@pytest.mark.parametrize("num_devices", [1, 4, 8, 32])
+@pytest.mark.parametrize("is_decode", [False, True])
+def test_zero_bias_is_identity_and_forces_host_on_every_mesh(num_devices, is_decode):
+    from vllm.v1.sample.logits_processor.builtin import LogitBiasLogitsProcessor
+
+    from vllm_tt_plugin.input_batch import SamplingInputBatch
+    from vllm_tt_plugin.model_runner import TTModelRunner
+
+    proc = object.__new__(LogitBiasLogitsProcessor)
+    proc.biases = {0: {0: 0.0}}
+    proc.bias_tensor = torch.tensor([0.0])
+    proc.logits_slice = (torch.tensor([0]), torch.tensor([0]))
+    logits = torch.tensor([[1.25, -2.0, float("-inf")]])
+    assert torch.equal(proc.apply(logits.clone()), logits)
+    sampling = object.__new__(SamplingInputBatch)
+    sampling.logitsprocs = SimpleNamespace(all=[proc])
+    sampling.bad_words_token_ids = {}
+    assert sampling.has_active_logitsprocs()
+    runner = SimpleNamespace(
+        sample_on_device_mode="all",
+        seeded_sampling_policy="auto",
+        num_devices=num_devices,
+        tt_data_parallel_size=1,
+        model=SimpleNamespace(model_capabilities={}),
+        model_config=SimpleNamespace(logits_processors=[]),
+        input_batch=SimpleNamespace(
+            no_penalties=True,
+            no_allowed_token_ids=True,
+            max_num_logprobs=None,
+            sampling=sampling,
+        ),
+    )
+    assert not TTModelRunner.check_perform_device_sampling(runner, is_decode, False)
+    proc.biases.clear()
+    assert TTModelRunner.check_perform_device_sampling(runner, is_decode, False)

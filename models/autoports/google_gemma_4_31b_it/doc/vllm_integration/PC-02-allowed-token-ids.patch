diff --git a/tests/test_allowed_token_contract.py b/tests/test_allowed_token_contract.py
new file mode 100644
--- /dev/null
+++ b/tests/test_allowed_token_contract.py
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+"""Allowed-token checks must inspect tokens even when special text is hidden."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from tests.tt.test_host_only_params import _assert_allowed_token_response
+
+
+def response(ids, text="", count=None):
+    return SimpleNamespace(
+        choices=[SimpleNamespace(token_ids=ids, text=text)],
+        usage=SimpleNamespace(completion_tokens=len(ids) if count is None else count),
+    )
+
+
+def test_special_tokens_need_not_produce_visible_text():
+    result = response([1, 2, 3])
+    with pytest.raises(AssertionError):
+        assert len(result.choices[0].text) > 0
+    _assert_allowed_token_response(result, [1, 2, 3])
+
+
+def test_disallowed_tokens_fail_even_with_visible_text():
+    with pytest.raises(AssertionError, match="outside allowlist"):
+        _assert_allowed_token_response(response([4], text="visible"), [1, 2, 3])
+
+
+def test_missing_tokens_and_wrong_usage_fail():
+    with pytest.raises(AssertionError):
+        _assert_allowed_token_response(response([]), [1, 2, 3])
+    with pytest.raises(AssertionError):
+        _assert_allowed_token_response(response([1], count=2), [1, 2, 3])

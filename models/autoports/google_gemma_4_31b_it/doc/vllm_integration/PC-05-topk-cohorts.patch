+def _topk_first_token_plan(top_logprobs, sampled_rows):
+    """Fix two cohort sizes before draws, with a family error bound of 1e-6."""
+    assert sampled_rows > 0
+    assert all(key.startswith("token_id:") for key in top_logprobs)
+    ranked = sorted(
+        ((int(key.split(":", 1)[1]), value) for key, value in top_logprobs.items()),
+        key=lambda item: item[1],
+        reverse=True,
+    )
+    assert len(ranked) >= 20, "Need top20 reference to resolve top10 cutoff ties"
+    cutoff = ranked[9][1]
+    assert math.isfinite(cutoff) and ranked[19][1] < cutoff, (
+        "Top10 support cannot be resolved within top20 reference"
+    )
+    support = {token for token, value in ranked if value >= cutoff}
+    weights = [math.exp((value - ranked[0][1]) / 2.0) for _, value in ranked[:10]]
+    pmax = 1.0 / sum(weights)
+    assert 0 < pmax < 1, "Reference is too concentrated to calibrate diversity"
+    # sum(p_i**N) <= pmax**(N-1). Pair match probability sum(p_i**2)
+    # is at most pmax. Union-bound two constant cohorts and <2 mismatches.
+    for waves in range(1, 1024 // sampled_rows + 1):
+        count = waves * sampled_rows
+        bound = (
+            2 * pmax ** (count - 1)
+            + pmax**count
+            + count * (1 - pmax) * pmax ** (count - 1)
+        )
+        if count >= 2 and bound <= 1e-6 / 3:
+            return dict(
+                support=support,
+                waves=waves,
+                count=count,
+                pmax=pmax,
+                failure_bound=bound,
+            )
+    raise AssertionError(
+        "Cannot calibrate first-token diversity within 1024 draws per cohort"
+    )
+
+
+def _assert_topk_first_token_cohorts(cohorts, support):
+    assert len(cohorts) == 2 and len(cohorts[0]) == len(cohorts[1])
+    for ids in cohorts:
+        assert ids and set(ids) <= support, "Sampled first token outside top10 support"
+        assert_varied(ids, 2, "Calibrated top-k cohort must contain two first tokens")
+    assert_pairwise_varied(
+        cohorts[0],
+        cohorts[1],
+        2,
+        "Calibrated top-k cohorts must differ at two positions",
+    )
 
 

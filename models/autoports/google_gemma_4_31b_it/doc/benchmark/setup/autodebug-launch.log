    64	    @classmethod
    65	    def get_max_tokens_all_users(cls, *, max_model_len, max_num_seqs=1, **kwargs):
    66	        # The pinned worker divides this synthetic budget by 32, while
    67	        # hybrid normalization gives global attention 64-token blocks.
    68	        # Its separate eight-window allowance covers the five live sliding groups.
    69	        # Cached tails from completed turns share the same LRU pool as global
    70	        # prefixes. Reserve one prior 24K-turn equivalent so growing 32K
    71	        # conversations can retain prefixes while allocating their next turn.
    72	        # Keep the single-request floor conservative; this is a cache budget,
    73	        # not the advertised context or a scheduler token limit.
    74	        target_tokens_per_user = 32768
    75	        prior_turn_tokens_per_user = 24576
    76	        worker_block_size, global_block_size = 32, 64
    77	        global_blocks = max_num_seqs * math.ceil(
    78	            (target_tokens_per_user + prior_turn_tokens_per_user) / global_block_size
    79	        )
    80	        budget = max(max_model_len, worker_block_size * global_blocks)
    81	        print(
    82	            json.dumps(
    83	                {
    84	                    "event": "serving_pool_budget",
    85	                    "synthetic_token_budget": budget,
    86	                    "target_tokens_per_user": target_tokens_per_user,
    87	                    "prior_turn_reserve_tokens_per_user": prior_turn_tokens_per_user,
    88	                    "global_block_size": global_block_size,
    89	                    "max_model_len": max_model_len,
    90	                    "max_num_seqs": max_num_seqs,
    91	                    "basis": "normalized hybrid blocks plus prior-turn APC reserve; worker adds live sliding/output reserves",
    92	                }
    93	            ),
    94	            flush=True,
    95	        )
    96	        return budget

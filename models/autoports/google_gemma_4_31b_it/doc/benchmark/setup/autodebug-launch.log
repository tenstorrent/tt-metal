   515	    def refresh_page_tables(self, host_page_tables, *, revision):
   516	        """Refresh fixed bindings only on an explicit scheduler mapping change."""
   517	        if revision == self.page_revision:
   518	            return
   519	        self._validate_page_maps(host_page_tables)
   520	        for host, target in zip(host_page_tables, self.page_table):
   521	            if tuple(host.shape) != tuple(target.shape):
   522	                raise ValueError("Page-table capacity is fixed for the trace lifetime")
   523	        for host, target in zip(host_page_tables, self.page_table):
   524	            self._copy(host.to(torch.int32), target)
   525	            self.counters["page_refreshes"] += 1
   526	        self.prefill.host_pages = [p.clone() for p in host_page_tables]
   527	        self.page_revision = revision

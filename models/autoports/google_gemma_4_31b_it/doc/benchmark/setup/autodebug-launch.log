   475	    def _reserve_requests(self, lengths, generated):
   476	        if not self.owns_cache:
   477	            return
   478	        counts = [((n + generated + 127) // 128) * 4 if n else 0 for n in lengths]
   479	        if sum(counts) > self.model.pool_blocks:
   480	            raise ValueError(f"Requests need {sum(counts)*32} pooled tokens; capacity is {self.model.pool_blocks*32}")
   481	        tables = []
   482	        for layer, old in zip(self.model.layers, self.prefill.host_pages):
   483	            if layer.sliding_window:
   484	                tables.append(old)
   485	                continue
   486	            table = torch.empty_like(old)
   487	            offset = 0
   488	            for slot, count in enumerate(counts):
   489	                table[slot] = offset if count else 0
   490	                table[slot, :count] = torch.arange(offset, offset + count, dtype=torch.int32)
   491	                offset += count
   492	            tables.append(table)
   493	        revision = tuple(counts)
   494	        self.refresh_page_tables(tables, revision=revision)

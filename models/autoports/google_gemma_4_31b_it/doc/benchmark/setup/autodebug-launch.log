   174	    @staticmethod
   175	    def _physical_pages(source, factor, context):
   176	        """Translate scheduler blocks to the decoder's 32-token tile pages."""
   177	        if factor < 1:
   178	            raise ValueError("Scheduler blocks must contain at least one tile page")
   179	        columns = (context + 32 * factor - 1) // (32 * factor)
   180	        if bool((source[:, columns:] != 0).any()):
   181	            raise ValueError("Scheduler columns beyond context must be zero padding")
   182	        source = source[:, :columns].to(torch.int32)
   183	        offsets = torch.arange(factor, dtype=torch.int32)
   184	        return (source.unsqueeze(-1) * factor + offsets).flatten(1)[:, : (context + 31) // 32]

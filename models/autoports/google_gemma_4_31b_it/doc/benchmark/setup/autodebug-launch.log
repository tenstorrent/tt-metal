   186	    def _pages(self, page_table, page_tables_per_layer, kv_cache):
   187	        if kv_cache is not self.kv_cache:
   188	            raise ValueError("vLLM must pass the allocator's exact cache object")
   189	        maps = []
   190	        for index, target, factor in zip(self.model.layer_indices, self.generator.page_table, self.cache_page_factors):
   191	            source = page_table if page_tables_per_layer is None else page_tables_per_layer[index]
   192	            source = self._physical_pages(source, factor, self.context)
   193	            host = torch.zeros(tuple(target.shape), dtype=torch.int32)
   194	            if source.shape[1] > host.shape[1] or source.shape[0] > host.shape[0]:
   195	                raise ValueError("Scheduler page table exceeds prepared capacity")
   196	            host[: source.shape[0], : source.shape[1]] = source.to(torch.int32)
   197	            maps.append(host)

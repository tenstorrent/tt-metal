   440	    def set_sampling(self, *, temperature=0.0, top_k=1, top_p=1.0, seed=0, reset_seed=True):
   441	        def per_slot(value, name):
   442	            values = list(value) if isinstance(value, (list, tuple)) else [value] * self.batch
   443	            if len(values) != self.batch:
   444	                raise ValueError(f"{name} requires a scalar or one value per configured slot")
   445	            return values
   446
   447	        temperatures = per_slot(temperature, "temperature")
   448	        ks, ps = per_slot(top_k, "top_k"), per_slot(top_p, "top_p")
   449	        for temp, k, p in zip(temperatures, ks, ps):
   450	            if not isinstance(temp, Real) or not math.isfinite(temp) or temp < 0:
   451	                raise ValueError("Temperature must be finite and nonnegative")
   452	            if not isinstance(p, Real) or not math.isfinite(p) or not 0 <= p <= 1:
   453	                raise ValueError("top_p must be within [0, 1]")
   454	            if not isinstance(k, Integral) or (temp > 0 and not 1 <= k <= 32):
   455	                raise ValueError("Common device sampling supports stochastic top_k in [1, 32]")
   456	        if isinstance(seed, (list, tuple)):
   457	            if len(seed) != self.batch or any(
   458	                not isinstance(value, Integral) or not 0 <= value < 2**32 for value in seed
   459	            ):
   460	                raise ValueError("Seed list must contain one uint32 seed per slot")
   461	            seeds = torch.zeros(32, dtype=torch.uint32)
   462	            seeds[: self.batch] = torch.tensor(seed, dtype=torch.uint32)
   463	        else:
   464	            if not isinstance(seed, Integral) or not 0 <= seed <= 2**31 - 33:
   465	                raise ValueError("Seed must leave room for the 32 signed per-slot seeds")
   466	            seeds = (torch.arange(32, dtype=torch.int64) + int(seed)).to(torch.uint32)
   467	        # The common formatter treats scalar temperature as one active lane.
   468	        # Describe all configured slots explicitly, then let it pad unused lanes.
   469	        params = format_sampling_params(SamplingParams(temperature=temperatures, top_k=ks, top_p=ps), 32)
   470	        self.sampler.reset_params(params.top_k, params.top_p, params.temperature)
   471	        if reset_seed:
   472	            self.seed_values = seeds
   473	            self._copy(self.seed_values, self.sampler.seeds_tt_tensor)

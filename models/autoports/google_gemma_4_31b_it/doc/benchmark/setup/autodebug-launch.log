   496	    def _validate_page_maps(self, maps):
   497	        if len(self.kv_cache) != len(self.model.layers) or len(self.page_table) != len(self.model.layers):
   498	            raise ValueError("Cache and device tables must cover every decoder layer")
   499	        if len(maps) != len(self.model.layers):
   500	            raise ValueError("One page ownership map is required per layer")
   501	        for layer, host, cache, page in zip(self.model.layers, maps, self.kv_cache, self.page_table):
   502	            if len(cache) != 2 or any(
   503	                tuple(t.shape)[1:] != (layer.nkv, 32, layer.head_dim) or t.dtype != layer.cache_dtype for t in cache
   504	            ):
   505	                raise ValueError("External cache must preserve the decoder paged shape and dtype")
   506	            if tuple(cache[0].shape) != tuple(cache[1].shape) or tuple(page.shape) != tuple(host.shape):
   507	                raise ValueError("External K/V capacities and ownership-map shapes must agree")
   508	            if page.dtype != ttnn.int32 or page.layout != ttnn.ROW_MAJOR_LAYOUT:
   509	                raise ValueError("Page tables require signed int32 row-major storage")
   510	            if host.ndim != 2 or host.shape[0] != self.batch:
   511	                raise ValueError("Page ownership maps must contain every configured slot")
   512	            if bool((host < 0).any()) or bool((host >= cache[0].shape[0]).any()):
   513	                raise ValueError("Page ownership map references a block outside its cache")

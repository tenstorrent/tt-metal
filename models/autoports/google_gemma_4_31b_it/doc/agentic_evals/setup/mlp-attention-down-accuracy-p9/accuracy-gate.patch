+def _assert_accuracy_trace_counters(result):
+    """Check teacher-forcing replay counts and ensure these checks capture no new traces."""
+    repeats = result.get("teacher_forcing_repeats", [])
+    assert len(repeats) == 3, "Accuracy run requires three AIME teacher-forcing repeats"
+    expected_decode_replays = sum(int(row["total"]) - 1 for trial in repeats for row in trial)
+    assert result["decode_counters"]["model_replays"] == expected_decode_replays, (
+        "AIME decode replay count differs from the teacher-forcing callback positions"
+    )
+    if "natural" in result:
+        assert len(result["natural"]) == 1, "Natural-text reference must be a single scored entry"
+        expected_natural_replays = sum(int(row["total"]) - 1 for row in result["natural"])
+        assert result["natural_counters"]["model_replays"] == expected_natural_replays, (
+            "Natural-text replay count differs from the teacher-forcing callback positions"
+        )
+    for phase in ("prefill", "decode", "natural"):
+        counters = result.get(phase + "_counters")
+        if counters is not None:
+            assert counters.get("captures", 0) == 0, f"Unexpected trace capture during {phase} accuracy check"
 

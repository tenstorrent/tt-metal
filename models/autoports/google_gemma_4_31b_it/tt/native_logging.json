{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "native_hex": {
      "()": "models.autoports.google_gemma_4_31b_it.tt.native_log_formatter.NativeHexFormatter"
    }
  },
  "handlers": {
    "async_handler": {
      "class": "utils.logging_utils.AsyncLogHandler",
      "level": "DEBUG",
      "filename": "ext://utils.logging_utils.LOG_PATH",
      "max_bytes": 104857600,
      "backup_count": 5
    },
    "native_hex": {
      "class": "models.autoports.google_gemma_4_31b_it.tt.native_log_formatter.NativeFramedHandler",
      "level": "INFO",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "vllm": {
      "handlers": [
        "async_handler"
      ],
      "level": "DEBUG",
      "propagate": false
    },
    "vllm.entrypoints.serve.utils.request_logger": {
      "handlers": [
        "native_hex"
      ],
      "level": "INFO",
      "propagate": false
    },
    "vllm.entrypoints.serve.middleware.log_response": {
      "handlers": [
        "native_hex"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}

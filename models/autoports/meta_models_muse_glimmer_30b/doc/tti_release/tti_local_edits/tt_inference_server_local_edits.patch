diff --git a/workflows/model_specs/prod/llm.yaml b/workflows/model_specs/prod/llm.yaml
index a65d88da7..acb32560b 100644
--- a/workflows/model_specs/prod/llm.yaml
+++ b/workflows/model_specs/prod/llm.yaml
@@ -1282,3 +1282,64 @@ templates:
     Qwen/Qwen3.6-27B:
       reasoning_parser_name: qwen3
       tool_call_parser_name: qwen3_coder
+# =============================================================================
+# LOCAL EDIT -- not part of the automated release process.
+#
+# Added by the tt-metal model-bringup TTI release stage for the generated
+# autoport of meta-models/Muse-Glimmer-30B
+# (models/autoports/meta_models_muse_glimmer_30b).  It is here, rather than
+# supplied purely through --runtime-model-spec-json, because EVAL_CONFIGS at
+# the bottom of reference_config/evals/eval_config.py is built by iterating
+# MODEL_SPECS: a runtime spec that the catalog has never heard of gets no eval
+# tasks at all.  The release run still passes --runtime-model-spec-json, and
+# that JSON is exported from this entry.
+#
+# `impl: muse_glimmer_30b_autoport` is the point of the whole entry: it pins
+# impl.code_path to the generated autoport rather than to stock
+# models/tt_transformers.
+# =============================================================================
+- weights:
+    - meta-models/Muse-Glimmer-30B
+  version: "0.20.0"
+  # The tt-metal commit under evaluation: the optimized-vLLM stage's HEAD on
+  # branch agentic-research/hous/muse-glimmer-30b.  Drives the report's
+  # code_link, which resolves to the autoport directory.
+  tt_metal_commit: "7db0eca"
+  impl: muse_glimmer_30b_autoport
+  inference_engine: VLLM
+  model_type: LLM
+  # The autoport implements the text stack only; the checkpoint's perception
+  # encoder is not ported, so no image benchmarks are generated.
+  supported_modalities:
+    - text
+  # FUNCTIONAL, not EXPERIMENTAL: at EXPERIMENTAL every performance tier AND
+  # eval accuracy are masked to informational, which would make this release
+  # report unable to fail.  FUNCTIONAL enforces eval accuracy and the
+  # functional (10%-of-roofline) performance tier, which is the bar this
+  # bring-up actually claims.
+  status: FUNCTIONAL
+  device_model_specs:
+    - device: P300X2  # QB2 (2x P300, 4-chip Blackhole ring)
+      max_concurrency: 32
+      # doc/context_contract.json: current_supported_context == the
+      # HF-advertised 131072, no capability reduction.
+      max_context: 131072
+      # The KV pool the autoport actually allocates, read off the running
+      # server: "52 layers x 2 x (16416, 1, 64, 128) BFLOAT8_B ... 1050624
+      # tokens across all users".  Without this the pool would be inferred as
+      # max_context, understating benchmark concurrency by 8x.
+      max_tokens_all_users_override: 1050624
+      default_impl: true
+      tensor_cache_timeout: 5400.0
+      env_vars:
+        MESH_DEVICE: "P300x2"
+      override_tt_config:
+        fabric_config: FABRIC_1D_RING
+        fabric_packet_payload_bytes: 8192
+        trace_region_size: 400000000
+        l1_small_size: 6144
+        trace_mode: decode_only
+        sample_on_device_mode: all
+      vllm_args:
+        block_size: "64"
+  has_builtin_warmup: true

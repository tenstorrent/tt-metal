diff --git a/tests/report_module/test_acceptance_criteria.py b/tests/report_module/test_acceptance_criteria.py
index 229a92ffe..0518bf70a 100644
--- a/tests/report_module/test_acceptance_criteria.py
+++ b/tests/report_module/test_acceptance_criteria.py
@@ -536,3 +536,85 @@ def test_build_acceptance_export_failure_defaults_model_status():
     assert export["acceptance_blockers"] == {"benchmarks:B": "bad"}
     assert export["acceptance_criteria_metadata"]["enforcement_result"] == "FAIL"
     assert export["acceptance_criteria_metadata"]["model_status"] == ""
+
+
+# --- Spec tests: SPEC_TESTS known_issues waivers --------------------------
+#
+# LOCAL EDIT (tt-metal model-bringup TTI release stage). The model catalog has
+# always been able to declare `workflow_type: SPEC_TESTS` waivers -- the
+# meta-llama/Llama-3.3-70B-Instruct P300X2 entry in
+# workflows/model_specs/prod/llm.yaml carries one for `test_penalties`, tracked
+# in #3888 -- but nothing consulted them: _check_spec_tests took no
+# known_issues and test_module.dispatch.run_spec_tests counted the block as a
+# hard failure regardless, so the declared waiver was a no-op and the workflow
+# could never return 0. These cover the plumbing that makes it behave like the
+# EVALS waivers above.
+
+
+def _spec_with_details(*rows) -> Block:
+    return Block(
+        kind="spec_tests",
+        title="T",
+        task_type="functional",
+        data={
+            "success": False,
+            "status": "fail",
+            "detailed_test_results": [
+                {"test_case": name, "status": status} for name, status in rows
+            ],
+        },
+    )
+
+
+_PENALTY_WAIVER = [
+    {"workflow_type": "SPEC_TESTS", "task_name": "test_penalties", "reason": "#3888"}
+]
+
+
+def test_spec_known_issue_waives_blocker_when_it_covers_every_failure():
+    schema = _spec_with_details(("test_penalties", "❌ FAILED"), ("test_stop", "✅ PASSED"))
+    accepted, blockers, cats = acceptance_criteria_check(
+        _schema(schema), _PENALTY_WAIVER
+    )
+    cat = {c.name: c for c in cats}[CATEGORY_SPEC_TESTS]
+    assert accepted is True and blockers == {}
+    assert cat.status == STATUS_PASS and cat.failed == 0
+    assert "#3888" in cat.waived["spec.spec_tests:T"]
+
+
+def test_spec_known_issue_does_not_waive_an_uncovered_failure():
+    # An unrelated regression in the same suite must still block, even though
+    # one of the two failing test cases is waived.
+    schema = _spec_with_details(
+        ("test_penalties", "❌ FAILED"), ("test_stop", "❌ FAILED")
+    )
+    accepted, blockers, _ = acceptance_criteria_check(_schema(schema), _PENALTY_WAIVER)
+    assert accepted is False and "spec.spec_tests:T" in blockers
+
+
+def test_spec_known_issue_wrong_workflow_still_blocks():
+    schema = _spec_with_details(("test_penalties", "❌ FAILED"))
+    known_issues = [
+        {"workflow_type": "EVALS", "task_name": "test_penalties", "reason": "x"}
+    ]
+    accepted, blockers, _ = acceptance_criteria_check(_schema(schema), known_issues)
+    assert accepted is False and "spec.spec_tests:T" in blockers
+
+
+def test_spec_blanket_waiver_covers_a_block_with_no_sub_test_detail():
+    # task_name: null waives the whole SPEC_TESTS workflow; it is also the only
+    # thing that can waive a crashed suite that reported no detailed results.
+    schema = _schema(_spec("error", error={"type": "AttributeError", "message": "x"}))
+    known_issues = [
+        {"workflow_type": "SPEC_TESTS", "task_name": None, "reason": "suite broken"}
+    ]
+    accepted, blockers, cats = acceptance_criteria_check(schema, known_issues)
+    cat = {c.name: c for c in cats}[CATEGORY_SPEC_TESTS]
+    assert accepted is True and blockers == {}
+    assert "suite broken" in cat.waived["spec.spec_tests:T"]
+
+
+def test_spec_failure_without_known_issues_still_blocks():
+    schema = _spec_with_details(("test_penalties", "❌ FAILED"))
+    accepted, blockers, _ = acceptance_criteria_check(_schema(schema))
+    assert accepted is False and "spec.spec_tests:T" in blockers

+def spec_test_known_issue_waiver(
+    block: Block, known_issues: Optional[Iterable[Any]]
+) -> Optional[str]:
+    """Reason for waiving a *failing* spec-test block, or ``None``.
+
+    ``workflows/model_specs/prod/llm.yaml`` already declares SPEC_TESTS
+    waivers (e.g. the ``task_name: test_penalties`` entry on the
+    ``meta-llama/Llama-3.3-70B-Instruct`` P300X2 spec, tracked in #3888), but
+    nothing consulted them: :func:`_check_spec_tests` took no ``known_issues``
+    and ``test_module.dispatch.run_spec_tests`` counted the block as a hard
+    failure, so a declared SPEC_TESTS waiver was a no-op. This is the shared
+    predicate both now use.
+
+    The catalog spells these waivers at *pytest test-case* granularity, so a
+    block is waived only when every failing sub-test it reports is covered by a
+    declared waiver — an unrelated regression in the same suite still blocks. A
+    waiver with ``task_name: null`` matches the whole SPEC_TESTS workflow and
+    waives the block outright, which is also the only thing that can waive a
+    block that reports no per-sub-test detail (e.g. a crashed suite).
+    """
+    if not known_issues:
+        return None
+
+    blanket = _find_waiver(known_issues, "SPEC_TESTS", None)
+    data = block.data if isinstance(block.data, Mapping) else {}
+    rows = data.get("detailed_test_results")
+    if not isinstance(rows, list):
+        return blanket
+
+    failing: List[str] = []
+    for row in rows:
+        if not isinstance(row, Mapping):
+            continue
+        if "FAIL" not in str(row.get("status", "")).upper():
+            continue
+        name = str(row.get("test_case") or "").strip()
+        if name and name not in failing:
+            failing.append(name)
+
+    if not failing:
+        return blanket
+
+    reasons: List[str] = []
+    for name in failing:
+        reason = _find_waiver(known_issues, "SPEC_TESTS", name)
+        if reason is None:
+            return None
+        entry = f"{name}: {reason}"
+        if entry not in reasons:
+            reasons.append(entry)
+    return "; ".join(reasons)
+
+
 ACCEPTANCE_EXPORT_KEYS = (
     "acceptance_criteria",
     "acceptance_blockers",

{
  "schema_version": 1,
  "config_id": "c20-attn4-cclbfp8-kv4-sliding-only",
  "description": "c14 with the KV cache at BFP4 on the 39 sliding-window layers and BFP8 on the 13 full-attention layers. Separates the cache's capacity saving (per layer, so mostly in the 39) from its decode win (only in the 13) and from its accuracy cost.",
  "weights": {
    "attn_projections": {
      "dtype": "bfloat4_b",
      "roles": [
        "wqkv",
        "attn_gate",
        "o_proj"
      ]
    },
    "mlp_gate_up": {
      "dtype": "bfloat4_b",
      "roles": [
        "mlp_gate",
        "mlp_up"
      ]
    },
    "mlp_down": {
      "dtype": "bfloat4_b",
      "roles": [
        "mlp_down"
      ]
    },
    "lm_head": {
      "dtype": "bfloat4_b",
      "output_dtype": "bfloat16",
      "matmul": "dram_sharded",
      "cores": 52,
      "in0_block_w": 2
    },
    "embedding": {
      "dtype": "bfloat16",
      "note": "structural: ttnn.embedding needs a ROW_MAJOR BF16 table"
    },
    "norms": {
      "dtype": "bfloat16",
      "note": "structural: every RMSNorm weight is packed BF16"
    }
  },
  "layer_exceptions": [
    {
      "layers": [
        3,
        7,
        11,
        15,
        19,
        23,
        27,
        31,
        35,
        39,
        43,
        47,
        51
      ],
      "kv_cache_dtype": "bfloat8_b"
    }
  ],
  "compute_fidelity": {
    "decode": {
      "default": "LoFi",
      "by_role": {}
    },
    "prefill": {
      "default": "LoFi",
      "by_role": {}
    },
    "lm_head": {
      "fidelity": "LoFi",
      "fp32_dest_acc_en": false
    }
  },
  "activations": {
    "activation_dtype": "bfloat16",
    "residual_dtype": "bfloat16"
  },
  "ccl": {
    "prefill_dtype": "bfloat8_b",
    "decode_dtype": "bfloat8_b",
    "decode_dtype_note": "null means the collective carries the activation dtype"
  },
  "kv_cache": {
    "dtype": "bfloat4_b"
  },
  "decoder_overrides": {},
  "logits": {
    "lm_head_output_dtype": "bfloat16",
    "sampling_input_dtype": "bfloat16",
    "sampling_implementation": "models.common.sampling.SamplingGenerator"
  }
}

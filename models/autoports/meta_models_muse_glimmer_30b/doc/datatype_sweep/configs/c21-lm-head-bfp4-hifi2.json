{
  "schema_version": 1,
  "config_id": "c21-lm-head-bfp4-hifi2",
  "description": "The selected policy with the BFP4 LM head at HiFi2 instead of LoFi. The BFP4+HiFi2 arm for the LM-head weight group; c14 is its BFP4+LoFi arm.",
  "weights": {
    "attn_projections": {
      "dtype": "bfloat4_b",
      "roles": [
        "wqkv",
        "attn_gate",
        "o_proj"
      ]
    },
    "mlp_gate_up": {
      "dtype": "bfloat4_b",
      "roles": [
        "mlp_gate",
        "mlp_up"
      ]
    },
    "mlp_down": {
      "dtype": "bfloat4_b",
      "roles": [
        "mlp_down"
      ]
    },
    "lm_head": {
      "dtype": "bfloat4_b",
      "output_dtype": "bfloat16",
      "matmul": "dram_sharded",
      "cores": 52,
      "in0_block_w": 2
    },
    "embedding": {
      "dtype": "bfloat16",
      "note": "structural: ttnn.embedding needs a ROW_MAJOR BF16 table"
    },
    "norms": {
      "dtype": "bfloat16",
      "note": "structural: every RMSNorm weight is packed BF16"
    }
  },
  "layer_exceptions": [],
  "compute_fidelity": {
    "decode": {
      "default": "LoFi",
      "by_role": {}
    },
    "prefill": {
      "default": "LoFi",
      "by_role": {}
    },
    "lm_head": {
      "fidelity": "HiFi2",
      "fp32_dest_acc_en": false
    }
  },
  "activations": {
    "activation_dtype": "bfloat16",
    "residual_dtype": "bfloat16"
  },
  "ccl": {
    "prefill_dtype": "bfloat8_b",
    "decode_dtype": "bfloat8_b",
    "decode_dtype_note": "null means the collective carries the activation dtype"
  },
  "kv_cache": {
    "dtype": "bfloat8_b"
  },
  "decoder_overrides": {},
  "logits": {
    "lm_head_output_dtype": "bfloat16",
    "sampling_input_dtype": "bfloat16",
    "sampling_implementation": "models.common.sampling.SamplingGenerator"
  }
}

__pycache__/
*.pyc

# The repo-root .gitignore excludes *.log and *.csv globally; the functional
# decoder's evidence (test/profiler/watcher logs and tt-perf-report CSVs) is a
# required stage artifact and must be committed.
!doc/**/*.log
!doc/**/*.csv

# The vLLM stage's runner writes its evidence to readiness_vllm/ rather than doc/,
# so the root .gitignore's global *.log rule hides artifacts the stage README
# cites as proof. Un-ignore the small ones; server.log is deliberately NOT
# un-ignored because a single serving run produces ~81 MB of it. A filtered
# excerpt carrying the configuration and TT-side lines is committed instead, as
# doc/vllm_integration/logs/server_excerpt.log.
!readiness_vllm/sampling_tests.log
!readiness_vllm/vllm_benchmark.log
!readiness_vllm/vllm_ci_serving_benchmark.log

# The optimized-vLLM stage drives many server arms and each one leaves a raw
# server.log of 50-130 MB under doc/optimized_vllm/<arm>/server/. The `!doc/**/*.log`
# rule above would pull every one of them into git; ~400 MB of raw serving log is not
# stage evidence and cannot be cheaply removed from history later. Each arm commits
# <arm>/server_excerpt.log instead, which carries the configuration, the TT-side lines
# and the tail. Re-ignore the raw ones, after the un-ignore so this wins.
doc/optimized_vllm/*/server/server*.log

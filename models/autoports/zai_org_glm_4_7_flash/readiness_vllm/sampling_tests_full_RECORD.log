        seeds = max_batch_size // 3
        greedy_count = max_batch_size - seeds - seeds
        configs = []
        # Greedy requests
        for i in range(greedy_count):
            configs.append(RequestConfig(prompt=prompt, max_tokens=10, temperature=0))

        # Sampling requests with different seeds

            evidence["prefill_wall_s"] = round(wall, 1)
            evidence["prefill_tokens_per_s"] = round(S / wall, 1)
            print(f"[{kind}] full-context prefill S={S}: {wall:.0f}s ({S / wall:.0f} tok/s)")
            got = ttnn.to_torch(out).float()[0, 0]

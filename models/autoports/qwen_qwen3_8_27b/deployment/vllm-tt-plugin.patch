+def test_mamba_tables_cover_raw_model_indices_not_attention_ordinals():
+    specs = _specs()
+    full = [name for name, spec in specs.items() if isinstance(spec, FullAttentionSpec)]
+    linear = [name for name, spec in specs.items() if isinstance(spec, MambaSpec)]
+    groups = [KVCacheGroupSpec(full, specs[full[0]])]
+    groups.extend(
+        KVCacheGroupSpec(linear[start : start + 16], specs[linear[0]])
+        for start in range(0, 48, 16)
+    )
+    config = KVCacheConfig(num_blocks=289, kv_cache_tensors=[], kv_cache_groups=groups)
+    runner = SimpleNamespace(
+        tt_max_batch_size=2,
+        _is_lane_mode=False,
+        vocab_size=32,
+        _host_logitsprocs=None,
+        _is_block_output_model=False,
+        _output_tokens_per_step=1,
+        parallel_config=object(),
+        cache_config=SimpleNamespace(block_size=4096),
+        scheduler_config=SimpleNamespace(max_num_batched_tokens=4096),
+        model_config=SimpleNamespace(
+            max_model_len=262144,
+            get_num_layers=lambda _: 64,
+            get_num_layers_by_block_type=lambda *_: 16,
+        ),
+        _validate_kv_cache_groups=TTModelRunner._validate_kv_cache_groups,
+        _allocate_kv_caches=lambda config: object(),
+    )
+    with patch("vllm_tt_plugin.model_runner.InputBatch", return_value=object()):
+        TTModelRunner.initialize_kv_cache(runner, config)
+    tables = [torch.full((2, 64), i, dtype=torch.int32) for i in range(4)]
+    expanded = TTModelRunner._block_tables_per_layer(runner, tables)
+    assert len(expanded) == 64
+    for raw_index in range(64):
+        group = next(
+            i
+            for i, g in enumerate(groups)
+            if f"model.layers.{raw_index}.state" in g.layer_names
+        )
+        assert torch.equal(expanded[raw_index], tables[group])
+

diff --git a/tests/test_block_table_padding.py b/tests/test_block_table_padding.py
new file mode 100644
index 0000000..c67c3b1
--- /dev/null
+++ b/tests/test_block_table_padding.py
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+"""Group-shared page tables require at most one padded allocation per group."""
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from vllm_tt_plugin.model_runner import TTModelRunner
+
+
+@pytest.mark.parametrize("shape", [(1, 3), (32, 9), (35, 12)])
+def test_per_layer_tables_pad_once_per_group_and_preserve_values(shape):
+    groups = [torch.full(shape, i + 1, dtype=torch.int32) for i in range(4)]
+    original = [table.clone() for table in groups]
+    mapping = [i % 4 for i in range(64)]
+    runner = SimpleNamespace(
+        _layer_to_group_idx=mapping,
+        tt_max_batch_size=32,
+        max_num_blocks_per_req=9,
+    )
+    with patch("torch.zeros", wraps=torch.zeros) as zeros:
+        output = TTModelRunner._block_tables_per_layer(runner, groups)
+    assert zeros.call_count == (0 if shape == (32, 9) else 4)
+    for layer, group in enumerate(mapping):
+        expected = torch.zeros(32, 9, dtype=torch.int32)
+        rows, cols = min(shape[0], 32), min(shape[1], 9)
+        expected[:rows, :cols] = group + 1
+        assert torch.equal(output[layer], expected)
+        assert output[layer] is output[group]
+    assert all(torch.equal(table, before) for table, before in zip(groups, original))
+
+
+def test_missing_group_and_non_hybrid_tables_preserve_contract():
+    runner = SimpleNamespace(
+        _layer_to_group_idx=[0, 1, 0, 1],
+        tt_max_batch_size=2,
+        max_num_blocks_per_req=3,
+    )
+    table = torch.ones(2, 3, dtype=torch.int32)
+    output = TTModelRunner._block_tables_per_layer(runner, [table, None])
+    assert output[0] is table and output[2] is table
+    assert output[1] is None and output[3] is None

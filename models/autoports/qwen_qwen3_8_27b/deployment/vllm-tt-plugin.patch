+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+"""Mixed prompt chunks preserve slots, row metadata and final sampling route."""
+
+from dataclasses import dataclass
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm_tt_plugin.prefill import submit_prefill_chunks
+
+
+@dataclass
+class Params:
+    seed: list
+    temperature: list
+    optional: object = None
+
+
+@pytest.mark.parametrize("rope", [False, True])
+@pytest.mark.parametrize("logprobs", [False, True])
+def test_mixed_prefill_only_samples_final_rows_with_original_state_slots(
+    rope, logprobs
+):
+    calls = []
+    sampled = []
+
+    def forward(**kwargs):
+        calls.append(kwargs)
+        ids = kwargs["tokens"][:, 0]
+        if "sampling_params" in kwargs:
+            sampled.extend(kwargs["sampling_params"].seed)
+            output = ids[:, None] + 10
+            if logprobs:
+                output = (output, (ids[:, None].float(), ids[:, None] + 100))
+        else:
+            # An old adapter may return full logits. They must be discarded.
+            output = torch.full((len(ids), 1, 9), float("nan"))
+        return (output, ids + 20) if rope else output
+
+    kwargs = dict(
+        tokens=torch.tensor([[0, 1], [2, 3], [4, 5]]),
+        page_table=torch.tensor([[10], [11], [12]]),
+        page_tables_per_layer=[torch.tensor([[30], [31], [32]]), None],
+        kv_cache=object(),
+        enable_trace=True,
+        start_pos=[0, 128, 256],
+        prompt_lens=[2, 130, 258],
+        empty_slots=[4, 1, 6],
+        sampling_params=Params([100, 101, 102], [0.0, 0.0, 0.0]),
+        intermediate_prefill_mask=torch.tensor([True, False, True]),
+        stage_inputs=[{"request": i} for i in range(3)],
+        pixel_values=[None, ["image"], None],
+    )
+    result = submit_prefill_chunks(
+        SimpleNamespace(prefill_forward=forward), kwargs, request_specific_rope=rope
+    )
+    assert sampled == [101]
+    assert [call["empty_slots"] for call in calls] == [[4, 6], [1]]
+    assert calls[0]["intermediate_prefill_mask"].tolist() == [True, True]
+    assert "sampling_params" not in calls[0]
+    assert "intermediate_prefill_mask" not in calls[1]
+    assert calls[1]["page_tables_per_layer"][0].tolist() == [[31]]
+    assert calls[1]["stage_inputs"] == [{"request": 1}]
+    assert calls[1]["pixel_values"] == [["image"]]
+    assert calls[0]["kv_cache"] is kwargs["kv_cache"]
+    if rope:
+        result, deltas = result
+        assert deltas.tolist() == [20, 22, 24]
+    if logprobs:
+        result, (values, indices) = result
+        assert values.tolist() == [[0.0], [2.0], [0.0]]
+        assert indices.tolist() == [[0], [102], [0]]
+    assert result.tolist() == [[0], [12], [0]]
+    assert kwargs["sampling_params"].seed == [100, 101, 102]
+
+
+def test_split_assigns_original_slots_when_original_call_used_default_slots():
+    calls = []
+
+    def forward(**kwargs):
+        calls.append(kwargs)
+        return torch.ones(len(kwargs["tokens"]), 1)
+
+    output = submit_prefill_chunks(
+        SimpleNamespace(prefill_forward=forward),
+        dict(
+            tokens=torch.zeros(2, 4),
+            sampling_params=Params([2, 3], [0.0, 0.0]),
+            intermediate_prefill_mask=torch.tensor([True, False]),
+        ),
+        request_specific_rope=False,
+    )
+    assert [call["empty_slots"] for call in calls] == [[0], [1]]
+    assert output.tolist() == [[0.0], [1.0]]

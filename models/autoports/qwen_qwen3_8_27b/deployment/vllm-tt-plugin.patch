+def test_continuing_prefill_keeps_state_after_a_peer_finishes():
+    """Packing a partial prompt into row zero does not move its device state."""
+    r = _runner(slots=2)
+    assert _prefill(r, ["A", "B"]) == [0, 1]
+    state = ["A", "B"]
+    _release(r, finished=["A"])
+    r.requests.pop("A")
+
+    assert _prefill(r, ["B"]) == [1]
+    _assert_state_found(r, state)
+    state = _gather(state, _decode(r, ["B"]))
+    _assert_state_found(r, state)
+    assert state[0] == "B"
+
+
+def test_reordered_prefill_continuations_keep_their_slots():
+    r = _runner(slots=3)
+    assert _prefill(r, ["A", "B", "C"]) == [0, 1, 2]
+    state = ["A", "B", "C"]
+
+    assert _prefill(r, ["C", "A", "B"]) == [2, 0, 1]
+    _assert_state_found(r, state)
+    state = _gather(state, _decode(r, ["C", "A", "B"]))
+    _assert_state_found(r, state)
+    assert state == ["C", "A", "B"]
+
+
+def test_new_prefill_reserves_later_continuations_before_assigning_slots():
+    r = _runner(slots=3)
+    assert _prefill(r, ["A", "B"]) == [0, 1]
+    state = ["A", "B", None]
+
+    assert _prefill(r, ["NEW", "A"]) == [2, 0]
+    state[2] = "NEW"
+    _assert_state_found(r, state)
+    state = _gather(state, _decode(r, ["NEW", "A", "B"]))
+    _assert_state_found(r, state)
+    assert state == ["NEW", "A", "B"]
+
+
 def test_release_keeps_a_merely_unscheduled_request():
     """Every prefill step leaves the whole decode batch unscheduled, and that state is
     still live. The release predicate must not read "unscheduled" as "dead"."""

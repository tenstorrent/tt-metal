   338	    batch_size, num_heads, sequence_length, k_head_dim = key.shape
   339	    v_head_dim = value.shape[-1]
   340	    scale = 1 / (query.shape[-1] ** 0.5)
   341	    query = query * scale
   342	
   343	    core_attn_out = torch.zeros(
   344	        batch_size, num_heads, sequence_length, v_head_dim, dtype=value.dtype, device=value.device
   345	    )
   346	    last_recurrent_state = (
   347	        torch.zeros(batch_size, num_heads, k_head_dim, v_head_dim, dtype=value.dtype, device=value.device)
   348	        if initial_state is None
   349	        else initial_state.to(value)
   350	    )
   351	
   352	    for i in range(sequence_length):
   353	        q_t = query[:, :, i]
   354	        k_t = key[:, :, i]
   355	        v_t = value[:, :, i]
   356	        g_t = g[:, :, i].exp().unsqueeze(-1).unsqueeze(-1)
   357	        beta_t = beta[:, :, i].unsqueeze(-1)

     4	// Program factory for fused_recurrent_gated_delta_rule.
     5	// Parallelism: one Tensix core per (B*HV) head; each core walks the T token axis sequentially,
     6	// holding the recurrent state S [K,V] on-core. All math is in the compute kernel, derived from
     7	// flash-linear-attention `naive_recurrent_gated_delta_rule`.
     8	
     9	#include "fused_recurrent_gated_delta_rule_program_factory.hpp"
    10	
    11	#include <algorithm>
    12	#include <set>
    13	#include <vector>
    14	
    15	#include <tt-metalium/buffer.hpp>
    16	#include <tt-metalium/constants.hpp>
    17	#include <tt-metalium/program_descriptors.hpp>
    18	#include <tt-metalium/tensor_accessor_args.hpp>
    19	#include <tt-metalium/tensor/tensor_types.hpp>
    20	
    21	#include "ttnn/operations/core/compute_kernel/compute_kernel_config.hpp"
    22	
    23	using namespace tt::tt_metal;
    24	using namespace tt::constants;
    25	
    26	namespace ttnn::prim {
    27	
    28	// CB index plan (all fp32). Kept in sync with the compute/reader/writer kernels.
    29	namespace cb {
    30	constexpr uint32_t q = tt::CBIndex::c_0;          // [1,K]  one token
    31	constexpr uint32_t k = tt::CBIndex::c_1;          // [1,K]
    32	constexpr uint32_t v = tt::CBIndex::c_2;          // [1,V]
    33	constexpr uint32_t decay = tt::CBIndex::c_3;      // [1,1]  scalar exp(g_t)
    34	constexpr uint32_t beta = tt::CBIndex::c_4;       // [1,1]  scalar
    35	constexpr uint32_t S = tt::CBIndex::c_5;          // [K,V]  reader-produced initial state
    36	constexpr uint32_t out = tt::CBIndex::c_6;        // [1,V]  output o_t
    37	constexpr uint32_t state_out = tt::CBIndex::c_7;  // [K,V]  state output (per-token or final)
    38	constexpr uint32_t s2 = tt::CBIndex::c_8;         // [K,V]  compute state ping
    39	constexpr uint32_t s3 = tt::CBIndex::c_9;         // [K,V]  compute state pong
    40	constexpr uint32_t sd = tt::CBIndex::c_10;        // [K,V]  decayed state (S*decay)
    41	constexpr uint32_t vread = tt::CBIndex::c_11;     // [1,V]  k . S'
    42	constexpr uint32_t u = tt::CBIndex::c_12;         // [1,V]  beta*(v - vread)
    43	constexpr uint32_t kcol = tt::CBIndex::c_13;      // [K,1]  transpose(k)
    44	constexpr uint32_t blkidx = tt::CBIndex::c_16;    // [BH]   uint32 scratch, ring mode only
    45	}  // namespace cb
    46	
    47	tt::tt_metal::ProgramDescriptor FusedRecurrentGatedDeltaRuleProgramFactory::create_descriptor(
    48	    const FusedRecurrentGatedDeltaRuleParams& attrs,
    49	    const FusedRecurrentGatedDeltaRuleInputs& in,
    50	    std::vector<Tensor>& outputs) {
    51	    const uint32_t BH = attrs.BH;
    52	    const uint32_t T = attrs.T;
    53	    const uint32_t Kt = attrs.key_dim / TILE_WIDTH;
    54	    const uint32_t Vt = attrs.val_dim / TILE_WIDTH;
    55	    const uint32_t per_token = attrs.output_per_token_state ? 1u : 0u;
    56	    const bool ring = in.initial_state_block_idx.has_value();
    57	    const uint32_t use_blk_idx = ring ? 1u : 0u;
    58	    Buffer* blk_buf = ring ? in.initial_state_block_idx->buffer() : nullptr;
    59	    // The [BH] index vector is one ROW_MAJOR page; the aligned page size keeps the DRAM read aligned.
    60	    const uint32_t blk_page_bytes = ring ? blk_buf->aligned_page_size() : 0u;
    61	
    62	    const uint32_t kv = Kt * Vt;
    63	
    64	    auto* device = in.q.device();
    65	    const CoreCoord grid = device->compute_with_storage_grid_size();
    66	    const uint32_t grid_y = grid.y;
    67	    TT_FATAL(BH <= grid.x * grid_y, "num_heads {} exceeds compute cores {}", BH, grid.x * grid_y);
    68	
    69	    std::vector<CoreCoord> head_cores(BH);
    70	    std::set<CoreRange> core_set;
    71	    for (uint32_t h = 0; h < BH; h++) {
    72	        head_cores[h] = CoreCoord{h / grid_y, h % grid_y};
    73	        core_set.insert(CoreRange{head_cores[h], head_cores[h]});
    74	    }
    75	    CoreRangeSet cores{core_set};
    76	
    77	    ProgramDescriptor desc;
    78	    const tt::DataFormat fmt = tt::DataFormat::Float32;
    79	    const uint32_t ts = tt::tile_size(fmt);
    80	    auto add_cb = [&](uint32_t idx, uint32_t n_tiles, uint32_t nbuf = 1) {
    81	        desc.cbs.push_back(CBDescriptor{
    82	            .total_size = n_tiles * nbuf * ts,
    83	            .core_ranges = cores,
    84	            .format_descriptors = {
    85	                {CBFormatDescriptor{.buffer_index = static_cast<uint8_t>(idx), .data_format = fmt, .page_size = ts}}}});
    86	    };
    87	
    88	    add_cb(cb::q, Kt);
    89	    add_cb(cb::k, Kt);
    90	    add_cb(cb::v, Vt);
    91	    add_cb(cb::decay, 1, T > 1 ? 2 : 1);
    92	    add_cb(cb::beta, 1, T > 1 ? 2 : 1);
    93	    add_cb(cb::S, kv);
    94	    add_cb(cb::out, Vt, 2);
    95	    add_cb(cb::state_out, kv, 2);
    96	    add_cb(cb::s2, kv);
    97	    add_cb(cb::s3, kv);
    98	    add_cb(cb::sd, kv);
    99	    add_cb(cb::vread, Vt);
   100	    add_cb(cb::u, Vt);
   101	    add_cb(cb::kcol, Kt);
   102	    if (ring) {
   103	        const tt::DataFormat idx_fmt = datatype_to_dataformat_converter(in.initial_state_block_idx->dtype());
   104	        desc.cbs.push_back(CBDescriptor{
   105	            .total_size = blk_page_bytes,
   106	            .core_ranges = cores,
   107	            .format_descriptors = {{CBFormatDescriptor{
   108	                .buffer_index = static_cast<uint8_t>(cb::blkidx),
   109	                .data_format = idx_fmt,
   110	                .page_size = blk_page_bytes}}}});
   111	    }
   112	
   113	    const std::string kdir = "ttnn/cpp/ttnn/operations/transformer/fused_recurrent_gated_delta_rule/device/kernels/";
   114	    const std::vector<uint32_t> compute_ct = {Kt, Vt, per_token};
   115	
   116	    std::vector<uint32_t> reader_ct = {Kt, Vt, use_blk_idx};
   117	    TensorAccessorArgs(*in.q.buffer()).append_to(reader_ct);
   118	    TensorAccessorArgs(*in.k.buffer()).append_to(reader_ct);
   119	    TensorAccessorArgs(*in.v.buffer()).append_to(reader_ct);
   120	    TensorAccessorArgs(*in.decay.buffer()).append_to(reader_ct);
   121	    TensorAccessorArgs(*in.beta.buffer()).append_to(reader_ct);
   122	    TensorAccessorArgs(in.initial_state.has_value() ? in.initial_state->buffer() : nullptr).append_to(reader_ct);
   123	    TensorAccessorArgs(blk_buf).append_to(reader_ct);
   124	
   125	    std::vector<uint32_t> writer_ct = {Kt, Vt, per_token};
   126	    TensorAccessorArgs(*outputs[0].buffer()).append_to(writer_ct);
   127	    TensorAccessorArgs(*outputs[1].buffer()).append_to(writer_ct);
   128	
   129	    KernelDescriptor reader;
   130	    reader.kernel_source = kdir + "dataflow/reader_fused_recurrent_gated_delta_rule.cpp";
   131	    reader.source_type = KernelDescriptor::SourceType::FILE_PATH;
   132	    reader.core_ranges = cores;
   133	    reader.compile_time_args = reader_ct;
   134	    reader.config = ReaderConfigDescriptor{};
   135	    reader.runtime_args.reserve(BH);
   136	
   137	    KernelDescriptor writer;
   138	    writer.kernel_source = kdir + "dataflow/writer_fused_recurrent_gated_delta_rule.cpp";
   139	    writer.source_type = KernelDescriptor::SourceType::FILE_PATH;
   140	    writer.core_ranges = cores;
   141	    writer.compile_time_args = writer_ct;
   142	    writer.config = WriterConfigDescriptor{};
   143	    writer.runtime_args.reserve(BH);
   144	
   145	    KernelDescriptor compute;
   146	    compute.kernel_source = kdir + "compute/fused_recurrent_gated_delta_rule.cpp";
   147	    compute.source_type = KernelDescriptor::SourceType::FILE_PATH;
   148	    compute.core_ranges = cores;
   149	    compute.compile_time_args = compute_ct;
   150	    // Honor the caller's compute config (the public wrapper defaults it to HiFi4 / fp32 acc / exact).
   151	    auto [math_fidelity, math_approx_mode, fp32_dest_acc_en, packer_l1_acc, dst_full_sync_en] =
   152	        get_compute_kernel_config_args(device->arch(), attrs.compute_kernel_config);
   153	    compute.config = ComputeConfigDescriptor{
   154	        .math_fidelity = math_fidelity,
   155	        .fp32_dest_acc_en = fp32_dest_acc_en,
   156	        .dst_full_sync_en = dst_full_sync_en,
   157	        .math_approx_mode = math_approx_mode};
   158	    compute.runtime_args.reserve(BH);
   159	
   160	    auto* q_buf = in.q.buffer();
   161	    auto* k_buf = in.k.buffer();
   162	    auto* v_buf = in.v.buffer();
   163	    auto* decay_buf = in.decay.buffer();
   164	    auto* beta_buf = in.beta.buffer();
   165	    auto* s0_buf = in.initial_state.has_value() ? in.initial_state->buffer() : nullptr;
   166	    auto* o_buf = outputs[0].buffer();
   167	    auto* st_buf = outputs[1].buffer();
   168	
   169	    for (uint32_t h = 0; h < BH; h++) {
   170	        const auto& core = head_cores[h];
   171	        reader.emplace_runtime_args(
   172	            core, {h, T, q_buf, k_buf, v_buf, decay_buf, beta_buf, s0_buf, blk_buf, blk_page_bytes, BH});
   173	        // BH is needed by the writer to place per-token state token-major (page t*BH + h).
   174	        writer.emplace_runtime_args(core, {h, T, o_buf, st_buf, BH});
   175	        compute.emplace_runtime_args(core, {T});
   176	    }
   177	
   178	    desc.kernels.push_back(std::move(reader));
   179	    desc.kernels.push_back(std::move(writer));
   180	    desc.kernels.push_back(std::move(compute));
   181	    return desc;
   182	}
   183	
   184	}  // namespace ttnn::prim


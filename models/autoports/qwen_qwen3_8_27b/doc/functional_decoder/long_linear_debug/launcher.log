   127	def test_golden_per_key_decay_reduces_to_scalar_decay():
   128	    """A rank-4 g whose rows are constant over K is the scalar-decay recurrence, bit for bit."""
   129	    x = make_inputs(2, 3, 12, 12, K, V, seed=6)
   130	    g4 = x["g"].unsqueeze(-1).expand(-1, -1, -1, K).contiguous()
   131	    o3, s3 = _golden()(
   132	        x["q"], x["k"], x["v"], x["g"], x["beta"], initial_state=x["initial_state"], output_final_state=True
   133	    )
   134	    o4, s4 = _golden()(x["q"], x["k"], x["v"], g4, x["beta"], initial_state=x["initial_state"], output_final_state=True)
   135	    assert torch.equal(o3, o4) and torch.equal(s3, s4)
   136	    # and a genuinely per-key decay scales the state rows: row k of S decays by exp(g[k])
   137	    g_rows = -torch.rand(2, 1, 12, K)
   138	    _, s_rows = recurrent_gated_delta_rule(
   139	        x["q"][:, :1],
   140	        x["k"][:, :1],
   141	        x["v"][:, :1],
   142	        x["beta"][:, :1],
   143	        g_rows,
   144	        initial_state=x["initial_state"],
   145	        output_final_state=True,
   146	    )
   147	    decayed = x["initial_state"] * g_rows[:, 0].exp()[..., :, None]
   148	    k_hat = x["k"][:, 0]  # [B, H, K]
   149	    v_read = (decayed * k_hat[..., None]).sum(-2)
   150	    u = (x["v"][:, 0] - v_read) * x["beta"][:, 0][..., None]
   151	    expected = decayed + k_hat.unsqueeze(-1) * u.unsqueeze(-2)
   152	    torch.testing.assert_close(s_rows, expected)

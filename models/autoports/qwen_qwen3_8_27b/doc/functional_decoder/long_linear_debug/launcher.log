   223	    def prefill_forward(self, hidden_states, *, state, start_position=0, page_table=None, cos=None, sin=None):
   224	        """Chunked [B,S,H] prefill, all logical outputs returned; resume at a chunk boundary.
   225	
   226	        cos/sin: [B,1,S,64] for absolute positions start_position..start_position+S.
   227	        Linear state summarizes precisely the prefix; paged state owns the prefix pages.
   228	        """
   229	        batch, length, _ = hidden_states.shape
   230	        if not 0 < length or start_position + length > self.config.max_position_embeddings:
   231	            raise ValueError("Invalid logical sequence extent")
   232	        if start_position % self.chunk_size:
   233	            raise ValueError("Prefill continuation starts at a chunk boundary; decode handles individual tokens")

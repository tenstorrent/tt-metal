    34	def test_golden_matches_fla_naive(shape, B, T, with_state):
    35	    """The op's argument order (q, k, v, g, beta) over FLA naive's (q, k, v, beta, g); q, k pre-normalised on the host
    36	    as FLA naive expects; GQA expanded on the host for FLA. Bit-identical: the same statements in the same order."""
    37	    sh = SHAPES[shape]
    38	    x = make_inputs(B, T, sh.num_key_heads, sh.num_value_heads, K, V, seed=1, with_state=with_state)
    39	    o, state = _golden()(
    40	        x["q"], x["k"], x["v"], x["g"], x["beta"], initial_state=x["initial_state"], output_final_state=True
    41	    )
    42	    groups = sh.num_value_heads // sh.num_key_heads
    43	    o_ref, state_ref = fla_naive_recurrent_gated_delta_rule(
    44	        x["q"].repeat_interleave(groups, dim=2),
    45	        x["k"].repeat_interleave(groups, dim=2),
    46	        x["v"],
    47	        x["beta"],
    48	        x["g"],
    49	        initial_state=x["initial_state"],
    50	        output_final_state=True,
    51	    )
    52	    assert o.shape == (B, T, sh.num_value_heads, V) and state.shape == (B, sh.num_value_heads, K, V)
    53	    assert torch.equal(o, o_ref) and torch.equal(state, state_ref)

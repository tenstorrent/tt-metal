   246	                    c = ttnn.pad(c, [(0, 0), (0, 0), (0, physical - n), (0, 0)], value=0)
   247	                    s = ttnn.pad(s, [(0, 0), (0, 0), (0, physical - n), (0, 0)], value=0)
   248	                y = self._attention(h, state, page_table=page_table, cos=c, sin=s, chunk_start=start_position + offset)

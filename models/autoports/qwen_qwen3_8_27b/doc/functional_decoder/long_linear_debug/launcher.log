   200	                    "padding; consider a smaller core grid or INTERLEAVED.",
   201	                    layout,
   202	                    shard_dim,
   203	                    is_height ? "rows" : "cols",
   204	                    shard_dim / data_per_core,
   205	                    data_per_core,
   206	                    is_height ? "rows" : "cols",
   207	                    is_height ? 'h' : 'w',
   208	                    phys_dim,
   209	                    num_cores);
   210	            }
   211	        }
   212	    } else {
   213	        TT_FATAL(
   214	            false, "Unsupported memory layout {}: expected BLOCK_SHARDED, HEIGHT_SHARDED, or WIDTH_SHARDED", layout);
   215	    }
   216	    return output_mem_config;
   217	}

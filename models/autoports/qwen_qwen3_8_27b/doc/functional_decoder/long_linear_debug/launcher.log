    42	// The existing native implementation, unconditionally. Calls the native prim directly rather than
    43	// re-entering ttnn::untilize, so a call that has already been routed to native cannot be routed a
    44	// second time and land on codegen partway through.
    45	ttnn::Tensor untilize_native(
    46	    const ttnn::Tensor& input_tensor,
    47	    const std::optional<MemoryConfig>& memory_config,
    48	    bool use_multicore,
    49	    const std::optional<CoreRangeSet>& sub_core_grids) {
    50	    // If the input tensor is not sharded, and logical shape != padded shape, then unpad the input tensor.

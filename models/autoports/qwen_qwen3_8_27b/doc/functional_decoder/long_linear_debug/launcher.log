   537	                key,
   538	                value,
   539	                g=g,
   540	                beta=beta,
   541	                initial_state=recurrent_state if use_precomputed_states else None,
   542	                output_final_state=cache_params is not None,
   543	                use_qk_l2norm_in_kernel=True,

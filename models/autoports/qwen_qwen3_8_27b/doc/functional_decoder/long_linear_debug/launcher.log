     4	
     5	"""Test utilities for the fused GDN decode recurrence (ttnn.transformer.fused_recurrent_gated_delta_rule).
     6	
     7	The reference semantics live in the op's registered golden (ttnn.get_golden_function(op), implemented in
     8	ttnn/ttnn/operations/transformer_golden.py); this module holds what is not reference semantics: the model shapes, input
     9	generation, the chained single-token helper, and a vendored copy of FLA's naive recurrence as the oracle the golden is
    10	checked against."""
    11	
    12	from dataclasses import dataclass
    13	
    14	import torch
    15	
    16	from ttnn.operations.transformer_golden import l2_norm
    17	
    18	
    19	@dataclass(frozen=True)
    20	class Shape:
    21	    num_key_heads: int
    22	    num_value_heads: int
    23	
    24	
    25	# Per-device head counts of served configurations.
    26	SHAPES = {
    27	    "qwen27b_tp4": Shape(4, 12),  # Qwen3.6-27B TP 4
    28	    "qwen9b_tp1": Shape(16, 32),  # Qwen3.5-9B single chip
    29	}
    30	
    31	
    32	def make_inputs(B, T, H, HV, K, V, *, seed, normalize_qk=True, with_state=True):
    33	    """Recurrence inputs in the layer's post-conv convention: q, k, v ~ N(0, 1), beta ~ U(0, 1) (a sigmoid output),
    34	    g = -2 U(0, 1) (log decay), state ~ 0.05 N(0, 1). With normalize_qk the q, k rows are L2-normalised (the golden
    35	    module's l2_norm) as the current op expects them. Returns a dict of fp32 torch tensors, token-major [B, T, heads, D].
    36	    """
    37	    gen = torch.Generator().manual_seed(seed)
    38	    r = lambda *shape: torch.randn(*shape, generator=gen, dtype=torch.float32)
    39	    q, k = r(B, T, H, K), r(B, T, H, K)
    40	    if normalize_qk:
    41	        q, k = l2_norm(q), l2_norm(k)
    42	    v = r(B, T, HV, V)
    43	    beta = torch.rand(B, T, HV, generator=gen, dtype=torch.float32)
    44	    g = -torch.rand(B, T, HV, generator=gen, dtype=torch.float32) * 2.0
    45	    s0 = 0.05 * r(B, HV, K, V) if with_state else None
    46	    return {"q": q, "k": k, "v": v, "g": g, "beta": beta, "initial_state": s0}
    47	
    48	
    49	def chained_decode(fn, q, k, v, g, beta, initial_state=None):
    50	    """Run fn (op or golden, (q, k, v, g, beta, *, initial_state, output_final_state) -> (o, state)) one token at a
    51	    time and stitch: o [B, T, HV, V], states [B, T, HV, K, V] (the state after each token)."""
    52	    T = q.shape[1]
    53	    state = initial_state
    54	    outs, states = [], []
    55	    for t in range(T):
    56	        sl = slice(t, t + 1)
    57	        o_t, state = fn(
    58	            q[:, sl], k[:, sl], v[:, sl], g[:, sl], beta[:, sl], initial_state=state, output_final_state=True
    59	        )
    60	        outs.append(o_t)
    61	        states.append(state)
    62	    return torch.cat(outs, dim=1), torch.stack(states, dim=1)
    63	
    64	
    65	def fla_naive_recurrent_gated_delta_rule(q, k, v, beta, g, scale=None, initial_state=None, output_final_state=False):
    66	    """Vendored copy of FLA's naive_recurrent_gated_delta_rule (flash-linear-attention,
    67	    fla/ops/gated_delta_rule/naive.py, MIT license, (c) Songlin Yang et al.), FLA order (q, k, v, beta, g). The oracle
    68	    of the golden; vendored because no tt-metal environment installs FLA."""
    69	    q, k, v, beta, g = map(lambda x: x.transpose(1, 2).contiguous().to(torch.float32), [q, k, v, beta, g])
    70	    B, H, T, K, V = *k.shape, v.shape[-1]
    71	    o = torch.zeros(B, H, T, V).to(v)
    72	    h = torch.zeros(B, H, K, V).to(v)
    73	    if initial_state is not None:
    74	        h = initial_state.to(torch.float32)
    75	    if scale is None:
    76	        scale = 1 / (q.shape[-1] ** 0.5)
    77	    q = q * scale
    78	    for i in range(T):
    79	        b_q = q[:, :, i]
    80	        b_k = k[:, :, i]
    81	        b_v = v[:, :, i].clone()
    82	        h = h.clone() * g[:, :, i].exp()[..., None, None]
    83	        b_beta = beta[:, :, i]
    84	        b_v = b_v - (h.clone() * b_k[..., None]).sum(-2)
    85	        b_v = b_v * b_beta[..., None]
    86	        h = h.clone() + b_k.unsqueeze(-1) * b_v.unsqueeze(-2)
    87	        o[:, :, i] = torch.einsum("bhd,bhdm->bhm", b_q, h)
    88	    if not output_final_state:
    89	        h = None
    90	    o = o.transpose(1, 2).contiguous()
    91	    return o, h

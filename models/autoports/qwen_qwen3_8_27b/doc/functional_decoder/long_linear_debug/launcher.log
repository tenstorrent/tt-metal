    19	namespace ttnn::operations::data_movement {
    20	using OwnedUntilizeArgs = std::tuple<ttnn::Tensor>;
    21	using BaseUntilizeType = std::function<ttnn::Tensor(const ttnn::Tensor&)>;
    22	
    23	using MassagedUntilize = MassagedOperation<ttnn::Tensor, const ttnn::Tensor&>;
    24	using MassagedUntilizeParams = MassagedOperationParams<ttnn::Tensor, const ttnn::Tensor&>;
    25	
    26	MassagedUntilize build_ndiml_untilize(BaseUntilizeType base_untilize) {
    27	    auto original_shape = std::make_shared<std::pair<ttnn::Shape, ttnn::Shape>>();
    28	    return MassagedUntilize(MassagedUntilizeParams{
    29	        .predicate = [](const ttnn::Tensor& input_tensor) -> bool { return input_tensor.logical_shape().rank() > 4; },
    30	        .pre_transform = [=](const ttnn::Tensor& input_tensor) -> OwnedUntilizeArgs {
    31	            *original_shape = std::make_pair(input_tensor.logical_shape(), input_tensor.padded_shape());
    32	            ttnn::Tensor squeezed_tensor = squeeze_from_ND_to_4D(input_tensor);
    33	            return std::make_tuple(squeezed_tensor);
    34	        },
    35	        .post_transform = [=](const ttnn::Tensor& output) -> ttnn::Tensor {
    36	            auto unsqueezed_tensor = ttnn::reshape(output, original_shape->first, original_shape->second);
    37	            return unsqueezed_tensor;
    38	        },
    39	        .operation = std::move(base_untilize)});
    40	}

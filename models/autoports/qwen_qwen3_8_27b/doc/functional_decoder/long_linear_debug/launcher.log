   376	        self.num_k_heads = config.linear_num_key_heads
   377	        self.head_k_dim = config.linear_key_head_dim
   378	        self.head_v_dim = config.linear_value_head_dim
   379	        self.key_dim = self.head_k_dim * self.num_k_heads
   380	        self.value_dim = self.head_v_dim * self.num_v_heads
   381	
   382	        self.conv_kernel_size = config.linear_conv_kernel_dim
   383	        self.layer_idx = layer_idx
   384	        self.activation = config.hidden_act
   385	        self.act = ACT2FN[config.hidden_act]
   386	        self.layer_norm_epsilon = config.rms_norm_eps

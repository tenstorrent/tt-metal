    47	// Reshape through ROW_MAJOR (moves data across the tile boundary), then re-tilize.
    48	ttnn::Tensor reshape_rm(const ttnn::Tensor& x, const ttnn::Shape& shape) {
    49	    ttnn::Tensor t = ttnn::to_layout(x, Layout::ROW_MAJOR);
    50	    t = ttnn::reshape(t, shape);
    51	    return ttnn::to_layout(t, Layout::TILE);
    52	}
    53	
    54	}  // namespace
    55	
    56	std::tuple<ttnn::Tensor, std::optional<ttnn::Tensor>> fused_recurrent_gated_delta_rule(
    57	    const ttnn::Tensor& q_in,
    58	    const ttnn::Tensor& k_in,
    59	    const ttnn::Tensor& v_in,
    60	    const ttnn::Tensor& g_in,
    61	    const ttnn::Tensor& beta_in,
    62	    std::optional<float> scale_opt,
    63	    const std::optional<ttnn::Tensor>& initial_state,
    64	    const std::optional<ttnn::Tensor>& initial_state_block_idx,
    65	    bool output_final_state,
    66	    bool output_per_token_state,
    67	    bool use_qk_l2norm,
    68	    const std::optional<ttnn::MemoryConfig>& memory_config,
    69	    const std::optional<ttnn::DeviceComputeKernelConfig>& compute_kernel_config) {
    70	    TT_FATAL(!use_qk_l2norm, "fused_recurrent_gated_delta_rule: use_qk_l2norm not done here; L2-normalize q/k on host");
    71	
    72	    auto* dev = q_in.device();
    73	    const auto& qs = q_in.logical_shape();  // [B,T,H,K]
    74	    const auto& vs = v_in.logical_shape();  // [B,T,HV,V]
    75	    const uint32_t B = qs[0];
    76	    const uint32_t T = qs[1];
    77	    const uint32_t H = qs[2];
    78	    const uint32_t K = qs[3];
    79	    const uint32_t HV = vs[2];
    80	    const uint32_t V = vs[3];
    81	    TT_FATAL(HV % H == 0, "HV ({}) must be divisible by H ({})", HV, H);
    82	    const uint32_t G = HV / H;
    83	    const uint32_t BH = B * HV;
    84	
    85	    const float scale = scale_opt.has_value() ? *scale_opt : (1.0f / std::sqrt(static_cast<float>(K)));
    86	
    87	    // Scale q (q is already L2-normed on host), then head-split + GQA-expand q,k from H to HV heads.
    88	    ttnn::Tensor q = ttnn::multiply(as_f32(q_in), scale);
    89	    ttnn::Tensor k = as_f32(k_in);
    90	    q = head_split(q, B, T, H, K);  // [B*H, T, K]
    91	    k = head_split(k, B, T, H, K);
    92	    if (G > 1) {
    93	        q = ttnn::repeat_interleave(q, G, 0);  // [BH, T, K]
    94	        k = ttnn::repeat_interleave(k, G, 0);
    95	    }
    96	    ttnn::Tensor v = head_split(v_in, B, T, HV, V);  // [BH, T, V]
    97	
    98	    // decay = exp(g); beta as-is (already sigmoid'd).
    99	    ttnn::Tensor decay = ttnn::exp(headvec_split(g_in, B, T, HV));  // [BH, T]
   100	    ttnn::Tensor beta = headvec_split(beta_in, B, T, HV);           // [BH, T]
   101	
   102	    // Per-token layout: each (head, token) its own zero-padded tile-block.
   103	    //   q/k [BH*T,1,K], v [BH*T,1,V], decay/beta [BH*T,1,1].
   104	    // T==1 fast path: head_split already yields [BH,1,D] == [BH*T,1,D], so the q/k/v relayout is a
   105	    // no-op — skip the RM round-trip (it is ~5x the cost of the permute; see test_headsplit_bench).
   106	    if (T > 1) {
   107	        q = reshape_rm(q, ttnn::Shape({BH * T, 1, K}));
   108	        k = reshape_rm(k, ttnn::Shape({BH * T, 1, K}));
   109	        v = reshape_rm(v, ttnn::Shape({BH * T, 1, V}));
   110	    }
   111	    // decay/beta come from headvec_split as [BH,T] (BH packed in tile-rows); they always need the
   112	    // relayout to per-scalar tiles [BH*T,1,1] so bcast_scalar reads element [0,0]. They are tiny.
   113	    decay = reshape_rm(decay, ttnn::Shape({BH * T, 1, 1}));
   114	    beta = reshape_rm(beta, ttnn::Shape({BH * T, 1, 1}));
   115	
   116	    // Initial state [B,HV,K,V] -> [BH,K,V] fp32 TILE. Always provide (zeros if absent) so the reader
   117	    // always reads S (it takes the unconditional path; there is no in-kernel zeroing). Traced callers
   118	    // pass a persistent state buffer (never absent); the zeros() fallback here is eager-only
   119	    // (device-side fill, uncached), same caveat as chunk_gated_delta_rule.
   120	    //
   121	    // Ring mode: initial_state is the [T*BH,K,V] ring and also the state output; pass it through untouched, since a
   122	    // reshape or typecast would break the in-place aliasing. The device op validates it.
   123	    const bool ring = initial_state_block_idx.has_value();
   124	    std::optional<ttnn::Tensor> s0 = initial_state;
   125	    if (!ring) {
   126	        if (initial_state.has_value()) {
   127	            s0 = ttnn::reshape(as_f32(*initial_state), ttnn::Shape({BH, K, V}));
   128	        } else {
   129	            s0 = ttnn::zeros(
   130	                ttnn::Shape({BH, K, V}), DataType::FLOAT32, Layout::TILE, std::ref(*dev), ttnn::DRAM_MEMORY_CONFIG);
   131	        }
   132	    }
   133	
   134	    const auto out_mem = memory_config.value_or(ttnn::DRAM_MEMORY_CONFIG);
   135	    const auto kernel_cfg = init_device_compute_kernel_config(
   136	        dev->arch(),
   137	        compute_kernel_config,
   138	        MathFidelity::HiFi4,
   139	        /*default_approx_mode=*/false,
   140	        /*default_fp32_acc=*/true,
   141	        /*default_l1_acc=*/false);
   142	
   143	    const bool want_state = output_final_state || output_per_token_state;
   144	    auto res = ttnn::prim::fused_recurrent_gated_delta_rule(
   145	        q,
   146	        k,
   147	        v,
   148	        decay,
   149	        beta,
   150	        s0,
   151	        initial_state_block_idx,
   152	        T,
   153	        want_state && !output_per_token_state,
   154	        output_per_token_state,
   155	        out_mem,
   156	        kernel_cfg);
   157	    const ttnn::Tensor& o_pt = res[0];  // [BH*T, 1, V]
   158	    const ttnn::Tensor& st = res[1];    // [BH*T,K,V] per-token, else [BH,K,V]
   159	
   160	    // o [BH*T,1,V] -> [B,HV,T,V] -> [B,T,HV,V].
   161	    ttnn::Tensor o = ttnn::to_layout(o_pt, Layout::ROW_MAJOR);
   162	    o = ttnn::reshape(o, ttnn::Shape({B, HV, T, V}));
   163	    o = ttnn::permute(o, ttsl::SmallVector<int64_t>{0, 2, 1, 3});  // [B,T,HV,V]
   164	    o = ttnn::to_layout(o, Layout::TILE);
   165	
   166	    std::optional<ttnn::Tensor> state_opt;
   167	    if (ring) {
   168	        // res[1] is the caller's ring; return it as-is so the buffer stays aliased.
   169	        state_opt = st;
   170	    } else if (output_per_token_state) {
   171	        // The writer lays per-token state out token-major, so the raw [BH*T,K,V] buffer already
   172	        // reads as [T,B,HV,K,V]. At B==1 -- the speculative-decode case -- that IS the requested
   173	        // [B,T,HV,K,V] element order, and K,V (the tiled dims) are untouched, so this is a pure
   174	        // metadata reshape. It replaces an untilize + 5D permute + re-tilize of the whole state
   175	        // tensor, which ran once per GDN layer per verify.
   176	        if (B == 1) {
   177	            state_opt = ttnn::reshape(st, ttnn::Shape({B, T, HV, K, V}));
   178	        } else {
   179	            ttnn::Tensor s = ttnn::to_layout(st, Layout::ROW_MAJOR);
   180	            s = ttnn::reshape(s, ttnn::Shape({T, B, HV, K, V}));
   181	            s = ttnn::permute(s, ttsl::SmallVector<int64_t>{1, 0, 2, 3, 4});  // [B,T,HV,K,V]
   182	            state_opt = ttnn::to_layout(s, Layout::TILE);
   183	        }
   184	    } else if (output_final_state) {
   185	        state_opt = ttnn::reshape(st, ttnn::Shape({B, HV, K, V}));
   186	    }
   187	
   188	    return {o, state_opt};
   189	}
   190	
   191	}  // namespace ttnn::transformer

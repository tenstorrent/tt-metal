    86	//
    87	// `input_shard_spec`: when `memory_config` is sharded but has no shard_spec, seed
    88	// derivation from the input tensor's spec (layout should match the input).
    89	MemoryConfig recompute_shard_spec_for_output(
    90	    const MemoryConfig& memory_config,
    91	    const tt::tt_metal::TensorSpec& output_shape,
    92	    bool explicit_memory_config = false,
    93	    const std::optional<tt::tt_metal::ShardSpec>& input_shard_spec = std::nullopt) {

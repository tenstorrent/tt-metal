    38	static uint32_t collapse_second_dim(const ttnn::Shape& shape) {
    39	    TT_FATAL((shape.rank() != 0), "Can't collapse rank 0 tensor shape");
    40	    uint32_t second_dim = 1;
    41	    for (int64_t i = 0; i < static_cast<int64_t>(shape.rank()) - 1; ++i) {
    42	        second_dim = second_dim * shape[i];
    43	    }
    44	    return second_dim;
    45	}
    46	
    47	// Largest n in [1, max_n] with dim % n == 0 and (dim / n) % align == 0, else 0.
    48	static uint32_t find_best_n_1d(uint32_t dim, uint32_t max_n, uint32_t align) {
    49	    for (uint32_t n = max_n; n > 0; n--) {
    50	        if (dim % n == 0 && (dim / n) % align == 0) {
    51	            return n;
    52	        }
    53	    }
    54	    return 0;
    55	}

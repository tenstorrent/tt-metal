    95	    // from input_shard_spec (typically the input tensor's) and re-enter. The caller's
    96	    // layout and buffer_type are preserved; the full ShardSpec (grid, orientation, and
    97	    // per-core shape) comes from the input and will be re-derived for the output shape.
    98	    if (!memory_config.shard_spec().has_value() && input_shard_spec.has_value()) {

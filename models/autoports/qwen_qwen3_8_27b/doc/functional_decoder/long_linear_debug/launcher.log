    75	// True if the inner-2D of `shape` is not tile-aligned, i.e. the tiled output has implicit padding lanes.
    76	static bool has_inner_2d_tile_padding(const ttnn::Shape& shape) {
    77	    TT_ASSERT(shape.rank() >= 2, "has_inner_2d_tile_padding requires rank >= 2");
    78	    return (shape[-1] % tt::constants::TILE_WIDTH != 0) || (shape[-2] % tt::constants::TILE_HEIGHT != 0);
    79	}

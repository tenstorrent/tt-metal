   146	    ttnn::Shape s_shape = attrs.output_per_token_state ? ttnn::Shape({attrs.BH * attrs.T, attrs.key_dim, attrs.val_dim})
   147	                                                       : ttnn::Shape({attrs.BH, attrs.key_dim, attrs.val_dim});
   148	    return {tt::tt_metal::TensorSpec(o_shape, layout), tt::tt_metal::TensorSpec(s_shape, layout)};
   149	}

    57	// Flatten PadValue to float for fill_implicit_tile_padding.
    58	//   - uint32 + FLOAT32: caller-supplied uint32 is the bit pattern of the desired float, use bit_cast.
    59	//   - Otherwise: caller-supplied value is a numeric integer or float, use static_cast.
    60	// Note: integer pad values > 2^24 lose precision through this float bottleneck.
    61	static float pad_value_as_float(const PadValue& pad_value, DataType dtype) {
    62	    return std::visit(
    63	        [dtype](auto v) -> float {
    64	            using T = std::decay_t<decltype(v)>;
    65	            if constexpr (std::is_same_v<T, uint32_t>) {
    66	                if (dtype == DataType::FLOAT32) {
    67	                    return std::bit_cast<float>(v);
    68	                }
    69	            }
    70	            return static_cast<float>(v);
    71	        },
    72	        pad_value);
    73	}

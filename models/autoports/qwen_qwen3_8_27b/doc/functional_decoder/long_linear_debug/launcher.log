    25	def reference_prefill(ref, x, cos, sin, cache):
    26	    """Long tests compare the final 128 outputs against all valid prefix state.
    27	
    28	    Earlier tokens need only the token mixer to establish this single layer's
    29	    state. This avoids quadratic reference outputs without shortening context.
    30	    TT still computes and returns every output.
    31	    """

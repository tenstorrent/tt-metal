    33	    tail = min(length, 128) if length > 4096 else length
    34	    prefix = length - tail
    35	    if prefix and ref.layer_type == 'full_attention':
    36	        ks, vs = [], []
    37	        for start in range(0, prefix, 2048):
    38	            end = min(start + 2048, prefix)
    39	            h = ref.input_layernorm(x[:, start:end])
    40	            a = ref.self_attn
    41	            k = a.k_norm(a.k_proj(h).reshape(batch, end-start, 4, 256)).transpose(1, 2)
    42	            v = a.v_proj(h).reshape(batch, end-start, 4, 256).transpose(1, 2)
    43	            _, k = apply_rotary_pos_emb(k, k, cos[:, start:end], sin[:, start:end])
    44	            ks.append(k); vs.append(v)
    45	        cache.update(torch.cat(ks, dim=2), torch.cat(vs, dim=2), ref.self_attn.layer_idx)
    46	    elif prefix:
    47	        for start in range(0, prefix, 1024):
    48	            end = min(start + 1024, prefix)
    49	            ref.linear_attn(ref.input_layernorm(x[:, start:end]), cache_params=cache)
    50	    mask = torch.where(torch.arange(length)[None, :] > torch.arange(prefix, length)[:, None],
    51	                       float('-inf'), 0.0).to(torch.bfloat16)[None, None]
    52	    return ref(x[:, prefix:], position_embeddings=(cos[:, prefix:], sin[:, prefix:]),
    53	               attention_mask=mask if ref.layer_type == 'full_attention' else None, past_key_values=cache)

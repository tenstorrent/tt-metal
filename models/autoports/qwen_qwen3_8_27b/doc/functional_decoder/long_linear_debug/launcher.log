   192	            const auto& out_shape = output_mem_config.shard_spec().value().shape;
   193	            const uint32_t shard_dim = is_height ? out_shape[0] : out_shape[1];
   194	            const uint32_t data_per_core = (phys_dim + num_cores - 1) / num_cores;
   195	            if (data_per_core > 0 && shard_dim / data_per_core >= kOverpadWarnThreshold) {

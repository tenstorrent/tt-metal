   235	        for offset in range(0, length, self.chunk_size):
   236	            n = min(self.chunk_size, length - offset)
   237	            x = ttnn.to_layout(hidden_states[:, offset:offset + n, :], ttnn.TILE_LAYOUT)
   238	            h = self._norm(x, self.in_norm)

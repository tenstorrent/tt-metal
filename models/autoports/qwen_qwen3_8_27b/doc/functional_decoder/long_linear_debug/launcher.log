   219	ttnn::Tensor perform_reshape_on_2D_RM(
   220	    const ttnn::Tensor& tensor,
   221	    const ttnn::Shape& logical_shape,
   222	    const ttnn::Shape& padded_shape,
   223	    const MemoryConfig& memory_config,
   224	    const std::optional<CoreRangeSet>& sub_core_grid) {
   225	    // RM kernel assumes linear page ordering; use s2i/i2s for sharded buffers.
   226	    auto temp_tensor = tensor;
   227	    auto intermediate_out_memory_config = memory_config;
   228	
   229	    if (tensor.memory_config().is_sharded()) {
   230	        TT_FATAL(!sub_core_grid.has_value(), "Sharded reshape does not support sub core grid specification\n");
   231	        MemoryConfig temp_memory_config{TensorMemoryLayout::INTERLEAVED, tensor.memory_config().buffer_type()};
   232	        temp_tensor = ttnn::sharded_to_interleaved(tensor, temp_memory_config, std::nullopt);
   233	    }
   234	    if (memory_config.is_sharded()) {
   235	        intermediate_out_memory_config =
   236	            MemoryConfig{TensorMemoryLayout::INTERLEAVED, intermediate_out_memory_config.buffer_type()};
   237	    }
   238	
   239	    auto temp_tensor2 = ttnn::prim::reshape_view(
   240	        temp_tensor, logical_shape, padded_shape, intermediate_out_memory_config, false, sub_core_grid);


   185	template <bool SCALE_EN, bool is_fp32_dest_acc_en, bool CLAMP_NEGATIVE, int ITERATIONS>
   186	inline void _sfpu_exp_21f_bf16_tti_(const std::uint16_t exp_base_scale_factor) {

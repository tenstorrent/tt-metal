   445	sfpi_inline sfpi::vFloat _sfpu_exp_(sfpi::vFloat val) {
   446	    // If exponent is > -1 extract it and replace with -1
   447	    sfpi::vInt exp = exexp(val);
   448	    v_if(exp >= 0) { val = setexp(val, 126); }
   449	    v_endif;
   450	
   451	    // Run series in Horner form
   452	    sfpi::vFloat tmp = val * 0.8373f + sfpi::sFloat16b(0.863281f);
   453	    val = val * tmp + 1.0f;
   454	
   455	    v_if(exp >= 0) {
   456	        val = val * val;
   457	        for (int s_iter = 0; s_iter < 7; s_iter++) {
   458	            exp = exp - 1;
   459	            // Narrow predication on each loop
   460	            v_and(exp >= 0);
   461	            val = val * val;
   462	        }
   463	    }
   464	    v_endif;
   465	
   466	    return val;
   467	}

    18	constexpr uint32_t kDefaultDecodeChunkSize = 32;
    19	constexpr uint32_t kDefaultMaxCoresPerHeadBatch = 1;
    20	
    21	inline uint32_t get_chunk_size(uint32_t s) {
    22	    /*
    23	    # find maximum power of 2 divisor of s
    24	    for i in range(1, s):
    25	        if s % (2**(i+1)) != 0:
    26	            break
    27	    */
    28	    uint32_t i = 1;
    29	    for (; i < s; i++) {
    30	        if (s % (1 << (i + 1)) != 0) {
    31	            break;
    32	        }
    33	    }
    34	    return std::min(512, 1 << i);
    35	}

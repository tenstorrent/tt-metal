    64	constexpr float EXP_21F_BF16_C0 = 1.0017248f;
    65	constexpr float EXP_21F_BF16_C1 = 7.839635491371155e-08f;
    66	constexpr float EXP_21F_BF16_C2 = 4.791750143340323e-15f;

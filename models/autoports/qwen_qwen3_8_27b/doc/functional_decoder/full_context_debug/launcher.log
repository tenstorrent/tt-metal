   175	/*
   176	 * Implementation of _sfpu_exp_21f_bf16_ (same algorithm) with TTI intrinsics
   177	 * This implementation is faster, and give comparable accuracy as _sfpu_exp_21f_bf16_
   178	 * (~< 1 ULP).

    94	template <uint32_t Sk_chunk_t, uint32_t max_size>
    95	inline uint32_t get_dynamic_Sk_chunk_t(int cur_pos) {
    96	    if constexpr (Sk_chunk_t == 0) {
    97	        // Cur_pos + 1 for position, but -1 for divup, so cancels out
    98	        // ie. divup(a, b) = (a - 1) / b + 1
    99	        uint32_t seq_len_in_tiles = cur_pos / tt::constants::TILE_HEIGHT + 1;
   100	
   101	        // Use nearest power of 2 to nicely divide total CB size which is some factor of max_size
   102	        // Technically, should not be an issue but seeing PCC issues when using 3 tiles eg.
   103	        // - Can switch to nearest tile if this is fixed
   104	        return nearest_pow_of_2_up_to_8<max_size>(seq_len_in_tiles);
   105	    }
   106	    return Sk_chunk_t;
   107	}


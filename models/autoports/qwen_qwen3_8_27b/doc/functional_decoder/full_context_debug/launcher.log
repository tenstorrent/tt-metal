   324	    MATH(SFPU_UNARY_INIT_FN(reciprocal, sfpu::sfpu_reciprocal_init, (APPROX)));
   325	    pack_reconfig_data_format(in_cb);
   326	
   327	    cb_in.wait_front(num_tiles);
   328	    for (uint32_t i = 0; i < num_tiles; ++i) {
   329	        tile_regs_acquire();
   330	        copy_tile(in_cb, i, 0);
   331	        MATH((recip_tile_first_column(0)));
   332	        tile_regs_commit();
   333	        tile_regs_wait();
   334	        pack_tile(0, in_cb);
   335	        tile_regs_release();
   336	    }
   337	    cb_in.pop_front(num_tiles);
   338	    cb_in.reserve_back(num_tiles);
   339	    cb_in.push_back(num_tiles);
   340	}

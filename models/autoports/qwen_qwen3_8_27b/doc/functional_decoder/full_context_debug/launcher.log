/usr/bin/bash -lc "python3 - <<'PY'
import struct

def bf16(x):
    bits = struct.unpack('>I', struct.pack('>f', x))[0]
    bits = (bits + 0x7fff + ((bits >> 16) & 1)) & 0xffff0000
    return struct.unpack('>f', struct.pack('>I', bits))[0]

for sequence in (16385,262142):
    capacity=min(262144, ((sequence+128+255)//256)*256)
    print({'sequence':sequence,'capacity':capacity,'pages':capacity//32,'page_table_bytes':capacity//8})
    for pos in (sequence,sequence+1):
        length=pos+1
        chunks=(length+31)//32
        print({'position':pos,'valid_tokens':length,'padded_tokens':chunks*32,'chunks':chunks,'final_page':pos//32,'final_row':pos%32,'kv_tiles_per_core':chunks*8})
for pos in (16385,262142,262143):
    chunks=(pos+32)//32
    total=0.0
    for i in range(chunks):
        block_tokens=min(32,pos+1-i*32)
        total=bf16(total+block_tokens)
    print({'equal_logits_pos':pos,'bf16_denominator':total,'exact_denominator':pos+1,'fraction':total/(pos+1)})
print({'max_cache_tile':8191*32+3*8+7,'bytes_per_cache':8192*4*32*256*2})

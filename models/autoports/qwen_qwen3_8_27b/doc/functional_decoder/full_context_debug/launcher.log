   391	// clang-format off
   392	/**
   393	 * A blocking call that waits for the specified number of tiles to be free in the specified circular buffer. This call
   394	 * is used by the producer to wait for the consumer to consume (ie. free up) the specified number of tiles. This is a
   395	 * polling operation that does not advance any CB pointer.
   396	 *
   397	 * Return value: None
   398	 *
   399	 * | Argument  | Description                           | Type     | Valid Range                                                                                       | Required |
   400	 * |-----------|---------------------------------------|----------|---------------------------------------------------------------------------------------------------|----------|
   401	 * | cb_id     | The index of the circular buffer (CB) | uint32_t | 0 to 31                                                                                           | True     |
   402	 * | num_tiles | The number of free tiles to wait for  | uint32_t | It must be less or equal than the size of the CB (the total number of tiles that fit into the CB) | True     |
   403	 */
   404	// clang-format on
   405	FORCE_INLINE
   406	void cb_reserve_back(int32_t operand, int32_t num_pages) {
   407	    uintptr_t pages_acked_ptr = (uintptr_t)get_cb_tiles_acked_ptr(operand);
   408	
   409	    // while the producer (write-side interface) is waiting for space to free up "tiles_pushed" is not changing
   410	    // "tiles_pushed" is updated by the producer only when the tiles are pushed
   411	    uint32_t pages_received = get_cb_tiles_received_ptr(operand)[0];
   412	
   413	    int32_t free_space_pages;
   414	    WAYPOINT("CRBW");
   415	    {
   416	        SYNC_WAIT("SYNC-CB-RESERVE", operand);
   417	        do {
   418	            // uint16_t's here because Tensix updates the val at tiles_acked_ptr as uint16 in llk_pop_tiles
   419	            // TODO: I think we could have TRISC update tiles_acked_ptr, and we wouldn't need uint16 here
   420	            invalidate_l1_cache();
   421	            uint16_t pages_acked = (uint16_t)reg_read(pages_acked_ptr);
   422	            uint16_t free_space_pages_wrap =
   423	                get_local_cb_interface(operand).fifo_num_pages - (pages_received - pages_acked);
   424	            free_space_pages = (int32_t)free_space_pages_wrap;
   425	        } while (free_space_pages < num_pages);
   426	    }
   427	    WAYPOINT("CRBD");
   428	}
   429	
   430	// clang-format off
   431	/**
   432	 * A non-blocking call that tells the caller if the specified number of pages are available in the specified circular
   433	 * buffer (CB). This call is used by the consumer of the CB to see if the producer has filled the CB with at least the
   434	 * specified number of tiles. This is a polling operation that does not advance any CB pointer. See cb_wait_front for
   435	 * the blocking variant and cumulative wait semantics.
   145	};

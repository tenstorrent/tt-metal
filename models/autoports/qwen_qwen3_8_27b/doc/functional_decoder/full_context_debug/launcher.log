   738	template <uint32_t scale_fp32>
   739	void sub_exp_block(uint32_t in0_cb, uint32_t in1_cb, uint32_t out_cb, uint32_t num_tiles) {
   740	    CircularBuffer cb_in0(in0_cb);
   741	    CircularBuffer cb_in1(in1_cb);
   742	    CircularBuffer cb_out(out_cb);
   743	    // Precondition: in0_cb and in1_cb have num_tiles produced
   744	    // Postcondition: out_cb has num_tiles produced
   745	    // Postcondition: in0_cb and in1_cb has num_tiles produced
   746	
   747	    sub_init(in0_cb, in1_cb);
   748	    exp_tile_init<EXP_APPROX_MODE>();
   749	    cb_in0.wait_front(num_tiles);
   750	    cb_in1.wait_front(num_tiles);
   751	    cb_out.reserve_back(num_tiles);
   752	
   753	    // Convert scale_fp32 to bf16 scale
   754	    constexpr uint16_t scale_bf16 = scale_fp32 >> 16;
   755	
   756	    for (uint32_t i = 0; i < num_tiles; i++) {
   757	        invalidate_l1_cache();
   758	        tile_regs_acquire();
   759	        sub_tiles(in0_cb, in1_cb, i, i, 0);
   760	        MATH((exp_tile_first_column<EXP_APPROX_MODE, scale_bf16>(0)));
   761	        tile_regs_commit();
   762	        tile_regs_wait();
   763	        pack_tile(0, out_cb);
   764	        tile_regs_release();
   765	        cb_out.push_back(1);
   766	    }
   767	}

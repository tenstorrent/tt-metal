    68	template <bool is_fp32_dest_acc_en, typename C0, typename C1, typename C2>
    69	sfpi_inline sfpi::vFloat _sfpu_exp_21f_bf16_unsafe_(sfpi::vFloat val, C0 c0, C1 c1, C2 c2) {
    70	    constexpr float ONE_LN2 = 1.4426950216293334961f;

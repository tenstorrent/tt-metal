    81	    // To refine approximation of 2**(x_f), we use an approximation of 2**x on [0; 2^23]
    82	    // This uses a 2nd degree polynomial adjustment of the fractional part
    83	    frac = PolynomialEvaluator::eval(frac, c0, c1, c2);

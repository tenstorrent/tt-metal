   633	 * in0_cb += in1_cb
   634	 */
   635	template <bool pop_in1 = true>
   636	void add_block_inplace(uint32_t in0_cb, uint32_t in1_cb, uint32_t num_tiles) {
   637	    CircularBuffer cb_in0(in0_cb);
   638	    CircularBuffer cb_in1(in1_cb);
   639	    // Precondition: in0_cb and in1_cb have num_tiles produced
   640	    // Postcondition: in0_cb has num_tiles produced
   641	    // Postcondition: in1_cb has num_tiles consumed
   642	
   643	    reconfig_data_format(in0_cb, in1_cb);
   644	    pack_reconfig_data_format(in0_cb);
   645	    add_init(in0_cb, in1_cb);
   646	    cb_in0.wait_front(num_tiles);
   647	    cb_in1.wait_front(num_tiles);
   648	    for (uint32_t i = 0; i < num_tiles; i++) {
   649	        tile_regs_acquire();
   650	        add_tiles(in0_cb, in1_cb, i, i, 0);
   651	        tile_regs_commit();
   652	        tile_regs_wait();
   653	        pack_tile(0, in0_cb);
   654	        tile_regs_release();
   655	    }
   656	
   657	    cb_in0.pop_front(num_tiles);
   658	    if (pop_in1) {
   659	        cb_in1.pop_front(num_tiles);
   660	    }
   661	    cb_in0.reserve_back(num_tiles);
   662	    cb_in0.push_back(num_tiles);
   663	}

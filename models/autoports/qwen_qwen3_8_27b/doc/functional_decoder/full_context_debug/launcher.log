    11	inline uint32_t nearest_n(uint32_t x, uint32_t n) { return ((x + n - 1) / n) * n; }
    12	
    13	template <uint8_t max>
    14	inline uint8_t nearest_pow_of_2_up_to_8(uint32_t x) {
    15	    if (x == 0) {
    16	        return 1;  // Handle edge case when x is 0
    17	    }
    18	
    19	    // Round up to nearest power of 2
    20	    --x;          // Decrease x by 1 to handle exact powers of 2
    21	    x |= x >> 1;  // Propagate the highest set bit
    22	    x |= x >> 2;  // Propagate the highest set bit
    23	
    24	    // Uncomment if want to support full range of uin32_t
    25	    // x |= x >> 4;  // Propagate the highest set bit
    26	    // x |= x >> 8;  // Propagate the highest set bit
    27	    // x |= x >> 16;  // Propagate the highest set bit
    28	
    29	    uint32_t result = x + 1;  // Add 1 to get the next power of 2
    30	
    31	    // Cap the result at max
    32	    return (result > max) ? max : result;
    33	}
    34	
    35	inline std::tuple<uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t> get_workload_for_core(
    36	    int cur_pos,
    37	    int core_num,
    38	    int num_cores_per_batch,
    39	    uint32_t k_chunk_size,
    40	    std::optional<uint32_t> sliding_window_size = std::nullopt) {
    41	    uint32_t window_start = 0;
    42	    uint32_t window_start_unaligned = 0;  // Keep track of the actual window start for masking
    43	    uint32_t valid_seq_len;
    44	
    45	    if (sliding_window_size.has_value() && sliding_window_size.value() > 0) {
    46	        // Calculate actual window bounds
    47	        uint32_t window_end = cur_pos + 1;  // exclusive end
    48	        window_start_unaligned =
    49	            (window_end > sliding_window_size.value()) ? (window_end - sliding_window_size.value()) : 0;
    50	
    51	        // Round window_start down to chunk boundary to ensure we capture the full window
    52	        uint32_t window_start_aligned = (window_start_unaligned / k_chunk_size) * k_chunk_size;
    53	
    54	        // Round window_end up to chunk boundary to ensure we capture the full window
    55	        uint32_t window_end_aligned = nearest_n(window_end, k_chunk_size);
    56	
    57	        // Calculate valid_seq_len based on the sliding window range
    58	        valid_seq_len = window_end_aligned - window_start_aligned;
    59	        window_start = window_start_aligned;  // Use aligned start for chunk calculations
    60	    } else {
    61	        // Standard behavior: process from beginning up to cur_pos
    62	        valid_seq_len = nearest_n(cur_pos + 1, k_chunk_size);
    63	        window_start = 0;
    64	        window_start_unaligned = 0;
    65	    }
    66	
    67	    uint32_t pst_value = valid_seq_len / tt::constants::TILE_HEIGHT;
    68	    uint32_t window_start_chunk = window_start / k_chunk_size;
    69	    uint32_t num_chunks_value = valid_seq_len / k_chunk_size;
    70	
    71	    uint32_t k_chunk_start = window_start_chunk;
    72	    uint32_t k_chunk_end = window_start_chunk;
    73	
    74	    // Distribute active chunks among cores
    75	    if (num_cores_per_batch > int(num_chunks_value)) {
    76	        int chunks_per_core = (core_num < int(num_chunks_value)) ? 1 : 0;
    77	        k_chunk_start = window_start_chunk + (num_chunks_value - core_num - 1) * chunks_per_core;
    78	        k_chunk_end = window_start_chunk + (num_chunks_value - core_num) * chunks_per_core;
    79	    } else {
    80	        int chunks_per_core = num_chunks_value / num_cores_per_batch;
    81	        int residuals = num_chunks_value % num_cores_per_batch;
    82	        int reversed_core_num = num_cores_per_batch - core_num - 1;
    83	        k_chunk_start =
    84	            window_start_chunk + reversed_core_num * chunks_per_core + std::min(residuals, reversed_core_num);
    85	        k_chunk_end = k_chunk_start + chunks_per_core;
    86	        if (reversed_core_num < residuals) {
    87	            k_chunk_end += 1;
    88	        }
    89	    }
    90	
    91	    return {pst_value, num_chunks_value, k_chunk_start, k_chunk_end, window_start_unaligned, window_start_chunk};
    92	}

   312	@pytest.mark.timeout(120)
   313	def test_sdpa_decode_tree_reduction_power_of_2_regression(device):
   314	    """Regression test for issue #38521: tree-reduction round count off-by-one for power-of-2 core counts.
   315	
   316	    The formula `32 - __builtin_clz(num_cores_per_head)` computes floor(log2(n)) + 1,
   317	    not ceil(log2(n)). For powers of 2 these differ by 1. With num_cores_per_head=64:
   318	        32 - __builtin_clz(64) = 7, but ceil(log2(64)) = 6.
   319	    This caused a TT_FATAL because 7 > MAX_TREE_REDUCTION_ROUNDS (6), even though
   320	    64 cores genuinely fits in 6 binary-tree reduction rounds.
   321	
   322	    By omitting program_config the op uses the full device grid with no
   323	    max_cores_per_head_batch cap. With b=1 and nkv=1 this gives
   324	    num_cores_per_head == total_device_cores. When that count is a power of 2
   325	    (e.g. 64 on WH 8x8) the off-by-one fires.
   326	
   327	    The fix: `(n <= 1) ? 0 : (32 - __builtin_clz(n - 1))`.
   328	    """
   329	    import torch
   330	
   331	    grid = device.compute_with_storage_grid_size()
   332	    num_cores = grid.x * grid.y
   333	    if num_cores < 2 or (num_cores & (num_cores - 1)) != 0:
   334	        pytest.skip(
   335	            f"Device grid {grid.x}x{grid.y}={num_cores} cores is not a power of 2; "
   336	            "bug only triggers on power-of-2 core counts"
   337	        )
   338	
   339	    b, nkv, nh, s, d = 1, 1, 8, 2048, 128
   340	
   341	    torch.manual_seed(1234)
   342	    Q = torch.randn(1, b, nh, d)
   343	    K = torch.randn(b, nkv, s, d)
   344	    V = torch.randn(b, nkv, s, d)
   345	
   346	    dram = ttnn.DRAM_MEMORY_CONFIG
   347	    tt_Q = ttnn.as_tensor(Q, device=device, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, memory_config=dram)
   348	    tt_K = ttnn.as_tensor(K, device=device, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, memory_config=dram)
   349	    tt_V = ttnn.as_tensor(V, device=device, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, memory_config=dram)
   350	
   351	    start_indices_tt = ttnn.Tensor(torch.tensor([s // 2] * b, dtype=torch.int32), ttnn.int32).to(device)
   352	
   353	    # Call without program_config so the op uses the full device grid.
   354	    # With b=1, nkv=1: num_cores_per_head = total device cores (power of 2).
   355	    # Before the fix, the tree-reduction round formula was off by one → TT_FATAL.
   356	    tt_out = ttnn.transformer.scaled_dot_product_attention_decode(
   357	        tt_Q,
   358	        tt_K,
   359	        tt_V,
   360	        cur_pos_tensor=start_indices_tt,
   361	        scale=d**-0.5,
   362	        memory_config=dram,
   363	    )
   364	    assert tt_out is not None
   365	

    39	@torch.no_grad()
    40	def reference_prefill(ref, x, cos, sin, cache):
    41	    """Long tests compare the final 128 outputs against all valid prefix state.
    42	
    43	    Earlier tokens need only the token mixer to establish this single layer's
    44	    state. This avoids quadratic reference outputs without shortening context.
    45	    TT still computes and returns every output.
    46	    """
    47	    batch, length, _ = x.shape
    48	    tail = min(length, 128) if batch * length > 4096 else length
    49	    prefix = length - tail
    50	    if prefix and ref.layer_type == 'full_attention':
    51	        ks, vs = [], []
    52	        for start in range(0, prefix, 2048):
    53	            end = min(start + 2048, prefix)
    54	            h = ref.input_layernorm(x[:, start:end])
    55	            a = ref.self_attn
    56	            k = a.k_norm(a.k_proj(h).reshape(batch, end-start, 4, 256)).transpose(1, 2)
    57	            v = a.v_proj(h).reshape(batch, end-start, 4, 256).transpose(1, 2)
    58	            _, k = apply_rotary_pos_emb(k, k, cos[:, start:end], sin[:, start:end])
    59	            ks.append(k); vs.append(v)
    60	        cache.update(torch.cat(ks, dim=2), torch.cat(vs, dim=2), ref.self_attn.layer_idx)
    61	    elif prefix:
    62	        for start in range(0, prefix, 1024):
    63	            end = min(start + 1024, prefix)
    64	            ref.linear_attn(ref.input_layernorm(x[:, start:end]), cache_params=cache)
    65	    mask = torch.where(torch.arange(length)[None, :] > torch.arange(prefix, length)[:, None],
    66	                       float('-inf'), 0.0).to(torch.bfloat16)[None, None]
    67	    return ref(x[:, prefix:], position_embeddings=(cos[:, prefix:], sin[:, prefix:]),
    68	               attention_mask=mask if ref.layer_type == 'full_attention' else None, past_key_values=cache)

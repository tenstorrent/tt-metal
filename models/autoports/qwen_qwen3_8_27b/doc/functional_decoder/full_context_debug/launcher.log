   729	            move_block_ool(cb_prev_sum, cb_out_l, Sq_chunk_t);
   730	        }
   731	    }
   732	
   733	    // Free up cb_q_in after Q chunks
   734	    CircularBuffer(cb_q_in).pop_front(q_chunk_tiles);
   735	}


    88	    if constexpr (!is_fp32_dest_acc_en) {
    89	        // LRegs work on float32 data. If DST is bfloat16 then SFPSTORE will truncate it.
    90	        // This can reduce accuracy: for instance, 9**2 = 80.8 gets round to 80.5
    91	        // rather than 81 (which would have been correct).
    92	        // To avoid this issue, we explicitly convert to bfloat16 using round-to-nearest.
    93	        y = sfpi::convert<sfpi::vFloat16b>(y, sfpi::RoundMode::Nearest);
    94	    }

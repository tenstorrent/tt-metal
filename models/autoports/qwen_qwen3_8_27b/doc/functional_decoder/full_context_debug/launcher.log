   317	void recip_block_inplace(uint32_t in_cb, uint32_t num_tiles) {
   318	    CircularBuffer cb_in(in_cb);
   319	    // Precondition: in_cb has num_tiles produced
   320	    // Postcondition: in_cb has num_tiles produced
   321	    reconfig_data_format_srca(in_cb);
   322	    copy_init(in_cb);

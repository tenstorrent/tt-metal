    36	sfpi_inline sfpi::vInt _float_to_int32_for_exp_21f_(sfpi::vFloat val) {
    37	    sfpi::vInt exp = sfpi::exexp(val);
    38	    sfpi::vInt man =
    39	        sfpi::exman(val, sfpi::MantissaMode::ImplicitOne);  // get mantissa with implicit bit (man in [1; 2])

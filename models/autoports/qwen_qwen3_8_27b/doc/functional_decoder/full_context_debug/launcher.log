     5	#include "sdpa_decode_device_operation.hpp"
     6	#include "ttnn/tensor/tensor_ops.hpp"
     7	#include "ttnn/device_operation.hpp"
     8	
     9	#include <cstdint>
    10	
    11	#include <tt-metalium/constants.hpp>
    12	
    13	#include "ttnn/operation.hpp"
    14	#include "ttnn/tensor/tensor_utils.hpp"
    15	
    16	#include <tt_stl/reflection.hpp>
    17	
    18	using namespace tt::tt_metal;
    19	
    20	namespace ttnn::prim {
    21	void SdpaDecodeDeviceOperation::validate_on_program_cache_miss(
    22	    const operation_attributes_t& operation_attributes, const tensor_args_t& tensor_args) {
    23	    bool use_mla = operation_attributes.use_mla.value_or(false);
    24	    const uint32_t spec_T = operation_attributes.spec_multi_pos_tiles;
    25	    const bool spec_multi_pos = spec_T > 0;
    26	
    27	    if (use_mla) {
    28	        TT_FATAL(
    29	            operation_attributes.head_dim_v.has_value(), "Must provide head_dim_v for multi-latent attention decode");
    30	        TT_FATAL(operation_attributes.is_causal, "Multi-latent attention decode only tested for causal!");
    31	    } else {
    32	        TT_FATAL(tensor_args.v.has_value(), "Must have 3 input tensors and mask");
    33	    }
    34	
    35	    std::vector<Tensor> input_tensors{{tensor_args.q}, {tensor_args.k}};
    36	    if (tensor_args.v.has_value()) {
    37	        input_tensors.emplace_back(tensor_args.v.value());
    38	    }
    39	    for (const auto& input_tensor : input_tensors) {
    40	        TT_FATAL(input_tensor.storage_type() == StorageType::DEVICE, "Operands to SDPA need to be on device!");
    41	        TT_FATAL(input_tensor.buffer() != nullptr, "Operands to SDPA need to be allocated in buffers on device!");
    42	        TT_FATAL(
    43	            input_tensor.dtype() == DataType::BFLOAT16 || input_tensor.dtype() == DataType::BFLOAT8_B ||
    44	                input_tensor.dtype() == DataType::BFLOAT4_B,
    45	            "Unsupported data type {}.",
    46	            input_tensor.dtype());
    47	    }
    48	
    49	    for (size_t i = 1; i < input_tensors.size(); i++) {
    50	        TT_FATAL(input_tensors.at(i).layout() == Layout::TILE, "Inputs to SDPA must be tilized except for Q");
    51	    }
    52	
    53	    const auto q_shape = input_tensors.at(0).padded_shape();
    54	    const auto q_shape_unpadded = input_tensors.at(0).logical_shape();
    55	    const auto k_shape = input_tensors.at(1).padded_shape();
    56	    const auto v_shape = input_tensors.size() > 2 ? input_tensors.at(2).padded_shape() : k_shape;
    57	
    58	    // When using multi-latent attention, the V tensor is the same as K tensor, but of smaller head dimension.
    59	    // If V tensor is not provided, we assume that V is subset of K in the hidden dimension. Hence we use K shape for V.
    60	    // If V tensor is provided, we take the V tensor and use that to validate head_dim_v. (hidden dim of V must be equal
    61	    // to head_dim_v)
    62	
    63	    if (use_mla) {
    64	        // Head dim v validation
    65	        if (tensor_args.v.has_value()) {
    66	            TT_FATAL(
    67	                v_shape[3] == operation_attributes.head_dim_v.value(),
    68	                "Head dimension of V must be equal to head_dim_v, got {} and {}",
    69	                v_shape[3],
    70	                operation_attributes.head_dim_v.value());
    71	        }
    72	        TT_FATAL(
    73	            q_shape[3] == k_shape[3],
    74	            "Head dimension of Q must be equal to head dim of K, got {} and {}",
    75	            q_shape[3],
    76	            k_shape[3]);
    77	        TT_FATAL(
    78	            operation_attributes.head_dim_v.value() <= q_shape[3],
    79	            "Head dimension of V must be less than or equal to head dim of Q, got {} and {}",
    80	            operation_attributes.head_dim_v.value(),
    81	            q_shape[3]);
    82	    }
    83	
    84	    if (spec_multi_pos) {
    85	        // Speculative multi-position mode: spec_T candidates folded onto EACH batch row, so
    86	        // every row scans its KV cache once instead of spec_T times. With B batch rows the
    87	        // call carries B*spec_T candidates; batch b owns cur_pos entries
    88	        // [b*spec_T, (b+1)*spec_T). Everything below is what the kernel path assumes; a
    89	        // violation would silently produce wrong attention bounds rather than fail, so all
    90	        // of it is checked up front.
    91	        TT_FATAL(operation_attributes.is_causal, "spec_multi_pos_tiles requires is_causal");
    92	        TT_FATAL(operation_attributes.paged_attention, "spec_multi_pos_tiles requires paged attention");
    93	        TT_FATAL(tensor_args.page_table_tensor.has_value(), "spec_multi_pos_tiles requires a page_table tensor");
    94	        TT_FATAL(!use_mla, "spec_multi_pos_tiles is not supported with multi-latent attention");
    95	        TT_FATAL(
    96	            !operation_attributes.sliding_window_size.has_value() ||
    97	                operation_attributes.sliding_window_size.value() == 0,
    98	            "spec_multi_pos_tiles is not supported with sliding_window_size");
    99	        TT_FATAL(
   100	            !tensor_args.attn_mask.has_value(), "spec_multi_pos_tiles is not supported with an explicit attn_mask");
   101	        TT_FATAL(
   102	            !input_tensors.at(0).is_sharded(),
   103	            "spec_multi_pos_tiles requires an unsharded (DRAM interleaved) Q tensor");
   104	        TT_FATAL(
   105	            input_tensors.at(0).dtype() == DataType::BFLOAT16,
   106	            "spec_multi_pos_tiles requires a BFLOAT16 Q tensor, got {}",
   107	            input_tensors.at(0).dtype());
   108	        TT_FATAL(
   109	            input_tensors.at(0).layout() == Layout::TILE,
   110	            "spec_multi_pos_tiles requires a TILE layout Q tensor, got {}",
   111	            input_tensors.at(0).layout());
   112	        TT_FATAL(k_shape[1] == 1, "spec_multi_pos_tiles requires num_kv_heads == 1, got {}", k_shape[1]);
   113	        TT_FATAL(
   114	            q_shape[2] == spec_T * tt::constants::TILE_HEIGHT,
   115	            "spec_multi_pos_tiles={}: Q must have {} padded rows per batch (one 32-row tile per candidate), got {}",
   116	            spec_T,
   117	            spec_T * tt::constants::TILE_HEIGHT,
   118	            q_shape[2]);
   119	        const auto& spec_page_table = tensor_args.page_table_tensor.value();
   120	        TT_FATAL(!spec_page_table.is_sharded(), "spec_multi_pos_tiles requires an unsharded page_table tensor");
   121	        // B comes from the page table in paged mode (see the program factory), so the Q batch
   122	        // dim must agree with it: one page-table row per group of spec_T candidates.
   123	        TT_FATAL(
   124	            spec_page_table.padded_shape()[0] == q_shape[1],
   125	            "spec_multi_pos_tiles: page_table must have one row per Q batch group, got {} rows for Q batch {}",
   126	            spec_page_table.padded_shape()[0],
   127	            q_shape[1]);
   128	        TT_FATAL(tensor_args.cur_pos_tensor.has_value(), "spec_multi_pos_tiles requires a cur_pos tensor");
   129	        // use_half_tile is is_causal && num_q_heads <= 16 && bf16; num_q_heads is T*32 > 16
   130	        // here so it is already false, but the kernel path (full-tile masks, full-tile Q
   131	        // row-tiles) depends on it, so make the dependency explicit.
   132	        TT_FATAL(
   133	            q_shape_unpadded[2] > 16,
   134	            "spec_multi_pos_tiles requires full 32x32 tiles (use_half_tile must be false), but Q has {} logical heads",
   135	            q_shape_unpadded[2]);
   136	    }
   137	
   138	    // Input 0 must be sharded by height or DRAM interleaved. All other inputs must be in DRAM.
   139	    const auto Q_memcfg = input_tensors.at(0).memory_config();
   140	    if (input_tensors.at(0).is_sharded()) {
   141	        TT_FATAL(
   142	            Q_memcfg.memory_layout() == TensorMemoryLayout::HEIGHT_SHARDED,
   143	            "Q tensor memory layout must be HEIGHT_SHARDED when sharded but got {}",
   144	            Q_memcfg.memory_layout());
   145	    } else {
   146	        TT_FATAL(
   147	            Q_memcfg.buffer_type() == tt::tt_metal::BufferType::DRAM,
   148	            "Q tensor buffer type must be DRAM when not sharded but got {}",
   149	            Q_memcfg.buffer_type());
   150	    }
   151	
   152	    // ROW_MAJOR Q is only supported when Q is height-sharded in L1. The interleaved reader path always
   153	    // reads Q as tiles into the tilized Q CB, while compute waits on the row-major Q CB whenever Q is
   154	    // ROW_MAJOR -> the kernels deadlock and hang the device (#58698). Likewise, a ROW_MAJOR Q selects a
   155	    // ROW_MAJOR output, and the interleaved writer path writes tile-sized pages, which is only valid for
   156	    // a sharded output whose shard buffer backs the output CB directly.
   157	    if (input_tensors.at(0).layout() == Layout::ROW_MAJOR) {
   158	        TT_FATAL(
   159	            input_tensors.at(0).is_sharded(),
   160	            "ROW_MAJOR Q is only supported when Q is HEIGHT_SHARDED in L1; interleaved ROW_MAJOR Q is not "
   161	            "supported. Convert Q to TILE layout or shard it.");
   162	        TT_FATAL(
   163	            operation_attributes.output_mem_config.is_sharded(),
   164	            "ROW_MAJOR Q produces a ROW_MAJOR output, which requires a HEIGHT_SHARDED output memory config; "
   165	            "got {}",
   166	            operation_attributes.output_mem_config.memory_layout());
   167	    }
   168	
   169	    for (std::size_t i = 1; i < input_tensors.size(); i++) {
   170	        TT_FATAL(
   171	            input_tensors.at(i).buffer()->buffer_type() == tt::tt_metal::BufferType::DRAM,
   172	            "Input tensor {} buffer type must be DRAM but got {}",
   173	            i,
   174	            input_tensors.at(i).buffer()->buffer_type());
   175	    }
   176	    // Output memconfig must be height sharded or DRAM
   177	    if (operation_attributes.output_mem_config.is_sharded()) {
   178	        TT_FATAL(
   179	            operation_attributes.output_mem_config.memory_layout() == TensorMemoryLayout::HEIGHT_SHARDED,
   180	            "Output memory config layout must be HEIGHT_SHARDED when sharded but got {}",
   181	            operation_attributes.output_mem_config.memory_layout());
   182	    }
   183	
   184	    if (!operation_attributes.is_causal) {
   185	        if (tensor_args.attn_mask.has_value()) {
   186	            // Non-causal: an explicit mask is permitted, so validate its shape and dtype
   187	            const auto& mask_tensor = tensor_args.attn_mask.value();
   188	            const auto mask_shape = mask_tensor.padded_shape();
   189	            const auto mask_shape_unpadded = mask_tensor.logical_shape();
   190	
   191	            TT_FATAL(
   192	                mask_shape[2] == q_shape[2],
   193	                "Expect same number of padded heads in mask as in Q, got {} and {}",
   194	                mask_shape[2],
   195	                q_shape[2]);
   196	            TT_FATAL(
   197	                mask_shape_unpadded[2] == q_shape_unpadded[2],
   198	                "Expect same number of heads in mask as in Q, got {} and {}",
   199	                mask_shape_unpadded[2],
   200	                q_shape_unpadded[2]);
   201	            if (!operation_attributes.paged_attention) {
   202	                TT_FATAL(
   203	                    mask_shape[3] == k_shape[2],
   204	                    "Expect same sequence length in mask as in K, got {} and {}",
   205	                    mask_shape[3],
   206	                    k_shape[2]);
   207	            }
   208	
   209	            TT_FATAL(operation_attributes.k_chunk_size > 0, "Must provide k_chunk_size if using attention mask!");
   210	            TT_FATAL(
   211	                mask_shape[3] % operation_attributes.k_chunk_size == 0,
   212	                "Mask sequence length must be multiple of chunk size, got: {} and {}",
   213	                mask_shape[3],
   214	                operation_attributes.k_chunk_size);
   215	
   216	            TT_FATAL(
   217	                mask_tensor.dtype() == DataType::BFLOAT16 || mask_tensor.dtype() == DataType::BFLOAT8_B ||
   218	                    mask_tensor.dtype() == DataType::BFLOAT4_B,
   219	                "Unsupported data type for mask tensor: {}.",
   220	                mask_tensor.dtype());
   221	        }
   222	    } else {
   223	        // Causal: causality is applied from cur_pos on device, so an explicit mask is rejected
   224	        TT_FATAL(
   225	            not tensor_args.attn_mask.has_value(),
   226	            "attn_mask must not be provided when is_causal=True. Pass is_causal=False to use an explicit mask.");
   227	    }
   228	
   229	    const auto& paged_geo = operation_attributes.paged_cache_geometry;
   230	    if (paged_geo.active()) {
   231	        TT_FATAL(
   232	            tensor_args.page_table_tensor.has_value(),
   233	            "PagedCacheGeometryOverride is only supported in paged mode (when page_table is provided)");
   234	        TT_FATAL(paged_geo.block_size > 0, "PagedCacheGeometryOverride.block_size must be > 0");
   235	        TT_FATAL(paged_geo.num_kv_heads > 0, "PagedCacheGeometryOverride.num_kv_heads must be > 0");
   236	    }
   237	
   238	    if (operation_attributes.cache_position_modulo.has_value()) {
   239	        TT_FATAL(
   240	            tensor_args.page_table_tensor.has_value(),
   241	            "cache_position_modulo is only supported in paged mode (when page_table is provided)");
   242	        const uint32_t modulo = operation_attributes.cache_position_modulo.value();
   243	        TT_FATAL(modulo > 0, "cache_position_modulo must be > 0 when provided");
   244	        // Wrap must align with block boundaries (otherwise a wrapped position would split
   245	        // across two physical blocks and the kernel can't address it). Pull
   246	        // effective_block_size from the same fallback the program factory uses.
   247	        // block_size>0 is already enforced above when the override is active.
   248	        const uint32_t effective_block_size = paged_geo.active() ? paged_geo.block_size : k_shape[2];
   249	        TT_FATAL(
   250	            modulo % effective_block_size == 0,
   251	            "cache_position_modulo ({}) must be a multiple of effective block_size ({})",
   252	            modulo,
   253	            effective_block_size);
   254	        if (operation_attributes.sliding_window_size.has_value() &&
   255	            operation_attributes.sliding_window_size.value() > 0) {
   256	            TT_FATAL(
   257	                modulo >= operation_attributes.sliding_window_size.value(),
   258	                "cache_position_modulo ({}) must be >= sliding_window_size ({}); a tighter "
   259	                "capacity would let the SDPA attention range wrap multiple times and "
   260	                "double-count positions.",
   261	                modulo,
   262	                operation_attributes.sliding_window_size.value());
   263	        }
   264	    }
   265	
   266	    if (operation_attributes.is_causal && tensor_args.cur_pos_tensor.has_value() &&
   267	        !tensor_args.cur_pos_tensor->is_sharded()) {
   268	        // The reader fetches only page 0 of an interleaved cur_pos tensor and indexes it by batch,
   269	        // so every position must sit in that one row. A [B, 1] tensor has B one-entry pages: batch
   270	        // b > 0 would read page padding as its position and scan far past the KV cache (hang).
   271	        const auto& cur_pos_shape = tensor_args.cur_pos_tensor->padded_shape();
   272	        TT_FATAL(
   273	            cur_pos_shape.volume() == cur_pos_shape[-1],
   274	            "cur_pos tensor must hold all positions in its last dim (e.g. [B] or [1, B]), got shape {}",
   275	            cur_pos_shape);
   276	    }
   277	
   278	    if (operation_attributes.paged_attention) {
   279	        // Paged attention verification
   280	        TT_FATAL(
   281	            !operation_attributes.share_cache.value_or(false), "Share cache feature not supported for paged attention");
   282	        TT_FATAL(tensor_args.page_table_tensor.has_value(), "Must have page_table tensor for paged attention");
   283	        const auto& page_table_tensor = tensor_args.page_table_tensor.value();
   284	        const auto B = page_table_tensor.is_sharded() ? q_shape[1] : page_table_tensor.padded_shape()[0];
   285	
   286	        if (operation_attributes.is_causal) {
   287	            // Check cur pos tensor for causal mode
   288	            TT_FATAL(
   289	                tensor_args.cur_pos_tensor.has_value(), "Must have cur_pos tensor for paged attention in causal mode");
   290	            const auto& cur_pos_tensor = tensor_args.cur_pos_tensor.value();
   291	            TT_FATAL(
   292	                cur_pos_tensor.dtype() == DataType::INT32,
   293	                "Expect cur_pos to be INT32, got {}",
   294	                cur_pos_tensor.dtype());
   295	            TT_FATAL(
   296	                cur_pos_tensor.layout() == Layout::ROW_MAJOR,
   297	                "Expect cur_pos to be ROW_MAJOR, got {}",
   298	                cur_pos_tensor.layout());
   299	            const auto cur_pos_shape = cur_pos_tensor.padded_shape();
   300	
   301	            if (!cur_pos_tensor.is_sharded()) {
   302	                if (spec_multi_pos) {
   303	                    // Spec mode collapses spec_T candidates onto each batch row, so cur_pos
   304	                    // carries B*spec_T entries: batch b's group is [b*spec_T, (b+1)*spec_T).
   305	                    TT_FATAL(
   306	                        cur_pos_shape[-1] == B * spec_T,
   307	                        "spec_multi_pos_tiles={}: cur_pos must have {} entries (B={} groups of {}), got {}",
   308	                        spec_T,
   309	                        B * spec_T,
   310	                        B,
   311	                        spec_T,
   312	                        cur_pos_shape[-1]);
   313	                    // Within a group the entries must be non-decreasing: the reader takes the group's

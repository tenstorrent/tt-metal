   104	/*
   105	 * This function implements the exponential function using a polynomial approximation algorithm
   106	 * based on "Simple Multiple Precision Algorithms for Exponential Functions [Tips & Tricks]"
   107	 * by Moroz et al. 2022 (https://doi.org/10.1109/MSP.2022.3157460).
   108	 * More specifically, it is the implementation of the `exp_21f` algorithm described in Section 5
   109	 *
   110	 * @param val The input value (sfpi::vFloat vector), can be any floating point number
   111	 *
   112	 * @return sfpi::vFloat Result of exp(val)
   113	 *
   114	 * @see Moroz et al. 2022 - "Simple Multiple Precision Algorithms for Exponential Functions"
   115	 *      ( https://doi.org/10.1109/MSP.2022.3157460 )
   116	 */
   117	// Like the unsafe overload, accepts EXP_21F_BF16_C0..C2 as floats or preloaded
   118	// vFloats. A fused caller can retain them across its loop without changing the clamp.
   119	template <bool is_fp32_dest_acc_en, typename C0, typename C1, typename C2>
   120	sfpi_inline sfpi::vFloat _sfpu_exp_21f_bf16_(sfpi::vFloat val, C0 c0, C1 c1, C2 c2) {
   121	    // This function computes exp(x) by leveraging mathematic properties of exp(x):
   122	    // That is, exp(x) = 2**(x / ln2) = 2**(x_i) * 2**(x_f) where
   123	    // - z_i = trunc(x / ln2) (integer part)
   124	    // - z_f = x/ln2 - trunc(x/ln2) (fractional part)
   125	    //
   126	    // The paper relies on the following formula (c.f. Section 2 and 3 of paper):
   127	    // z = (bias + x * factor * N_m); where:
   128	    // factor = log(2) * 2^23
   129	    // bias = 127 * 2^23
   130	    // Fundamentally, the formula in the paper computes
   131	    // z = val * log(2) * 2^23 + 127 * 2^23
   132	    // This formula prepares for the computation of exp(x) = 2^(x/log(2))
   133	    //
   134	    // In our case, we will let the multiplication by 2^23 be done implicitly in _float_to_int32_exp21f_ function
   135	    constexpr float ONE_LN2 = 1.4426950216293334961f;
   136	    sfpi::vFloat xlog2 = (val * ONE_LN2 + 127.f);
   137	
   138	    // Intermediary values can overflow in xlog2 is outside of [0, 256[ which leads to invalid results instead of 0
   139	    // (when input < -88.5) and +inf (when input > 88.5)
   140	    // To avoid this, we clamp xlog2 to [0, 255]
   141	    // (thresholds values are rounded to bf16, as it does not change result but only requires one SFPLOADI vs. two)
   142	    xlog2 = sfpi::clamp(xlog2, 0.0f, 255.0f);
   143	
   144	    sfpi::vFloat z = sfpi::as<sfpi::vFloat>(_float_to_int32_for_exp_21f_(xlog2));
   145	
   146	    sfpi::vInt exponential_part =
   147	        exexp(z, sfpi::ExponentMode::Biased);     // Extract exponent ( = 2**(integer part of val/ln2))
   148	    sfpi::vMag fractional_part = sfpi::exman(z);  // Extract mantissa ( = leftover part, in [0; 1])
   149	
   150	    sfpi::vFloat frac = sfpi::convert<sfpi::vFloat>(fractional_part, sfpi::RoundMode::Nearest);
   151	
   152	    // To refine approximation of 2**(x_f), we use an approximation of 2**x on [0; 2^23]
   153	    // This uses a 2nd degree polynomial adjustment of the fractional part
   154	    frac = PolynomialEvaluator::eval(frac, c0, c1, c2);
   155	
   156	    // Recombined exponent and mantissa: this is equivalent to 2**(x_i) * 2**(x_f)
   157	    sfpi::vFloat y = sfpi::setexp(frac, exponential_part);
   158	
   159	    if constexpr (!is_fp32_dest_acc_en) {
   160	        // LRegs work on float32 data. If DST is bfloat16 then SFPSTORE will truncate it.
   161	        // This can reduce accuracy: for instance, 9**2 = 80.8 gets round to 80.5
   162	        // rather than 81 (which would have been correct).
   163	        // To avoid this issue, we explicitly convert to bfloat16 using round-to-nearest.
   164	        y = sfpi::convert<sfpi::vFloat16b>(y, sfpi::RoundMode::Nearest);
   165	    }
   166	
   167	    return y;
   168	}

   150	/*
   151	Stochastic rounding modes:
   152	    None: No stochastic rounding enabled, default rounding is round to nearest even.
   153	    Fpu: Enables stochastic rounding for every accumulation in the fpu
   154	    Pack: Enables stochastic rounding in both gasket and packer. Gasket rounding is in
   155	    data format conversion stage from dest format to pack_src_format. Packer rounding
   156	    is in data format conversion stage from pack_src_format to pack_dst_format.
   157	    All: Enables fpu, pack and gasket rounding.
   158	*/
   159	enum class StochRndType : std::uint8_t
   160	{
   161	    None = 0,
   162	    Fpu  = 1,
   163	    Pack = 2,
   164	    All  = 0xf,
   165	};

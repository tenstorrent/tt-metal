   232	    def prefill_forward(self, hidden_states, *, state, start_position=0, page_table=None, cos=None, sin=None):
   233	        """Chunked [B,S,H] prefill, all logical outputs returned; resume at a chunk boundary.
   234	
   235	        cos/sin: [B,1,S,64] for absolute positions start_position..start_position+S.
   236	        Linear state summarizes precisely the prefix; paged state owns the prefix pages.
   237	        """
   238	        batch, length, _ = hidden_states.shape
   239	        if not 0 < length or start_position + length > self.config.max_position_embeddings:
   240	            raise ValueError("Invalid logical sequence extent")
   241	        if start_position % self.chunk_size:
   242	            raise ValueError("Prefill continuation starts at a chunk boundary; decode handles individual tokens")
   243	        outputs = []
   244	        for offset in range(0, length, self.chunk_size):
   245	            n = min(self.chunk_size, length - offset)
   246	            x = ttnn.to_layout(hidden_states[:, offset:offset + n, :], ttnn.TILE_LAYOUT)
   247	            h = self._norm(x, self.in_norm)
   248	            if self.layer_type == "linear_attention":

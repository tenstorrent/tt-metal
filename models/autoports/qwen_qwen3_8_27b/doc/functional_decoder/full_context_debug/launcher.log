   185	    std::optional<float> scale,
   186	    std::optional<uint32_t> sliding_window_size,
   187	    const std::optional<MemoryConfig>& memory_config,
   188	    std::optional<ttnn::operations::transformer::SDPAProgramConfig> program_config,
   189	    std::optional<DeviceComputeKernelConfig> compute_kernel_config) {
   190	    uint32_t s = input_tensor_k.logical_shape()[-2];
   191	    uint32_t k_chunk_size = get_chunk_size(s);
   192	    if (program_config.has_value() && program_config.value().k_chunk_size > 0) {
   193	        k_chunk_size = program_config.value().k_chunk_size;
   194	        // assert chunk size must be power of 2 and multiple of 32
   195	        TT_FATAL(
   196	            (k_chunk_size & (k_chunk_size - 1)) == 0,
   197	            "User provided k_chunk_size must be power of 2, got: {}",
   198	            k_chunk_size);
   199	        TT_FATAL(k_chunk_size % 32 == 0, "User provided k_chunk_size must be multiple of 32, got: {}", k_chunk_size);
   200	    } else {
   201	        TT_FATAL(
   202	            k_chunk_size % 32 == 0,
   203	            "Chunk size must be multiple of 32, but the maximum calculated k_chunk_size is: {}",
   204	            k_chunk_size);
   205	    }
   206	
   207	    if (input_tensor_v.has_value()) {
   208	        TT_FATAL(
   209	            input_tensor_v.value().padded_shape()[-1] == head_dim_v,
   210	            "Head dimension of the V tensor must be equal to head_dim_v parameter value, got {} and {}",
   211	            input_tensor_v.value().padded_shape()[-1],
   212	            head_dim_v);
   213	    }
   214	    // get chunk size and then pass to sdpa decode as an attribute for prgm cache
   215	    auto kernel_config_val = init_device_compute_kernel_config(
   216	        input_tensor_q.device()->arch(), compute_kernel_config, tt::tt_metal::MathFidelity::HiFi2, true, false, false);
   217	
   218	    return ttnn::prim::sdpa_decode(
   219	        input_tensor_q,
   220	        input_tensor_k,
   221	        input_tensor_v,
   222	        cur_pos_tensor,
   223	        std::nullopt,
   224	        attn_mask,
   225	        attention_sink,
   226	        is_causal,
   227	        false,
   228	        cur_pos,
   229	        scale,
   230	        sliding_window_size,
   231	        memory_config.value_or(operation::DEFAULT_OUTPUT_MEMORY_CONFIG),
   232	        program_config,
   233	        kernel_config_val,
   234	        k_chunk_size,
   235	        std::nullopt,
   236	        true,
   237	        head_dim_v);
   238	}
   239	
   240	ttnn::Tensor paged_flash_multi_latent_attention_decode(
   241	    const ttnn::Tensor& input_tensor_q,
   242	    const ttnn::Tensor& input_tensor_k,
   243	    const std::optional<const Tensor>& input_tensor_v,
   244	    const uint32_t head_dim_v,
   245	    const ttnn::Tensor& page_table_tensor,
   246	    const bool is_causal,
   247	    const std::optional<const Tensor>& attn_mask,
   248	    const std::optional<const Tensor>& cur_pos_tensor,
   249	    const std::optional<const Tensor>& attention_sink,
   250	    std::optional<float> scale,
   251	    std::optional<uint32_t> sliding_window_size,
   252	    const std::optional<MemoryConfig>& memory_config,
   253	    std::optional<ttnn::operations::transformer::SDPAProgramConfig> program_config,
   254	    std::optional<DeviceComputeKernelConfig> compute_kernel_config) {
   255	    // NOTE: If V tensor is not provided, the operator assumes that V is subset of K in the hidden dimension.
   256	    // and V will be read from the K tensor buffer.
   257	
   258	    // Use k_chunk_size as override; if k_chunk_size == 0, figure it out in kernels
   259	    // uint32_t k_chunk_size = get_chunk_size(s);
   260	    uint32_t k_chunk_size = 0;
   261	    if (program_config.has_value() && program_config.value().k_chunk_size > 0) {
   262	        k_chunk_size = program_config.value().k_chunk_size;
   263	        // assert chunk size must be power of 2 and multiple of 32
   264	        TT_FATAL(
   265	            (k_chunk_size & (k_chunk_size - 1)) == 0,
   266	            "User provided k_chunk_size must be power of 2, got: {}",
   267	            k_chunk_size);
   268	        TT_FATAL(k_chunk_size % 32 == 0, "User provided k_chunk_size must be multiple of 32, got: {}", k_chunk_size);
   269	    }
   270	
   271	    if (input_tensor_v.has_value()) {
   272	        TT_FATAL(
   273	            input_tensor_v.value().padded_shape()[-1] == head_dim_v,
   274	            "Head dimension of the V tensor must be equal to head_dim_v parameter value, got {} and {}",
   275	            input_tensor_v.value().padded_shape()[-1],
   276	            head_dim_v);
   277	    }
   278	
   279	    // get chunk size and then pass to sdpa decode as an attribute for prgm cache
   280	    auto kernel_config_val = init_device_compute_kernel_config(
   281	        input_tensor_q.device()->arch(), compute_kernel_config, tt::tt_metal::MathFidelity::HiFi2, true, false, false);
   282	
   283	    return ttnn::prim::sdpa_decode(
   284	        input_tensor_q,
   285	        input_tensor_k,
   286	        input_tensor_v,
   287	        cur_pos_tensor,
   288	        page_table_tensor,
   289	        attn_mask,
   290	        attention_sink,
   291	        is_causal,
   292	        true,
   293	        std::vector<uint32_t>(),
   294	        scale,
   295	        sliding_window_size,
   296	        memory_config.value_or(operation::DEFAULT_OUTPUT_MEMORY_CONFIG),
   297	        program_config,
   298	        kernel_config_val,
   299	        k_chunk_size,
   300	        std::nullopt,
   301	        true,
   302	        head_dim_v);
   303	}

    31	def audit_runtime(function):
    32	    def checked(*args, **kwargs):
    33	        with NoTorchRuntime(), patch.object(ttnn, 'from_torch', side_effect=AssertionError('runtime from_torch')), \
    34	                patch.object(ttnn, 'to_torch', side_effect=AssertionError('runtime to_torch')):
    35	            return function(*args, **kwargs)
    36	    return checked

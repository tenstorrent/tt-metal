    17	// Wait for N tiles available in the incoming stream
    18	inline void llk_wait_tiles(int operand, std::int32_t num_tiles) {
    19	    DeviceZoneScopedSumN1("CB-COMPUTE-WAIT-FRONT");
    20	    std::uint32_t input = operand;
    21	
    22	    volatile tt_l1_ptr std::uint32_t* tiles_received_ptr = get_cb_tiles_received_ptr(operand);
    23	    std::uint16_t num_tiles_u = (std::uint16_t)num_tiles;
    24	
    25	    std::uint16_t tiles_received;
    26	
    27	    uint16_t num_tiles_recv;
    28	    {
    29	        SYNC_WAIT("SYNC-CB-WAIT", operand);
    30	        do {
    31	            tiles_received = (std::uint16_t)reg_read((std::uint32_t)tiles_received_ptr);
    32	            num_tiles_recv = tiles_received - get_local_cb_interface(input).tiles_acked;
    33	        } while (num_tiles_recv < num_tiles_u);
    34	    }
    35	}
    36	
    37	// Pop N tiles from the incoming stream
    38	inline void llk_pop_tiles(
    39	    const std::int32_t operand, const std::int32_t num_tiles, const std::int32_t block_c_dim = 0) {
    40	    SYNC_SIGNAL("SYNC-CB-POP", operand);
    41	    std::uint32_t input = operand;
    42	
    43	    // Convert the counter's byte address to a Tensix 4-byte word address, masked to 18 bits.
    44	    const std::uint32_t tiles_acked_addr_tensix =
    45	        static_cast<std::uint32_t>((reinterpret_cast<std::uintptr_t>(get_cb_tiles_acked_ptr(operand)) >> 2) & 0x3ffff);
    46	    std::uint32_t num_words = num_tiles * get_local_cb_interface(operand).fifo_page_size;
    47	
    48	    get_local_cb_interface(input).tiles_acked += num_tiles;
    49	    TT_SETDMAREG(0, get_local_cb_interface(input).tiles_acked, 0, LO_16(4));
    50	    TTI_STALLWAIT(p_stall::STALL_THCON, p_stall::UNPACK);
    51	    TT_STOREREG(4, tiles_acked_addr_tensix);
    52	    auto& cb = get_local_cb_interface(input);
    53	
    54	    LLK_ASSERT(cb.fifo_rd_ptr < cb.fifo_limit, "CB pop_front: fifo_rd_ptr already at or past fifo_limit");
    55	
   385	    // TODO: I think we could have TRISC update tiles_acked_ptr, and we wouldn't need uint16 here
   386	    uint16_t pages_acked = (uint16_t)reg_read(pages_acked_ptr);
   387	    uint16_t free_space_pages_wrap = get_local_cb_interface(operand).fifo_num_pages - (pages_received - pages_acked);
   388	    return num_pages <= static_cast<int32_t>(free_space_pages_wrap);
   389	}

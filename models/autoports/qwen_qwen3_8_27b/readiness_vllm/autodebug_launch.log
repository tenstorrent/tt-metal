   240	    def prefill_forward(self, hidden_states, *, state, start_position=0, page_table=None, cos=None, sin=None):
   241	        """Chunked [B,S,H] prefill, all logical outputs returned; resume at a chunk boundary.
   242	
   243	        cos/sin: [B,1,S,64] for absolute positions start_position..start_position+S.
   244	        Linear state summarizes precisely the prefix; paged state owns the prefix pages.
   245	        """
   246	        batch, length, _ = hidden_states.shape
   247	        if not 0 < length or start_position + length > self.config.max_position_embeddings:
   248	            raise ValueError("Invalid logical sequence extent")
   249	        if start_position % self.chunk_size:
   250	            raise ValueError("Prefill continuation starts at a chunk boundary; decode handles individual tokens")
   251	        outputs = []
   252	        for offset in range(0, length, self.chunk_size):
   253	            n = min(self.chunk_size, length - offset)
   254	            x = ttnn.to_layout(hidden_states[:, offset:offset + n, :], ttnn.TILE_LAYOUT)
   255	            h = self._norm(x, self.in_norm)
   256	            if self.layer_type == "linear_attention":
   257	                y = self._delta(h, state)
   258	            else:
   259	                c, s = cos[:, :, offset:offset + n, :], sin[:, :, offset:offset + n, :]
   260	                physical = ((n + 31) // 32) * 32
   261	                if physical != n:
   262	                    h = ttnn.pad(h, [(0, 0), (0, physical - n), (0, 0)], value=0)
   263	                    c = ttnn.pad(c, [(0, 0), (0, 0), (0, physical - n), (0, 0)], value=0)
   264	                    s = ttnn.pad(s, [(0, 0), (0, 0), (0, physical - n), (0, 0)], value=0)
   265	                y = self._attention(h, state, page_table=page_table, cos=c, sin=s, chunk_start=start_position + offset)

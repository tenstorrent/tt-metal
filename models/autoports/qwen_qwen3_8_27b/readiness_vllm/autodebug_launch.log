   230	    def decode_forward(self, hidden_states, *, state, page_table=None, current_pos=None, cos=None, sin=None):
   231	        """One token per request; current_pos is a device INT32 tensor, never a host list."""
   232	        assert hidden_states.shape[1] == 1
   233	        h = self._norm(hidden_states, self.in_norm)

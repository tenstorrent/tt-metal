   763	    def _align_prefill_chunk_end(
   764	        self, request: Request, start: int, num_new_tokens: int
   765	    ) -> int:
   766	        """Round a *partial* prefill chunk down so it ends on the alignment grid.
   767	
   768	        Chunks that finish the prompt, decode steps and multimodal prompts are
   769	        left alone. A new request whose aligned chunk would be empty waits for
   770	        the next step; a running request never gets an empty chunk.
   771	        """
   772	        align = getattr(self, "_prefill_chunk_alignment", 0)
   773	        if align <= 1 or num_new_tokens <= 0:
   774	            return num_new_tokens
   775	        end = start + num_new_tokens
   776	        if end >= request.num_prompt_tokens:
   777	            return num_new_tokens
   778	        if getattr(request, "mm_features", None) or getattr(
   779	            request, "has_encoder_inputs", False
   780	        ):
   781	            return num_new_tokens
   782	        aligned_end = end // align * align
   783	        if aligned_end <= start:
   784	            if start != 0:
   785	                return num_new_tokens
   786	            # A new request waits only when this step's leftover budget is what
   787	            # stopped it. If a full step could not reach the grid either (a
   788	            # permanent cap below the alignment), it must still make progress.
   789	            return (
   790	                0 if num_new_tokens < self._full_step_prefill_cap() else num_new_tokens
   791	            )
   792	        return aligned_end - start
   793	
   794	    def _full_step_prefill_cap(self) -> int:
   795	        """Most prompt tokens one scheduling step can give a single new request."""
   796	        cfg = getattr(self, "scheduler_config", None)
   797	        if cfg is None:
   798	            return sys.maxsize
   799	        limit, _ = _effective_prefill_step_limit(cfg)
   800	        return limit

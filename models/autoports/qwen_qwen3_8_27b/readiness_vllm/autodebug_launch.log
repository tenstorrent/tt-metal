    26	def load_precision(value=None):
    27	    """Explicit override > environment > selected artifact > safe baseline."""
    28	    if value is None:
    29	        value = os.environ.get('QWEN38_PRECISION_CONFIG')
    30	    if value is None:
    31	        selected = ROOT / 'doc/datatype_sweep/selected_precision_config.json'
    32	        value = selected if selected.exists() else None
    33	    config = copy.deepcopy(BASELINE) if value is None else (
    34	        copy.deepcopy(value) if isinstance(value, dict) else json.loads(Path(value).read_text()))
    35	    if set(config) != set(BASELINE):
    36	        raise ValueError('Precision configuration must contain exactly the versioned contract fields')
    37	    for field in ('weight_groups', 'compute_fidelities', 'activation_dtype', 'ccl_dtype', 'logits_sampling'):
    38	        if set(config[field]) != set(BASELINE[field]):
    39	            raise ValueError(f'Incomplete or unknown precision keys in {field}')
    40	    # These are enforced runtime invariants, not silently ignored options. The
    41	    # recurrence, shared workspace and common sampler require these representations.
    42	    for field in ('schema_version', 'residual_dtype', 'logits_sampling', 'recurrent_state_dtype', 'max_context'):
    43	        if config[field] != BASELINE[field]:
    44	            raise ValueError(f'Unsupported precision invariant {field}: {config[field]}')
    45	    for field, keys in {'weight_groups': ('embedding', 'norm'), 'compute_fidelities': ('norm',),
    46	                        'ccl_dtype': ('prefill', 'native_batched'), 'activation_dtype': ('fused_row',)}.items():
    47	        if set(config[field]) != set(BASELINE[field]):
    48	            raise ValueError(f'Incomplete precision field {field}')
    49	        for key in keys:
    50	            if config[field][key] != BASELINE[field][key]:
    51	                raise ValueError(f'Fixed runtime representation {field}.{key}')
    52	    for dtype in [*config['weight_groups'].values(), *config['activation_dtype'].values(),
    53	                  *config['ccl_dtype'].values(), config['kv_cache_dtype']]:
    54	        if dtype not in ('bfloat16', 'bfloat8_b', 'bfloat4_b'):
    55	            raise ValueError(f'Unsupported dtype {dtype}')
    56	    if any(f not in ('LoFi', 'HiFi2', 'HiFi4') for f in config['compute_fidelities'].values()):
    57	        raise ValueError('Unsupported math fidelity')
    58	    for layer, override in config['layer_exceptions'].items():
    59	        if not isinstance(layer, str) or not layer.isdigit() or not 0 <= int(layer) < 64:
    60	            raise ValueError('Invalid layer exception')
    61	        if set(override) - {'attention_dtype', 'mlp_dtype', 'down_dtype', 'fidelity'}:
    62	            raise ValueError('Unsupported layer override')
    63	        for key, value in override.items():
    64	            allowed = ('LoFi', 'HiFi2', 'HiFi4') if key == 'fidelity' else ('bfloat16', 'bfloat8_b', 'bfloat4_b')

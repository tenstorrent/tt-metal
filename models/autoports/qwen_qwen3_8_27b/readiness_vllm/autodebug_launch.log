    70	def decoder_policy(config, index):
    71	    weights, fidelity = config['weight_groups'], config['compute_fidelities']
    72	    policy = {g + '_dtype': weights[g] for g in ('attention', 'mlp', 'down')}
    73	    policy.update(fidelity=fidelity['projection'], fused_fidelity=fidelity['fused_decode'],
    74	                  fused_prefill_fidelity=fidelity['fused_prefill'], sdpa_fidelity=fidelity['sdpa'],
    75	                  kv_dtype=config['kv_cache_dtype'], ccl_dtype=config['ccl_dtype']['decode_b1'],
    76	                  attention_activation=config['activation_dtype']['ordinary_attention'],
    77	                  mlp_activation=config['activation_dtype']['ordinary_mlp'],
    78	                  precision_prefill_activation=config['activation_dtype']['prefill_column'])
    79	    policy.update(config['layer_exceptions'].get(str(index), {}))
    80	    return policy

   190	class DeferredDecodeOutput(AsyncModelRunnerOutput):
   191	    """Run the deferred device readback exactly once, from whichever caller
   192	    reaches it first.
   193	
   194	    The executor resolves the step through ``get_output``; the runner's drain
   195	    resolves it through ``ensure_finalized``. Depending on the executor, these
   196	    calls can share a thread or race across threads. ``_finalize_lock`` makes
   197	    either ordering resolve the readback exactly once; a second readback
   198	    of the same device submission corrupts the decode output. The completion
   199	    event is set here, when the readback actually runs, not only inside
   200	    ``get_output``. That is the invariant the drain depends on: vLLM 0.22's
   201	    ``step_with_batch_queue`` schedules the next batch before resolving the
   202	    prior future, so a drain that merely ``event.wait()``-ed would block forever
   203	    on an event nothing else has reached yet.
   204	    """
   205	
   206	    _completion_event: threading.Event
   207	    _finalize_lock: threading.Lock
   208	    _finalized: bool
   209	    _cached_output: Any
   210	    _cached_exception: BaseException | None
   211	
   212	    def _init_deferred(self) -> None:
   213	        self._finalized = False
   214	        self._cached_output = None
   215	        self._cached_exception = None
   216	        self._finalize_lock = threading.Lock()
   217	
   218	    def ensure_finalized(self) -> Any:
   219	        if self._finalized:
   220	            return self._replay()
   221	        with self._finalize_lock:
   222	            if not self._finalized:
   223	                # A failed readback still consumed this submission. Cache the
   224	                # failure as terminal so a racing drain cannot perform the same
   225	                # non-idempotent device readback a second time.
   226	                try:
   227	                    self._cached_output = self._get_output_impl()
   228	                except BaseException as exc:
   229	                    self._cached_exception = exc
   230	                    raise
   231	                finally:
   232	                    self._finalized = True
   233	                    self._completion_event.set()
   234	        return self._replay()
   235	
   236	    def _replay(self) -> Any:
   237	        if self._cached_exception is not None:
   238	            raise self._cached_exception
   239	        return self._cached_output
   240	
   241	    def is_resolved(self) -> bool:
   242	        return self._completion_event.is_set()
   243	
   244	    def get_output(self) -> Any:
   245	        return self.ensure_finalized()
   246	
   247	    def _get_output_impl(self) -> Any:
   248	        raise NotImplementedError

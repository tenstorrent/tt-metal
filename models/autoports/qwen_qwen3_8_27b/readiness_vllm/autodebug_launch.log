    37	# ``SchedulerOutput`` has no backend metadata field. Like lane step state, this
    38	# TT-only signal is attached to the mutable output object and therefore follows
    39	# it through the executor serialization boundary. Counts, rather than a set of
    40	# request IDs, identify exactly how many newest in-flight frames a wholesale
    41	# prefix-cache reset made stale.
    42	_TT_FORCED_RESET_DISCARD_COUNTS_ATTR = "_tt_forced_reset_discard_counts"
    43	_TT_OUTPUT_FRAME_REQ_IDS_ATTR = "_tt_output_frame_req_ids"
    44	
    45	
    46	def set_tt_forced_reset_discard_counts(
    47	    scheduler_output: SchedulerOutput, counts: dict[str, int]
    48	) -> None:
    49	    if counts:
    50	        set_tt_scheduler_output_field(
    51	            scheduler_output, _TT_FORCED_RESET_DISCARD_COUNTS_ATTR, dict(counts)
    52	        )
    53	
    54	
    55	def get_tt_forced_reset_discard_counts(
    56	    scheduler_output: SchedulerOutput,
    57	) -> dict[str, int]:
    58	    return dict(getattr(scheduler_output, _TT_FORCED_RESET_DISCARD_COUNTS_ATTR, {}))
    59	
    60	
    61	# Per-step block-output reconciliation decisions, keyed by request id. Attached
    62	# to the ``SchedulerOutput`` -- the ONLY object that re-associates a step's
    63	# output with the scheduling decision that produced it: under async scheduling
    64	# ``schedule()`` for step K+1 (which mutates per-``Request`` state) runs BEFORE
    65	# ``update_from_output`` commits step K, so a single overwritten ``Request``
    66	# slot would hand step K's commit the K+1 decision. The engine core holds each
    67	# in-flight step's ``SchedulerOutput`` in its batch queue and passes it back to
    68	# ``update_from_output``, so a map carried here always matches the output being
    69	# committed (in sync mode the pairing is trivially the same step). Mirrors the
    70	# forced-reset-count pattern above.

diff --git a/src/vllm_tt_plugin/prefill.py b/src/vllm_tt_plugin/prefill.py
new file mode 100644
index 0000000..d8d6d5c
--- /dev/null
+++ b/src/vllm_tt_plugin/prefill.py
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc.
+"""Submit mixed prompt chunks without sampling unfinished requests."""
+
+from dataclasses import fields
+from typing import Any
+
+import torch
+
+
+def _rows(value: Any, rows: list[int]) -> Any:
+    if isinstance(value, (list, tuple)):
+        return [value[i] for i in rows]
+    return value[rows]
+
+
+def _scatter_output(value: Any, rows: list[int], count: int) -> Any:
+    """Expand materialized tokens/logits and optional device logprob payloads."""
+    if value is None:
+        return None
+    if isinstance(value, tuple):
+        return tuple(_scatter_output(part, rows, count) for part in value)
+    if not isinstance(value, torch.Tensor) or value.shape[0] != len(rows):
+        raise ValueError(
+            "Split prefill requires host tensor outputs in submitted-row order"
+        )
+    result = value.new_zeros((count, *value.shape[1:]))
+    result[rows] = value
+    return result
+
+
+def submit_prefill_chunks(model, kwargs: dict, *, request_specific_rope: bool):
+    """Split intermediate/final rows while retaining scheduler-owned state slots.
+
+    Intermediate calls omit sampling parameters; final calls retain the selected
+    sampling route. Legacy adapters can return logits for intermediate calls,
+    which are discarded. Adapters accepting the suppression mask may omit that
+    readback. No masked-device-sampling capability is assumed.
+    """
+    mask = kwargs.get("intermediate_prefill_mask")
+    if mask is None or not bool(mask.any()) or bool(mask.all()):
+        return model.prefill_forward(**kwargs)
+    count = len(mask)
+    final_rows = torch.nonzero(~mask, as_tuple=False).flatten().tolist()
+    intermediate_rows = torch.nonzero(mask, as_tuple=False).flatten().tolist()
+    rope_output = None
+    final_output = None
+    for rows, suppressed in ((intermediate_rows, True), (final_rows, False)):
+        selected = {}
+        for key, value in kwargs.items():
+            if key in ("kv_cache", "enable_trace") or value is None:
+                selected[key] = value
+            elif key == "sampling_params":
+                if not suppressed:
+                    selected[key] = type(value)(
+                        **{
+                            field.name: (
+                                _rows(getattr(value, field.name), rows)
+                                if getattr(value, field.name) is not None
+                                else None
+                            )
+                            for field in fields(value)
+                        }
+                    )
+            elif key == "page_tables_per_layer":
+                selected[key] = [
+                    None if table is None else table[rows] for table in value
+                ]
+            elif key == "intermediate_prefill_mask":
+                if suppressed:
+                    selected[key] = mask[rows]
+            else:
+                # Execution inputs and multimodal/stage fields are row-aligned.
+                selected[key] = _rows(value, rows)
+        selected["empty_slots"] = _rows(
+            kwargs.get("empty_slots", list(range(count))), rows
+        )
+        output = model.prefill_forward(**selected)
+        if request_specific_rope:
+            output, deltas = output
+            if rope_output is None:
+                rope_output = deltas.new_zeros((count, *deltas.shape[1:]))
+            rope_output[rows] = deltas
+        if not suppressed:
+            final_output = _scatter_output(output, final_rows, count)
+    return (final_output, rope_output) if request_specific_rope else final_output

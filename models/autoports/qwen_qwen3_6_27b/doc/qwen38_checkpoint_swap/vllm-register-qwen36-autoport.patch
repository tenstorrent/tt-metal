     # Qwen3.5 - Text
+    # Two implementations serve this architecture, selected the same way the
+    # Mistral entry below selects between tt_transformers and its autoport:
+    #   qwen3_6_27b_autoport  -> models/autoports/qwen_qwen3_6_27b (DEFAULT)
+    #   demo                  -> models/demos/blackhole/qwen36 (hand-written)
+    #
+    # The autoport is the default because it is the implementation this
+    # architecture ships with: it carries the full bringup evidence chain and it
+    # is what serves sibling checkpoints of the same architecture (e.g.
+    # Qwen/Qwen3.8-27B via QWEN_AUTOPORT_MODEL_ID). Defaulting to the demo meant
+    # any caller that did not know about this variable -- including the
+    # tt-inference-server release workflow, which spawns its own server --
+    # silently got the demo instead.
+    qwen3_5_text_version = os.getenv("TT_QWEN3_5_TEXT_VER", "qwen3_6_27b_autoport")
+    if qwen3_5_text_version == "demo":
+        path_qwen3_5_text = "models.demos.blackhole.qwen36.tt.qwen36_vllm:Qwen36ForCausalLM"
+    elif qwen3_5_text_version == "qwen3_6_27b_autoport":
+        path_qwen3_5_text = (
+            "models.autoports.qwen_qwen3_6_27b.tt.generator_vllm:Qwen36ForCausalLM"
+        )
+    else:
+        raise ValueError(
+            f"Unsupported TT Qwen3.5 version: {qwen3_5_text_version}, "
+            "pick one of [demo, qwen3_6_27b_autoport]"
+        )
+
     _register_model_if_missing(
         ModelRegistry,
         "TTQwen3_5ForConditionalGeneration",
-        "models.demos.blackhole.qwen36.tt.qwen36_vllm:Qwen36ForCausalLM",
+        path_qwen3_5_text,
     )
 

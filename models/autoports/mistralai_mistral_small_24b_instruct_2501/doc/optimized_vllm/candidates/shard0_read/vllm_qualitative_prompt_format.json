{
  "endpoint": "/v1/chat/completions",
  "message_format": [
    {
      "role": "user",
      "content": "<prompt>"
    }
  ],
  "chat_template_owner": "vLLM tokenizer configuration",
  "model": "mistralai/Mistral-Small-24B-Instruct-2501",
  "greedy_sampling": {
    "temperature": 0.0,
    "max_tokens": 256
  },
  "sampled_sampling": {
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 32,
    "max_tokens": 256
  }
}

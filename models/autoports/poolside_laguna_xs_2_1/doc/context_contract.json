      "plugin_calls_prefill_warmup_twice": true,
      "full_bucket_ladder_passes": 1,
      "mechanism": "Laguna's private _prefill_programs_warmed latch survives the plugin's public-flag reset and suppresses the redundant second full-model pass",
      "runtime_offset_slots_preallocated": true,
      "program_cache_frozen_after_trace": true,
      "program_cache_misses_allowed_after_trace": false
    },
    "terminal_row_selection": {
      "index": "prompt_lens - start_pos - 1",
      "selector": "host one-hot copied into a persistent per-bucket device buffer",
      "output": "persistent one-row device buffer",
      "program_compilation": "once per bucket during the single full ladder warmup",
      "persistent_selector_and_output_buffers": true,
      "allocation_claim_scope": "no per-request selector/output buffer; this is not a global allocation-free prefill claim"

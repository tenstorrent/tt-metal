      "max_num_seqs": 1,
      "scheduler_chunked_prefill": false,
      "speculative_decode": false,
      "external_kv_connectors": false
    },
    "prefix_resume_range": "vLLM supplies full tokens, absolute exclusive prompt_lens, and absolute cached-prefix start_pos; Laguna uploads only tokens[start_pos:prompt_lens]",
    "bucket_length_basis": "prompt_lens - start_pos",
    "model_position_basis": "absolute start_pos",
    "resume_alignment": "the scheduler admits start_pos only at the 8192-token canonical quantum; the model additionally validates 64-token KV-block alignment",
    "runtime_start_inputs": {
      "paged_fill": "each request row is host-rebased so column zero represents start_pos; device slices use only fixed relative pipeline offsets",
      "rope": "absolute position ids are copied into persistent inputs and indexed embedding writes persistent cos/sin outputs",
      "sdpa": "chunk_start_idx_tensor carries the absolute start as runtime data"
    },
    "private_scratch_kv": {
      "physical_blocks_per_layer": 1,
      "logical_capacity_increase": 0,
      "block_id": "the first physical block outside vLLM's logical block-id range",
      "attention_padding": "a persistent prefill-only attention table maps whole padding blocks to the zero-initialized scratch block",
      "fill_padding": "a separate persistent paged-fill table maps padding to -1, the paged_fill_cache write-skip sentinel, so writer cores cannot race on scratch",
      "purpose": "prevent zero-filled scheduler columns from aliasing physical block 0 without allowing concurrent padding writes to race on scratch",
      "decode_page_table_modified": false
    },
    "extended_private_prefill_addressability": {
      "page_table_horizon": "max_model_len + largest_bucket",
      "rope_horizon": "max_model_len + largest_bucket",

# GLM-5.3-Flash, homelab-1: one Ethernet hop = two Ethernet-adjacent chips as a 1x2 mesh with fabric. Same content as
# tt_metal's p300 descriptor (2 P300 chips are ClusterType P300 and pick that one automatically); kept here so a hop
# pair across cards (cable edges 0-2, 1-3, 2-5, 3-4, 4-7, 5-6) is opened with an explicit, versioned descriptor:
#   TT_VISIBLE_DEVICES=<a>,<b> TT_MESH_GRAPH_DESC_PATH=$TT_METAL_HOME/models/autoports/zai_org_glm_5_3_flash/mesh/glm_pair_1x2_mesh_graph_descriptor.textproto
#   ttnn.set_fabric_config(ttnn.FabricConfig.FABRIC_1D); mesh = ttnn.open_mesh_device(ttnn.MeshShape(1, 2))
# Verified per ring edge by Stage 04a (logs/mesh/pairs_*.log).

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 2 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

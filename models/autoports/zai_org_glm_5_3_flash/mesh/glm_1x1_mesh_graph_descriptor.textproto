# GLM-5.3-Flash, homelab-1: ONE Blackhole chip of a p300a as a 1x1 mesh (pipeline stage = one chip, one process per chip).
# A single visible P300 chip is ClusterType CUSTOM (tt_cluster.cpp: P300 with num_chips != 2/4), which requires a
# custom mesh graph descriptor. Use with TT_VISIBLE_DEVICES=<chip> (what `tt-lock run chipN` exports), fabric DISABLED:
#   export TT_MESH_GRAPH_DESC_PATH=$TT_METAL_HOME/models/autoports/zai_org_glm_5_3_flash/mesh/glm_1x1_mesh_graph_descriptor.textproto
#   mesh = ttnn.open_mesh_device(ttnn.MeshShape(1, 1), trace_region_size=...)
# Verified to open on chips 0-7 by Stage 04a (doc/ttnn/04a-multichip-handoff-prework/logs/mesh/).

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 1 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

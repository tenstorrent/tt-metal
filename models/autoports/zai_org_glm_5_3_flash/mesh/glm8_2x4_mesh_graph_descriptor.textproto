# GLM-5.3-Flash, homelab-1: all 8 chips (UMD logical 0-7 = BDFs 01,02,1d,1e,55,56,8c,8d; 4x p300a) as a 2x4 Ethernet
# MESH with fabric. Re-measured 2026-10-17 after the card3 board swap (doc/hardware.md §3; Stage 04a
# logs/topology/): every edge = 2 links.
#   row 0: chip 0 -- chip 2 -- chip 5 -- chip 6      (cables 0-2, 2-5, 5-6)
#   row 1: chip 1 -- chip 3 -- chip 4 -- chip 7      (cables 1-3, 3-4, 4-7)
#   columns (on-board): 0-1, 2-3, 5-4, 6-7; no wrap-around (not a torus).
# The topology mapper picks the physical placement; read mesh.get_device_ids() for coordinate -> chip.
# Use with TT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7 (8 P300 chips -> ClusterType CUSTOM, which requires this file):
#   export TT_MESH_GRAPH_DESC_PATH=$TT_METAL_HOME/models/autoports/zai_org_glm_5_3_flash/mesh/glm8_2x4_mesh_graph_descriptor.textproto
#   ttnn.set_fabric_config(ttnn.FabricConfig.FABRIC_1D); mesh = ttnn.open_mesh_device(ttnn.MeshShape(2, 4))
# (Superseded 2026-10-15 note: with the old cabling no 2x4 Ethernet mesh existed and this only opened fabric-less.)

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 2, 4 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

# GLM-5.3-Flash, homelab-1: Ethernet-connected chips 0-5 of group `glm` as a 1x6 LINE (snake 0-1-3-4-5-2 or
# equivalent; the 3x2 ladder also closes a 6-ring 0-1-3-4-5-2-0). Use with TT_VISIBLE_DEVICES=0,1,2,3,4,5.
#   export TT_MESH_GRAPH_DESC_PATH=$TT_METAL_HOME/models/autoports/zai_org_glm_5_3_flash/mesh/glm6_1x6_line_mesh_graph_descriptor.textproto

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 6 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

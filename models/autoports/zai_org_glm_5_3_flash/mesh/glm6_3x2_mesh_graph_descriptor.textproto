# GLM-5.3-Flash, homelab-1: the Ethernet-connected part of tt-lock group `glm` — UMD logical chips 0-5
# (boards 0x4513192601b, 0x45131926037, 0x45100000000) — as a 3x2 mesh with fabric. Use with
# TT_VISIBLE_DEVICES=0,1,2,3,4,5 (6 P300 chips -> ClusterType CUSTOM). Physical ladder (2 links per edge):
#   row 0: chip 0 - chip 1      (board 601b, on-board)
#   row 1: chip 2 - chip 3      (board 6037, on-board)
#   row 2: chip 5 - chip 4      (board 0000, on-board)
#   columns: 0-2, 2-5 and 1-3, 3-4 (QSFP-DD cables)
#   export TT_MESH_GRAPH_DESC_PATH=$TT_METAL_HOME/models/autoports/zai_org_glm_5_3_flash/mesh/glm6_3x2_mesh_graph_descriptor.textproto

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 3, 2 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

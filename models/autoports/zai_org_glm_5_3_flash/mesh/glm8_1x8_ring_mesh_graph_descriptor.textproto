# GLM-5.3-Flash, homelab-1: all 8 chips as a 1x8 RING over the Hamiltonian cycle of the 2x4 Ethernet mesh
# (doc/hardware.md §3, 2026-10-17): 0 - 2 - 5 - 6 - 7 - 4 - 3 - 1 - (0); every hop one Ethernet edge (2 links).
# This is also the layer-pipeline order of Stage 04a's partition.json (stage k on ring position k; the last stage,
# chip 1, is one hop from chip 0 for on-device token feedback). For TP/EP collectives over all 8 chips
# (FABRIC_1D_RING + ttnn.Topology.Ring) and for an 8-stage pipeline in one process (8 1x1 submeshes, socket hops).
# Use with TT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7:
#   export TT_MESH_GRAPH_DESC_PATH=$TT_METAL_HOME/models/autoports/zai_org_glm_5_3_flash/mesh/glm8_1x8_ring_mesh_graph_descriptor.textproto
#   ttnn.set_fabric_config(ttnn.FabricConfig.FABRIC_1D_RING); mesh = ttnn.open_mesh_device(ttnn.MeshShape(1, 8))

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 8 ] dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

# --- Instantiation ----------------------------------------------------------
top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

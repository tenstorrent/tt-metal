graph_templates {
  key: "T3K"
  value {
    children {
      name: "node1"
      node_ref { node_descriptor: "N300_LB" }
    }
    internal_connections {
      key: "QSFP_DD"
      value {
        connections { port_a { path: ["node1"] tray_id: 1 port_id: 1 } port_b { path: ["node1"] tray_id: 4 port_id: 1 } }
        connections { port_a { path: ["node1"] tray_id: 2 port_id: 2 } port_b { path: ["node1"] tray_id: 3 port_id: 2 } }
      }
    }
  }
}

# Root instance - T3K with single node
root_instance {
  template_name: "T3K"
  child_mappings {
    key: "node1"
    value { host_id: 0 }
  }
}

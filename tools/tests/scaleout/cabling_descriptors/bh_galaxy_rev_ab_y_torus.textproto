graph_templates {
  key: "bh_galaxy_y_torus"
  value {
    children {
      name: "node1"
      node_ref { node_descriptor: "BH_GALAXY_REV_AB" }
    }
    internal_connections {
      key: "QSFP_DD"
      value {
        # Y torus
        connections { port_a { path: ["node1"] tray_id: 1 port_id: 2 } port_b { path: ["node1"] tray_id: 2 port_id: 2 } }
        connections { port_a { path: ["node1"] tray_id: 1 port_id: 1 } port_b { path: ["node1"] tray_id: 2 port_id: 1 } }
        connections { port_a { path: ["node1"] tray_id: 3 port_id: 1 } port_b { path: ["node1"] tray_id: 4 port_id: 1 } }
        connections { port_a { path: ["node1"] tray_id: 3 port_id: 2 } port_b { path: ["node1"] tray_id: 4 port_id: 2 } }
      }
    }
  }
}

# Root instance with concrete host mappings
root_instance {
  template_name: "bh_galaxy_y_torus"
  child_mappings {
    key: "node1"
    value { host_id: 0 }
  }
}

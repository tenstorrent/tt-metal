--- a/tt_metal/programming_examples/high_power_matmul/high_power_matmul.cpp
+++ b/tt_metal/programming_examples/high_power_matmul/high_power_matmul.cpp
@@ -4,6 +4,9 @@
 
 #include <algorithm>
 #include <chrono>
+#include <cmath>

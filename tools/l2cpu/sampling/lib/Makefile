# x280s: the bit-exact sampling library. Host reference (.so), RISC-V firmware library, tests, QEMU bit-exactness test.
#
#   make                 host library libx280s_host.so
#   make test            host unit tests + NumPy spec guard + expf sweep (needs numpy, pytest)
#   make riscv           build/rv/libx280s.a (scalar) and build/rv/libx280s_rvv.a (RVV fast path), nm check
#   make qemu-test       corpus generated by the host build, replayed on QEMU (scalar and RVV images)
#   make bench           host time per row, V = 151936
#
# Variables: PY (python with numpy + pytest; default python3), RISCV_PREFIX (default riscv64-unknown-elf- from PATH),
#            QEMU (default qemu-system-riscv64 from PATH), LOGDIR (QEMU logs; default build/logs),
#            CORPUS_NPY (optional recorded rows, uint16 bf16 or float32 [N, V], added to the QEMU corpus),
#            CORPUS_NPY_COUNT (rows taken from CORPUS_NPY, default 100),
#            ZB=1|0 (RISC-V build with Zba + Zbb, which the x280 executes; default 1; 0 = plain rv64gcv; run
#            `make clean` when switching).
#
# Every flavour: -O2 -ffp-contract=off -fno-fast-math (bit-exactness between x86-64 and rv64gcv).

HERE := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
PY ?= python3
LOGDIR ?= $(HERE)build/logs

FPFLAGS := -O2 -ffp-contract=off -fno-fast-math
CWARN := -std=c11 -Wall -Wextra -Werror

# ---- host -------------------------------------------------------------------------------------
HOSTCC ?= gcc
HOST_CFLAGS := $(CWARN) $(FPFLAGS) -fPIC

BUILD := $(HERE)build

all: libx280s_host.so

libx280s_host.so: x280s.c x280s.h Makefile
	$(HOSTCC) $(HOST_CFLAGS) -shared -o $@ x280s.c

$(BUILD)/expf_sweep: tests/expf_sweep.c x280s.c x280s.h
	@mkdir -p $(BUILD)
	$(HOSTCC) -std=c11 $(FPFLAGS) -o $@ tests/expf_sweep.c x280s.c -lm

$(BUILD)/fpenv_test: tests/fpenv_test.c x280s.c x280s.h
	@mkdir -p $(BUILD)
	$(HOSTCC) $(CWARN) $(FPFLAGS) -o $@ tests/fpenv_test.c x280s.c

test: libx280s_host.so $(BUILD)/fpenv_test
	$(BUILD)/fpenv_test
	$(PY) -m pytest -q -s -c tests/pytest.ini --rootdir=tests --noconftest -p no:cacheprovider tests
	@echo "host tests PASS"

expf-sweep: $(BUILD)/expf_sweep
	$(BUILD)/expf_sweep

bench: libx280s_host.so
	$(PY) tests/bench_host.py

# ---- RISC-V ------------------------------------------------------------------------------------
RISCV_PREFIX ?= $(shell command -v riscv64-unknown-elf-gcc >/dev/null 2>&1 && echo riscv64-unknown-elf-)
RVCC := $(RISCV_PREFIX)gcc
RVAR := $(RISCV_PREFIX)ar
RVNM := $(RISCV_PREFIX)nm
RVOBJCOPY := $(RISCV_PREFIX)objcopy
QEMU ?= $(shell command -v qemu-system-riscv64 2>/dev/null)

ZB ?= 1
RV_ISA := rv64gcv$(if $(filter 1,$(ZB)),_zba_zbb)
RV_ARCH := -march=$(RV_ISA) -mabi=lp64d -mcmodel=medany
RV_CFLAGS := $(CWARN) $(FPFLAGS) $(RV_ARCH) -ffreestanding -fno-builtin -fno-tree-loop-distribute-patterns \
	-fno-common -ffunction-sections -fdata-sections -fno-stack-protector -fno-pic
RVB := $(BUILD)/rv

need-rv:
	@if [ -z "$(RISCV_PREFIX)" ]; then echo "riscv64-unknown-elf-gcc not found in PATH (Ubuntu: gcc-riscv64-unknown-elf)"; exit 2; fi

$(RVB)/x280s.o: x280s.c x280s.h Makefile | need-rv
	@mkdir -p $(RVB)
	$(RVCC) $(RV_CFLAGS) -c -o $@ x280s.c

$(RVB)/x280s_rvv.o: x280s.c x280s.h Makefile | need-rv
	@mkdir -p $(RVB)
	$(RVCC) $(RV_CFLAGS) -DX280S_RVV -c -o $@ x280s.c

$(RVB)/libx280s.a: $(RVB)/x280s.o
	$(RVAR) rcs $@ $^

$(RVB)/libx280s_rvv.a: $(RVB)/x280s_rvv.o
	$(RVAR) rcs $@ $^

riscv: $(RVB)/libx280s.a $(RVB)/libx280s_rvv.a nm-check

# The library must not reference any external symbol at all (no libc, libm, libgcc helpers).
nm-check: $(RVB)/x280s.o $(RVB)/x280s_rvv.o
	@for o in $^; do u=$$($(RVNM) -u $$o); if [ -n "$$u" ]; then echo "UNDEFINED in $$o:"; echo "$$u"; exit 1; fi; \
	echo "nm -u $$(basename $$o): no undefined symbols"; done

# ---- QEMU bit-exactness test -------------------------------------------------------------------
# Optional recorded rows (e.g. Qwen3-8B logits recorded with the qwen3 example's harness, see ../README.md) are added
# to the QEMU corpus when CORPUS_NPY names an existing file; the default corpus is synthetic only.
CORPUS_NPY ?=
CORPUS_NPY_COUNT ?= 100
QEMU_MACHINE ?= virt
QEMU_VLEN ?= 512
QEMU_FLAGS = -M $(QEMU_MACHINE) -cpu rv64,v=true,vlen=$(1),elen=64,zba=true,zbb=true -smp 4 -m 256M -bios none -nographic -serial stdio -monitor none -icount shift=0

$(RVB)/corpus.S $(RVB)/corpus_meta.txt: libx280s_host.so tests/gen_corpus.py x280s_ref.py
	@mkdir -p $(RVB)
	$(PY) tests/gen_corpus.py --out $(RVB)/corpus.S $(if $(and $(CORPUS_NPY),$(wildcard $(CORPUS_NPY))),--npy $(CORPUS_NPY) --npy-count $(CORPUS_NPY_COUNT),)

QEMU_SRC := qemu/start.S qemu/main.c qemu/link.ld

$(RVB)/qemu_test.elf: $(QEMU_SRC) $(RVB)/corpus.S $(RVB)/x280s.o | need-rv
	$(RVCC) $(RV_ARCH) -O2 -ffreestanding -nostdlib -nostartfiles -fno-builtin -fno-tree-loop-distribute-patterns \
		-Wall -Wextra -Wl,--no-warn-rwx-segments -I. -T qemu/link.ld -o $@ qemu/start.S qemu/main.c $(RVB)/corpus.S $(RVB)/x280s.o

$(RVB)/qemu_test_rvv.elf: $(QEMU_SRC) $(RVB)/corpus.S $(RVB)/x280s_rvv.o | need-rv
	$(RVCC) $(RV_ARCH) -O2 -ffreestanding -nostdlib -nostartfiles -fno-builtin -fno-tree-loop-distribute-patterns \
		-Wall -Wextra -I. -DX280S_EXPECT_RVV -T qemu/link.ld -o $@ qemu/start.S qemu/main.c $(RVB)/corpus.S $(RVB)/x280s_rvv.o

qemu-test: nm-check $(RVB)/qemu_test.elf $(RVB)/qemu_test_rvv.elf
	@if [ -z "$(QEMU)" ]; then echo "qemu-system-riscv64 not found"; exit 2; fi
	@mkdir -p $(LOGDIR)
	@set -e; for run in qemu_test:512 qemu_test_rvv:512 qemu_test_rvv:128 qemu_test_rvv:1024; do \
	  e=$${run%:*}; vlen=$${run#*:}; \
	  log=$(LOGDIR)/sampling-$$e-vlen$$vlen.log; \
	  echo "== $$e (VLEN $$vlen) -> $$log"; \
	  timeout 900 $(QEMU) $(call QEMU_FLAGS,$$vlen) -kernel $(RVB)/$$e.elf > $$log 2>&1; rc=$$?; \
	  grep -E '^(phase1|PASS expf|FAIL|PASS multi|ALL PASS|FAILED|INSTRET)' $$log | head -20; \
	  if [ $$rc -ne 0 ] || ! grep -q '^ALL PASS' $$log; then echo "$$e VLEN $$vlen FAILED (rc $$rc), see $$log"; exit 1; fi; \
	done; echo "qemu-test PASS (scalar VLEN 512; RVV VLEN 128/512/1024)"

clean:
	rm -rf $(BUILD) libx280s_host.so

.PHONY: all test expf-sweep bench riscv nm-check need-rv qemu-test clean

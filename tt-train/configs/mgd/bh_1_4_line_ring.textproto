# Blackhole 1x4 mesh, a ring along its four devices (FABRIC_2D_TORUS_X): the 2D fabric the 4-chip QuietBox CI runs
# (1, 4) on. Used by the tt-train tests that sum gradients over four devices.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 4 ], dim_types: [ LINE, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }

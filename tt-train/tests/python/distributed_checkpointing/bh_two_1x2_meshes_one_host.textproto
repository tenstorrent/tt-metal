# Two ranks on one Blackhole host, each with its own [1, 2] mesh (mesh ids 0 and 1): the multi-mesh case of
# ttml.distributed_checkpointing, where ranks hold different keys and no collective spans the ranks.
mesh_descriptors {
  name: "M"
  arch: BLACKHOLE
  device_topology { dims: [1, 2] dim_types: [LINE, LINE] }
  host_topology { dims: [1, 1] }
  channels { count: 1 policy: RELAXED }
}
graph_descriptors {
  name: "G"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M" mesh_id: 1 } }
}
top_level_instance { graph { graph_descriptor: "G" graph_id: 0 } }

# Two ranks, each with its own [2, 2] Blackhole mesh (mesh ids 0 and 1): the one-mesh-per-host shape of
# ttml.distributed_checkpointing. tt-run places mesh 0 on the first host of --hosts and mesh 1 on the second; with one
# host listed, both ranks share it (eight chips). No collective spans the ranks.
mesh_descriptors {
  name: "M"
  arch: BLACKHOLE
  device_topology { dims: [2, 2] dim_types: [LINE, LINE] }
  host_topology { dims: [1, 1] }
  channels { count: 1 policy: RELAXED }
}
graph_descriptors {
  name: "G"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M" mesh_id: 1 } }
}
top_level_instance { graph { graph_descriptor: "G" graph_id: 0 } }

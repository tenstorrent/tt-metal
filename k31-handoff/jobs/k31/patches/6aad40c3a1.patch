diff --git a/tests/blaze/infra/test_reload_k3_kv_table.py b/tests/blaze/infra/test_reload_k3_kv_table.py
new file mode 100644
index 00000000..32828e48
--- /dev/null
+++ b/tests/blaze/infra/test_reload_k3_kv_table.py
@@ -0,0 +1,230 @@
+# SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+# SPDX-License-Identifier: Apache-2.0
+"""Kimi-K3 on a reload ring: HandOff exports its three cache configs -- device-free.
+
+What K3 adds over M3 (``test_reload_kv_table.py``): MLA kvpe on some layers and KDA state and conv on the
+rest, KDA rows whose synthetic position extent is not the MLA context, and a spec that takes each stage's live
+KDA allocation (``kv_migration_spec_stage_kwargs``). The ranks run as threads over one all-gather; ttnn must
+be importable for the KvChunkAddressTable binding.
+"""
+
+import pathlib
+import threading
+from dataclasses import replace
+from types import SimpleNamespace
+
+import pytest
+
+try:
+    import ttnn
+
+    from blaze.models.kimi_k3 import cache_migration as km
+    from blaze.models.kimi_k3 import entry as k3
+    from blaze.models.kimi_k3.entry import MODEL_NAME
+    from blaze.models.kimi_k3.kimi_k3_blaze_config import KIMI_K3_DIMS
+    from blaze.models.pipeline_hand_off.hand_off import HandOff
+except Exception as e:  # pragma: no cover - environment dependent (ttnn build)
+    pytest.skip(f"reload hand-off unavailable: {e}", allow_module_level=True)
+
+pytestmark = [pytest.mark.device("cpu"), pytest.mark.level("infra")]
+
+DEPTH = 8192  # the smallest valid MLA depth (K3_MLA_SEQ_LEN_QUANTUM)
+SLOTS = 2
+N_DEV = 8
+KVPE = 576
+#: One fabric mesh over three ranks: an embedding rank with no layer, then two with several layers each.
+RANK_LAYERS = [(), (0, 1, 2, 3), (4, 5, 6, 7)]
+LAYERS = range(8)
+
+
+HOST = 0x0C0FFEE0
+
+
+def _rank_chips(rank):
+    """Rank ``rank``'s eight chips on fabric mesh 0, as ``(unique id, mesh, chip)``; rank 0 holds none."""
+    return [(0xA000 + rank * 8 + i, 0, rank * 8 + i) for i in range(8) if rank]
+
+
+class _Ring:
+    """The ring's ranks as threads over one all-gather, as MPI runs them (``test_reload_kv_table._Ring``)."""
+
+    def __init__(self, n):
+        self._barrier, self._slots, self._local = threading.Barrier(n, timeout=20), [0] * n, threading.local()
+
+    def _allgather(self, value):
+        self._slots[self._local.rank] = int(value)
+        self._barrier.wait()
+        out = list(self._slots)
+        self._barrier.wait()
+        return out
+
+    def run(self, monkeypatch, fns):
+        from blaze import kv_chunk_migration_helpers as helpers
+
+        monkeypatch.setattr(ttnn, "distributed_context_allgather_int", self._allgather)
+        monkeypatch.setattr(ttnn, "distributed_context_get_rank", lambda: self._local.rank)
+        monkeypatch.setattr(ttnn, "distributed_context_get_size", lambda: len(fns))
+        monkeypatch.setattr(ttnn, "distributed_context_barrier", lambda: self._barrier.wait())
+        monkeypatch.setattr(helpers, "_host_tag_int", lambda: HOST)
+        monkeypatch.setattr(helpers, "_enumerate_decode_devices", lambda device: device)
+        results, errors = [None] * len(fns), [None] * len(fns)
+
+        def body(rank, fn):
+            self._local.rank = rank
+            try:
+                results[rank] = fn()
+            except BaseException as exc:  # noqa: BLE001
+                errors[rank] = exc
+
+        threads = [threading.Thread(target=body, args=(rank, fn)) for rank, fn in enumerate(fns)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+        return results, errors
+
+
+class _Cache:
+    """A live cache as the export reads it: its base and its shape (rank 4 for kvpe, rank 3 for KDA)."""
+
+    def __init__(self, addr, shape):
+        self.addr, self.shape = addr, shape
+
+    def buffer_address(self):
+        return self.addr
+
+
+def _is_mla(layer):
+    return KIMI_K3_DIMS.is_mla_layer(layer)
+
+
+def _base(layer, config):
+    return 0x100000 * (layer + 1) + 0x1000 * int(config)
+
+
+def _kda_transients(layer, *, users=SLOTS, versions=1):
+    return {
+        "s_cache": _Cache(_base(layer, "1"), (1, 1, 64)),
+        "conv_cache": _Cache(_base(layer, "2"), (1, 1, 64)),
+        "max_num_users": users,
+        "max_length": versions,
+    }
+
+
+def _mla_transients(layer):
+    return {"ttnn_kv_cache": _Cache(_base(layer, "0"), (SLOTS, 1, DEPTH // N_DEV, KVPE))}
+
+
+def _pins(layer, **kda):
+    """What K3's harnesses declare under ``"kv_migration"``: the dict their spec hooks read."""
+    if _is_mla(layer):
+        return {"scratch": {"mla_transients": _mla_transients(layer)}}
+    return {"scratch": {"kda_transients": _kda_transients(layer, **kda)}}
+
+
+def _export(monkeypatch, tmp_path, pins_by_rank, *, expected_layers=LAYERS):
+    table, device_map = tmp_path / "table.pb", tmp_path / "device_map.txt"
+
+    def rank_fn(rank):
+        ctx = SimpleNamespace(
+            kv_migration=pins_by_rank[rank], submesh=_rank_chips(rank), pipeline=SimpleNamespace(my_mesh_id=0)
+        )
+        hand_off = HandOff(
+            io_socket_prefix="p",
+            kv_slots=SLOTS,
+            kv_depth=DEPTH,
+            ring_capacity=7,
+            spec_factory=k3.kv_migration_spec,
+            spec_stage_kwargs=k3.kv_migration_spec_stage_kwargs,
+            kv_table_path=str(table),
+            device_map_path=str(device_map),
+            ring_info_path=str(tmp_path / "ring.json"),
+            expected_layers=expected_layers,
+        )
+        return lambda: hand_off._export_kv_table(ctx)
+
+    _, errors = _Ring(len(pins_by_rank)).run(monkeypatch, [rank_fn(r) for r in range(len(pins_by_rank))])
+    return table, errors
+
+
+def test_the_ring_holds_both_kinds():
+    kinds = {_is_mla(layer) for layers in RANK_LAYERS for layer in layers}
+    assert kinds == {True, False}, "the ring under test must mix MLA and KDA layers"
+
+
+def test_the_stage_hook_reads_kda_geometry_and_zeros_elsewhere():
+    from blaze.kv_chunk_migration_helpers import _PinnedView
+
+    hook = k3.kv_migration_spec_stage_kwargs
+    kda_layer = next(layer for layer in LAYERS if not _is_mla(layer))
+    mla_layer = next(layer for layer in LAYERS if _is_mla(layer))
+    assert hook(_PinnedView(_pins(kda_layer, versions=1))) == {"kda_max_num_users": SLOTS, "kda_max_length": 1}
+    assert hook(_PinnedView(_pins(mla_layer))) == {"kda_max_num_users": 0, "kda_max_length": 0}
+    # A rank past its own layer count joins the gather with empty pins and the same keys.
+    assert hook(_PinnedView({})) == {"kda_max_num_users": 0, "kda_max_length": 0}
+
+
+@pytest.mark.parametrize("versions", [1, 8], ids=["one_kda_slot", "eight_kda_versions"])
+def test_hand_off_exports_k3s_three_configs(monkeypatch, tmp_path, versions):
+    """Every layer's rows land on its own rank's chips at its own base: kvpe up to the MLA depth, KDA S and conv
+    up to the KDA extent of ``versions`` state slots, the other kind's rows empty."""
+    pins = [{layer: _pins(layer, versions=versions) for layer in layers} for layers in RANK_LAYERS]
+    table_path, errors = _export(monkeypatch, tmp_path, pins)
+    assert errors == [None] * 3
+    table = ttnn.experimental.disaggregation.import_from_protobuf_file(str(table_path))
+    spec = k3.kv_migration_spec(max_seq_len=DEPTH, num_slots=SLOTS, kda_max_length=versions)
+    extent = km.kda_position_extent(N_DEV, versions)
+    for rank, layers in enumerate(RANK_LAYERS):
+        own = {chip for _, _, chip in _rank_chips(rank)}
+        for layer in layers:
+            for cfg_id, cfg in enumerate(spec.configs):
+                if (cfg.name == "0") != _is_mla(layer):
+                    assert table.lookup(layer, 0, 1, cfg_id).size_bytes == 0, (layer, cfg.name)
+                    continue
+                last = (DEPTH if _is_mla(layer) else extent) - cfg.chunk_n_tokens
+                for pos in (0, last):
+                    loc = table.lookup(layer, pos, 1, cfg_id)
+                    assert loc.size_bytes == cfg.chunk_size_bytes, (layer, cfg.name, pos)
+                    group = table.get_device_group(loc.device_group_index)
+                    assert {int(f.chip_id) for f in group.fabric_node_ids} <= own, (layer, cfg.name)
+                    # kvpe has its own geometry (CP8 over the 4x2 mesh as 8x1); KDA uses the spec's.
+                    geom = replace(cfg.geom or spec.geom, max_seq_len=DEPTH)
+                    want = cfg.locate(pos, 1, _base(layer, cfg.name), geom, layer)
+                    assert loc.noc_addr == want.noc_addr, (layer, cfg.name, pos)
+
+
+def test_kda_stages_that_disagree_on_the_version_count_fail_every_rank(monkeypatch, tmp_path):
+    # One table addresses every KDA layer with one max_length.
+    pins = [{layer: _pins(layer, versions=1) for layer in layers} for layers in RANK_LAYERS]
+    pins[2][4] = _pins(4, versions=8)
+    _, errors = _export(monkeypatch, tmp_path, pins)
+    assert all(isinstance(e, BaseException) for e in errors), errors
+    assert any("different version counts" in str(e) for e in errors)
+
+
+def test_kda_stages_with_fewer_users_than_slots_fail_every_rank(monkeypatch, tmp_path):
+    pins = [{layer: _pins(layer, users=SLOTS - 1) for layer in layers} for layers in RANK_LAYERS]
+    _, errors = _export(monkeypatch, tmp_path, pins)
+    assert all(isinstance(e, BaseException) for e in errors), errors
+    assert any("max_num_users" in str(e) for e in errors)
+
+
+def test_hand_off_from_env_takes_k3s_hooks(monkeypatch, tmp_path):
+    monkeypatch.setenv("BLAZE_RELOAD_KV_TABLE_PATH", str(tmp_path / "t.pb"))
+    hand_off = HandOff.from_env(model=MODEL_NAME, kv_slots=15, kv_depth=1_048_576, ring_capacity=47)
+    assert hand_off.spec_factory is k3.kv_migration_spec
+    assert hand_off.spec_stage_kwargs is k3.kv_migration_spec_stage_kwargs
+
+
+def test_k3_harnesses_declare_their_reload_pins():
+    """Every K3 decoder harness declares "kv_migration" pins holding the dict its spec hooks read in the regular
+    pipeline. Checked on the source: building a harness needs a device."""
+    root = pathlib.Path(__file__).resolve().parents[1] / "fused_ops"
+    for rel, key, value in (

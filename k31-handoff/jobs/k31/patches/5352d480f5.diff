+
+def _k3_table(cfg, *, depth, kda_max_length, tags=True):
+    """K3's table over one KDA layer and one MLA layer, each on its own mesh, at MLA depth ``depth``."""
+    from blaze.kv_chunk_migration_helpers import build_kv_table
+
+    spec1 = km.k3_migration_spec(max_seq_len=depth, num_slots=1, blaze_config=cfg, kda_max_length=kda_max_length)
+    kv, state, cv = spec1.configs
+    if not tags:
+        state, cv = replace(state, tensor_type=None), replace(cv, tensor_type=None)
+    kda, mla = _kinds(cfg)
+    table = build_kv_table(
+        spec=replace(
+            spec1,
+            configs=(
+                replace(kv, mesh_id_to_addr={1: 0x1000}),
+                replace(state, mesh_id_to_addr={0: 0x2000}),
+                replace(cv, mesh_id_to_addr={0: 0x3000}),
+            ),
+        ),
+        num_layers=max(kda[0], mla[0]) + 1,
+        layer_id_to_stage_key={kda[0]: 0, mla[0]: 1},
+        stage_key_to_devices={0: [(c, c) for c in range(8)], 1: [(c, c) for c in range(8)]},
+        stage_key_to_host={0: 0xA, 1: 0xB},
+        layer_indexed=True,
+    )
+    return spec1, table
+
+
+#: MLA depths a deployment runs: the smallest (one quantum), the reduced 144K context and the full 1M.
+_DEPTHS = [8192, 147_456, 1_048_576]
+
+
+@pytest.mark.parametrize("depth", _DEPTHS)
+def test_one_slot_decode_table_matches_k3_prefill(cfg, tmp_path, depth):
+    """At one KDA state slot per user (``TT_K3_KDA_STATE_SLOTS=1``), the table decode exports carries, for configs
+    "1" and "2", the tag, extent, stride and chunk size prefill publishes, whatever the MLA depth: a Snapshot is not
+    padded to the context. "0" stays a ``Kv`` token cache. Checked on the protobuf the KV Manager loads."""
+    import ttnn
+
+    disagg = ttnn.experimental.disaggregation
+    spec1, table = _k3_table(cfg, depth=depth, kda_max_length=1)
+    disagg.export_to_protobuf_file(table, str(tmp_path / "decode.pb"))
+    loaded = disagg.import_from_protobuf_file(str(tmp_path / "decode.pb"))
+    ids = {c.name: i for i, c in enumerate(spec1.configs)}
+    assert loaded.config(ids["0"]).tensor_type == disagg.KvChunkTensorType.Kv
+    assert loaded.config(ids["0"]).max_sequence_length == depth
+    for name, (extent, stride, chunk_bytes) in _PREFILL_KDA.items():
+        got = loaded.config(ids[name])
+        assert got.tensor_type == disagg.KvChunkTensorType.Snapshot, name
+        geometry = (got.max_sequence_length, got.chunk_n_tokens, got.chunk_size_bytes)
+        assert geometry == (extent, stride, chunk_bytes), (name, depth)
+

+def test_kda_configs_are_snapshots_and_kvpe_is_a_token_cache(spec):
+    """The KV Manager moves a Snapshot config whole, whatever range a migration names, and refuses a copy unless
+    prefill and decode tag a config alike (tt-d-gen#1955)."""
+    import ttnn
+
+    tags = {c.name: c.tensor_type for c in spec.configs}
+    snapshot = ttnn.experimental.disaggregation.KvChunkTensorType.Snapshot
+    assert tags == {"0": None, "1": snapshot, "2": snapshot}

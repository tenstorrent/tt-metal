# Shared settings for the K3.1 P->D run (prefill Quad6, decode Quad8, KV Manager fleet). Sourced by the launchers.
PD=/data/bklockiewicz/k31run/pd
OUT=$PD/out
# P: positions prefill applies and migrates; decode re-applies prompt[P] (the 1-token tail), then N greedy tokens.
P=10240
N_TOKENS=32
MATCH_TOKENS=8
K3_MAX_SEQ_LEN=16384
PROMPT_DIR=/mnt/weka/model-cache/stable/deepseek-prefill-cache/golden/k3_vllm_code_debug_1M
K31_HF_MODEL=/mnt/weka/model-weights/llm/moonshotai/Kimi-K3.1-Pro-dequantized
DECODE_CACHE=/data/bklockiewicz/k31-decode-cache
PREFILL_TABLE=$PD/prefill_table.pb
DECODE_TABLE=$PD/decode_table.pb
PREFILL_DEVICE_MAP=/tmp/prefill_device_map.txt
DECODE_DEVICE_MAP=/tmp/decode_device_map.txt
DONE_FILE=$PD/migration_done.sentinel
HANDOFF=$PD/handoff.json
KVM_URL=http://bh-glx-120-c07u02:18081
